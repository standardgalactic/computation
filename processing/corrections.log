98107e-12}, {"id": 17, "seek": 2854, "start": 42.48, "end": 43.48, "text": " every single day.", "tokens": [51062, 633, 2167, 786, 13, 51112], "temperature": 0.0, "avg_logprob": -0.12820366024971008, "compression_ratio": 1.7239057239057238, "no_speech_prob": 1.069017053698107e-12}, {"id": 18, "seek": 2854, "start": 43.68, "end": 44.980000000000004, "text": " Every single day.", "tokens": [51122, 2048, 2167, 786, 13, 51187], "temperature": 0.0, "avg_logprob": -0.12820366024971008, "compression_ratio": 1.7239057239057238, "no_speech_prob": 1.069017053698107e-12}, {"id": 19, "seek": 2854, "start": 45.06, "end": 50.06, "text": " In the algorithms we use, the words we speak, the way we label our own lives.", "tokens": [51191, 682, 264, 14642, 321, 764, 11, 264, 2283, 321, 1710, 11, 264, 636, 321, 7645, 527, 1065, 2909, 13, 51441], "temperature": 0.0, "avg_logprob": -0.12820366024971008, "compression_ratio": 1.7239057239057238, "no_speech_prob": 1.069017053698107e-12}, {"id": 20, "seek": 2854, "start": 50.32, "end": 55.56, "text": " So today we are going on a deep dive into the invisible geometry of your choices.", "tokens": [51454, 407, 965, 321, 366, 516, 322, 257, 2452, 9192, 666, 264, 14603, 18426, 295, 428, 7994, 13, 51716], "temperature": 0.0, "avg_logprob": -0.12820366024971008, "compression_ratio": 1.7239057239057238, "no_speech_prob": 1.069017053698107e-12}, {"id": 21, "seek": 2854, "start": 56.28, "end": 57.78, "text": " Welcome to the deep dive, everyone.", "tokens": [51752, 4027, 281, 264, 2452, 9192, 11, 1518, 13, 51827], "temperature": 0.0, "avg_logprob": -0.12820366024971008, "compression_ratio": 1.7239057239057238, "no_speech_prob": 1.069017053698107e-12}, {"id": 22, "seek": 5778, "start": 57.78, "end": 63.44, "text": " We are looking at a fascinating, just remarkably dense text from 2026.", "tokens": [50365, 492, 366, 1237, 412, 257, 10343, 11, 445, 37381, 18011, 2487, 490, 945, 10880, 13, 50648], "temperature": 0.0, "avg_logprob": -0.12834089651875114, "compression_ratio": 1.4382978723404256, "no_speech_prob": 1.6292489276106825e-12}, {"id": 23, "seek": 5778, "start": 63.620000000000005, "end": 67.46000000000001, "text": " Yeah, it's called Generative Continuation Geometry by an author named Flixian.", "tokens": [50657, 865, 11, 309, 311, 1219, 15409, 1166, 14674, 16073, 2876, 34730, 538, 364, 3793, 4926, 3235, 970, 952, 13, 50849], "temperature": 0.0, "avg_logprob": -0.12834089651875114, "compression_ratio": 1.4382978723404256, "no_speech_prob": 1.6292489276106825e-12}, {"id": 24, "seek": 5778, "start": 67.78, "end": 72.98, "text": " And to really grasp what this book is doing, you have to picture a shifting digital blueprint.", "tokens": [50865, 400, 281, 534, 21743, 437, 341, 1446, 307, 884, 11, 291, 362, 281, 3036, 257, 17573, 4562, 35868, 13, 51125], "temperature": 0.0, "avg_logprob": -0.12834089651875114, "compression_ratio": 1.4382978723404256, "no_speech_prob": 1.6292489276106825e-12}, {"id": 25, "seek": 5778, "start": 73.34, "end": 73.54, "text": " Right.", "tokens": [51143, 1779, 13, 51153], "temperature": 0.0, "avg_logprob": -0.12834089651875114, "compression_ratio": 1.4382978723404256, "no_speech_prob": 1.6292489276106825e-12}, {"id": 26, "seek": 5778, "start": 73.62, "end": 78.0, "text": " Because the sheer scale of what we are dealing with today is staggering.", "tokens": [51157, 1436, 264, 23061, 4373, 295, 437, 321, 366, 6260, 365, 965, 307, 42974, 13, 51376], "temperature": 0.0, "avg_logprob": -0.12834089651875114, "compression_ratio": 1.4382978723404256, "no_speech_prob": 1.6292489276106825e-12}, {"id": 27, "seek": 5778, "start": 78.34, "end": 79.1, "text": " It really is.", "tokens": [51393, 467, 534, 307, 13, 51431], "temperature": 0.0, "avg_logprob": -0.12834089651875114, "compression_ratio": 1.4382978723404256, "no_speech_prob": 1.6292489276106825e-12}, {"id": 28, "seek": 7910, "start": 79.1, "end": 84.78, "text": " Imagine this vast, like, branching maze of topological pathways.", "tokens": [50365, 11739, 341, 8369, 11, 411, 11, 9819, 278, 33032, 295, 1192, 4383, 22988, 13, 50649], "temperature": 0.0, "avg_logprob": -0.15243368678622776, "compression_ratio": 0.9411764705882353, "no_speech_prob": 1.388442420931224e-12}, {"id": 29, "seek": 8478, "start": 84.78, "end": 89.66, "text": " Every state you are in, every single moment of your life is a node.", "tokens": [50365, 2048, 1785, 291, 366, 294, 11, 633, 2167, 1623, 295, 428, 993, 307, 257, 9984, 13, 50609], "temperature": 0.0, "avg_logprob": -0.25412886718223837, "compression_ratio": 1.0975609756097562, "no_speech_prob": 1.4639824725756756e-12}, {"id": 30, "seek": 8478, "start": 89.9, "end": 90.92, "text": " Just a point on a map.", "tokens": [50621, 1449, 257, 935, 322, 257, 4471, 13, 50672], "temperature": 0.0, "avg_logprob": -0.25412886718223837, "compression_ratio": 1.0975609756097562, "no_speech_prob": 1.4639824725756756e-12}, {"id": 31, "seek": 9092, "start": 90.92, "end": 91.60000000000001, "text": " Exactly.", "tokens": [50365, 7587, 13, 50399], "temperature": 0.0, "avg_logprob": -0.14919651976419152, "compression_ratio": 1.5751879699248121, "no_speech_prob": 1.4383393564729174e-12}, {"id": 32, "seek": 9092, "start": 92.04, "end": 97.18, "text": " And exploding out of that node are all the possible things that could happen next based", "tokens": [50421, 400, 35175, 484, 295, 300, 9984, 366, 439, 264, 1944, 721, 300, 727, 1051, 958, 2361, 50678], "temperature": 0.0, "avg_logprob": -0.14919651976419152, "compression_ratio": 1.5751879699248121, "no_speech_prob": 1.4383393564729174e-12}, {"id": 33, "seek": 9092, "start": 97.18, "end": 99.08, "text": " on the rules of whatever system you are in.", "tokens": [50678, 322, 264, 4474, 295, 2035, 1185, 291, 366, 294, 13, 50773], "temperature": 0.0, "avg_logprob": -0.14919651976419152, "compression_ratio": 1.5751879699248121, "no_speech_prob": 1.4383393564729174e-12}, {"id": 34, "seek": 9092, "start": 99.4, "end": 101.34, "text": " And the book claims to be about generation, right?", "tokens": [50789, 400, 264, 1446, 9441, 281, 312, 466, 5125, 11, 558, 30, 50886], "temperature": 0.0, "avg_logprob": -0.14919651976419152, "compression_ratio": 1.5751879699248121, "no_speech_prob": 1.4383393564729174e-12}, {"id": 35, "seek": 9092, "start": 101.42, "end": 102.64, "text": " Like, building those futures.", "tokens": [50890, 1743, 11, 2390, 729, 26071, 13, 50951], "temperature": 0.0, "avg_logprob": -0.14919651976419152, "compression_ratio": 1.5751879699248121, "no_speech_prob": 1.4383393564729174e-12}, {"id": 36, "seek": 9092, "start": 102.9, "end": 103.56, "text": " That's the title, yeah.", "tokens": [50964, 663, 311, 264, 4876, 11, 1338, 13, 50997], "temperature": 0.0, "avg_logprob": -0.14919651976419152, "compression_ratio": 1.5751879699248121, "no_speech_prob": 1.4383393564729174e-12}, {"id": 37, "seek": 9092, "start": 103.62, "end": 106.88, "text": " But the deeper you get into the math, you realize that's almost a bait and switch.", "tokens": [51000, 583, 264, 7731, 291, 483, 666, 264, 5221, 11, 291, 4325, 300, 311, 1920, 257, 16865, 293, 3679, 13, 51163], "temperature": 0.0, "avg_logprob": -0.14919651976419152, "compression_ratio": 1.5751879699248121, "no_speech_prob": 1.4383393564729174e-12}, {"id": 38, "seek": 9092, "start": 107.12, "end": 107.82, "text": " It totally is.", "tokens": [51175, 467, 3879, 307, 13, 51210], "temperature": 0.0, "avg_logprob": -0.14919651976419152, "compression_ratio": 1.5751879699248121, "no_speech_prob": 1.4383393564729174e-12}, {"id": 39, "seek": 9092, "start": 107.86, "end": 111.66, "text": " It's actually a master class in how information and possibilities are lost.", "tokens": [51212, 467, 311, 767, 257, 4505, 1508, 294, 577, 1589, 293, 12178, 366, 2731, 13, 51402], "temperature": 0.0, "avg_logprob": -0.14919651976419152, "compression_ratio": 1.5751879699248121, "no_speech_prob": 1.4383393564729174e-12}, {"id": 40, "seek": 11166, "start": 111.66, "end": 114.03999999999999, "text": " Yeah, it is the ultimate irony of the text.", "tokens": [50365, 865, 11, 309, 307, 264, 9705, 35365, 295, 264, 2487, 13, 50484], "temperature": 0.0, "avg_logprob": -0.08488619644030006, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.4839792806045637e-12}, {"id": 41, "seek": 11166, "start": 114.56, "end": 119.88, "text": " It's a framework for generating reality that actually spends all its time showing how futures", "tokens": [50510, 467, 311, 257, 8388, 337, 17746, 4103, 300, 767, 25620, 439, 1080, 565, 4099, 577, 26071, 50776], "temperature": 0.0, "avg_logprob": -0.08488619644030006, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.4839792806045637e-12}, {"id": 42, "seek": 11166, "start": 119.88, "end": 120.39999999999999, "text": " collapse.", "tokens": [50776, 15584, 13, 50802], "temperature": 0.0, "avg_logprob": -0.08488619644030006, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.4839792806045637e-12}, {"id": 43, "seek": 11166, "start": 120.62, "end": 122.5, "text": " So our mission today is to decode this.", "tokens": [50813, 407, 527, 4447, 965, 307, 281, 979, 1429, 341, 13, 50907], "temperature": 0.0, "avg_logprob": -0.08488619644030006, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.4839792806045637e-12}, {"id": 44, "seek": 11166, "start": 122.66, "end": 129.78, "text": " We are going to explore how futures are mathematically built, how they branch, and how easily your future", "tokens": [50915, 492, 366, 516, 281, 6839, 577, 26071, 366, 44003, 3094, 11, 577, 436, 9819, 11, 293, 577, 3612, 428, 2027, 51271], "temperature": 0.0, "avg_logprob": -0.08488619644030006, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.4839792806045637e-12}, {"id": 45, "seek": 11166, "start": 129.78, "end": 133.98, "text": " potential is erased, mislabeled, or constrained without you ever even knowing it.", "tokens": [51271, 3995, 307, 38359, 11, 3346, 75, 18657, 292, 11, 420, 38901, 1553, 291, 1562, 754, 5276, 309, 13, 51481], "temperature": 0.0, "avg_logprob": -0.08488619644030006, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.4839792806045637e-12}, {"id": 46, "seek": 11166, "start": 134.62, "end": 140.06, "text": " But to understand that collapse, you know, to really see the walls closing in, we have to", "tokens": [51513, 583, 281, 1223, 300, 15584, 11, 291, 458, 11, 281, 534, 536, 264, 7920, 10377, 294, 11, 321, 362, 281, 51785], "temperature": 0.0, "avg_logprob": -0.08488619644030006, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.4839792806045637e-12}, {"id": 47, "seek": 14006, "start": 140.06, "end": 141.76, "text": " start with the foundational mechanics.", "tokens": [50365, 722, 365, 264, 32195, 12939, 13, 50450], "temperature": 0.0, "avg_logprob": -0.18503372414598188, "compression_ratio": 1.5298804780876494, "no_speech_prob": 2.0524311417080554e-12}, {"id": 48, "seek": 14006, "start": 142.04, "end": 144.74, "text": " We have to understand how a future is built from scratch.", "tokens": [50464, 492, 362, 281, 1223, 577, 257, 2027, 307, 3094, 490, 8459, 13, 50599], "temperature": 0.0, "avg_logprob": -0.18503372414598188, "compression_ratio": 1.5298804780876494, "no_speech_prob": 2.0524311417080554e-12}, {"id": 49, "seek": 14006, "start": 144.98, "end": 145.22, "text": " Right.", "tokens": [50611, 1779, 13, 50623], "temperature": 0.0, "avg_logprob": -0.18503372414598188, "compression_ratio": 1.5298804780876494, "no_speech_prob": 2.0524311417080554e-12}, {"id": 50, "seek": 14006, "start": 145.86, "end": 152.0, "text": " And the text grounds this incredibly dense math in a surprisingly beautiful natural image.", "tokens": [50655, 400, 264, 2487, 19196, 341, 6252, 18011, 5221, 294, 257, 17600, 2238, 3303, 3256, 13, 50962], "temperature": 0.0, "avg_logprob": -0.18503372414598188, "compression_ratio": 1.5298804780876494, "no_speech_prob": 2.0524311417080554e-12}, {"id": 51, "seek": 14006, "start": 152.2, "end": 153.28, "text": " The growth of a fern.", "tokens": [50972, 440, 4599, 295, 257, 283, 1248, 13, 51026], "temperature": 0.0, "avg_logprob": -0.18503372414598188, "compression_ratio": 1.5298804780876494, "no_speech_prob": 2.0524311417080554e-12}, {"id": 52, "seek": 14006, "start": 153.6, "end": 153.9, "text": " Yes.", "tokens": [51042, 1079, 13, 51057], "temperature": 0.0, "avg_logprob": -0.18503372414598188, "compression_ratio": 1.5298804780876494, "no_speech_prob": 2.0524311417080554e-12}, {"id": 53, "seek": 14006, "start": 154.64000000000001, "end": 161.22, "text": " The fern frond is the quintessential illustration of what Flixing calls a continuation attractor.", "tokens": [51094, 440, 283, 1248, 431, 684, 307, 264, 40006, 48143, 22645, 295, 437, 3235, 970, 278, 5498, 257, 29357, 5049, 284, 13, 51423], "temperature": 0.0, "avg_logprob": -0.18503372414598188, "compression_ratio": 1.5298804780876494, "no_speech_prob": 2.0524311417080554e-12}, {"id": 54, "seek": 14006, "start": 161.52, "end": 164.34, "text": " Which sounds like a sci-fi term, but it's really elegant.", "tokens": [51438, 3013, 3263, 411, 257, 2180, 12, 13325, 1433, 11, 457, 309, 311, 534, 21117, 13, 51579], "temperature": 0.0, "avg_logprob": -0.18503372414598188, "compression_ratio": 1.5298804780876494, "no_speech_prob": 2.0524311417080554e-12}, {"id": 55, "seek": 14006, "start": 164.58, "end": 164.98000000000002, "text": " It is.", "tokens": [51591, 467, 307, 13, 51611], "temperature": 0.0, "avg_logprob": -0.18503372414598188, "compression_ratio": 1.5298804780876494, "no_speech_prob": 2.0524311417080554e-12}, {"id": 56, "seek": 16498, "start": 164.98, "end": 170.44, "text": " If you walk into a forest and look at a frame, you have to realize that nature didn't draw", "tokens": [50365, 759, 291, 1792, 666, 257, 6719, 293, 574, 412, 257, 3920, 11, 291, 362, 281, 4325, 300, 3687, 994, 380, 2642, 50638], "temperature": 0.0, "avg_logprob": -0.10714448444427006, "compression_ratio": 1.589655172413793, "no_speech_prob": 1.4898027473134179e-12}, {"id": 57, "seek": 16498, "start": 170.44, "end": 172.14, "text": " that plant leaf by leaf.", "tokens": [50638, 300, 3709, 10871, 538, 10871, 13, 50723], "temperature": 0.0, "avg_logprob": -0.10714448444427006, "compression_ratio": 1.589655172413793, "no_speech_prob": 1.4898027473134179e-12}, {"id": 58, "seek": 16498, "start": 172.5, "end": 172.82, "text": " Right.", "tokens": [50741, 1779, 13, 50757], "temperature": 0.0, "avg_logprob": -0.10714448444427006, "compression_ratio": 1.589655172413793, "no_speech_prob": 1.4898027473134179e-12}, {"id": 59, "seek": 16498, "start": 172.89999999999998, "end": 174.22, "text": " There's no tiny artist in there.", "tokens": [50761, 821, 311, 572, 5870, 5748, 294, 456, 13, 50827], "temperature": 0.0, "avg_logprob": -0.10714448444427006, "compression_ratio": 1.589655172413793, "no_speech_prob": 1.4898027473134179e-12}, {"id": 60, "seek": 16498, "start": 174.35999999999999, "end": 174.67999999999998, "text": " Exactly.", "tokens": [50834, 7587, 13, 50850], "temperature": 0.0, "avg_logprob": -0.10714448444427006, "compression_ratio": 1.589655172413793, "no_speech_prob": 1.4898027473134179e-12}, {"id": 61, "seek": 16498, "start": 174.94, "end": 181.29999999999998, "text": " It doesn't have this massive complex blueprint stored in its DNA detailing the exact coordinates", "tokens": [50863, 467, 1177, 380, 362, 341, 5994, 3997, 35868, 12187, 294, 1080, 8272, 42459, 264, 1900, 21056, 51181], "temperature": 0.0, "avg_logprob": -0.10714448444427006, "compression_ratio": 1.589655172413793, "no_speech_prob": 1.4898027473134179e-12}, {"id": 62, "seek": 16498, "start": 181.29999999999998, "end": 182.92, "text": " of every single jagged edge.", "tokens": [51181, 295, 633, 2167, 6368, 3004, 4691, 13, 51262], "temperature": 0.0, "avg_logprob": -0.10714448444427006, "compression_ratio": 1.589655172413793, "no_speech_prob": 1.4898027473134179e-12}, {"id": 63, "seek": 16498, "start": 183.07999999999998, "end": 189.0, "text": " Because if you look closely at one little leaflet on that fern, a pinna, I think it's called,", "tokens": [51270, 1436, 498, 291, 574, 8185, 412, 472, 707, 10871, 2631, 322, 300, 283, 1248, 11, 257, 5447, 629, 11, 286, 519, 309, 311, 1219, 11, 51566], "temperature": 0.0, "avg_logprob": -0.10714448444427006, "compression_ratio": 1.589655172413793, "no_speech_prob": 1.4898027473134179e-12}, {"id": 64, "seek": 16498, "start": 189.2, "end": 192.33999999999997, "text": " it looks almost exactly like a miniature version of the whole fern.", "tokens": [51576, 309, 1542, 1920, 2293, 411, 257, 34674, 3037, 295, 264, 1379, 283, 1248, 13, 51733], "temperature": 0.0, "avg_logprob": -0.10714448444427006, "compression_ratio": 1.589655172413793, "no_speech_prob": 1.4898027473134179e-12}, {"id": 65, "seek": 16498, "start": 192.42, "end": 192.83999999999997, "text": " It does.", "tokens": [51737, 467, 775, 13, 51758], "temperature": 0.0, "avg_logprob": -0.10714448444427006, "compression_ratio": 1.589655172413793, "no_speech_prob": 1.4898027473134179e-12}, {"id": 66, "seek": 19284, "start": 192.84, "end": 196.92000000000002, "text": " And if you zoom in on a sub-leaflet of that one, it's just a smaller fern again.", "tokens": [50365, 400, 498, 291, 8863, 294, 322, 257, 1422, 12, 306, 2792, 2631, 295, 300, 472, 11, 309, 311, 445, 257, 4356, 283, 1248, 797, 13, 50569], "temperature": 0.0, "avg_logprob": -0.12863892449273004, "compression_ratio": 1.6109324758842443, "no_speech_prob": 1.2596076525567268e-12}, {"id": 67, "seek": 19284, "start": 196.96, "end": 198.4, "text": " It's fractals all the way down.", "tokens": [50571, 467, 311, 17948, 1124, 439, 264, 636, 760, 13, 50643], "temperature": 0.0, "avg_logprob": -0.12863892449273004, "compression_ratio": 1.6109324758842443, "no_speech_prob": 1.2596076525567268e-12}, {"id": 68, "seek": 19284, "start": 198.54, "end": 198.74, "text": " Right.", "tokens": [50650, 1779, 13, 50660], "temperature": 0.0, "avg_logprob": -0.12863892449273004, "compression_ratio": 1.6109324758842443, "no_speech_prob": 1.2596076525567268e-12}, {"id": 69, "seek": 19284, "start": 198.9, "end": 202.86, "text": " Which means the final shape is not a static file being loaded into reality.", "tokens": [50668, 3013, 1355, 264, 2572, 3909, 307, 406, 257, 13437, 3991, 885, 13210, 666, 4103, 13, 50866], "temperature": 0.0, "avg_logprob": -0.12863892449273004, "compression_ratio": 1.6109324758842443, "no_speech_prob": 1.2596076525567268e-12}, {"id": 70, "seek": 19284, "start": 203.24, "end": 204.34, "text": " It is an active process.", "tokens": [50885, 467, 307, 364, 4967, 1399, 13, 50940], "temperature": 0.0, "avg_logprob": -0.12863892449273004, "compression_ratio": 1.6109324758842443, "no_speech_prob": 1.2596076525567268e-12}, {"id": 71, "seek": 19284, "start": 204.66, "end": 206.74, "text": " A process that's running constantly.", "tokens": [50956, 316, 1399, 300, 311, 2614, 6460, 13, 51060], "temperature": 0.0, "avg_logprob": -0.12863892449273004, "compression_ratio": 1.6109324758842443, "no_speech_prob": 1.2596076525567268e-12}, {"id": 72, "seek": 19284, "start": 207.1, "end": 207.56, "text": " Exactly.", "tokens": [51078, 7587, 13, 51101], "temperature": 0.0, "avg_logprob": -0.12863892449273004, "compression_ratio": 1.6109324758842443, "no_speech_prob": 1.2596076525567268e-12}, {"id": 73, "seek": 19284, "start": 207.86, "end": 212.84, "text": " A very small set of growth rules is being applied over and over again to its own output.", "tokens": [51116, 316, 588, 1359, 992, 295, 4599, 4474, 307, 885, 6456, 670, 293, 670, 797, 281, 1080, 1065, 5598, 13, 51365], "temperature": 0.0, "avg_logprob": -0.12863892449273004, "compression_ratio": 1.6109324758842443, "no_speech_prob": 1.2596076525567268e-12}, {"id": 74, "seek": 19284, "start": 213.02, "end": 215.96, "text": " So mathematically, how does the book describe this?", "tokens": [51374, 407, 44003, 11, 577, 775, 264, 1446, 6786, 341, 30, 51521], "temperature": 0.0, "avg_logprob": -0.12863892449273004, "compression_ratio": 1.6109324758842443, "no_speech_prob": 1.2596076525567268e-12}, {"id": 75, "seek": 19284, "start": 216.16, "end": 221.98000000000002, "text": " The text uses a concept known as the Hutchinson operator to explain how this mechanism works.", "tokens": [51531, 440, 2487, 4960, 257, 3410, 2570, 382, 264, 48499, 14321, 12973, 281, 2903, 577, 341, 7513, 1985, 13, 51822], "temperature": 0.0, "avg_logprob": -0.12863892449273004, "compression_ratio": 1.6109324758842443, "no_speech_prob": 1.2596076525567268e-12}, {"id": 76, "seek": 22198, "start": 221.98, "end": 222.66, "text": " Okay.", "tokens": [50365, 1033, 13, 50399], "temperature": 0.0, "avg_logprob": -0.255162750802389, "compression_ratio": 1.4764397905759161, "no_speech_prob": 1.3671258135977693e-12}, {"id": 77, "seek": 22198, "start": 222.73999999999998, "end": 223.78, "text": " The Hutchinson operator.", "tokens": [50403, 440, 48499, 14321, 12973, 13, 50455], "temperature": 0.0, "avg_logprob": -0.255162750802389, "compression_ratio": 1.4764397905759161, "no_speech_prob": 1.3671258135977693e-12}, {"id": 78, "seek": 22198, "start": 224.04, "end": 224.26, "text": " Yeah.", "tokens": [50468, 865, 13, 50479], "temperature": 0.0, "avg_logprob": -0.255162750802389, "compression_ratio": 1.4764397905759161, "no_speech_prob": 1.3671258135977693e-12}, {"id": 79, "seek": 22198, "start": 224.44, "end": 226.79999999999998, "text": " And this is where the geometry gets really fascinating.", "tokens": [50488, 400, 341, 307, 689, 264, 18426, 2170, 534, 10343, 13, 50606], "temperature": 0.0, "avg_logprob": -0.255162750802389, "compression_ratio": 1.4764397905759161, "no_speech_prob": 1.3671258135977693e-12}, {"id": 80, "seek": 22198, "start": 227.2, "end": 230.29999999999998, "text": " Because the Hutchinson operator doesn't act on numbers.", "tokens": [50626, 1436, 264, 48499, 14321, 12973, 1177, 380, 605, 322, 3547, 13, 50781], "temperature": 0.0, "avg_logprob": -0.255162750802389, "compression_ratio": 1.4764397905759161, "no_speech_prob": 1.3671258135977693e-12}, {"id": 81, "seek": 22198, "start": 230.95999999999998, "end": 233.56, "text": " It acts on the space of shapes itself.", "tokens": [50814, 467, 10672, 322, 264, 1901, 295, 10854, 2564, 13, 50944], "temperature": 0.0, "avg_logprob": -0.255162750802389, "compression_ratio": 1.4764397905759161, "no_speech_prob": 1.3671258135977693e-12}, {"id": 82, "seek": 22198, "start": 234.56, "end": 234.82, "text": " Okay.", "tokens": [50994, 1033, 13, 51007], "temperature": 0.0, "avg_logprob": -0.255162750802389, "compression_ratio": 1.4764397905759161, "no_speech_prob": 1.3671258135977693e-12}, {"id": 83, "seek": 22198, "start": 234.89999999999998, "end": 238.35999999999999, "text": " Let me slow us down there for a second because that sounds like a paradox to me.", "tokens": [51011, 961, 385, 2964, 505, 760, 456, 337, 257, 1150, 570, 300, 3263, 411, 257, 26221, 281, 385, 13, 51184], "temperature": 0.0, "avg_logprob": -0.255162750802389, "compression_ratio": 1.4764397905759161, "no_speech_prob": 1.3671258135977693e-12}, {"id": 84, "seek": 22198, "start": 238.54, "end": 238.85999999999999, "text": " How so?", "tokens": [51193, 1012, 370, 30, 51209], "temperature": 0.0, "avg_logprob": -0.255162750802389, "compression_ratio": 1.4764397905759161, "no_speech_prob": 1.3671258135977693e-12}, {"id": 85, "seek": 23886, "start": 238.86, "end": 243.72000000000003, "text": " Well, how do you perform mathematical operations on a space of shapes?", "tokens": [50365, 1042, 11, 577, 360, 291, 2042, 18894, 7705, 322, 257, 1901, 295, 10854, 30, 50608], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 86, "seek": 23886, "start": 243.98000000000002, "end": 247.12, "text": " I mean, if I have an equation, I plug in a number, I get a number back.", "tokens": [50621, 286, 914, 11, 498, 286, 362, 364, 5367, 11, 286, 5452, 294, 257, 1230, 11, 286, 483, 257, 1230, 646, 13, 50778], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 87, "seek": 23886, "start": 247.20000000000002, "end": 249.8, "text": " How do you plug in a shape and measure what comes back?", "tokens": [50782, 1012, 360, 291, 5452, 294, 257, 3909, 293, 3481, 437, 1487, 646, 30, 50912], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 88, "seek": 23886, "start": 250.06, "end": 252.68, "text": " You measure it using something called the Hausdorff distance.", "tokens": [50925, 509, 3481, 309, 1228, 746, 1219, 264, 22725, 67, 284, 602, 4560, 13, 51056], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 89, "seek": 23886, "start": 252.9, "end": 253.86, "text": " The Hausdorff distance.", "tokens": [51067, 440, 22725, 67, 284, 602, 4560, 13, 51115], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 90, "seek": 23886, "start": 254.0, "end": 254.22000000000003, "text": " Okay.", "tokens": [51122, 1033, 13, 51133], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 91, "seek": 23886, "start": 254.46, "end": 255.20000000000002, "text": " Paint a picture for me.", "tokens": [51145, 34865, 257, 3036, 337, 385, 13, 51182], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 92, "seek": 23886, "start": 255.3, "end": 255.46, "text": " Sure.", "tokens": [51187, 4894, 13, 51195], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 93, "seek": 23886, "start": 256.40000000000003, "end": 259.42, "text": " Imagine you draw two completely different messy scribbles.", "tokens": [51242, 11739, 291, 2642, 732, 2584, 819, 16191, 39435, 8806, 13, 51393], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 94, "seek": 23886, "start": 259.7, "end": 260.88, "text": " Just random lines.", "tokens": [51407, 1449, 4974, 3876, 13, 51466], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 95, "seek": 23886, "start": 260.90000000000003, "end": 261.04, "text": " Yeah.", "tokens": [51467, 865, 13, 51474], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 96, "seek": 23886, "start": 261.06, "end": 264.06, "text": " Totally random scribbles on two pieces of transparent plastic.", "tokens": [51475, 22837, 4974, 39435, 8806, 322, 732, 3755, 295, 12737, 5900, 13, 51625], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 97, "seek": 23886, "start": 264.24, "end": 264.52000000000004, "text": " Mm-hmm.", "tokens": [51634, 8266, 12, 10250, 13, 51648], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 98, "seek": 23886, "start": 264.64, "end": 266.26, "text": " You overlay them on top of each other.", "tokens": [51654, 509, 31741, 552, 322, 1192, 295, 1184, 661, 13, 51735], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 99, "seek": 23886, "start": 266.3, "end": 266.48, "text": " Okay.", "tokens": [51737, 1033, 13, 51746], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 100, "seek": 23886, "start": 266.52000000000004, "end": 268.46000000000004, "text": " I have my two transparent sheets.", "tokens": [51748, 286, 362, 452, 732, 12737, 15421, 13, 51845], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 101, "seek": 23886, "start": 268.46000000000004, "end": 268.8, "text": " Okay.", "tokens": [51845, 1033, 13, 51862], "temperature": 0.0, "avg_logprob": -0.16249196122332318, "compression_ratio": 1.7610062893081762, "no_speech_prob": 1.4213640030583119e-12}, {"id": 102, "seek": 26886, "start": 268.86, "end": 274.66, "text": " To find the Hausdorff distance, you find the point on the first scribble that is the absolute", "tokens": [50365, 1407, 915, 264, 22725, 67, 284, 602, 4560, 11, 291, 915, 264, 935, 322, 264, 700, 39435, 638, 300, 307, 264, 8236, 50655], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 103, "seek": 26886, "start": 274.66, "end": 277.12, "text": " furthest away from any part of the second scribble.", "tokens": [50655, 2687, 36356, 1314, 490, 604, 644, 295, 264, 1150, 39435, 638, 13, 50778], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 104, "seek": 26886, "start": 277.2, "end": 279.22, "text": " So the biggest gap between the two drawings.", "tokens": [50782, 407, 264, 3880, 7417, 1296, 264, 732, 18618, 13, 50883], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 105, "seek": 26886, "start": 279.24, "end": 279.6, "text": " Exactly.", "tokens": [50884, 7587, 13, 50902], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 106, "seek": 26886, "start": 279.76, "end": 280.6, "text": " Then you reverse it.", "tokens": [50910, 1396, 291, 9943, 309, 13, 50952], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 107, "seek": 26886, "start": 281.0, "end": 284.12, "text": " You find the point on the second scribble furthest from the first.", "tokens": [50972, 509, 915, 264, 935, 322, 264, 1150, 39435, 638, 2687, 36356, 490, 264, 700, 13, 51128], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 108, "seek": 26886, "start": 284.18, "end": 284.46000000000004, "text": " Okay.", "tokens": [51131, 1033, 13, 51145], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 109, "seek": 26886, "start": 284.58000000000004, "end": 285.08000000000004, "text": " That makes sense.", "tokens": [51151, 663, 1669, 2020, 13, 51176], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 110, "seek": 26886, "start": 285.26, "end": 288.52000000000004, "text": " The larger of those two distances is your Hausdorff metric.", "tokens": [51185, 440, 4833, 295, 729, 732, 22182, 307, 428, 22725, 67, 284, 602, 20678, 13, 51348], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 111, "seek": 26886, "start": 288.90000000000003, "end": 289.6, "text": " Oh, I see.", "tokens": [51367, 876, 11, 286, 536, 13, 51402], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 112, "seek": 26886, "start": 289.6, "end": 294.94, "text": " It is a strict mathematical way of asking, like, what is the worst case scenario for how", "tokens": [51402, 467, 307, 257, 10910, 18894, 636, 295, 3365, 11, 411, 11, 437, 307, 264, 5855, 1389, 9005, 337, 577, 51669], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 113, "seek": 26886, "start": 294.94, "end": 296.6, "text": " mismatched these two shapes are?", "tokens": [51669, 23220, 24102, 613, 732, 10854, 366, 30, 51752], "temperature": 0.0, "avg_logprob": -0.1329087539457939, "compression_ratio": 1.8129496402877698, "no_speech_prob": 1.2595692717998208e-12}, {"id": 114, "seek": 29660, "start": 296.6, "end": 301.16, "text": " So, if the Hausdorff distance is large, the shapes are completely different.", "tokens": [50365, 407, 11, 498, 264, 22725, 67, 284, 602, 4560, 307, 2416, 11, 264, 10854, 366, 2584, 819, 13, 50593], "temperature": 0.0, "avg_logprob": -0.17584135822046584, "compression_ratio": 1.570281124497992, "no_speech_prob": 1.383236624200035e-12}, {"id": 115, "seek": 29660, "start": 301.32000000000005, "end": 301.56, "text": " Right.", "tokens": [50601, 1779, 13, 50613], "temperature": 0.0, "avg_logprob": -0.17584135822046584, "compression_ratio": 1.570281124497992, "no_speech_prob": 1.383236624200035e-12}, {"id": 116, "seek": 29660, "start": 301.82000000000005, "end": 305.64000000000004, "text": " And if it shrinks down to zero, the shapes are functionally identical.", "tokens": [50626, 400, 498, 309, 9884, 16431, 760, 281, 4018, 11, 264, 10854, 366, 2445, 379, 14800, 13, 50817], "temperature": 0.0, "avg_logprob": -0.17584135822046584, "compression_ratio": 1.570281124497992, "no_speech_prob": 1.383236624200035e-12}, {"id": 117, "seek": 29660, "start": 306.08000000000004, "end": 306.54, "text": " Precisely.", "tokens": [50839, 48746, 736, 13, 50862], "temperature": 0.0, "avg_logprob": -0.17584135822046584, "compression_ratio": 1.570281124497992, "no_speech_prob": 1.383236624200035e-12}, {"id": 118, "seek": 29660, "start": 306.86, "end": 308.92, "text": " And that's exactly the mechanic we need here.", "tokens": [50878, 400, 300, 311, 2293, 264, 23860, 321, 643, 510, 13, 50981], "temperature": 0.0, "avg_logprob": -0.17584135822046584, "compression_ratio": 1.570281124497992, "no_speech_prob": 1.383236624200035e-12}, {"id": 119, "seek": 29660, "start": 309.04, "end": 313.68, "text": " Because the rules that build a fern, these Hutchinson operators we mentioned, they have", "tokens": [50987, 1436, 264, 4474, 300, 1322, 257, 283, 1248, 11, 613, 48499, 14321, 19077, 321, 2835, 11, 436, 362, 51219], "temperature": 0.0, "avg_logprob": -0.17584135822046584, "compression_ratio": 1.570281124497992, "no_speech_prob": 1.383236624200035e-12}, {"id": 120, "seek": 29660, "start": 313.68, "end": 315.12, "text": " a very specific requirement.", "tokens": [51219, 257, 588, 2685, 11695, 13, 51291], "temperature": 0.0, "avg_logprob": -0.17584135822046584, "compression_ratio": 1.570281124497992, "no_speech_prob": 1.383236624200035e-12}, {"id": 121, "seek": 29660, "start": 315.5, "end": 315.96000000000004, "text": " What's that?", "tokens": [51310, 708, 311, 300, 30, 51333], "temperature": 0.0, "avg_logprob": -0.17584135822046584, "compression_ratio": 1.570281124497992, "no_speech_prob": 1.383236624200035e-12}, {"id": 122, "seek": 29660, "start": 316.06, "end": 318.68, "text": " They have to be what the text calls contractions.", "tokens": [51338, 814, 362, 281, 312, 437, 264, 2487, 5498, 4364, 626, 13, 51469], "temperature": 0.0, "avg_logprob": -0.17584135822046584, "compression_ratio": 1.570281124497992, "no_speech_prob": 1.383236624200035e-12}, {"id": 123, "seek": 31868, "start": 318.68, "end": 322.84000000000003, "text": " This means they must have a Lipschitz constant of less than one.", "tokens": [50365, 639, 1355, 436, 1633, 362, 257, 441, 2600, 339, 6862, 5754, 295, 1570, 813, 472, 13, 50573], "temperature": 0.0, "avg_logprob": -0.1488837900087815, "compression_ratio": 1.8134920634920635, "no_speech_prob": 1.9815828665448176e-12}, {"id": 124, "seek": 31868, "start": 323.04, "end": 323.06, "text": " Okay.", "tokens": [50583, 1033, 13, 50584], "temperature": 0.0, "avg_logprob": -0.1488837900087815, "compression_ratio": 1.8134920634920635, "no_speech_prob": 1.9815828665448176e-12}, {"id": 125, "seek": 31868, "start": 323.1, "end": 325.52, "text": " I'm definitely going to need a translation on Lipschitz constant.", "tokens": [50586, 286, 478, 2138, 516, 281, 643, 257, 12853, 322, 441, 2600, 339, 6862, 5754, 13, 50707], "temperature": 0.0, "avg_logprob": -0.1488837900087815, "compression_ratio": 1.8134920634920635, "no_speech_prob": 1.9815828665448176e-12}, {"id": 126, "seek": 31868, "start": 325.88, "end": 327.82, "text": " Think of it as a speed limit on stretching.", "tokens": [50725, 6557, 295, 309, 382, 257, 3073, 4948, 322, 19632, 13, 50822], "temperature": 0.0, "avg_logprob": -0.1488837900087815, "compression_ratio": 1.8134920634920635, "no_speech_prob": 1.9815828665448176e-12}, {"id": 127, "seek": 31868, "start": 328.04, "end": 329.08, "text": " A speed limit on stretching.", "tokens": [50833, 316, 3073, 4948, 322, 19632, 13, 50885], "temperature": 0.0, "avg_logprob": -0.1488837900087815, "compression_ratio": 1.8134920634920635, "no_speech_prob": 1.9815828665448176e-12}, {"id": 128, "seek": 31868, "start": 329.16, "end": 329.38, "text": " Okay.", "tokens": [50889, 1033, 13, 50900], "temperature": 0.0, "avg_logprob": -0.1488837900087815, "compression_ratio": 1.8134920634920635, "no_speech_prob": 1.9815828665448176e-12}, {"id": 129, "seek": 31868, "start": 329.7, "end": 329.94, "text": " Right.", "tokens": [50916, 1779, 13, 50928], "temperature": 0.0, "avg_logprob": -0.1488837900087815, "compression_ratio": 1.8134920634920635, "no_speech_prob": 1.9815828665448176e-12}, {"id": 130, "seek": 31868, "start": 330.36, "end": 335.56, "text": " If a rule has a Lipschitz constant of less than one, it means that no matter what you", "tokens": [50949, 759, 257, 4978, 575, 257, 441, 2600, 339, 6862, 5754, 295, 1570, 813, 472, 11, 309, 1355, 300, 572, 1871, 437, 291, 51209], "temperature": 0.0, "avg_logprob": -0.1488837900087815, "compression_ratio": 1.8134920634920635, "no_speech_prob": 1.9815828665448176e-12}, {"id": 131, "seek": 31868, "start": 335.56, "end": 340.56, "text": " put into the rule, the output will always bring the points closer together than they", "tokens": [51209, 829, 666, 264, 4978, 11, 264, 5598, 486, 1009, 1565, 264, 2793, 4966, 1214, 813, 436, 51459], "temperature": 0.0, "avg_logprob": -0.1488837900087815, "compression_ratio": 1.8134920634920635, "no_speech_prob": 1.9815828665448176e-12}, {"id": 132, "seek": 31868, "start": 340.56, "end": 341.24, "text": " were before.", "tokens": [51459, 645, 949, 13, 51493], "temperature": 0.0, "avg_logprob": -0.1488837900087815, "compression_ratio": 1.8134920634920635, "no_speech_prob": 1.9815828665448176e-12}, {"id": 133, "seek": 31868, "start": 341.5, "end": 343.9, "text": " So it shrinks the distance between any two points.", "tokens": [51506, 407, 309, 9884, 16431, 264, 4560, 1296, 604, 732, 2793, 13, 51626], "temperature": 0.0, "avg_logprob": -0.1488837900087815, "compression_ratio": 1.8134920634920635, "no_speech_prob": 1.9815828665448176e-12}, {"id": 134, "seek": 34390, "start": 343.9, "end": 344.38, "text": " Exactly.", "tokens": [50365, 7587, 13, 50389], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 135, "seek": 34390, "start": 344.67999999999995, "end": 347.65999999999997, "text": " Every time you apply the rule, the overall shape contracts.", "tokens": [50404, 2048, 565, 291, 3079, 264, 4978, 11, 264, 4787, 3909, 13952, 13, 50553], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 136, "seek": 34390, "start": 348.06, "end": 349.28, "text": " So the shrinking is the engine.", "tokens": [50573, 407, 264, 41684, 307, 264, 2848, 13, 50634], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 137, "seek": 34390, "start": 349.62, "end": 349.88, "text": " Yes.", "tokens": [50651, 1079, 13, 50664], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 138, "seek": 34390, "start": 350.09999999999997, "end": 354.96, "text": " If the rules are always contracting the space, bringing things tighter and tighter together,", "tokens": [50675, 759, 264, 4474, 366, 1009, 36095, 264, 1901, 11, 5062, 721, 30443, 293, 30443, 1214, 11, 50918], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 139, "seek": 34390, "start": 355.21999999999997, "end": 361.78, "text": " they are going to predictably, unavoidably converge into a specific self-similar shape.", "tokens": [50931, 436, 366, 516, 281, 6069, 1188, 11, 36541, 17079, 1188, 41881, 666, 257, 2685, 2698, 12, 30937, 2202, 3909, 13, 51259], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 140, "seek": 34390, "start": 361.88, "end": 362.88, "text": " Which is the attractor.", "tokens": [51264, 3013, 307, 264, 5049, 284, 13, 51314], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 141, "seek": 34390, "start": 363.23999999999995, "end": 363.65999999999997, "text": " Wow.", "tokens": [51332, 3153, 13, 51353], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 142, "seek": 34390, "start": 364.17999999999995, "end": 365.26, "text": " Okay, that's brilliant.", "tokens": [51379, 1033, 11, 300, 311, 10248, 13, 51433], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 143, "seek": 34390, "start": 365.62, "end": 368.91999999999996, "text": " And here's the truly mind-bending part about these contracting rules.", "tokens": [51451, 400, 510, 311, 264, 4908, 1575, 12, 65, 2029, 644, 466, 613, 36095, 4474, 13, 51616], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 144, "seek": 34390, "start": 368.97999999999996, "end": 369.64, "text": " Lay it on me.", "tokens": [51619, 20084, 309, 322, 385, 13, 51652], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 145, "seek": 34390, "start": 369.94, "end": 372.46, "text": " The starting shape is completely irrelevant.", "tokens": [51667, 440, 2891, 3909, 307, 2584, 28682, 13, 51793], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 146, "seek": 34390, "start": 372.46, "end": 373.17999999999995, "text": " Wait, really?", "tokens": [51793, 3802, 11, 534, 30, 51829], "temperature": 0.0, "avg_logprob": -0.19515294739694306, "compression_ratio": 1.6506849315068493, "no_speech_prob": 1.6171474966422683e-12}, {"id": 147, "seek": 37318, "start": 373.5, "end": 374.34000000000003, "text": " Completely irrelevant.", "tokens": [50381, 39978, 28682, 13, 50423], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 148, "seek": 37318, "start": 374.6, "end": 374.98, "text": " Completely.", "tokens": [50436, 39978, 13, 50455], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 149, "seek": 37318, "start": 375.34000000000003, "end": 376.66, "text": " You can start with a perfect square.", "tokens": [50473, 509, 393, 722, 365, 257, 2176, 3732, 13, 50539], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 150, "seek": 37318, "start": 376.84000000000003, "end": 378.34000000000003, "text": " You can start with a photograph of a cat.", "tokens": [50548, 509, 393, 722, 365, 257, 8348, 295, 257, 3857, 13, 50623], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 151, "seek": 37318, "start": 378.36, "end": 378.84000000000003, "text": " A cat.", "tokens": [50624, 316, 3857, 13, 50648], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 152, "seek": 37318, "start": 379.04, "end": 379.48, "text": " Seriously.", "tokens": [50658, 14063, 13, 50680], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 153, "seek": 37318, "start": 379.84000000000003, "end": 385.48, "text": " If you apply the fern-making rules to the picture of the cat, measure the result, apply", "tokens": [50698, 759, 291, 3079, 264, 283, 1248, 12, 12402, 4474, 281, 264, 3036, 295, 264, 3857, 11, 3481, 264, 1874, 11, 3079, 50980], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 154, "seek": 37318, "start": 385.48, "end": 388.34000000000003, "text": " the rules again, and just keep iterating.", "tokens": [50980, 264, 4474, 797, 11, 293, 445, 1066, 17138, 990, 13, 51123], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 155, "seek": 37318, "start": 388.46000000000004, "end": 389.46000000000004, "text": " It turns into a fern.", "tokens": [51129, 467, 4523, 666, 257, 283, 1248, 13, 51179], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 156, "seek": 37318, "start": 389.46000000000004, "end": 394.0, "text": " The shape will contract, fold, and morph until it becomes the fern.", "tokens": [51179, 440, 3909, 486, 4364, 11, 4860, 11, 293, 25778, 1826, 309, 3643, 264, 283, 1248, 13, 51406], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 157, "seek": 37318, "start": 394.68, "end": 399.32, "text": " The destination is entirely determined by the rules, not the starting material.", "tokens": [51440, 440, 12236, 307, 7696, 9540, 538, 264, 4474, 11, 406, 264, 2891, 2527, 13, 51672], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 158, "seek": 37318, "start": 399.84000000000003, "end": 400.66, "text": " I love that.", "tokens": [51698, 286, 959, 300, 13, 51739], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 159, "seek": 37318, "start": 400.74, "end": 402.42, "text": " It actually makes me think about baking.", "tokens": [51743, 467, 767, 1669, 385, 519, 466, 12102, 13, 51827], "temperature": 0.0, "avg_logprob": -0.1997233979842242, "compression_ratio": 1.7321428571428572, "no_speech_prob": 2.076444268264699e-12}, {"id": 160, "seek": 40242, "start": 402.42, "end": 403.42, "text": " Baking?", "tokens": [50365, 363, 2456, 30, 50415], "temperature": 0.0, "avg_logprob": -0.20759594657204367, "compression_ratio": 1.6260504201680672, "no_speech_prob": 1.927920496858082e-12}, {"id": 161, "seek": 40242, "start": 403.42, "end": 404.24, "text": " How so?", "tokens": [50415, 1012, 370, 30, 50456], "temperature": 0.0, "avg_logprob": -0.20759594657204367, "compression_ratio": 1.6260504201680672, "no_speech_prob": 1.927920496858082e-12}, {"id": 162, "seek": 40242, "start": 404.24, "end": 409.36, "text": " Well, there is a massive difference between maintaining a sourdough starter and trying", "tokens": [50456, 1042, 11, 456, 307, 257, 5994, 2649, 1296, 14916, 257, 11006, 67, 581, 22465, 293, 1382, 50712], "temperature": 0.0, "avg_logprob": -0.20759594657204367, "compression_ratio": 1.6260504201680672, "no_speech_prob": 1.927920496858082e-12}, {"id": 163, "seek": 40242, "start": 409.36, "end": 412.86, "text": " to bake a very specific loaf of bread from a recipe.", "tokens": [50712, 281, 16562, 257, 588, 2685, 40743, 295, 5961, 490, 257, 6782, 13, 50887], "temperature": 0.0, "avg_logprob": -0.20759594657204367, "compression_ratio": 1.6260504201680672, "no_speech_prob": 1.927920496858082e-12}, {"id": 164, "seek": 40242, "start": 413.04, "end": 413.40000000000003, "text": " Oh, right.", "tokens": [50896, 876, 11, 558, 13, 50914], "temperature": 0.0, "avg_logprob": -0.20759594657204367, "compression_ratio": 1.6260504201680672, "no_speech_prob": 1.927920496858082e-12}, {"id": 165, "seek": 40242, "start": 413.46000000000004, "end": 416.14000000000004, "text": " Because a recipe is just a linear set of instructions.", "tokens": [50917, 1436, 257, 6782, 307, 445, 257, 8213, 992, 295, 9415, 13, 51051], "temperature": 0.0, "avg_logprob": -0.20759594657204367, "compression_ratio": 1.6260504201680672, "no_speech_prob": 1.927920496858082e-12}, {"id": 166, "seek": 40242, "start": 416.3, "end": 416.76, "text": " Exactly.", "tokens": [51059, 7587, 13, 51082], "temperature": 0.0, "avg_logprob": -0.20759594657204367, "compression_ratio": 1.6260504201680672, "no_speech_prob": 1.927920496858082e-12}, {"id": 167, "seek": 40242, "start": 417.20000000000005, "end": 419.72, "text": " With the recipe, you are aiming for a final shape.", "tokens": [51104, 2022, 264, 6782, 11, 291, 366, 20253, 337, 257, 2572, 3909, 13, 51230], "temperature": 0.0, "avg_logprob": -0.20759594657204367, "compression_ratio": 1.6260504201680672, "no_speech_prob": 1.927920496858082e-12}, {"id": 168, "seek": 40242, "start": 420.06, "end": 424.5, "text": " But with the sourdough starter, you aren't storing the final shape of the loaf in the jar", "tokens": [51247, 583, 365, 264, 11006, 67, 581, 22465, 11, 291, 3212, 380, 26085, 264, 2572, 3909, 295, 264, 40743, 294, 264, 15181, 51469], "temperature": 0.0, "avg_logprob": -0.20759594657204367, "compression_ratio": 1.6260504201680672, "no_speech_prob": 1.927920496858082e-12}, {"id": 169, "seek": 40242, "start": 424.5, "end": 425.3, "text": " in your fridge.", "tokens": [51469, 294, 428, 13023, 13, 51509], "temperature": 0.0, "avg_logprob": -0.20759594657204367, "compression_ratio": 1.6260504201680672, "no_speech_prob": 1.927920496858082e-12}, {"id": 170, "seek": 42530, "start": 425.3, "end": 426.88, "text": " You're just keeping the yeast alive.", "tokens": [50365, 509, 434, 445, 5145, 264, 21629, 5465, 13, 50444], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 171, "seek": 42530, "start": 427.04, "end": 427.2, "text": " Yeah.", "tokens": [50452, 865, 13, 50460], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 172, "seek": 42530, "start": 427.28000000000003, "end": 431.04, "text": " You're just maintaining a very simple set of biological rules for the yeast.", "tokens": [50464, 509, 434, 445, 14916, 257, 588, 2199, 992, 295, 13910, 4474, 337, 264, 21629, 13, 50652], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 173, "seek": 42530, "start": 431.64, "end": 432.32, "text": " Feed it flour.", "tokens": [50682, 33720, 309, 7693, 13, 50716], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 174, "seek": 42530, "start": 432.52000000000004, "end": 433.1, "text": " Feed it water.", "tokens": [50726, 33720, 309, 1281, 13, 50755], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 175, "seek": 42530, "start": 433.24, "end": 433.82, "text": " Keep it warm.", "tokens": [50762, 5527, 309, 4561, 13, 50791], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 176, "seek": 42530, "start": 434.02000000000004, "end": 435.64, "text": " You aren't forcing the complexity.", "tokens": [50801, 509, 3212, 380, 19030, 264, 14024, 13, 50882], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 177, "seek": 42530, "start": 435.84000000000003, "end": 438.94, "text": " The complexity generates itself based on those underlying rules.", "tokens": [50892, 440, 14024, 23815, 2564, 2361, 322, 729, 14217, 4474, 13, 51047], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 178, "seek": 42530, "start": 439.08000000000004, "end": 439.32, "text": " Right.", "tokens": [51054, 1779, 13, 51066], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 179, "seek": 42530, "start": 439.52000000000004, "end": 444.96000000000004, "text": " And the book draws a very hard line here between true generation, which is what your sourdough", "tokens": [51076, 400, 264, 1446, 20045, 257, 588, 1152, 1622, 510, 1296, 2074, 5125, 11, 597, 307, 437, 428, 11006, 67, 581, 51348], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 180, "seek": 42530, "start": 444.96000000000004, "end": 447.56, "text": " starter is doing, and mere accumulation.", "tokens": [51348, 22465, 307, 884, 11, 293, 8401, 35647, 13, 51478], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 181, "seek": 42530, "start": 447.92, "end": 449.74, "text": " What's accumulation in this context?", "tokens": [51496, 708, 311, 35647, 294, 341, 4319, 30, 51587], "temperature": 0.0, "avg_logprob": -0.17225389399080196, "compression_ratio": 1.678030303030303, "no_speech_prob": 1.492717516433928e-12}, {"id": 182, "seek": 44974, "start": 449.74, "end": 452.22, "text": " The accumulation is just growth without an attractor.", "tokens": [50365, 440, 35647, 307, 445, 4599, 1553, 364, 5049, 284, 13, 50489], "temperature": 0.0, "avg_logprob": -0.16098151096077853, "compression_ratio": 1.6688741721854305, "no_speech_prob": 1.5983151217466296e-12}, {"id": 183, "seek": 44974, "start": 452.98, "end": 456.18, "text": " It is, um, it's like spilling water on a linoleum floor.", "tokens": [50527, 467, 307, 11, 1105, 11, 309, 311, 411, 637, 7345, 1281, 322, 257, 287, 2982, 306, 449, 4123, 13, 50687], "temperature": 0.0, "avg_logprob": -0.16098151096077853, "compression_ratio": 1.6688741721854305, "no_speech_prob": 1.5983151217466296e-12}, {"id": 184, "seek": 44974, "start": 456.28000000000003, "end": 457.18, "text": " It just goes everywhere.", "tokens": [50692, 467, 445, 1709, 5315, 13, 50737], "temperature": 0.0, "avg_logprob": -0.16098151096077853, "compression_ratio": 1.6688741721854305, "no_speech_prob": 1.5983151217466296e-12}, {"id": 185, "seek": 44974, "start": 457.56, "end": 457.76, "text": " Yeah.", "tokens": [50756, 865, 13, 50766], "temperature": 0.0, "avg_logprob": -0.16098151096077853, "compression_ratio": 1.6688741721854305, "no_speech_prob": 1.5983151217466296e-12}, {"id": 186, "seek": 44974, "start": 457.90000000000003, "end": 462.58, "text": " The water just spreads out boundlessly, getting bigger and messier without any underlying plan.", "tokens": [50773, 440, 1281, 445, 25728, 484, 5472, 12048, 11, 1242, 3801, 293, 2082, 811, 1553, 604, 14217, 1393, 13, 51007], "temperature": 0.0, "avg_logprob": -0.16098151096077853, "compression_ratio": 1.6688741721854305, "no_speech_prob": 1.5983151217466296e-12}, {"id": 187, "seek": 44974, "start": 462.72, "end": 465.18, "text": " Whereas true generation zeroes in on something.", "tokens": [51014, 13813, 2074, 5125, 4018, 279, 294, 322, 746, 13, 51137], "temperature": 0.0, "avg_logprob": -0.16098151096077853, "compression_ratio": 1.6688741721854305, "no_speech_prob": 1.5983151217466296e-12}, {"id": 188, "seek": 44974, "start": 465.34000000000003, "end": 465.76, "text": " Exactly.", "tokens": [51145, 7587, 13, 51166], "temperature": 0.0, "avg_logprob": -0.16098151096077853, "compression_ratio": 1.6688741721854305, "no_speech_prob": 1.5983151217466296e-12}, {"id": 189, "seek": 44974, "start": 466.1, "end": 471.82, "text": " True generation, driven by these mathematical contractions, zeroes in on a specific, infinitely", "tokens": [51183, 13587, 5125, 11, 9555, 538, 613, 18894, 4364, 626, 11, 4018, 279, 294, 322, 257, 2685, 11, 36227, 51469], "temperature": 0.0, "avg_logprob": -0.16098151096077853, "compression_ratio": 1.6688741721854305, "no_speech_prob": 1.5983151217466296e-12}, {"id": 190, "seek": 44974, "start": 471.82, "end": 472.90000000000003, "text": " detailed destiny.", "tokens": [51469, 9942, 17893, 13, 51523], "temperature": 0.0, "avg_logprob": -0.16098151096077853, "compression_ratio": 1.6688741721854305, "no_speech_prob": 1.5983151217466296e-12}, {"id": 191, "seek": 44974, "start": 473.24, "end": 477.90000000000003, "text": " But mathematically, how do we know the shape doesn't just shrink into a single microscopic", "tokens": [51540, 583, 44003, 11, 577, 360, 321, 458, 264, 3909, 1177, 380, 445, 23060, 666, 257, 2167, 47897, 51773], "temperature": 0.0, "avg_logprob": -0.16098151096077853, "compression_ratio": 1.6688741721854305, "no_speech_prob": 1.5983151217466296e-12}, {"id": 192, "seek": 44974, "start": 477.90000000000003, "end": 478.48, "text": " dot?", "tokens": [51773, 5893, 30, 51802], "temperature": 0.0, "avg_logprob": -0.16098151096077853, "compression_ratio": 1.6688741721854305, "no_speech_prob": 1.5983151217466296e-12}, {"id": 193, "seek": 47848, "start": 478.48, "end": 479.78000000000003, "text": " That's a great question.", "tokens": [50365, 663, 311, 257, 869, 1168, 13, 50430], "temperature": 0.0, "avg_logprob": -0.1471289854783278, "compression_ratio": 1.7190635451505016, "no_speech_prob": 1.7970262864569486e-12}, {"id": 194, "seek": 47848, "start": 479.92, "end": 484.62, "text": " I mean, if the rules are constantly contracting the space, bringing everything closer, why", "tokens": [50437, 286, 914, 11, 498, 264, 4474, 366, 6460, 36095, 264, 1901, 11, 5062, 1203, 4966, 11, 983, 50672], "temperature": 0.0, "avg_logprob": -0.1471289854783278, "compression_ratio": 1.7190635451505016, "no_speech_prob": 1.7970262864569486e-12}, {"id": 195, "seek": 47848, "start": 484.62, "end": 486.96000000000004, "text": " doesn't the fern just collapse into nothingness?", "tokens": [50672, 1177, 380, 264, 283, 1248, 445, 15584, 666, 1825, 1287, 30, 50789], "temperature": 0.0, "avg_logprob": -0.1471289854783278, "compression_ratio": 1.7190635451505016, "no_speech_prob": 1.7970262864569486e-12}, {"id": 196, "seek": 47848, "start": 487.46000000000004, "end": 492.70000000000005, "text": " We have to thank a piece of math called the Banach Fixed Point Theorem for that guarantee.", "tokens": [50814, 492, 362, 281, 1309, 257, 2522, 295, 5221, 1219, 264, 13850, 608, 25538, 292, 12387, 440, 37956, 337, 300, 10815, 13, 51076], "temperature": 0.0, "avg_logprob": -0.1471289854783278, "compression_ratio": 1.7190635451505016, "no_speech_prob": 1.7970262864569486e-12}, {"id": 197, "seek": 47848, "start": 492.96000000000004, "end": 494.32, "text": " The Banach Fixed Point Theorem.", "tokens": [51089, 440, 13850, 608, 25538, 292, 12387, 440, 37956, 13, 51157], "temperature": 0.0, "avg_logprob": -0.1471289854783278, "compression_ratio": 1.7190635451505016, "no_speech_prob": 1.7970262864569486e-12}, {"id": 198, "seek": 47848, "start": 494.42, "end": 494.62, "text": " Yeah.", "tokens": [51162, 865, 13, 51172], "temperature": 0.0, "avg_logprob": -0.1471289854783278, "compression_ratio": 1.7190635451505016, "no_speech_prob": 1.7970262864569486e-12}, {"id": 199, "seek": 47848, "start": 494.92, "end": 499.08000000000004, "text": " The theorem essentially proves that if you are operating within a complete metric space,", "tokens": [51187, 440, 20904, 4476, 25019, 300, 498, 291, 366, 7447, 1951, 257, 3566, 20678, 1901, 11, 51395], "temperature": 0.0, "avg_logprob": -0.1471289854783278, "compression_ratio": 1.7190635451505016, "no_speech_prob": 1.7970262864569486e-12}, {"id": 200, "seek": 47848, "start": 499.56, "end": 503.04, "text": " a contracting rule will always hit a unique solid fixed point.", "tokens": [51419, 257, 36095, 4978, 486, 1009, 2045, 257, 3845, 5100, 6806, 935, 13, 51593], "temperature": 0.0, "avg_logprob": -0.1471289854783278, "compression_ratio": 1.7190635451505016, "no_speech_prob": 1.7970262864569486e-12}, {"id": 201, "seek": 47848, "start": 503.26, "end": 504.08000000000004, "text": " It won't disappear.", "tokens": [51604, 467, 1582, 380, 11596, 13, 51645], "temperature": 0.0, "avg_logprob": -0.1471289854783278, "compression_ratio": 1.7190635451505016, "no_speech_prob": 1.7970262864569486e-12}, {"id": 202, "seek": 47848, "start": 504.5, "end": 506.78000000000003, "text": " And a complete metric space means what, exactly?", "tokens": [51666, 400, 257, 3566, 20678, 1901, 1355, 437, 11, 2293, 30, 51780], "temperature": 0.0, "avg_logprob": -0.1471289854783278, "compression_ratio": 1.7190635451505016, "no_speech_prob": 1.7970262864569486e-12}, {"id": 203, "seek": 50678, "start": 506.78, "end": 508.85999999999996, "text": " Like, a space with no holes in it.", "tokens": [50365, 1743, 11, 257, 1901, 365, 572, 8118, 294, 309, 13, 50469], "temperature": 0.0, "avg_logprob": -0.17322865238896124, "compression_ratio": 1.5049019607843137, "no_speech_prob": 1.6232506875116237e-12}, {"id": 204, "seek": 50678, "start": 509.09999999999997, "end": 510.7, "text": " That's a perfect way to visualize it.", "tokens": [50481, 663, 311, 257, 2176, 636, 281, 23273, 309, 13, 50561], "temperature": 0.0, "avg_logprob": -0.17322865238896124, "compression_ratio": 1.5049019607843137, "no_speech_prob": 1.6232506875116237e-12}, {"id": 205, "seek": 50678, "start": 510.82, "end": 513.66, "text": " Imagine you have a universe where only fractions are allowed to exist.", "tokens": [50567, 11739, 291, 362, 257, 6445, 689, 787, 36058, 366, 4350, 281, 2514, 13, 50709], "temperature": 0.0, "avg_logprob": -0.17322865238896124, "compression_ratio": 1.5049019607843137, "no_speech_prob": 1.6232506875116237e-12}, {"id": 206, "seek": 50678, "start": 513.78, "end": 515.8399999999999, "text": " No decimals, no irrational numbers.", "tokens": [50715, 883, 979, 332, 1124, 11, 572, 39914, 3547, 13, 50818], "temperature": 0.0, "avg_logprob": -0.17322865238896124, "compression_ratio": 1.5049019607843137, "no_speech_prob": 1.6232506875116237e-12}, {"id": 207, "seek": 50678, "start": 515.9, "end": 517.06, "text": " Okay, just pure fractions.", "tokens": [50821, 1033, 11, 445, 6075, 36058, 13, 50879], "temperature": 0.0, "avg_logprob": -0.17322865238896124, "compression_ratio": 1.5049019607843137, "no_speech_prob": 1.6232506875116237e-12}, {"id": 208, "seek": 50678, "start": 517.52, "end": 517.74, "text": " Right.", "tokens": [50902, 1779, 13, 50913], "temperature": 0.0, "avg_logprob": -0.17322865238896124, "compression_ratio": 1.5049019607843137, "no_speech_prob": 1.6232506875116237e-12}, {"id": 209, "seek": 50678, "start": 518.12, "end": 524.26, "text": " If you have a sequence of numbers in that universe that is mathematically creeping closer and", "tokens": [50932, 759, 291, 362, 257, 8310, 295, 3547, 294, 300, 6445, 300, 307, 44003, 47753, 4966, 293, 51239], "temperature": 0.0, "avg_logprob": -0.17322865238896124, "compression_ratio": 1.5049019607843137, "no_speech_prob": 1.6232506875116237e-12}, {"id": 210, "seek": 52426, "start": 524.26, "end": 526.06, "text": " closer to the square root of two...", "tokens": [50365, 4966, 281, 264, 3732, 5593, 295, 732, 485, 50455], "temperature": 0.0, "avg_logprob": -0.20575154133332083, "compression_ratio": 1.502857142857143, "no_speech_prob": 1.5887411828827136e-12}, {"id": 211, "seek": 52426, "start": 526.06, "end": 527.14, "text": " Which isn't a fraction.", "tokens": [50455, 3013, 1943, 380, 257, 14135, 13, 50509], "temperature": 0.0, "avg_logprob": -0.20575154133332083, "compression_ratio": 1.502857142857143, "no_speech_prob": 1.5887411828827136e-12}, {"id": 212, "seek": 52426, "start": 527.54, "end": 527.98, "text": " Exactly.", "tokens": [50529, 7587, 13, 50551], "temperature": 0.0, "avg_logprob": -0.20575154133332083, "compression_ratio": 1.502857142857143, "no_speech_prob": 1.5887411828827136e-12}, {"id": 213, "seek": 52426, "start": 528.28, "end": 528.52, "text": " Yeah.", "tokens": [50566, 865, 13, 50578], "temperature": 0.0, "avg_logprob": -0.20575154133332083, "compression_ratio": 1.502857142857143, "no_speech_prob": 1.5887411828827136e-12}, {"id": 214, "seek": 52426, "start": 528.64, "end": 532.92, "text": " In that fraction-only universe, the sequence will eventually fall into a void.", "tokens": [50584, 682, 300, 14135, 12, 25202, 6445, 11, 264, 8310, 486, 4728, 2100, 666, 257, 22009, 13, 50798], "temperature": 0.0, "avg_logprob": -0.20575154133332083, "compression_ratio": 1.502857142857143, "no_speech_prob": 1.5887411828827136e-12}, {"id": 215, "seek": 52426, "start": 533.04, "end": 536.38, "text": " It'll hit a hole because the square root of two isn't allowed to exist there.", "tokens": [50804, 467, 603, 2045, 257, 5458, 570, 264, 3732, 5593, 295, 732, 1943, 380, 4350, 281, 2514, 456, 13, 50971], "temperature": 0.0, "avg_logprob": -0.20575154133332083, "compression_ratio": 1.502857142857143, "no_speech_prob": 1.5887411828827136e-12}, {"id": 216, "seek": 52426, "start": 536.48, "end": 537.54, "text": " The limit doesn't exist.", "tokens": [50976, 440, 4948, 1177, 380, 2514, 13, 51029], "temperature": 0.0, "avg_logprob": -0.20575154133332083, "compression_ratio": 1.502857142857143, "no_speech_prob": 1.5887411828827136e-12}, {"id": 217, "seek": 52426, "start": 537.66, "end": 537.84, "text": " Right.", "tokens": [51035, 1779, 13, 51044], "temperature": 0.0, "avg_logprob": -0.20575154133332083, "compression_ratio": 1.502857142857143, "no_speech_prob": 1.5887411828827136e-12}, {"id": 218, "seek": 53784, "start": 537.84, "end": 540.84, "text": " But a complete metric space has no holes.", "tokens": [50365, 583, 257, 3566, 20678, 1901, 575, 572, 8118, 13, 50515], "temperature": 0.0, "avg_logprob": -0.1710334665635053, "compression_ratio": 1.6933333333333334, "no_speech_prob": 1.235093190915526e-12}, {"id": 219, "seek": 53784, "start": 541.32, "end": 546.76, "text": " It guarantees that if a sequence is contracting and honing in on a destination, the destination", "tokens": [50539, 467, 32567, 300, 498, 257, 8310, 307, 36095, 293, 2157, 278, 294, 322, 257, 12236, 11, 264, 12236, 50811], "temperature": 0.0, "avg_logprob": -0.1710334665635053, "compression_ratio": 1.6933333333333334, "no_speech_prob": 1.235093190915526e-12}, {"id": 220, "seek": 53784, "start": 546.76, "end": 549.46, "text": " actually exists in reality to catch it.", "tokens": [50811, 767, 8198, 294, 4103, 281, 3745, 309, 13, 50946], "temperature": 0.0, "avg_logprob": -0.1710334665635053, "compression_ratio": 1.6933333333333334, "no_speech_prob": 1.235093190915526e-12}, {"id": 221, "seek": 53784, "start": 549.6800000000001, "end": 554.3000000000001, "text": " So Affliction is saying that reality, or at least the continuation space of these futures,", "tokens": [50957, 407, 12840, 75, 4105, 307, 1566, 300, 4103, 11, 420, 412, 1935, 264, 29357, 1901, 295, 613, 26071, 11, 51188], "temperature": 0.0, "avg_logprob": -0.1710334665635053, "compression_ratio": 1.6933333333333334, "no_speech_prob": 1.235093190915526e-12}, {"id": 222, "seek": 53784, "start": 554.84, "end": 555.48, "text": " is complete.", "tokens": [51215, 307, 3566, 13, 51247], "temperature": 0.0, "avg_logprob": -0.1710334665635053, "compression_ratio": 1.6933333333333334, "no_speech_prob": 1.235093190915526e-12}, {"id": 223, "seek": 53784, "start": 555.82, "end": 556.14, "text": " Yes.", "tokens": [51264, 1079, 13, 51280], "temperature": 0.0, "avg_logprob": -0.1710334665635053, "compression_ratio": 1.6933333333333334, "no_speech_prob": 1.235093190915526e-12}, {"id": 224, "seek": 53784, "start": 556.2800000000001, "end": 557.46, "text": " It catches the complexity.", "tokens": [51287, 467, 25496, 264, 14024, 13, 51346], "temperature": 0.0, "avg_logprob": -0.1710334665635053, "compression_ratio": 1.6933333333333334, "no_speech_prob": 1.235093190915526e-12}, {"id": 225, "seek": 53784, "start": 557.62, "end": 559.3000000000001, "text": " It doesn't just let the future fall through a hole.", "tokens": [51354, 467, 1177, 380, 445, 718, 264, 2027, 2100, 807, 257, 5458, 13, 51438], "temperature": 0.0, "avg_logprob": -0.1710334665635053, "compression_ratio": 1.6933333333333334, "no_speech_prob": 1.235093190915526e-12}, {"id": 226, "seek": 53784, "start": 559.44, "end": 560.24, "text": " No, it doesn't.", "tokens": [51445, 883, 11, 309, 1177, 380, 13, 51485], "temperature": 0.0, "avg_logprob": -0.1710334665635053, "compression_ratio": 1.6933333333333334, "no_speech_prob": 1.235093190915526e-12}, {"id": 227, "seek": 56024, "start": 560.24, "end": 565.78, "text": " And the text unifies all of this under a single vocabulary called continuation operators.", "tokens": [50365, 400, 264, 2487, 517, 11221, 439, 295, 341, 833, 257, 2167, 19864, 1219, 29357, 19077, 13, 50642], "temperature": 0.0, "avg_logprob": -0.14979207014837184, "compression_ratio": 1.6766666666666667, "no_speech_prob": 1.3511895595452739e-12}, {"id": 228, "seek": 56024, "start": 566.26, "end": 567.34, "text": " Continuation operators.", "tokens": [50666, 14674, 16073, 19077, 13, 50720], "temperature": 0.0, "avg_logprob": -0.14979207014837184, "compression_ratio": 1.6766666666666667, "no_speech_prob": 1.3511895595452739e-12}, {"id": 229, "seek": 56024, "start": 567.54, "end": 567.72, "text": " Yeah.", "tokens": [50730, 865, 13, 50739], "temperature": 0.0, "avg_logprob": -0.14979207014837184, "compression_ratio": 1.6766666666666667, "no_speech_prob": 1.3511895595452739e-12}, {"id": 230, "seek": 56024, "start": 568.0, "end": 572.52, "text": " Whether a rule is shrinking things down to build a fractal fern or stretching things out", "tokens": [50753, 8503, 257, 4978, 307, 41684, 721, 760, 281, 1322, 257, 17948, 304, 283, 1248, 420, 19632, 721, 484, 50979], "temperature": 0.0, "avg_logprob": -0.14979207014837184, "compression_ratio": 1.6766666666666667, "no_speech_prob": 1.3511895595452739e-12}, {"id": 231, "seek": 56024, "start": 572.52, "end": 575.92, "text": " into the future, it's all governed by the same mathematical grammar.", "tokens": [50979, 666, 264, 2027, 11, 309, 311, 439, 35529, 538, 264, 912, 18894, 22317, 13, 51149], "temperature": 0.0, "avg_logprob": -0.14979207014837184, "compression_ratio": 1.6766666666666667, "no_speech_prob": 1.3511895595452739e-12}, {"id": 232, "seek": 56024, "start": 576.12, "end": 580.34, "text": " Which naturally leads to the most provocative question in this entire framework, I think.", "tokens": [51159, 3013, 8195, 6689, 281, 264, 881, 47663, 1168, 294, 341, 2302, 8388, 11, 286, 519, 13, 51370], "temperature": 0.0, "avg_logprob": -0.14979207014837184, "compression_ratio": 1.6766666666666667, "no_speech_prob": 1.3511895595452739e-12}, {"id": 233, "seek": 56024, "start": 580.52, "end": 581.4, "text": " The reverse engineering.", "tokens": [51379, 440, 9943, 7043, 13, 51423], "temperature": 0.0, "avg_logprob": -0.14979207014837184, "compression_ratio": 1.6766666666666667, "no_speech_prob": 1.3511895595452739e-12}, {"id": 234, "seek": 56024, "start": 581.5600000000001, "end": 582.0600000000001, "text": " Yes.", "tokens": [51431, 1079, 13, 51456], "temperature": 0.0, "avg_logprob": -0.14979207014837184, "compression_ratio": 1.6766666666666667, "no_speech_prob": 1.3511895595452739e-12}, {"id": 235, "seek": 56024, "start": 582.94, "end": 588.92, "text": " We know that simple rules can generate a massively complex future, but can we run the machine", "tokens": [51500, 492, 458, 300, 2199, 4474, 393, 8460, 257, 29379, 3997, 2027, 11, 457, 393, 321, 1190, 264, 3479, 51799], "temperature": 0.0, "avg_logprob": -0.14979207014837184, "compression_ratio": 1.6766666666666667, "no_speech_prob": 1.3511895595452739e-12}, {"id": 236, "seek": 56024, "start": 588.92, "end": 589.46, "text": " in reverse?", "tokens": [51799, 294, 9943, 30, 51826], "temperature": 0.0, "avg_logprob": -0.14979207014837184, "compression_ratio": 1.6766666666666667, "no_speech_prob": 1.3511895595452739e-12}, {"id": 237, "seek": 58946, "start": 589.46, "end": 590.1800000000001, "text": " Right.", "tokens": [50365, 1779, 13, 50401], "temperature": 0.0, "avg_logprob": -0.14523796881398848, "compression_ratio": 1.7132616487455197, "no_speech_prob": 1.9506336650099154e-12}, {"id": 238, "seek": 58946, "start": 590.26, "end": 592.94, "text": " This is known in the text as the collage theorem.", "tokens": [50405, 639, 307, 2570, 294, 264, 2487, 382, 264, 1263, 609, 20904, 13, 50539], "temperature": 0.0, "avg_logprob": -0.14523796881398848, "compression_ratio": 1.7132616487455197, "no_speech_prob": 1.9506336650099154e-12}, {"id": 239, "seek": 58946, "start": 593.0600000000001, "end": 594.0, "text": " The collage theorem.", "tokens": [50545, 440, 1263, 609, 20904, 13, 50592], "temperature": 0.0, "avg_logprob": -0.14523796881398848, "compression_ratio": 1.7132616487455197, "no_speech_prob": 1.9506336650099154e-12}, {"id": 240, "seek": 58946, "start": 594.0600000000001, "end": 598.5400000000001, "text": " If you have a target shape like a highly specific complex future that you desperately", "tokens": [50595, 759, 291, 362, 257, 3779, 3909, 411, 257, 5405, 2685, 3997, 2027, 300, 291, 23726, 50819], "temperature": 0.0, "avg_logprob": -0.14523796881398848, "compression_ratio": 1.7132616487455197, "no_speech_prob": 1.9506336650099154e-12}, {"id": 241, "seek": 58946, "start": 598.5400000000001, "end": 604.2, "text": " want to achieve, can you find the exact tiny set of rules required to build it?", "tokens": [50819, 528, 281, 4584, 11, 393, 291, 915, 264, 1900, 5870, 992, 295, 4474, 4739, 281, 1322, 309, 30, 51102], "temperature": 0.0, "avg_logprob": -0.14523796881398848, "compression_ratio": 1.7132616487455197, "no_speech_prob": 1.9506336650099154e-12}, {"id": 242, "seek": 58946, "start": 604.52, "end": 607.24, "text": " Basically, can we reverse engineer destiny?", "tokens": [51118, 8537, 11, 393, 321, 9943, 11403, 17893, 30, 51254], "temperature": 0.0, "avg_logprob": -0.14523796881398848, "compression_ratio": 1.7132616487455197, "no_speech_prob": 1.9506336650099154e-12}, {"id": 243, "seek": 58946, "start": 607.5, "end": 608.72, "text": " And the text proves that.", "tokens": [51267, 400, 264, 2487, 25019, 300, 13, 51328], "temperature": 0.0, "avg_logprob": -0.14523796881398848, "compression_ratio": 1.7132616487455197, "no_speech_prob": 1.9506336650099154e-12}, {"id": 244, "seek": 58946, "start": 609.12, "end": 610.22, "text": " Mathematically, yes.", "tokens": [51348, 15776, 40197, 11, 2086, 13, 51403], "temperature": 0.0, "avg_logprob": -0.14523796881398848, "compression_ratio": 1.7132616487455197, "no_speech_prob": 1.9506336650099154e-12}, {"id": 245, "seek": 58946, "start": 610.38, "end": 610.58, "text": " Right.", "tokens": [51411, 1779, 13, 51421], "temperature": 0.0, "avg_logprob": -0.14523796881398848, "compression_ratio": 1.7132616487455197, "no_speech_prob": 1.9506336650099154e-12}, {"id": 246, "seek": 58946, "start": 610.74, "end": 615.98, "text": " We can approximate any compact target future we want using a custom built set of rules.", "tokens": [51429, 492, 393, 30874, 604, 14679, 3779, 2027, 321, 528, 1228, 257, 2375, 3094, 992, 295, 4474, 13, 51691], "temperature": 0.0, "avg_logprob": -0.14523796881398848, "compression_ratio": 1.7132616487455197, "no_speech_prob": 1.9506336650099154e-12}, {"id": 247, "seek": 58946, "start": 616.0600000000001, "end": 618.7, "text": " So we can literally design our own future rules.", "tokens": [51695, 407, 321, 393, 3736, 1715, 527, 1065, 2027, 4474, 13, 51827], "temperature": 0.0, "avg_logprob": -0.14523796881398848, "compression_ratio": 1.7132616487455197, "no_speech_prob": 1.9506336650099154e-12}, {"id": 248, "seek": 61870, "start": 618.7, "end": 623.0200000000001, "text": " We can build a collage of transformations that gets us arbitrarily close to the desired", "tokens": [50365, 492, 393, 1322, 257, 1263, 609, 295, 34852, 300, 2170, 505, 19071, 3289, 1998, 281, 264, 14721, 50581], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 249, "seek": 61870, "start": 623.0200000000001, "end": 623.46, "text": " outcome.", "tokens": [50581, 9700, 13, 50603], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 250, "seek": 61870, "start": 623.58, "end": 623.72, "text": " Okay.", "tokens": [50609, 1033, 13, 50616], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 251, "seek": 61870, "start": 623.8000000000001, "end": 624.3000000000001, "text": " I love that.", "tokens": [50620, 286, 959, 300, 13, 50645], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 252, "seek": 61870, "start": 624.34, "end": 626.0600000000001, "text": " But there is a massive caveat coming.", "tokens": [50647, 583, 456, 307, 257, 5994, 43012, 1348, 13, 50733], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 253, "seek": 61870, "start": 626.1600000000001, "end": 627.12, "text": " I can hear it in your voice.", "tokens": [50738, 286, 393, 1568, 309, 294, 428, 3177, 13, 50786], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 254, "seek": 61870, "start": 627.2, "end": 627.2800000000001, "text": " Yeah.", "tokens": [50790, 865, 13, 50794], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 255, "seek": 61870, "start": 627.36, "end": 627.58, "text": " You can.", "tokens": [50798, 509, 393, 13, 50809], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 256, "seek": 61870, "start": 627.6800000000001, "end": 632.1, "text": " The caveat is what fliction leaves open as the universal generation conjecture.", "tokens": [50814, 440, 43012, 307, 437, 932, 4105, 5510, 1269, 382, 264, 11455, 5125, 416, 1020, 540, 13, 51035], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 257, "seek": 61870, "start": 632.4200000000001, "end": 633.6400000000001, "text": " Universal generation.", "tokens": [51051, 22617, 5125, 13, 51112], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 258, "seek": 61870, "start": 633.6400000000001, "end": 636.8000000000001, "text": " We know we can custom build a set of rules for one specific target.", "tokens": [51112, 492, 458, 321, 393, 2375, 1322, 257, 992, 295, 4474, 337, 472, 2685, 3779, 13, 51270], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 259, "seek": 61870, "start": 636.9000000000001, "end": 637.0400000000001, "text": " Yeah.", "tokens": [51275, 865, 13, 51282], "temperature": 0.0, "avg_logprob": -0.16957003981978805, "compression_ratio": 1.6147186147186148, "no_speech_prob": 1.7317258738103192e-12}, {"id": 260, "seek": 63704, "start": 637.04, "end": 643.24, "text": " But can we find one single universal toolkit of rules chosen in advance that can approximate", "tokens": [50365, 583, 393, 321, 915, 472, 2167, 11455, 40167, 295, 4474, 8614, 294, 7295, 300, 393, 30874, 50675], "temperature": 0.0, "avg_logprob": -0.13781854944321717, "compression_ratio": 1.5056179775280898, "no_speech_prob": 1.289319779412823e-12}, {"id": 261, "seek": 63704, "start": 643.24, "end": 646.6999999999999, "text": " absolutely any target future just by combining them in different ways?", "tokens": [50675, 3122, 604, 3779, 2027, 445, 538, 21928, 552, 294, 819, 2098, 30, 50848], "temperature": 0.0, "avg_logprob": -0.13781854944321717, "compression_ratio": 1.5056179775280898, "no_speech_prob": 1.289319779412823e-12}, {"id": 262, "seek": 63704, "start": 646.8199999999999, "end": 647.3, "text": " Oh, wow.", "tokens": [50854, 876, 11, 6076, 13, 50878], "temperature": 0.0, "avg_logprob": -0.13781854944321717, "compression_ratio": 1.5056179775280898, "no_speech_prob": 1.289319779412823e-12}, {"id": 263, "seek": 63704, "start": 647.36, "end": 648.5799999999999, "text": " Like an alphabet of reality.", "tokens": [50881, 1743, 364, 23339, 295, 4103, 13, 50942], "temperature": 0.0, "avg_logprob": -0.13781854944321717, "compression_ratio": 1.5056179775280898, "no_speech_prob": 1.289319779412823e-12}, {"id": 264, "seek": 63704, "start": 648.98, "end": 650.1999999999999, "text": " That's a really good way to put it.", "tokens": [50962, 663, 311, 257, 534, 665, 636, 281, 829, 309, 13, 51023], "temperature": 0.0, "avg_logprob": -0.13781854944321717, "compression_ratio": 1.5056179775280898, "no_speech_prob": 1.289319779412823e-12}, {"id": 265, "seek": 63704, "start": 650.24, "end": 652.42, "text": " I mean, we have 26 letters in the English alphabet.", "tokens": [51025, 286, 914, 11, 321, 362, 7551, 7825, 294, 264, 3669, 23339, 13, 51134], "temperature": 0.0, "avg_logprob": -0.13781854944321717, "compression_ratio": 1.5056179775280898, "no_speech_prob": 1.289319779412823e-12}, {"id": 266, "seek": 63704, "start": 652.42, "end": 658.48, "text": " And with those fixed rules, we can generate any novel, any poem, any instruction manual ever", "tokens": [51134, 400, 365, 729, 6806, 4474, 11, 321, 393, 8460, 604, 7613, 11, 604, 13065, 11, 604, 10951, 9688, 1562, 51437], "temperature": 0.0, "avg_logprob": -0.13781854944321717, "compression_ratio": 1.5056179775280898, "no_speech_prob": 1.289319779412823e-12}, {"id": 267, "seek": 63704, "start": 658.48, "end": 658.92, "text": " conceived.", "tokens": [51437, 34898, 13, 51459], "temperature": 0.0, "avg_logprob": -0.13781854944321717, "compression_ratio": 1.5056179775280898, "no_speech_prob": 1.289319779412823e-12}, {"id": 268, "seek": 63704, "start": 659.18, "end": 659.5799999999999, "text": " Exactly.", "tokens": [51472, 7587, 13, 51492], "temperature": 0.0, "avg_logprob": -0.13781854944321717, "compression_ratio": 1.5056179775280898, "no_speech_prob": 1.289319779412823e-12}, {"id": 269, "seek": 65958, "start": 659.58, "end": 664.86, "text": " So the text is asking if there is a fundamental alphabet of choices that can spell out every", "tokens": [50365, 407, 264, 2487, 307, 3365, 498, 456, 307, 257, 8088, 23339, 295, 7994, 300, 393, 9827, 484, 633, 50629], "temperature": 0.0, "avg_logprob": -0.14162888734237009, "compression_ratio": 1.5591836734693878, "no_speech_prob": 1.5130199610552397e-12}, {"id": 270, "seek": 65958, "start": 664.86, "end": 666.62, "text": " possible mathematical future.", "tokens": [50629, 1944, 18894, 2027, 13, 50717], "temperature": 0.0, "avg_logprob": -0.14162888734237009, "compression_ratio": 1.5591836734693878, "no_speech_prob": 1.5130199610552397e-12}, {"id": 271, "seek": 65958, "start": 666.96, "end": 667.2, "text": " Yes.", "tokens": [50734, 1079, 13, 50746], "temperature": 0.0, "avg_logprob": -0.14162888734237009, "compression_ratio": 1.5591836734693878, "no_speech_prob": 1.5130199610552397e-12}, {"id": 272, "seek": 65958, "start": 667.72, "end": 670.12, "text": " And the text admits this is an unsolved problem.", "tokens": [50772, 400, 264, 2487, 46682, 341, 307, 364, 2693, 29110, 1154, 13, 50892], "temperature": 0.0, "avg_logprob": -0.14162888734237009, "compression_ratio": 1.5591836734693878, "no_speech_prob": 1.5130199610552397e-12}, {"id": 273, "seek": 65958, "start": 670.7800000000001, "end": 673.5200000000001, "text": " It's the holy grail of continuation geometry.", "tokens": [50925, 467, 311, 264, 10622, 1295, 388, 295, 29357, 18426, 13, 51062], "temperature": 0.0, "avg_logprob": -0.14162888734237009, "compression_ratio": 1.5591836734693878, "no_speech_prob": 1.5130199610552397e-12}, {"id": 274, "seek": 65958, "start": 674.34, "end": 677.82, "text": " Can one fixed set of operators build everything?", "tokens": [51103, 1664, 472, 6806, 992, 295, 19077, 1322, 1203, 30, 51277], "temperature": 0.0, "avg_logprob": -0.14162888734237009, "compression_ratio": 1.5591836734693878, "no_speech_prob": 1.5130199610552397e-12}, {"id": 275, "seek": 65958, "start": 678.14, "end": 682.6, "text": " Or do different futures require fundamentally different physics to even approach them?", "tokens": [51293, 1610, 360, 819, 26071, 3651, 17879, 819, 10649, 281, 754, 3109, 552, 30, 51516], "temperature": 0.0, "avg_logprob": -0.14162888734237009, "compression_ratio": 1.5591836734693878, "no_speech_prob": 1.5130199610552397e-12}, {"id": 276, "seek": 65958, "start": 682.7800000000001, "end": 683.7, "text": " We just don't know yet.", "tokens": [51525, 492, 445, 500, 380, 458, 1939, 13, 51571], "temperature": 0.0, "avg_logprob": -0.14162888734237009, "compression_ratio": 1.5591836734693878, "no_speech_prob": 1.5130199610552397e-12}, {"id": 277, "seek": 68370, "start": 683.7, "end": 688.6400000000001, "text": " I want you, the listener, right now, to really apply this to your own life.", "tokens": [50365, 286, 528, 291, 11, 264, 31569, 11, 558, 586, 11, 281, 534, 3079, 341, 281, 428, 1065, 993, 13, 50612], "temperature": 0.0, "avg_logprob": -0.12565862747930712, "compression_ratio": 1.6206896551724137, "no_speech_prob": 1.6171528092329135e-12}, {"id": 278, "seek": 68370, "start": 689.26, "end": 690.6600000000001, "text": " Look at your daily habits.", "tokens": [50643, 2053, 412, 428, 5212, 14100, 13, 50713], "temperature": 0.0, "avg_logprob": -0.12565862747930712, "compression_ratio": 1.6206896551724137, "no_speech_prob": 1.6171528092329135e-12}, {"id": 279, "seek": 68370, "start": 690.8000000000001, "end": 691.72, "text": " That's a great exercise.", "tokens": [50720, 663, 311, 257, 869, 5380, 13, 50766], "temperature": 0.0, "avg_logprob": -0.12565862747930712, "compression_ratio": 1.6206896551724137, "no_speech_prob": 1.6171528092329135e-12}, {"id": 280, "seek": 68370, "start": 691.88, "end": 694.32, "text": " Are the things you do every day generative rules?", "tokens": [50774, 2014, 264, 721, 291, 360, 633, 786, 1337, 1166, 4474, 30, 50896], "temperature": 0.0, "avg_logprob": -0.12565862747930712, "compression_ratio": 1.6206896551724137, "no_speech_prob": 1.6171528092329135e-12}, {"id": 281, "seek": 68370, "start": 694.76, "end": 699.4000000000001, "text": " Are they little consistent contractions that are predictably mathematically pulling you", "tokens": [50918, 2014, 436, 707, 8398, 4364, 626, 300, 366, 6069, 1188, 44003, 8407, 291, 51150], "temperature": 0.0, "avg_logprob": -0.12565862747930712, "compression_ratio": 1.6206896551724137, "no_speech_prob": 1.6171528092329135e-12}, {"id": 282, "seek": 68370, "start": 699.4000000000001, "end": 701.9200000000001, "text": " toward a complex, self-similar future?", "tokens": [51150, 7361, 257, 3997, 11, 2698, 12, 30937, 2202, 2027, 30, 51276], "temperature": 0.0, "avg_logprob": -0.12565862747930712, "compression_ratio": 1.6206896551724137, "no_speech_prob": 1.6171528092329135e-12}, {"id": 283, "seek": 68370, "start": 702.12, "end": 704.24, "text": " Or are your days just boundless accumulation?", "tokens": [51286, 1610, 366, 428, 1708, 445, 5472, 1832, 35647, 30, 51392], "temperature": 0.0, "avg_logprob": -0.12565862747930712, "compression_ratio": 1.6206896551724137, "no_speech_prob": 1.6171528092329135e-12}, {"id": 284, "seek": 68370, "start": 704.6800000000001, "end": 704.96, "text": " Right.", "tokens": [51414, 1779, 13, 51428], "temperature": 0.0, "avg_logprob": -0.12565862747930712, "compression_ratio": 1.6206896551724137, "no_speech_prob": 1.6171528092329135e-12}, {"id": 285, "seek": 68370, "start": 705.12, "end": 709.44, "text": " Are you just spilling water on the floor, piling up random actions with no attractor, pulling", "tokens": [51436, 2014, 291, 445, 637, 7345, 1281, 322, 264, 4123, 11, 280, 4883, 493, 4974, 5909, 365, 572, 5049, 284, 11, 8407, 51652], "temperature": 0.0, "avg_logprob": -0.12565862747930712, "compression_ratio": 1.6206896551724137, "no_speech_prob": 1.6171528092329135e-12}, {"id": 286, "seek": 68370, "start": 709.44, "end": 710.26, "text": " them into a shape?", "tokens": [51652, 552, 666, 257, 3909, 30, 51693], "temperature": 0.0, "avg_logprob": -0.12565862747930712, "compression_ratio": 1.6206896551724137, "no_speech_prob": 1.6171528092329135e-12}, {"id": 287, "seek": 71026, "start": 710.26, "end": 715.64, "text": " Because if you view your habits as Hutchinson operators, your daily routine isn't just", "tokens": [50365, 1436, 498, 291, 1910, 428, 14100, 382, 48499, 14321, 19077, 11, 428, 5212, 9927, 1943, 380, 445, 50634], "temperature": 0.0, "avg_logprob": -0.16457146460856867, "compression_ratio": 1.5945945945945945, "no_speech_prob": 1.8182117053275326e-12}, {"id": 288, "seek": 71026, "start": 715.64, "end": 716.6, "text": " a schedule anymore.", "tokens": [50634, 257, 7567, 3602, 13, 50682], "temperature": 0.0, "avg_logprob": -0.16457146460856867, "compression_ratio": 1.5945945945945945, "no_speech_prob": 1.8182117053275326e-12}, {"id": 289, "seek": 71026, "start": 717.04, "end": 718.9, "text": " It is the geometry of your future.", "tokens": [50704, 467, 307, 264, 18426, 295, 428, 2027, 13, 50797], "temperature": 0.0, "avg_logprob": -0.16457146460856867, "compression_ratio": 1.5945945945945945, "no_speech_prob": 1.8182117053275326e-12}, {"id": 290, "seek": 71026, "start": 719.28, "end": 722.28, "text": " It recasts your entire life as an active state space.", "tokens": [50816, 467, 850, 20765, 428, 2302, 993, 382, 364, 4967, 1785, 1901, 13, 50966], "temperature": 0.0, "avg_logprob": -0.16457146460856867, "compression_ratio": 1.5945945945945945, "no_speech_prob": 1.8182117053275326e-12}, {"id": 291, "seek": 71026, "start": 722.42, "end": 727.3199999999999, "text": " So we've established how a single set of rules branches out to create a massive future,", "tokens": [50973, 407, 321, 600, 7545, 577, 257, 2167, 992, 295, 4474, 14770, 484, 281, 1884, 257, 5994, 2027, 11, 51218], "temperature": 0.0, "avg_logprob": -0.16457146460856867, "compression_ratio": 1.5945945945945945, "no_speech_prob": 1.8182117053275326e-12}, {"id": 292, "seek": 71026, "start": 727.4399999999999, "end": 727.6, "text": " right?", "tokens": [51224, 558, 30, 51232], "temperature": 0.0, "avg_logprob": -0.16457146460856867, "compression_ratio": 1.5945945945945945, "no_speech_prob": 1.8182117053275326e-12}, {"id": 293, "seek": 71026, "start": 728.0, "end": 732.14, "text": " We start with a seed, we apply the operators, we get the intricate fern.", "tokens": [51252, 492, 722, 365, 257, 8871, 11, 321, 3079, 264, 19077, 11, 321, 483, 264, 38015, 283, 1248, 13, 51459], "temperature": 0.0, "avg_logprob": -0.16457146460856867, "compression_ratio": 1.5945945945945945, "no_speech_prob": 1.8182117053275326e-12}, {"id": 294, "seek": 71026, "start": 732.3199999999999, "end": 732.6, "text": " Right.", "tokens": [51468, 1779, 13, 51482], "temperature": 0.0, "avg_logprob": -0.16457146460856867, "compression_ratio": 1.5945945945945945, "no_speech_prob": 1.8182117053275326e-12}, {"id": 295, "seek": 71026, "start": 732.86, "end": 734.78, "text": " But what happens when the opposite occurs?", "tokens": [51495, 583, 437, 2314, 562, 264, 6182, 11843, 30, 51591], "temperature": 0.0, "avg_logprob": -0.16457146460856867, "compression_ratio": 1.5945945945945945, "no_speech_prob": 1.8182117053275326e-12}, {"id": 296, "seek": 73478, "start": 734.78, "end": 740.02, "text": " What happens when two entirely different starting points, two completely different", "tokens": [50365, 708, 2314, 562, 732, 7696, 819, 2891, 2793, 11, 732, 2584, 819, 50627], "temperature": 0.0, "avg_logprob": -0.1585163083569757, "compression_ratio": 1.7316176470588236, "no_speech_prob": 1.6232399539101161e-12}, {"id": 297, "seek": 73478, "start": 740.02, "end": 744.02, "text": " sets of rules, end up converging on the exact same future?", "tokens": [50627, 6352, 295, 4474, 11, 917, 493, 9652, 3249, 322, 264, 1900, 912, 2027, 30, 50827], "temperature": 0.0, "avg_logprob": -0.1585163083569757, "compression_ratio": 1.7316176470588236, "no_speech_prob": 1.6232399539101161e-12}, {"id": 298, "seek": 73478, "start": 744.4, "end": 746.56, "text": " That is where the math gets a bit unforgiving.", "tokens": [50846, 663, 307, 689, 264, 5221, 2170, 257, 857, 31411, 15441, 13, 50954], "temperature": 0.0, "avg_logprob": -0.1585163083569757, "compression_ratio": 1.7316176470588236, "no_speech_prob": 1.6232399539101161e-12}, {"id": 299, "seek": 73478, "start": 747.5799999999999, "end": 750.88, "text": " The text handles this by introducing continuation quotients.", "tokens": [51005, 440, 2487, 18722, 341, 538, 15424, 29357, 9641, 2448, 13, 51170], "temperature": 0.0, "avg_logprob": -0.1585163083569757, "compression_ratio": 1.7316176470588236, "no_speech_prob": 1.6232399539101161e-12}, {"id": 300, "seek": 73478, "start": 751.02, "end": 752.14, "text": " Continuation quotients.", "tokens": [51177, 14674, 16073, 9641, 2448, 13, 51233], "temperature": 0.0, "avg_logprob": -0.1585163083569757, "compression_ratio": 1.7316176470588236, "no_speech_prob": 1.6232399539101161e-12}, {"id": 301, "seek": 73478, "start": 752.36, "end": 752.5, "text": " Yeah.", "tokens": [51244, 865, 13, 51251], "temperature": 0.0, "avg_logprob": -0.1585163083569757, "compression_ratio": 1.7316176470588236, "no_speech_prob": 1.6232399539101161e-12}, {"id": 302, "seek": 73478, "start": 752.62, "end": 756.14, "text": " And to visualize this, Fliction gives us the analogy of the two rivers.", "tokens": [51257, 400, 281, 23273, 341, 11, 3235, 4105, 2709, 505, 264, 21663, 295, 264, 732, 18361, 13, 51433], "temperature": 0.0, "avg_logprob": -0.1585163083569757, "compression_ratio": 1.7316176470588236, "no_speech_prob": 1.6232399539101161e-12}, {"id": 303, "seek": 73478, "start": 756.38, "end": 757.66, "text": " I love this analogy.", "tokens": [51445, 286, 959, 341, 21663, 13, 51509], "temperature": 0.0, "avg_logprob": -0.1585163083569757, "compression_ratio": 1.7316176470588236, "no_speech_prob": 1.6232399539101161e-12}, {"id": 304, "seek": 73478, "start": 757.6999999999999, "end": 758.5, "text": " It's so clear.", "tokens": [51511, 467, 311, 370, 1850, 13, 51551], "temperature": 0.0, "avg_logprob": -0.1585163083569757, "compression_ratio": 1.7316176470588236, "no_speech_prob": 1.6232399539101161e-12}, {"id": 305, "seek": 73478, "start": 758.9599999999999, "end": 764.4399999999999, "text": " Imagine two rivers rising on completely opposite sides of a massive mountain range.", "tokens": [51574, 11739, 732, 18361, 11636, 322, 2584, 6182, 4881, 295, 257, 5994, 6937, 3613, 13, 51848], "temperature": 0.0, "avg_logprob": -0.1585163083569757, "compression_ratio": 1.7316176470588236, "no_speech_prob": 1.6232399539101161e-12}, {"id": 306, "seek": 76444, "start": 764.44, "end": 764.6400000000001, "text": " Okay.", "tokens": [50365, 1033, 13, 50375], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 307, "seek": 76444, "start": 764.7600000000001, "end": 765.62, "text": " Two different origins.", "tokens": [50381, 4453, 819, 22721, 13, 50424], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 308, "seek": 76444, "start": 766.08, "end": 767.2600000000001, "text": " They carve through different rock.", "tokens": [50447, 814, 33832, 807, 819, 3727, 13, 50506], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 309, "seek": 76444, "start": 767.4000000000001, "end": 768.94, "text": " They cross totally different terrains.", "tokens": [50513, 814, 3278, 3879, 819, 26298, 1292, 13, 50590], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 310, "seek": 76444, "start": 769.1, "end": 770.48, "text": " They host different ecosystems.", "tokens": [50598, 814, 3975, 819, 32647, 13, 50667], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 311, "seek": 76444, "start": 770.9200000000001, "end": 772.3800000000001, "text": " They share absolutely no history.", "tokens": [50689, 814, 2073, 3122, 572, 2503, 13, 50762], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 312, "seek": 76444, "start": 772.58, "end": 772.98, "text": " None at all.", "tokens": [50772, 14492, 412, 439, 13, 50792], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 313, "seek": 76444, "start": 773.24, "end": 776.94, "text": " But eventually, down the valley, they arrive at the exact same confluence.", "tokens": [50805, 583, 4728, 11, 760, 264, 17636, 11, 436, 8881, 412, 264, 1900, 912, 1497, 40432, 13, 50990], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 314, "seek": 76444, "start": 777.2600000000001, "end": 779.5, "text": " They merge into a single massive river.", "tokens": [51006, 814, 22183, 666, 257, 2167, 5994, 6810, 13, 51118], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 315, "seek": 76444, "start": 779.7800000000001, "end": 785.2600000000001, "text": " And once that water merges, everything about its separate history becomes totally irrelevant.", "tokens": [51132, 400, 1564, 300, 1281, 3551, 2880, 11, 1203, 466, 1080, 4994, 2503, 3643, 3879, 28682, 13, 51406], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 316, "seek": 76444, "start": 785.5600000000001, "end": 785.98, "text": " Exactly.", "tokens": [51421, 7587, 13, 51442], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 317, "seek": 76444, "start": 786.2600000000001, "end": 791.8800000000001, "text": " If I launch a boat downstream of that confluence, the boat cannot tell which branch the water", "tokens": [51456, 759, 286, 4025, 257, 6582, 30621, 295, 300, 1497, 40432, 11, 264, 6582, 2644, 980, 597, 9819, 264, 1281, 51737], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 318, "seek": 76444, "start": 791.8800000000001, "end": 792.8000000000001, "text": " underneath it came from.", "tokens": [51737, 7223, 309, 1361, 490, 13, 51783], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 319, "seek": 76444, "start": 793.0200000000001, "end": 793.9200000000001, "text": " It has no idea.", "tokens": [51794, 467, 575, 572, 1558, 13, 51839], "temperature": 0.0, "avg_logprob": -0.1577180650499132, "compression_ratio": 1.7919463087248322, "no_speech_prob": 1.4106474235248134e-12}, {"id": 320, "seek": 79392, "start": 793.92, "end": 795.4599999999999, "text": " The history hasn't been hidden.", "tokens": [50365, 440, 2503, 6132, 380, 668, 7633, 13, 50442], "temperature": 0.0, "avg_logprob": -0.13676556944847107, "compression_ratio": 1.5911111111111111, "no_speech_prob": 1.478206988238251e-12}, {"id": 321, "seek": 79392, "start": 795.8199999999999, "end": 799.28, "text": " It has just ceased to matter to the physical reality of the boat.", "tokens": [50460, 467, 575, 445, 49917, 281, 1871, 281, 264, 4001, 4103, 295, 264, 6582, 13, 50633], "temperature": 0.0, "avg_logprob": -0.13676556944847107, "compression_ratio": 1.5911111111111111, "no_speech_prob": 1.478206988238251e-12}, {"id": 322, "seek": 79392, "start": 799.76, "end": 802.88, "text": " The futures of those two rivers are now perfectly identical.", "tokens": [50657, 440, 26071, 295, 729, 732, 18361, 366, 586, 6239, 14800, 13, 50813], "temperature": 0.0, "avg_logprob": -0.13676556944847107, "compression_ratio": 1.5911111111111111, "no_speech_prob": 1.478206988238251e-12}, {"id": 323, "seek": 79392, "start": 803.4599999999999, "end": 807.9799999999999, "text": " And mathematically, the book defines this as gamma equivalents.", "tokens": [50842, 400, 44003, 11, 264, 1446, 23122, 341, 382, 15546, 9052, 791, 13, 51068], "temperature": 0.0, "avg_logprob": -0.13676556944847107, "compression_ratio": 1.5911111111111111, "no_speech_prob": 1.478206988238251e-12}, {"id": 324, "seek": 79392, "start": 808.0999999999999, "end": 809.0, "text": " Gamma equivalents.", "tokens": [51074, 24723, 1696, 9052, 791, 13, 51119], "temperature": 0.0, "avg_logprob": -0.13676556944847107, "compression_ratio": 1.5911111111111111, "no_speech_prob": 1.478206988238251e-12}, {"id": 325, "seek": 79392, "start": 809.02, "end": 812.14, "text": " It's written with a little tilde symbol and a subscript gamma.", "tokens": [51120, 467, 311, 3720, 365, 257, 707, 45046, 5986, 293, 257, 2325, 662, 15546, 13, 51276], "temperature": 0.0, "avg_logprob": -0.13676556944847107, "compression_ratio": 1.5911111111111111, "no_speech_prob": 1.478206988238251e-12}, {"id": 326, "seek": 79392, "start": 812.3399999999999, "end": 813.66, "text": " Oh, like the squiggly line.", "tokens": [51286, 876, 11, 411, 264, 2339, 46737, 1622, 13, 51352], "temperature": 0.0, "avg_logprob": -0.13676556944847107, "compression_ratio": 1.5911111111111111, "no_speech_prob": 1.478206988238251e-12}, {"id": 327, "seek": 79392, "start": 813.8399999999999, "end": 814.68, "text": " Right, the squiggly line.", "tokens": [51361, 1779, 11, 264, 2339, 46737, 1622, 13, 51403], "temperature": 0.0, "avg_logprob": -0.13676556944847107, "compression_ratio": 1.5911111111111111, "no_speech_prob": 1.478206988238251e-12}, {"id": 328, "seek": 81468, "start": 814.68, "end": 820.18, "text": " And if you have two different paths or states and their massive branching trees of possible", "tokens": [50365, 400, 498, 291, 362, 732, 819, 14518, 420, 4368, 293, 641, 5994, 9819, 278, 5852, 295, 1944, 50640], "temperature": 0.0, "avg_logprob": -0.16083743992973776, "compression_ratio": 1.325, "no_speech_prob": 1.9354784702024785e-12}, {"id": 329, "seek": 81468, "start": 820.18, "end": 823.8199999999999, "text": " futures are perfectly identical, those states are gamma equivalent.", "tokens": [50640, 26071, 366, 6239, 14800, 11, 729, 4368, 366, 15546, 10344, 13, 50822], "temperature": 0.0, "avg_logprob": -0.16083743992973776, "compression_ratio": 1.325, "no_speech_prob": 1.9354784702024785e-12}, {"id": 330, "seek": 82382, "start": 823.82, "end": 826.62, "text": " So they share the exact same continuation space.", "tokens": [50365, 407, 436, 2073, 264, 1900, 912, 29357, 1901, 13, 50505], "temperature": 0.0, "avg_logprob": -0.1934587926040461, "compression_ratio": 1.52020202020202, "no_speech_prob": 1.5041961816744664e-12}, {"id": 331, "seek": 82382, "start": 826.7800000000001, "end": 827.0, "text": " Yes.", "tokens": [50513, 1079, 13, 50524], "temperature": 0.0, "avg_logprob": -0.1934587926040461, "compression_ratio": 1.52020202020202, "no_speech_prob": 1.5041961816744664e-12}, {"id": 332, "seek": 82382, "start": 827.32, "end": 833.2600000000001, "text": " And to really drive home the consequences of this, the book dives into a brilliant, highly", "tokens": [50540, 400, 281, 534, 3332, 1280, 264, 10098, 295, 341, 11, 264, 1446, 274, 1539, 666, 257, 10248, 11, 5405, 50837], "temperature": 0.0, "avg_logprob": -0.1934587926040461, "compression_ratio": 1.52020202020202, "no_speech_prob": 1.5041961816744664e-12}, {"id": 333, "seek": 82382, "start": 833.2600000000001, "end": 835.1400000000001, "text": " specific engineering example.", "tokens": [50837, 2685, 7043, 1365, 13, 50931], "temperature": 0.0, "avg_logprob": -0.1934587926040461, "compression_ratio": 1.52020202020202, "no_speech_prob": 1.5041961816744664e-12}, {"id": 334, "seek": 82382, "start": 835.7800000000001, "end": 836.5400000000001, "text": " The traffic light.", "tokens": [50963, 440, 6419, 1442, 13, 51001], "temperature": 0.0, "avg_logprob": -0.1934587926040461, "compression_ratio": 1.52020202020202, "no_speech_prob": 1.5041961816744664e-12}, {"id": 335, "seek": 82382, "start": 836.6600000000001, "end": 836.9200000000001, "text": " Yes.", "tokens": [51007, 1079, 13, 51020], "temperature": 0.0, "avg_logprob": -0.1934587926040461, "compression_ratio": 1.52020202020202, "no_speech_prob": 1.5041961816744664e-12}, {"id": 336, "seek": 82382, "start": 837.1800000000001, "end": 840.4200000000001, "text": " This is the exact scenario I mentioned at the very start of the deep dive.", "tokens": [51033, 639, 307, 264, 1900, 9005, 286, 2835, 412, 264, 588, 722, 295, 264, 2452, 9192, 13, 51195], "temperature": 0.0, "avg_logprob": -0.1934587926040461, "compression_ratio": 1.52020202020202, "no_speech_prob": 1.5041961816744664e-12}, {"id": 337, "seek": 82382, "start": 840.4200000000001, "end": 841.5400000000001, "text": " That's such a good example.", "tokens": [51195, 663, 311, 1270, 257, 665, 1365, 13, 51251], "temperature": 0.0, "avg_logprob": -0.1934587926040461, "compression_ratio": 1.52020202020202, "no_speech_prob": 1.5041961816744664e-12}, {"id": 338, "seek": 84154, "start": 841.54, "end": 844.5999999999999, "text": " This is where the math gets incredibly tangible.", "tokens": [50365, 639, 307, 689, 264, 5221, 2170, 6252, 27094, 13, 50518], "temperature": 0.0, "avg_logprob": -0.17365187612073174, "compression_ratio": 1.5393258426966292, "no_speech_prob": 1.4956349960598692e-12}, {"id": 339, "seek": 84154, "start": 844.74, "end": 849.1999999999999, "text": " And honestly, a little frustrating when you realize how often we build things this way.", "tokens": [50525, 400, 6095, 11, 257, 707, 16522, 562, 291, 4325, 577, 2049, 321, 1322, 721, 341, 636, 13, 50748], "temperature": 0.0, "avg_logprob": -0.17365187612073174, "compression_ratio": 1.5393258426966292, "no_speech_prob": 1.4956349960598692e-12}, {"id": 340, "seek": 84154, "start": 849.4, "end": 849.52, "text": " Yeah.", "tokens": [50758, 865, 13, 50764], "temperature": 0.0, "avg_logprob": -0.17365187612073174, "compression_ratio": 1.5393258426966292, "no_speech_prob": 1.4956349960598692e-12}, {"id": 341, "seek": 84154, "start": 849.5999999999999, "end": 853.0999999999999, "text": " So imagine a standard traffic light at a pedestrian crosswalk.", "tokens": [50768, 407, 3811, 257, 3832, 6419, 1442, 412, 257, 33947, 3278, 12490, 13, 50943], "temperature": 0.0, "avg_logprob": -0.17365187612073174, "compression_ratio": 1.5393258426966292, "no_speech_prob": 1.4956349960598692e-12}, {"id": 342, "seek": 84154, "start": 853.38, "end": 855.12, "text": " It has a cycle of four phases.", "tokens": [50957, 467, 575, 257, 6586, 295, 1451, 18764, 13, 51044], "temperature": 0.0, "avg_logprob": -0.17365187612073174, "compression_ratio": 1.5393258426966292, "no_speech_prob": 1.4956349960598692e-12}, {"id": 343, "seek": 84154, "start": 855.5, "end": 858.12, "text": " Let's label them zero, one, two, and three.", "tokens": [51063, 961, 311, 7645, 552, 4018, 11, 472, 11, 732, 11, 293, 1045, 13, 51194], "temperature": 0.0, "avg_logprob": -0.17365187612073174, "compression_ratio": 1.5393258426966292, "no_speech_prob": 1.4956349960598692e-12}, {"id": 344, "seek": 84154, "start": 858.26, "end": 858.48, "text": " Okay.", "tokens": [51201, 1033, 13, 51212], "temperature": 0.0, "avg_logprob": -0.17365187612073174, "compression_ratio": 1.5393258426966292, "no_speech_prob": 1.4956349960598692e-12}, {"id": 345, "seek": 84154, "start": 858.5799999999999, "end": 859.12, "text": " Zero to three.", "tokens": [51217, 17182, 281, 1045, 13, 51244], "temperature": 0.0, "avg_logprob": -0.17365187612073174, "compression_ratio": 1.5393258426966292, "no_speech_prob": 1.4956349960598692e-12}, {"id": 346, "seek": 84154, "start": 859.36, "end": 860.56, "text": " Phase zero is the red light.", "tokens": [51256, 24432, 4018, 307, 264, 2182, 1442, 13, 51316], "temperature": 0.0, "avg_logprob": -0.17365187612073174, "compression_ratio": 1.5393258426966292, "no_speech_prob": 1.4956349960598692e-12}, {"id": 347, "seek": 84154, "start": 861.04, "end": 864.76, "text": " The other phases are green, yellow, whatever it takes to manage the cars.", "tokens": [51340, 440, 661, 18764, 366, 3092, 11, 5566, 11, 2035, 309, 2516, 281, 3067, 264, 5163, 13, 51526], "temperature": 0.0, "avg_logprob": -0.17365187612073174, "compression_ratio": 1.5393258426966292, "no_speech_prob": 1.4956349960598692e-12}, {"id": 348, "seek": 84154, "start": 864.88, "end": 865.0799999999999, "text": " Right.", "tokens": [51532, 1779, 13, 51542], "temperature": 0.0, "avg_logprob": -0.17365187612073174, "compression_ratio": 1.5393258426966292, "no_speech_prob": 1.4956349960598692e-12}, {"id": 349, "seek": 86508, "start": 865.08, "end": 870.9000000000001, "text": " Now, the system also has a tiny piece of memory, a pending pedestrian request bit.", "tokens": [50365, 823, 11, 264, 1185, 611, 575, 257, 5870, 2522, 295, 4675, 11, 257, 32110, 33947, 5308, 857, 13, 50656], "temperature": 0.0, "avg_logprob": -0.14118465157442314, "compression_ratio": 1.7122302158273381, "no_speech_prob": 1.4493877018711965e-12}, {"id": 350, "seek": 86508, "start": 871.1, "end": 872.48, "text": " Just a simple computer bit.", "tokens": [50666, 1449, 257, 2199, 3820, 857, 13, 50735], "temperature": 0.0, "avg_logprob": -0.14118465157442314, "compression_ratio": 1.7122302158273381, "no_speech_prob": 1.4493877018711965e-12}, {"id": 351, "seek": 86508, "start": 872.6, "end": 872.9000000000001, "text": " Exactly.", "tokens": [50741, 7587, 13, 50756], "temperature": 0.0, "avg_logprob": -0.14118465157442314, "compression_ratio": 1.7122302158273381, "no_speech_prob": 1.4493877018711965e-12}, {"id": 352, "seek": 86508, "start": 873.14, "end": 874.34, "text": " It's just a zero or a one.", "tokens": [50768, 467, 311, 445, 257, 4018, 420, 257, 472, 13, 50828], "temperature": 0.0, "avg_logprob": -0.14118465157442314, "compression_ratio": 1.7122302158273381, "no_speech_prob": 1.4493877018711965e-12}, {"id": 353, "seek": 86508, "start": 874.58, "end": 877.0200000000001, "text": " A zero means no one has pushed the crosswalk button.", "tokens": [50840, 316, 4018, 1355, 572, 472, 575, 9152, 264, 3278, 12490, 2960, 13, 50962], "temperature": 0.0, "avg_logprob": -0.14118465157442314, "compression_ratio": 1.7122302158273381, "no_speech_prob": 1.4493877018711965e-12}, {"id": 354, "seek": 86508, "start": 877.6800000000001, "end": 881.34, "text": " A one means someone has pushed the button, and the system knows a human is waiting to cross.", "tokens": [50995, 316, 472, 1355, 1580, 575, 9152, 264, 2960, 11, 293, 264, 1185, 3255, 257, 1952, 307, 3806, 281, 3278, 13, 51178], "temperature": 0.0, "avg_logprob": -0.14118465157442314, "compression_ratio": 1.7122302158273381, "no_speech_prob": 1.4493877018711965e-12}, {"id": 355, "seek": 86508, "start": 881.74, "end": 882.0, "text": " Okay.", "tokens": [51198, 1033, 13, 51211], "temperature": 0.0, "avg_logprob": -0.14118465157442314, "compression_ratio": 1.7122302158273381, "no_speech_prob": 1.4493877018711965e-12}, {"id": 356, "seek": 86508, "start": 882.12, "end": 885.4200000000001, "text": " Let's look at the correct optimal design for this machine first.", "tokens": [51217, 961, 311, 574, 412, 264, 3006, 16252, 1715, 337, 341, 3479, 700, 13, 51382], "temperature": 0.0, "avg_logprob": -0.14118465157442314, "compression_ratio": 1.7122302158273381, "no_speech_prob": 1.4493877018711965e-12}, {"id": 357, "seek": 86508, "start": 885.6800000000001, "end": 886.44, "text": " The good engineer.", "tokens": [51395, 440, 665, 11403, 13, 51433], "temperature": 0.0, "avg_logprob": -0.14118465157442314, "compression_ratio": 1.7122302158273381, "no_speech_prob": 1.4493877018711965e-12}, {"id": 358, "seek": 86508, "start": 886.64, "end": 886.94, "text": " Right.", "tokens": [51443, 1779, 13, 51458], "temperature": 0.0, "avg_logprob": -0.14118465157442314, "compression_ratio": 1.7122302158273381, "no_speech_prob": 1.4493877018711965e-12}, {"id": 359, "seek": 86508, "start": 887.58, "end": 891.7800000000001, "text": " The proper way to program this light is to clear the pedestrian request, resetting the", "tokens": [51490, 440, 2296, 636, 281, 1461, 341, 1442, 307, 281, 1850, 264, 33947, 5308, 11, 14322, 783, 264, 51700], "temperature": 0.0, "avg_logprob": -0.14118465157442314, "compression_ratio": 1.7122302158273381, "no_speech_prob": 1.4493877018711965e-12}, {"id": 360, "seek": 89178, "start": 891.78, "end": 895.5799999999999, "text": " bit from a one back to a zero, exactly on arrival at the red light.", "tokens": [50365, 857, 490, 257, 472, 646, 281, 257, 4018, 11, 2293, 322, 18365, 412, 264, 2182, 1442, 13, 50555], "temperature": 0.0, "avg_logprob": -0.13002218518938338, "compression_ratio": 1.706070287539936, "no_speech_prob": 1.382725422875708e-12}, {"id": 361, "seek": 89178, "start": 895.68, "end": 895.8199999999999, "text": " Right.", "tokens": [50560, 1779, 13, 50567], "temperature": 0.0, "avg_logprob": -0.13002218518938338, "compression_ratio": 1.706070287539936, "no_speech_prob": 1.382725422875708e-12}, {"id": 362, "seek": 89178, "start": 895.88, "end": 896.74, "text": " The moment it transitions.", "tokens": [50570, 440, 1623, 309, 23767, 13, 50613], "temperature": 0.0, "avg_logprob": -0.13002218518938338, "compression_ratio": 1.706070287539936, "no_speech_prob": 1.382725422875708e-12}, {"id": 363, "seek": 89178, "start": 896.9599999999999, "end": 899.56, "text": " The absolute millisecond the light transitions into phase zero.", "tokens": [50624, 440, 8236, 27940, 18882, 264, 1442, 23767, 666, 5574, 4018, 13, 50754], "temperature": 0.0, "avg_logprob": -0.13002218518938338, "compression_ratio": 1.706070287539936, "no_speech_prob": 1.382725422875708e-12}, {"id": 364, "seek": 89178, "start": 899.6999999999999, "end": 902.64, "text": " The red light, the system says, okay, the crosswalk is now active.", "tokens": [50761, 440, 2182, 1442, 11, 264, 1185, 1619, 11, 1392, 11, 264, 3278, 12490, 307, 586, 4967, 13, 50908], "temperature": 0.0, "avg_logprob": -0.13002218518938338, "compression_ratio": 1.706070287539936, "no_speech_prob": 1.382725422875708e-12}, {"id": 365, "seek": 89178, "start": 903.06, "end": 906.0799999999999, "text": " Pedestrians can walk, so I can clear the memory of the button press.", "tokens": [50929, 16689, 377, 28145, 393, 1792, 11, 370, 286, 393, 1850, 264, 4675, 295, 264, 2960, 1886, 13, 51080], "temperature": 0.0, "avg_logprob": -0.13002218518938338, "compression_ratio": 1.706070287539936, "no_speech_prob": 1.382725422875708e-12}, {"id": 366, "seek": 89178, "start": 906.42, "end": 907.56, "text": " That makes perfect sense.", "tokens": [51097, 663, 1669, 2176, 2020, 13, 51154], "temperature": 0.0, "avg_logprob": -0.13002218518938338, "compression_ratio": 1.706070287539936, "no_speech_prob": 1.382725422875708e-12}, {"id": 367, "seek": 89178, "start": 907.92, "end": 908.9599999999999, "text": " The future arrived.", "tokens": [51172, 440, 2027, 6678, 13, 51224], "temperature": 0.0, "avg_logprob": -0.13002218518938338, "compression_ratio": 1.706070287539936, "no_speech_prob": 1.382725422875708e-12}, {"id": 368, "seek": 89178, "start": 909.4, "end": 913.02, "text": " But what if a lazy engineer writes the software differently?", "tokens": [51246, 583, 437, 498, 257, 14847, 11403, 13657, 264, 4722, 7614, 30, 51427], "temperature": 0.0, "avg_logprob": -0.13002218518938338, "compression_ratio": 1.706070287539936, "no_speech_prob": 1.382725422875708e-12}, {"id": 369, "seek": 89178, "start": 913.18, "end": 914.8199999999999, "text": " And this is where it all goes wrong.", "tokens": [51435, 400, 341, 307, 689, 309, 439, 1709, 2085, 13, 51517], "temperature": 0.0, "avg_logprob": -0.13002218518938338, "compression_ratio": 1.706070287539936, "no_speech_prob": 1.382725422875708e-12}, {"id": 370, "seek": 89178, "start": 915.06, "end": 920.88, "text": " What if, instead of clearing the memory on a specific transition to red, they just write", "tokens": [51529, 708, 498, 11, 2602, 295, 23937, 264, 4675, 322, 257, 2685, 6034, 281, 2182, 11, 436, 445, 2464, 51820], "temperature": 0.0, "avg_logprob": -0.13002218518938338, "compression_ratio": 1.706070287539936, "no_speech_prob": 1.382725422875708e-12}, {"id": 371, "seek": 92088, "start": 920.88, "end": 921.76, "text": " a blanket rule.", "tokens": [50365, 257, 17907, 4978, 13, 50409], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 372, "seek": 92088, "start": 921.96, "end": 922.48, "text": " Like what?", "tokens": [50419, 1743, 437, 30, 50445], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 373, "seek": 92088, "start": 922.58, "end": 927.56, "text": " A rule that says, whenever the light is red, clear the request bit.", "tokens": [50450, 316, 4978, 300, 1619, 11, 5699, 264, 1442, 307, 2182, 11, 1850, 264, 5308, 857, 13, 50699], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 374, "seek": 92088, "start": 927.68, "end": 927.96, "text": " Okay.", "tokens": [50705, 1033, 13, 50719], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 375, "seek": 92088, "start": 928.16, "end": 930.04, "text": " Honestly, that sounds almost identical.", "tokens": [50729, 12348, 11, 300, 3263, 1920, 14800, 13, 50823], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 376, "seek": 92088, "start": 930.38, "end": 932.2, "text": " If the light is red, clear the bit.", "tokens": [50840, 759, 264, 1442, 307, 2182, 11, 1850, 264, 857, 13, 50931], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 377, "seek": 92088, "start": 932.32, "end": 934.22, "text": " Why is that mathematically destructive?", "tokens": [50937, 1545, 307, 300, 44003, 26960, 30, 51032], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 378, "seek": 92088, "start": 934.62, "end": 936.74, "text": " Because of how it merges states prematurely.", "tokens": [51052, 1436, 295, 577, 309, 3551, 2880, 4368, 34877, 356, 13, 51158], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 379, "seek": 92088, "start": 936.82, "end": 937.0, "text": " Yeah.", "tokens": [51162, 865, 13, 51171], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 380, "seek": 92088, "start": 937.12, "end": 939.14, "text": " Think about being stopped at that intersection.", "tokens": [51177, 6557, 466, 885, 5936, 412, 300, 15236, 13, 51278], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 381, "seek": 92088, "start": 939.32, "end": 939.58, "text": " Okay.", "tokens": [51287, 1033, 13, 51300], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 382, "seek": 92088, "start": 939.58, "end": 946.3, "text": " If the lazy rule is running, the system constantly forces the pending request memory to zero for", "tokens": [51300, 759, 264, 14847, 4978, 307, 2614, 11, 264, 1185, 6460, 5874, 264, 32110, 5308, 4675, 281, 4018, 337, 51636], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 383, "seek": 92088, "start": 946.3, "end": 947.84, "text": " the entire duration of the red light.", "tokens": [51636, 264, 2302, 16365, 295, 264, 2182, 1442, 13, 51713], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 384, "seek": 92088, "start": 947.9, "end": 948.06, "text": " Right.", "tokens": [51716, 1779, 13, 51724], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 385, "seek": 92088, "start": 948.1, "end": 949.78, "text": " Because it's checking and saying, is it red?", "tokens": [51726, 1436, 309, 311, 8568, 293, 1566, 11, 307, 309, 2182, 30, 51810], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 386, "seek": 92088, "start": 949.9, "end": 950.16, "text": " Yes.", "tokens": [51816, 1079, 13, 51829], "temperature": 0.0, "avg_logprob": -0.16845330863163388, "compression_ratio": 1.7157190635451505, "no_speech_prob": 1.3619140537546315e-12}, {"id": 387, "seek": 95016, "start": 950.16, "end": 950.88, "text": " Make it zero.", "tokens": [50365, 4387, 309, 4018, 13, 50401], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 388, "seek": 95016, "start": 951.16, "end": 951.8199999999999, "text": " Over and over.", "tokens": [50415, 4886, 293, 670, 13, 50448], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 389, "seek": 95016, "start": 951.9399999999999, "end": 952.3399999999999, "text": " Exactly.", "tokens": [50454, 7587, 13, 50474], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 390, "seek": 95016, "start": 952.68, "end": 957.0, "text": " So it mathematically merges two totally different physical realities.", "tokens": [50491, 407, 309, 44003, 3551, 2880, 732, 3879, 819, 4001, 27785, 13, 50707], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 391, "seek": 95016, "start": 957.6, "end": 961.92, "text": " Reality A, you are sitting at a red light and no one is at the crosswalk.", "tokens": [50737, 33822, 316, 11, 291, 366, 3798, 412, 257, 2182, 1442, 293, 572, 472, 307, 412, 264, 3278, 12490, 13, 50953], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 392, "seek": 95016, "start": 961.9599999999999, "end": 962.92, "text": " Just an empty string.", "tokens": [50955, 1449, 364, 6707, 6798, 13, 51003], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 393, "seek": 95016, "start": 962.9399999999999, "end": 967.62, "text": " Reality B, you are sitting at a red light and a pedestrian just ran up and desperately pushed", "tokens": [51004, 33822, 363, 11, 291, 366, 3798, 412, 257, 2182, 1442, 293, 257, 33947, 445, 5872, 493, 293, 23726, 9152, 51238], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 394, "seek": 95016, "start": 967.62, "end": 967.9599999999999, "text": " the button.", "tokens": [51238, 264, 2960, 13, 51255], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 395, "seek": 95016, "start": 968.24, "end": 968.6, "text": " Oh.", "tokens": [51269, 876, 13, 51287], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 396, "seek": 95016, "start": 969.4599999999999, "end": 969.78, "text": " Wow.", "tokens": [51330, 3153, 13, 51346], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 397, "seek": 95016, "start": 970.0, "end": 974.6999999999999, "text": " Because the lazy system instantly wipes the button press out of memory purely because", "tokens": [51357, 1436, 264, 14847, 1185, 13518, 41228, 264, 2960, 1886, 484, 295, 4675, 17491, 570, 51592], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 398, "seek": 95016, "start": 974.6999999999999, "end": 976.36, "text": " the light happens to be red right now.", "tokens": [51592, 264, 1442, 2314, 281, 312, 2182, 558, 586, 13, 51675], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 399, "seek": 95016, "start": 976.4399999999999, "end": 976.74, "text": " Yes.", "tokens": [51679, 1079, 13, 51694], "temperature": 0.0, "avg_logprob": -0.19506145292712795, "compression_ratio": 1.7230769230769232, "no_speech_prob": 1.478200049344347e-12}, {"id": 400, "seek": 97674, "start": 976.74, "end": 979.66, "text": " It treats the two situations as identical.", "tokens": [50365, 467, 19566, 264, 732, 6851, 382, 14800, 13, 50511], "temperature": 0.0, "avg_logprob": -0.20218724982683048, "compression_ratio": 1.3333333333333333, "no_speech_prob": 1.8040577712263861e-12}, {"id": 401, "seek": 97674, "start": 979.66, "end": 982.88, "text": " It forces gamma equivalents where none should exist.", "tokens": [50511, 467, 5874, 15546, 9052, 791, 689, 6022, 820, 2514, 13, 50672], "temperature": 0.0, "avg_logprob": -0.20218724982683048, "compression_ratio": 1.3333333333333333, "no_speech_prob": 1.8040577712263861e-12}, {"id": 402, "seek": 97674, "start": 983.58, "end": 989.74, "text": " And by merging those two states, the lazy design commits a very specific mathematical crime.", "tokens": [50707, 400, 538, 44559, 729, 732, 4368, 11, 264, 14847, 1715, 48311, 257, 588, 2685, 18894, 7206, 13, 51015], "temperature": 0.0, "avg_logprob": -0.20218724982683048, "compression_ratio": 1.3333333333333333, "no_speech_prob": 1.8040577712263861e-12}, {"id": 403, "seek": 98974, "start": 989.74, "end": 993.08, "text": " The text calls it distinction loss.", "tokens": [50365, 440, 2487, 5498, 309, 16844, 4470, 13, 50532], "temperature": 0.0, "avg_logprob": -0.2560868595921716, "compression_ratio": 1.3644067796610169, "no_speech_prob": 3.1904544110783473e-12}, {"id": 404, "seek": 98974, "start": 993.4, "end": 994.34, "text": " Distinction loss.", "tokens": [50548, 9840, 12987, 4470, 13, 50595], "temperature": 0.0, "avg_logprob": -0.2560868595921716, "compression_ratio": 1.3644067796610169, "no_speech_prob": 3.1904544110783473e-12}, {"id": 405, "seek": 98974, "start": 994.34, "end": 1000.14, "text": " When you compute the mathematical fiber of that lazy shortcut, the loss is exactly the log", "tokens": [50595, 1133, 291, 14722, 264, 18894, 12874, 295, 300, 14847, 24822, 11, 264, 4470, 307, 2293, 264, 3565, 50885], "temperature": 0.0, "avg_logprob": -0.2560868595921716, "compression_ratio": 1.3644067796610169, "no_speech_prob": 3.1904544110783473e-12}, {"id": 406, "seek": 98974, "start": 1000.14, "end": 1001.2, "text": " base two of two.", "tokens": [50885, 3096, 732, 295, 732, 13, 50938], "temperature": 0.0, "avg_logprob": -0.2560868595921716, "compression_ratio": 1.3644067796610169, "no_speech_prob": 3.1904544110783473e-12}, {"id": 407, "seek": 100120, "start": 1001.2, "end": 1004.2800000000001, "text": " Which translates to exactly one bit of information.", "tokens": [50365, 3013, 28468, 281, 2293, 472, 857, 295, 1589, 13, 50519], "temperature": 0.0, "avg_logprob": -0.14679035118647984, "compression_ratio": 1.7107142857142856, "no_speech_prob": 2.1931508258771215e-12}, {"id": 408, "seek": 100120, "start": 1004.44, "end": 1004.84, "text": " Exactly.", "tokens": [50527, 7587, 13, 50547], "temperature": 0.0, "avg_logprob": -0.14679035118647984, "compression_ratio": 1.7107142857142856, "no_speech_prob": 2.1931508258771215e-12}, {"id": 409, "seek": 100120, "start": 1005.2, "end": 1008.38, "text": " One bit of the system's future potential has been destroyed.", "tokens": [50565, 1485, 857, 295, 264, 1185, 311, 2027, 3995, 575, 668, 8937, 13, 50724], "temperature": 0.0, "avg_logprob": -0.14679035118647984, "compression_ratio": 1.7107142857142856, "no_speech_prob": 2.1931508258771215e-12}, {"id": 410, "seek": 100120, "start": 1008.76, "end": 1012.6600000000001, "text": " Because the pedestrian who pushed the button while the light was already red is now trapped?", "tokens": [50743, 1436, 264, 33947, 567, 9152, 264, 2960, 1339, 264, 1442, 390, 1217, 2182, 307, 586, 14994, 30, 50938], "temperature": 0.0, "avg_logprob": -0.14679035118647984, "compression_ratio": 1.7107142857142856, "no_speech_prob": 2.1931508258771215e-12}, {"id": 411, "seek": 100120, "start": 1012.76, "end": 1013.08, "text": " Yes.", "tokens": [50943, 1079, 13, 50959], "temperature": 0.0, "avg_logprob": -0.14679035118647984, "compression_ratio": 1.7107142857142856, "no_speech_prob": 2.1931508258771215e-12}, {"id": 412, "seek": 100120, "start": 1013.44, "end": 1015.3000000000001, "text": " The system erased their action from history.", "tokens": [50977, 440, 1185, 38359, 641, 3069, 490, 2503, 13, 51070], "temperature": 0.0, "avg_logprob": -0.14679035118647984, "compression_ratio": 1.7107142857142856, "no_speech_prob": 2.1931508258771215e-12}, {"id": 413, "seek": 100120, "start": 1015.46, "end": 1019.3000000000001, "text": " The light will turn green, the cars will drive away, and the system will have no memory", "tokens": [51078, 440, 1442, 486, 1261, 3092, 11, 264, 5163, 486, 3332, 1314, 11, 293, 264, 1185, 486, 362, 572, 4675, 51270], "temperature": 0.0, "avg_logprob": -0.14679035118647984, "compression_ratio": 1.7107142857142856, "no_speech_prob": 2.1931508258771215e-12}, {"id": 414, "seek": 100120, "start": 1019.3000000000001, "end": 1020.9200000000001, "text": " that anyone was ever waiting to cross.", "tokens": [51270, 300, 2878, 390, 1562, 3806, 281, 3278, 13, 51351], "temperature": 0.0, "avg_logprob": -0.14679035118647984, "compression_ratio": 1.7107142857142856, "no_speech_prob": 2.1931508258771215e-12}, {"id": 415, "seek": 100120, "start": 1020.98, "end": 1024.72, "text": " Because the engineer merged the two rivers before they actually reached the confluence.", "tokens": [51354, 1436, 264, 11403, 36427, 264, 732, 18361, 949, 436, 767, 6488, 264, 1497, 40432, 13, 51541], "temperature": 0.0, "avg_logprob": -0.14679035118647984, "compression_ratio": 1.7107142857142856, "no_speech_prob": 2.1931508258771215e-12}, {"id": 416, "seek": 102472, "start": 1024.72, "end": 1030.04, "text": " The correct design waits to clear the memory until the precise moment it becomes entirely", "tokens": [50365, 440, 3006, 1715, 40597, 281, 1850, 264, 4675, 1826, 264, 13600, 1623, 309, 3643, 7696, 50631], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 417, "seek": 102472, "start": 1030.04, "end": 1031.78, "text": " redundant to the future of the system.", "tokens": [50631, 40997, 281, 264, 2027, 295, 264, 1185, 13, 50718], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 418, "seek": 102472, "start": 1032.18, "end": 1035.56, "text": " We can actually walk through this by checking the time horizon step by step.", "tokens": [50738, 492, 393, 767, 1792, 807, 341, 538, 8568, 264, 565, 18046, 1823, 538, 1823, 13, 50907], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 419, "seek": 102472, "start": 1036.1000000000001, "end": 1038.92, "text": " Like from t equals one to t equals four.", "tokens": [50934, 1743, 490, 256, 6915, 472, 281, 256, 6915, 1451, 13, 51075], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 420, "seek": 102472, "start": 1038.98, "end": 1039.5, "text": " Let's do it.", "tokens": [51078, 961, 311, 360, 309, 13, 51104], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 421, "seek": 102472, "start": 1039.56, "end": 1040.56, "text": " Let's trace the math.", "tokens": [51107, 961, 311, 13508, 264, 5221, 13, 51157], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 422, "seek": 102472, "start": 1040.64, "end": 1040.8, "text": " Okay.", "tokens": [51161, 1033, 13, 51169], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 423, "seek": 102472, "start": 1040.84, "end": 1044.08, "text": " Let's say the light is currently at phase three, the phase right before red.", "tokens": [51171, 961, 311, 584, 264, 1442, 307, 4362, 412, 5574, 1045, 11, 264, 5574, 558, 949, 2182, 13, 51333], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 424, "seek": 102472, "start": 1045.14, "end": 1047.1000000000001, "text": " A pedestrian walks up and presses the button.", "tokens": [51386, 316, 33947, 12896, 493, 293, 40892, 264, 2960, 13, 51484], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 425, "seek": 102472, "start": 1047.18, "end": 1048.58, "text": " The memory bit flips to one.", "tokens": [51488, 440, 4675, 857, 40249, 281, 472, 13, 51558], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 426, "seek": 102472, "start": 1049.0, "end": 1050.8, "text": " The system knows someone is there.", "tokens": [51579, 440, 1185, 3255, 1580, 307, 456, 13, 51669], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 427, "seek": 102472, "start": 1051.02, "end": 1052.6200000000001, "text": " So we advance one step in time.", "tokens": [51680, 407, 321, 7295, 472, 1823, 294, 565, 13, 51760], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 428, "seek": 102472, "start": 1053.14, "end": 1053.8600000000001, "text": " T equals one.", "tokens": [51786, 314, 6915, 472, 13, 51822], "temperature": 0.0, "avg_logprob": -0.1709286168957433, "compression_ratio": 1.7105263157894737, "no_speech_prob": 2.761509337173562e-12}, {"id": 429, "seek": 105386, "start": 1053.86, "end": 1055.9399999999998, "text": " At t equals one, the light turns red.", "tokens": [50365, 1711, 256, 6915, 472, 11, 264, 1442, 4523, 2182, 13, 50469], "temperature": 0.0, "avg_logprob": -0.13947258620965677, "compression_ratio": 1.7195571955719557, "no_speech_prob": 2.150707780271266e-12}, {"id": 430, "seek": 105386, "start": 1056.24, "end": 1057.3999999999999, "text": " It enters phase zero.", "tokens": [50484, 467, 18780, 5574, 4018, 13, 50542], "temperature": 0.0, "avg_logprob": -0.13947258620965677, "compression_ratio": 1.7195571955719557, "no_speech_prob": 2.150707780271266e-12}, {"id": 431, "seek": 105386, "start": 1057.52, "end": 1057.7199999999998, "text": " Right.", "tokens": [50548, 1779, 13, 50558], "temperature": 0.0, "avg_logprob": -0.13947258620965677, "compression_ratio": 1.7195571955719557, "no_speech_prob": 2.150707780271266e-12}, {"id": 432, "seek": 105386, "start": 1057.8999999999999, "end": 1060.56, "text": " The crosswalk sign lights up, allowing the pedestrian to cross.", "tokens": [50567, 440, 3278, 12490, 1465, 5811, 493, 11, 8293, 264, 33947, 281, 3278, 13, 50700], "temperature": 0.0, "avg_logprob": -0.13947258620965677, "compression_ratio": 1.7195571955719557, "no_speech_prob": 2.150707780271266e-12}, {"id": 433, "seek": 105386, "start": 1060.6399999999999, "end": 1065.2199999999998, "text": " Because the future, the button was pointing toward the crossing phase, has now safely arrived", "tokens": [50704, 1436, 264, 2027, 11, 264, 2960, 390, 12166, 7361, 264, 14712, 5574, 11, 575, 586, 11750, 6678, 50933], "temperature": 0.0, "avg_logprob": -0.13947258620965677, "compression_ratio": 1.7195571955719557, "no_speech_prob": 2.150707780271266e-12}, {"id": 434, "seek": 105386, "start": 1065.2199999999998, "end": 1065.78, "text": " in the present.", "tokens": [50933, 294, 264, 1974, 13, 50961], "temperature": 0.0, "avg_logprob": -0.13947258620965677, "compression_ratio": 1.7195571955719557, "no_speech_prob": 2.150707780271266e-12}, {"id": 435, "seek": 105386, "start": 1066.12, "end": 1068.32, "text": " So the system clears the bit back to zero.", "tokens": [50978, 407, 264, 1185, 47033, 264, 857, 646, 281, 4018, 13, 51088], "temperature": 0.0, "avg_logprob": -0.13947258620965677, "compression_ratio": 1.7195571955719557, "no_speech_prob": 2.150707780271266e-12}, {"id": 436, "seek": 105386, "start": 1068.56, "end": 1072.08, "text": " The history of the button press is erased, but it doesn't matter.", "tokens": [51100, 440, 2503, 295, 264, 2960, 1886, 307, 38359, 11, 457, 309, 1177, 380, 1871, 13, 51276], "temperature": 0.0, "avg_logprob": -0.13947258620965677, "compression_ratio": 1.7195571955719557, "no_speech_prob": 2.150707780271266e-12}, {"id": 437, "seek": 105386, "start": 1072.24, "end": 1072.6, "text": " Exactly.", "tokens": [51284, 7587, 13, 51302], "temperature": 0.0, "avg_logprob": -0.13947258620965677, "compression_ratio": 1.7195571955719557, "no_speech_prob": 2.150707780271266e-12}, {"id": 438, "seek": 105386, "start": 1072.74, "end": 1075.74, "text": " It doesn't matter because the bit became naturally redundant.", "tokens": [51309, 467, 1177, 380, 1871, 570, 264, 857, 3062, 8195, 40997, 13, 51459], "temperature": 0.0, "avg_logprob": -0.13947258620965677, "compression_ratio": 1.7195571955719557, "no_speech_prob": 2.150707780271266e-12}, {"id": 439, "seek": 105386, "start": 1076.28, "end": 1078.7199999999998, "text": " The river reached the confluence organically.", "tokens": [51486, 440, 6810, 6488, 264, 1497, 40432, 1798, 984, 13, 51608], "temperature": 0.0, "avg_logprob": -0.13947258620965677, "compression_ratio": 1.7195571955719557, "no_speech_prob": 2.150707780271266e-12}, {"id": 440, "seek": 107872, "start": 1078.72, "end": 1085.28, "text": " But if we look at the lazy design and the pedestrian presses the button at phase zero when the light", "tokens": [50365, 583, 498, 321, 574, 412, 264, 14847, 1715, 293, 264, 33947, 40892, 264, 2960, 412, 5574, 4018, 562, 264, 1442, 50693], "temperature": 0.0, "avg_logprob": -0.1034896473089854, "compression_ratio": 1.1904761904761905, "no_speech_prob": 2.0602846685646714e-12}, {"id": 441, "seek": 108528, "start": 1085.28, "end": 1089.56, "text": " is already red, that button press needs to trigger the next red light cycle.", "tokens": [50365, 307, 1217, 2182, 11, 300, 2960, 1886, 2203, 281, 7875, 264, 958, 2182, 1442, 6586, 13, 50579], "temperature": 0.0, "avg_logprob": -0.17018749237060546, "compression_ratio": 1.5604395604395604, "no_speech_prob": 1.755134557655802e-12}, {"id": 442, "seek": 108528, "start": 1089.74, "end": 1090.06, "text": " Right.", "tokens": [50588, 1779, 13, 50604], "temperature": 0.0, "avg_logprob": -0.17018749237060546, "compression_ratio": 1.5604395604395604, "no_speech_prob": 1.755134557655802e-12}, {"id": 443, "seek": 108528, "start": 1090.28, "end": 1094.26, "text": " The light isn't going to be red again until it cycles all the way through phase one, phase", "tokens": [50615, 440, 1442, 1943, 380, 516, 281, 312, 2182, 797, 1826, 309, 17796, 439, 264, 636, 807, 5574, 472, 11, 5574, 50814], "temperature": 0.0, "avg_logprob": -0.17018749237060546, "compression_ratio": 1.5604395604395604, "no_speech_prob": 1.755134557655802e-12}, {"id": 444, "seek": 108528, "start": 1094.26, "end": 1095.3799999999999, "text": " two, and phase three.", "tokens": [50814, 732, 11, 293, 5574, 1045, 13, 50870], "temperature": 0.0, "avg_logprob": -0.17018749237060546, "compression_ratio": 1.5604395604395604, "no_speech_prob": 1.755134557655802e-12}, {"id": 445, "seek": 108528, "start": 1095.54, "end": 1100.94, "text": " So that single bit of memory needs to stay alive in the machine's brain for a full four", "tokens": [50878, 407, 300, 2167, 857, 295, 4675, 2203, 281, 1754, 5465, 294, 264, 3479, 311, 3567, 337, 257, 1577, 1451, 51148], "temperature": 0.0, "avg_logprob": -0.17018749237060546, "compression_ratio": 1.5604395604395604, "no_speech_prob": 1.755134557655802e-12}, {"id": 446, "seek": 110094, "start": 1100.94, "end": 1101.78, "text": " steps of time.", "tokens": [50365, 4439, 295, 565, 13, 50407], "temperature": 0.0, "avg_logprob": -0.17653377239520734, "compression_ratio": 1.6168224299065421, "no_speech_prob": 2.0924093620949824e-12}, {"id": 447, "seek": 110094, "start": 1101.78, "end": 1108.06, "text": " But if the lazy software constantly zeroes out the memory during phase zero, it murders", "tokens": [50407, 583, 498, 264, 14847, 4722, 6460, 4018, 279, 484, 264, 4675, 1830, 5574, 4018, 11, 309, 30479, 50721], "temperature": 0.0, "avg_logprob": -0.17653377239520734, "compression_ratio": 1.6168224299065421, "no_speech_prob": 2.0924093620949824e-12}, {"id": 448, "seek": 110094, "start": 1108.06, "end": 1109.88, "text": " the bit at t equals one.", "tokens": [50721, 264, 857, 412, 256, 6915, 472, 13, 50812], "temperature": 0.0, "avg_logprob": -0.17653377239520734, "compression_ratio": 1.6168224299065421, "no_speech_prob": 2.0924093620949824e-12}, {"id": 449, "seek": 110094, "start": 1110.0, "end": 1112.3400000000001, "text": " It robs the system of the future crossing cycle.", "tokens": [50818, 467, 744, 929, 264, 1185, 295, 264, 2027, 14712, 6586, 13, 50935], "temperature": 0.0, "avg_logprob": -0.17653377239520734, "compression_ratio": 1.6168224299065421, "no_speech_prob": 2.0924093620949824e-12}, {"id": 450, "seek": 110094, "start": 1112.66, "end": 1117.6200000000001, "text": " Distinction loss is the formal mathematical quantification of a destroyed future.", "tokens": [50951, 9840, 12987, 4470, 307, 264, 9860, 18894, 4426, 3774, 295, 257, 8937, 2027, 13, 51199], "temperature": 0.0, "avg_logprob": -0.17653377239520734, "compression_ratio": 1.6168224299065421, "no_speech_prob": 2.0924093620949824e-12}, {"id": 451, "seek": 110094, "start": 1117.8, "end": 1120.06, "text": " It is the cost of premature convergence.", "tokens": [51208, 467, 307, 264, 2063, 295, 34877, 32181, 13, 51321], "temperature": 0.0, "avg_logprob": -0.17653377239520734, "compression_ratio": 1.6168224299065421, "no_speech_prob": 2.0924093620949824e-12}, {"id": 452, "seek": 110094, "start": 1120.46, "end": 1121.22, "text": " It really is.", "tokens": [51341, 467, 534, 307, 13, 51379], "temperature": 0.0, "avg_logprob": -0.17653377239520734, "compression_ratio": 1.6168224299065421, "no_speech_prob": 2.0924093620949824e-12}, {"id": 453, "seek": 110094, "start": 1121.28, "end": 1123.06, "text": " That is deeply unsettling to me.", "tokens": [51382, 663, 307, 8760, 43964, 1688, 281, 385, 13, 51471], "temperature": 0.0, "avg_logprob": -0.17653377239520734, "compression_ratio": 1.6168224299065421, "no_speech_prob": 2.0924093620949824e-12}, {"id": 454, "seek": 112306, "start": 1123.06, "end": 1129.46, "text": " The idea that a microscopic software shortcut physically deletes a potential event from", "tokens": [50365, 440, 1558, 300, 257, 47897, 4722, 24822, 9762, 1103, 37996, 257, 3995, 2280, 490, 50685], "temperature": 0.0, "avg_logprob": -0.12244388461112976, "compression_ratio": 1.5943396226415094, "no_speech_prob": 1.64920399385593e-12}, {"id": 455, "seek": 112306, "start": 1129.46, "end": 1129.98, "text": " reality.", "tokens": [50685, 4103, 13, 50711], "temperature": 0.0, "avg_logprob": -0.12244388461112976, "compression_ratio": 1.5943396226415094, "no_speech_prob": 1.64920399385593e-12}, {"id": 456, "seek": 112306, "start": 1130.34, "end": 1131.1599999999999, "text": " It is unsettling.", "tokens": [50729, 467, 307, 43964, 1688, 13, 50770], "temperature": 0.0, "avg_logprob": -0.12244388461112976, "compression_ratio": 1.5943396226415094, "no_speech_prob": 1.64920399385593e-12}, {"id": 457, "seek": 112306, "start": 1131.2, "end": 1133.56, "text": " But the text doesn't stop at bad code, does it?", "tokens": [50772, 583, 264, 2487, 1177, 380, 1590, 412, 1578, 3089, 11, 775, 309, 30, 50890], "temperature": 0.0, "avg_logprob": -0.12244388461112976, "compression_ratio": 1.5943396226415094, "no_speech_prob": 1.64920399385593e-12}, {"id": 458, "seek": 112306, "start": 1133.6599999999999, "end": 1138.36, "text": " It argues that this exact same destruction of the future happens in our everyday human", "tokens": [50895, 467, 38218, 300, 341, 1900, 912, 13563, 295, 264, 2027, 2314, 294, 527, 7429, 1952, 51130], "temperature": 0.0, "avg_logprob": -0.12244388461112976, "compression_ratio": 1.5943396226415094, "no_speech_prob": 1.64920399385593e-12}, {"id": 459, "seek": 112306, "start": 1138.36, "end": 1138.98, "text": " observations.", "tokens": [51130, 18163, 13, 51161], "temperature": 0.0, "avg_logprob": -0.12244388461112976, "compression_ratio": 1.5943396226415094, "no_speech_prob": 1.64920399385593e-12}, {"id": 460, "seek": 112306, "start": 1139.1, "end": 1141.1, "text": " Yeah, we do it to ourselves with the labels we use.", "tokens": [51167, 865, 11, 321, 360, 309, 281, 4175, 365, 264, 16949, 321, 764, 13, 51267], "temperature": 0.0, "avg_logprob": -0.12244388461112976, "compression_ratio": 1.5943396226415094, "no_speech_prob": 1.64920399385593e-12}, {"id": 461, "seek": 112306, "start": 1141.34, "end": 1141.9199999999998, "text": " Explain that.", "tokens": [51279, 39574, 300, 13, 51308], "temperature": 0.0, "avg_logprob": -0.12244388461112976, "compression_ratio": 1.5943396226415094, "no_speech_prob": 1.64920399385593e-12}, {"id": 462, "seek": 112306, "start": 1142.04, "end": 1143.5, "text": " How do words destroy futures?", "tokens": [51314, 1012, 360, 2283, 5293, 26071, 30, 51387], "temperature": 0.0, "avg_logprob": -0.12244388461112976, "compression_ratio": 1.5943396226415094, "no_speech_prob": 1.64920399385593e-12}, {"id": 463, "seek": 112306, "start": 1143.78, "end": 1146.32, "text": " This brings us to the concept of state insufficiency.", "tokens": [51401, 639, 5607, 505, 281, 264, 3410, 295, 1785, 1028, 1245, 42081, 13, 51528], "temperature": 0.0, "avg_logprob": -0.12244388461112976, "compression_ratio": 1.5943396226415094, "no_speech_prob": 1.64920399385593e-12}, {"id": 464, "seek": 112306, "start": 1147.22, "end": 1152.1799999999998, "text": " And to explain this, Fliction introduces a rather haunting analogy of a doctor's chart at the", "tokens": [51573, 400, 281, 2903, 341, 11, 3235, 4105, 31472, 257, 2831, 44512, 21663, 295, 257, 4631, 311, 6927, 412, 264, 51821], "temperature": 0.0, "avg_logprob": -0.12244388461112976, "compression_ratio": 1.5943396226415094, "no_speech_prob": 1.64920399385593e-12}, {"id": 465, "seek": 115218, "start": 1152.18, "end": 1153.1000000000001, "text": " end of a hospital bed.", "tokens": [50365, 917, 295, 257, 4530, 2901, 13, 50411], "temperature": 0.0, "avg_logprob": -0.13862440662999306, "compression_ratio": 1.637630662020906, "no_speech_prob": 2.563612950395866e-12}, {"id": 466, "seek": 115218, "start": 1153.18, "end": 1153.9, "text": " Okay, picture this.", "tokens": [50415, 1033, 11, 3036, 341, 13, 50451], "temperature": 0.0, "avg_logprob": -0.13862440662999306, "compression_ratio": 1.637630662020906, "no_speech_prob": 2.563612950395866e-12}, {"id": 467, "seek": 115218, "start": 1154.1200000000001, "end": 1158.5, "text": " You walk into a hospital room and you see a chart monitoring a patient's vital signs.", "tokens": [50462, 509, 1792, 666, 257, 4530, 1808, 293, 291, 536, 257, 6927, 11028, 257, 4537, 311, 11707, 7880, 13, 50681], "temperature": 0.0, "avg_logprob": -0.13862440662999306, "compression_ratio": 1.637630662020906, "no_speech_prob": 2.563612950395866e-12}, {"id": 468, "seek": 115218, "start": 1158.8, "end": 1161.96, "text": " Heart rate, blood pressure, respiratory rate, pupil dilation.", "tokens": [50696, 13569, 3314, 11, 3390, 3321, 11, 27038, 3314, 11, 44533, 11504, 399, 13, 50854], "temperature": 0.0, "avg_logprob": -0.13862440662999306, "compression_ratio": 1.637630662020906, "no_speech_prob": 2.563612950395866e-12}, {"id": 469, "seek": 115218, "start": 1162.14, "end": 1162.96, "text": " The standard stuff.", "tokens": [50863, 440, 3832, 1507, 13, 50904], "temperature": 0.0, "avg_logprob": -0.13862440662999306, "compression_ratio": 1.637630662020906, "no_speech_prob": 2.563612950395866e-12}, {"id": 470, "seek": 115218, "start": 1163.28, "end": 1163.52, "text": " Right.", "tokens": [50920, 1779, 13, 50932], "temperature": 0.0, "avg_logprob": -0.13862440662999306, "compression_ratio": 1.637630662020906, "no_speech_prob": 2.563612950395866e-12}, {"id": 471, "seek": 115218, "start": 1163.8600000000001, "end": 1168.4, "text": " You could have two patients in two different rooms whose numbers on those charts are perfectly", "tokens": [50949, 509, 727, 362, 732, 4209, 294, 732, 819, 9396, 6104, 3547, 322, 729, 17767, 366, 6239, 51176], "temperature": 0.0, "avg_logprob": -0.13862440662999306, "compression_ratio": 1.637630662020906, "no_speech_prob": 2.563612950395866e-12}, {"id": 472, "seek": 115218, "start": 1168.4, "end": 1171.94, "text": " identical, line by line, completely indistinguishable.", "tokens": [51176, 14800, 11, 1622, 538, 1622, 11, 2584, 1016, 468, 7050, 742, 712, 13, 51353], "temperature": 0.0, "avg_logprob": -0.13862440662999306, "compression_ratio": 1.637630662020906, "no_speech_prob": 2.563612950395866e-12}, {"id": 473, "seek": 115218, "start": 1171.94, "end": 1177.42, "text": " But one patient is simply taking a deep nap and the other patient is in an irreversible coma.", "tokens": [51353, 583, 472, 4537, 307, 2935, 1940, 257, 2452, 9296, 293, 264, 661, 4537, 307, 294, 364, 16014, 840, 964, 35106, 13, 51627], "temperature": 0.0, "avg_logprob": -0.13862440662999306, "compression_ratio": 1.637630662020906, "no_speech_prob": 2.563612950395866e-12}, {"id": 474, "seek": 115218, "start": 1177.96, "end": 1178.5600000000002, "text": " Oh, wow.", "tokens": [51654, 876, 11, 6076, 13, 51684], "temperature": 0.0, "avg_logprob": -0.13862440662999306, "compression_ratio": 1.637630662020906, "no_speech_prob": 2.563612950395866e-12}, {"id": 475, "seek": 117856, "start": 1178.56, "end": 1182.2, "text": " Now, the critical thing here is that the chart is not broken.", "tokens": [50365, 823, 11, 264, 4924, 551, 510, 307, 300, 264, 6927, 307, 406, 5463, 13, 50547], "temperature": 0.0, "avg_logprob": -0.13755287995209564, "compression_ratio": 1.7176470588235293, "no_speech_prob": 2.2629539301460833e-12}, {"id": 476, "seek": 117856, "start": 1183.0, "end": 1184.3999999999999, "text": " The chart is not lying.", "tokens": [50587, 440, 6927, 307, 406, 8493, 13, 50657], "temperature": 0.0, "avg_logprob": -0.13755287995209564, "compression_ratio": 1.7176470588235293, "no_speech_prob": 2.2629539301460833e-12}, {"id": 477, "seek": 117856, "start": 1184.58, "end": 1186.46, "text": " The sensors are terrifically calibrated, right?", "tokens": [50666, 440, 14840, 366, 7245, 4278, 21583, 5468, 11, 558, 30, 50760], "temperature": 0.0, "avg_logprob": -0.13755287995209564, "compression_ratio": 1.7176470588235293, "no_speech_prob": 2.2629539301460833e-12}, {"id": 478, "seek": 117856, "start": 1186.52, "end": 1186.9199999999998, "text": " Exactly.", "tokens": [50763, 7587, 13, 50783], "temperature": 0.0, "avg_logprob": -0.13755287995209564, "compression_ratio": 1.7176470588235293, "no_speech_prob": 2.2629539301460833e-12}, {"id": 479, "seek": 117856, "start": 1187.08, "end": 1190.96, "text": " And the numbers are completely accurate regarding the present physical moment of those bodies.", "tokens": [50791, 400, 264, 3547, 366, 2584, 8559, 8595, 264, 1974, 4001, 1623, 295, 729, 7510, 13, 50985], "temperature": 0.0, "avg_logprob": -0.13755287995209564, "compression_ratio": 1.7176470588235293, "no_speech_prob": 2.2629539301460833e-12}, {"id": 480, "seek": 117856, "start": 1191.28, "end": 1197.22, "text": " But mathematically, the text defines that chart as an observation map denoted by the", "tokens": [51001, 583, 44003, 11, 264, 2487, 23122, 300, 6927, 382, 364, 14816, 4471, 1441, 23325, 538, 264, 51298], "temperature": 0.0, "avg_logprob": -0.13755287995209564, "compression_ratio": 1.7176470588235293, "no_speech_prob": 2.2629539301460833e-12}, {"id": 481, "seek": 117856, "start": 1197.22, "end": 1198.1, "text": " Greek letter pi.", "tokens": [51298, 10281, 5063, 3895, 13, 51342], "temperature": 0.0, "avg_logprob": -0.13755287995209564, "compression_ratio": 1.7176470588235293, "no_speech_prob": 2.2629539301460833e-12}, {"id": 482, "seek": 117856, "start": 1198.3, "end": 1198.58, "text": " Right.", "tokens": [51352, 1779, 13, 51366], "temperature": 0.0, "avg_logprob": -0.13755287995209564, "compression_ratio": 1.7176470588235293, "no_speech_prob": 2.2629539301460833e-12}, {"id": 483, "seek": 117856, "start": 1198.84, "end": 1199.3799999999999, "text": " The pi map.", "tokens": [51379, 440, 3895, 4471, 13, 51406], "temperature": 0.0, "avg_logprob": -0.13755287995209564, "compression_ratio": 1.7176470588235293, "no_speech_prob": 2.2629539301460833e-12}, {"id": 484, "seek": 117856, "start": 1199.52, "end": 1204.1599999999999, "text": " And the tragedy is that this observation map, pi, is structurally insufficient.", "tokens": [51413, 400, 264, 18563, 307, 300, 341, 14816, 4471, 11, 3895, 11, 307, 6594, 6512, 41709, 13, 51645], "temperature": 0.0, "avg_logprob": -0.13755287995209564, "compression_ratio": 1.7176470588235293, "no_speech_prob": 2.2629539301460833e-12}, {"id": 485, "seek": 120416, "start": 1204.16, "end": 1209.44, "text": " It is simply not fine-grained enough to capture the massive difference in the possible futures", "tokens": [50365, 467, 307, 2935, 406, 2489, 12, 20735, 2001, 1547, 281, 7983, 264, 5994, 2649, 294, 264, 1944, 26071, 50629], "temperature": 0.0, "avg_logprob": -0.1038271141052246, "compression_ratio": 1.6768060836501901, "no_speech_prob": 1.8540711500814044e-12}, {"id": 486, "seek": 120416, "start": 1209.44, "end": 1210.66, "text": " of those two patients.", "tokens": [50629, 295, 729, 732, 4209, 13, 50690], "temperature": 0.0, "avg_logprob": -0.1038271141052246, "compression_ratio": 1.6768060836501901, "no_speech_prob": 1.8540711500814044e-12}, {"id": 487, "seek": 120416, "start": 1211.0600000000002, "end": 1216.48, "text": " Because the sleeping patient has a continuation space, a tree of futures, that includes waking", "tokens": [50710, 1436, 264, 8296, 4537, 575, 257, 29357, 1901, 11, 257, 4230, 295, 26071, 11, 300, 5974, 20447, 50981], "temperature": 0.0, "avg_logprob": -0.1038271141052246, "compression_ratio": 1.6768060836501901, "no_speech_prob": 1.8540711500814044e-12}, {"id": 488, "seek": 120416, "start": 1216.48, "end": 1220.94, "text": " up in 10 minutes, asking for a glass of water, and walking out of the hospital tomorrow.", "tokens": [50981, 493, 294, 1266, 2077, 11, 3365, 337, 257, 4276, 295, 1281, 11, 293, 4494, 484, 295, 264, 4530, 4153, 13, 51204], "temperature": 0.0, "avg_logprob": -0.1038271141052246, "compression_ratio": 1.6768060836501901, "no_speech_prob": 1.8540711500814044e-12}, {"id": 489, "seek": 120416, "start": 1221.26, "end": 1224.92, "text": " And the comatose patient's continuation space contains none of those branches.", "tokens": [51220, 400, 264, 395, 267, 541, 4537, 311, 29357, 1901, 8306, 6022, 295, 729, 14770, 13, 51403], "temperature": 0.0, "avg_logprob": -0.1038271141052246, "compression_ratio": 1.6768060836501901, "no_speech_prob": 1.8540711500814044e-12}, {"id": 490, "seek": 120416, "start": 1225.3200000000002, "end": 1228.68, "text": " Their topological futures are entirely alien to one another.", "tokens": [51423, 6710, 1192, 4383, 26071, 366, 7696, 12319, 281, 472, 1071, 13, 51591], "temperature": 0.0, "avg_logprob": -0.1038271141052246, "compression_ratio": 1.6768060836501901, "no_speech_prob": 1.8540711500814044e-12}, {"id": 491, "seek": 122868, "start": 1228.68, "end": 1234.28, "text": " So the observation map, the chart, is insufficient because it lumps two states together that have", "tokens": [50365, 407, 264, 14816, 4471, 11, 264, 6927, 11, 307, 41709, 570, 309, 44948, 732, 4368, 1214, 300, 362, 50645], "temperature": 0.0, "avg_logprob": -0.09314180121702306, "compression_ratio": 1.6633986928104576, "no_speech_prob": 1.721187862374629e-12}, {"id": 492, "seek": 122868, "start": 1234.28, "end": 1235.68, "text": " totally different destinies.", "tokens": [50645, 3879, 819, 40254, 530, 13, 50715], "temperature": 0.0, "avg_logprob": -0.09314180121702306, "compression_ratio": 1.6633986928104576, "no_speech_prob": 1.721187862374629e-12}, {"id": 493, "seek": 122868, "start": 1235.8, "end": 1237.98, "text": " It forces a false gamma equivalence.", "tokens": [50721, 467, 5874, 257, 7908, 15546, 9052, 655, 13, 50830], "temperature": 0.0, "avg_logprob": -0.09314180121702306, "compression_ratio": 1.6633986928104576, "no_speech_prob": 1.721187862374629e-12}, {"id": 494, "seek": 122868, "start": 1238.38, "end": 1241.96, "text": " And if we pull this back to the traffic light, we realize we do this every time we open our", "tokens": [50850, 400, 498, 321, 2235, 341, 646, 281, 264, 6419, 1442, 11, 321, 4325, 321, 360, 341, 633, 565, 321, 1269, 527, 51029], "temperature": 0.0, "avg_logprob": -0.09314180121702306, "compression_ratio": 1.6633986928104576, "no_speech_prob": 1.721187862374629e-12}, {"id": 495, "seek": 122868, "start": 1241.96, "end": 1242.3200000000002, "text": " mouths.", "tokens": [51029, 33171, 13, 51047], "temperature": 0.0, "avg_logprob": -0.09314180121702306, "compression_ratio": 1.6633986928104576, "no_speech_prob": 1.721187862374629e-12}, {"id": 496, "seek": 122868, "start": 1242.6000000000001, "end": 1243.38, "text": " We really do.", "tokens": [51061, 492, 534, 360, 13, 51100], "temperature": 0.0, "avg_logprob": -0.09314180121702306, "compression_ratio": 1.6633986928104576, "no_speech_prob": 1.721187862374629e-12}, {"id": 497, "seek": 122868, "start": 1243.5800000000002, "end": 1247.1200000000001, "text": " When you and I are on the phone and I say, hey, I'm going to be late, I'm waiting at a", "tokens": [51110, 1133, 291, 293, 286, 366, 322, 264, 2593, 293, 286, 584, 11, 4177, 11, 286, 478, 516, 281, 312, 3469, 11, 286, 478, 3806, 412, 257, 51287], "temperature": 0.0, "avg_logprob": -0.09314180121702306, "compression_ratio": 1.6633986928104576, "no_speech_prob": 1.721187862374629e-12}, {"id": 498, "seek": 122868, "start": 1247.1200000000001, "end": 1251.66, "text": " red light, I am using a semantic category, a word.", "tokens": [51287, 2182, 1442, 11, 286, 669, 1228, 257, 47982, 7719, 11, 257, 1349, 13, 51514], "temperature": 0.0, "avg_logprob": -0.09314180121702306, "compression_ratio": 1.6633986928104576, "no_speech_prob": 1.721187862374629e-12}, {"id": 499, "seek": 122868, "start": 1251.98, "end": 1257.16, "text": " But by using that word, I am literally throwing away the future for the sake of conversation.", "tokens": [51530, 583, 538, 1228, 300, 1349, 11, 286, 669, 3736, 10238, 1314, 264, 2027, 337, 264, 9717, 295, 3761, 13, 51789], "temperature": 0.0, "avg_logprob": -0.09314180121702306, "compression_ratio": 1.6633986928104576, "no_speech_prob": 1.721187862374629e-12}, {"id": 500, "seek": 125716, "start": 1257.16, "end": 1262.3000000000002, "text": " You are, because waiting at a red light throws away exactly what second of the cycle you", "tokens": [50365, 509, 366, 11, 570, 3806, 412, 257, 2182, 1442, 19251, 1314, 2293, 437, 1150, 295, 264, 6586, 291, 50622], "temperature": 0.0, "avg_logprob": -0.0941488682722845, "compression_ratio": 1.6632302405498283, "no_speech_prob": 1.4839878458017264e-12}, {"id": 501, "seek": 125716, "start": 1262.3000000000002, "end": 1262.66, "text": " are in.", "tokens": [50622, 366, 294, 13, 50640], "temperature": 0.0, "avg_logprob": -0.0941488682722845, "compression_ratio": 1.6632302405498283, "no_speech_prob": 1.4839878458017264e-12}, {"id": 502, "seek": 125716, "start": 1262.76, "end": 1262.94, "text": " Right.", "tokens": [50645, 1779, 13, 50654], "temperature": 0.0, "avg_logprob": -0.0941488682722845, "compression_ratio": 1.6632302405498283, "no_speech_prob": 1.4839878458017264e-12}, {"id": 503, "seek": 125716, "start": 1263.1200000000001, "end": 1264.88, "text": " It throws away how many cars are ahead of me.", "tokens": [50663, 467, 19251, 1314, 577, 867, 5163, 366, 2286, 295, 385, 13, 50751], "temperature": 0.0, "avg_logprob": -0.0941488682722845, "compression_ratio": 1.6632302405498283, "no_speech_prob": 1.4839878458017264e-12}, {"id": 504, "seek": 125716, "start": 1264.98, "end": 1268.16, "text": " It throws away whether a pedestrian just pressed the crosswalk button.", "tokens": [50756, 467, 19251, 1314, 1968, 257, 33947, 445, 17355, 264, 3278, 12490, 2960, 13, 50915], "temperature": 0.0, "avg_logprob": -0.0941488682722845, "compression_ratio": 1.6632302405498283, "no_speech_prob": 1.4839878458017264e-12}, {"id": 505, "seek": 125716, "start": 1268.3600000000001, "end": 1274.5, "text": " The text proves that ordinary semantic categories, the very foundations of human language, are", "tokens": [50925, 440, 2487, 25019, 300, 10547, 47982, 10479, 11, 264, 588, 22467, 295, 1952, 2856, 11, 366, 51232], "temperature": 0.0, "avg_logprob": -0.0941488682722845, "compression_ratio": 1.6632302405498283, "no_speech_prob": 1.4839878458017264e-12}, {"id": 506, "seek": 125716, "start": 1274.5, "end": 1277.52, "text": " vastly coarser than exact future equivalents.", "tokens": [51232, 41426, 598, 685, 260, 813, 1900, 2027, 9052, 791, 13, 51383], "temperature": 0.0, "avg_logprob": -0.0941488682722845, "compression_ratio": 1.6632302405498283, "no_speech_prob": 1.4839878458017264e-12}, {"id": 507, "seek": 125716, "start": 1277.7, "end": 1282.7, "text": " So language itself is just a massive exercise in distinction loss.", "tokens": [51392, 407, 2856, 2564, 307, 445, 257, 5994, 5380, 294, 16844, 4470, 13, 51642], "temperature": 0.0, "avg_logprob": -0.0941488682722845, "compression_ratio": 1.6632302405498283, "no_speech_prob": 1.4839878458017264e-12}, {"id": 508, "seek": 125716, "start": 1282.8400000000001, "end": 1284.5800000000002, "text": " It is mathematically necessary.", "tokens": [51649, 467, 307, 44003, 4818, 13, 51736], "temperature": 0.0, "avg_logprob": -0.0941488682722845, "compression_ratio": 1.6632302405498283, "no_speech_prob": 1.4839878458017264e-12}, {"id": 509, "seek": 125716, "start": 1284.8000000000002, "end": 1286.1000000000001, "text": " I mean, think about it.", "tokens": [51747, 286, 914, 11, 519, 466, 309, 13, 51812], "temperature": 0.0, "avg_logprob": -0.0941488682722845, "compression_ratio": 1.6632302405498283, "no_speech_prob": 1.4839878458017264e-12}, {"id": 510, "seek": 128610, "start": 1286.1, "end": 1290.78, "text": " If we lived in a world where we demanded that two situations must have the exact same", "tokens": [50365, 759, 321, 5152, 294, 257, 1002, 689, 321, 28276, 300, 732, 6851, 1633, 362, 264, 1900, 912, 50599], "temperature": 0.0, "avg_logprob": -0.10209979651109227, "compression_ratio": 1.6982456140350877, "no_speech_prob": 1.4664787396576062e-12}, {"id": 511, "seek": 128610, "start": 1290.78, "end": 1295.4199999999998, "text": " mathematical future in order to share a name, human language would instantly collapse.", "tokens": [50599, 18894, 2027, 294, 1668, 281, 2073, 257, 1315, 11, 1952, 2856, 576, 13518, 15584, 13, 50831], "temperature": 0.0, "avg_logprob": -0.10209979651109227, "compression_ratio": 1.6982456140350877, "no_speech_prob": 1.4664787396576062e-12}, {"id": 512, "seek": 128610, "start": 1295.78, "end": 1297.6799999999998, "text": " Because nothing is exactly the same.", "tokens": [50849, 1436, 1825, 307, 2293, 264, 912, 13, 50944], "temperature": 0.0, "avg_logprob": -0.10209979651109227, "compression_ratio": 1.6982456140350877, "no_speech_prob": 1.4664787396576062e-12}, {"id": 513, "seek": 128610, "start": 1297.8, "end": 1297.98, "text": " Right.", "tokens": [50950, 1779, 13, 50959], "temperature": 0.0, "avg_logprob": -0.10209979651109227, "compression_ratio": 1.6982456140350877, "no_speech_prob": 1.4664787396576062e-12}, {"id": 514, "seek": 128610, "start": 1298.1599999999999, "end": 1302.34, "text": " You could never use the phrase red light again because no two red lights in the history of", "tokens": [50968, 509, 727, 1128, 764, 264, 9535, 2182, 1442, 797, 570, 572, 732, 2182, 5811, 294, 264, 2503, 295, 51177], "temperature": 0.0, "avg_logprob": -0.10209979651109227, "compression_ratio": 1.6982456140350877, "no_speech_prob": 1.4664787396576062e-12}, {"id": 515, "seek": 128610, "start": 1302.34, "end": 1307.3, "text": " the universe have ever shared the exact same microscopic continuation space of approaching", "tokens": [51177, 264, 6445, 362, 1562, 5507, 264, 1900, 912, 47897, 29357, 1901, 295, 14908, 51425], "temperature": 0.0, "avg_logprob": -0.10209979651109227, "compression_ratio": 1.6982456140350877, "no_speech_prob": 1.4664787396576062e-12}, {"id": 516, "seek": 128610, "start": 1307.3, "end": 1310.1999999999998, "text": " cars, weather conditions, and waiting pedestrians.", "tokens": [51425, 5163, 11, 5503, 4487, 11, 293, 3806, 48339, 13, 51570], "temperature": 0.0, "avg_logprob": -0.10209979651109227, "compression_ratio": 1.6982456140350877, "no_speech_prob": 1.4664787396576062e-12}, {"id": 517, "seek": 128610, "start": 1310.4199999999998, "end": 1312.1, "text": " So meaning itself is a compromise.", "tokens": [51581, 407, 3620, 2564, 307, 257, 18577, 13, 51665], "temperature": 0.0, "avg_logprob": -0.10209979651109227, "compression_ratio": 1.6982456140350877, "no_speech_prob": 1.4664787396576062e-12}, {"id": 518, "seek": 131210, "start": 1312.1, "end": 1317.1, "text": " Meaning is fundamentally a known measurable loss of distinction.", "tokens": [50365, 19948, 307, 17879, 257, 2570, 43615, 4470, 295, 16844, 13, 50615], "temperature": 0.0, "avg_logprob": -0.1669963679901541, "compression_ratio": 1.495, "no_speech_prob": 1.9276336169632424e-12}, {"id": 519, "seek": 131210, "start": 1317.78, "end": 1318.6799999999998, "text": " That's wild.", "tokens": [50649, 663, 311, 4868, 13, 50694], "temperature": 0.0, "avg_logprob": -0.1669963679901541, "compression_ratio": 1.495, "no_speech_prob": 1.9276336169632424e-12}, {"id": 520, "seek": 131210, "start": 1318.9599999999998, "end": 1322.82, "text": " In order to communicate with each other, we have to voluntarily commit distinction loss.", "tokens": [50708, 682, 1668, 281, 7890, 365, 1184, 661, 11, 321, 362, 281, 41782, 5599, 16844, 4470, 13, 50901], "temperature": 0.0, "avg_logprob": -0.1669963679901541, "compression_ratio": 1.495, "no_speech_prob": 1.9276336169632424e-12}, {"id": 521, "seek": 131210, "start": 1323.28, "end": 1327.86, "text": " We have to agree to ignore the branches of the future that we just don't care about.", "tokens": [50924, 492, 362, 281, 3986, 281, 11200, 264, 14770, 295, 264, 2027, 300, 321, 445, 500, 380, 1127, 466, 13, 51153], "temperature": 0.0, "avg_logprob": -0.1669963679901541, "compression_ratio": 1.495, "no_speech_prob": 1.9276336169632424e-12}, {"id": 522, "seek": 131210, "start": 1328.04, "end": 1330.36, "text": " But Fliction tries to soften this a bit, right?", "tokens": [51162, 583, 3235, 4105, 9898, 281, 31356, 341, 257, 857, 11, 558, 30, 51278], "temperature": 0.0, "avg_logprob": -0.1669963679901541, "compression_ratio": 1.495, "no_speech_prob": 1.9276336169632424e-12}, {"id": 523, "seek": 133036, "start": 1330.36, "end": 1333.0, "text": " By introducing G-equivalence.", "tokens": [50365, 3146, 15424, 460, 12, 12816, 3576, 655, 13, 50497], "temperature": 0.0, "avg_logprob": -0.20891801366266213, "compression_ratio": 1.6213991769547325, "no_speech_prob": 1.9891256610587993e-12}, {"id": 524, "seek": 133036, "start": 1333.0, "end": 1339.4399999999998, "text": " Yeah, G-equivalence looks for broader structural symmetries instead of demanding exact pixel-perfect", "tokens": [50497, 865, 11, 460, 12, 12816, 3576, 655, 1542, 337, 13227, 15067, 14232, 302, 2244, 2602, 295, 19960, 1900, 19261, 12, 610, 1836, 50819], "temperature": 0.0, "avg_logprob": -0.20891801366266213, "compression_ratio": 1.6213991769547325, "no_speech_prob": 1.9891256610587993e-12}, {"id": 525, "seek": 133036, "start": 1339.4399999999998, "end": 1339.9199999999998, "text": " matches.", "tokens": [50819, 10676, 13, 50843], "temperature": 0.0, "avg_logprob": -0.20891801366266213, "compression_ratio": 1.6213991769547325, "no_speech_prob": 1.9891256610587993e-12}, {"id": 526, "seek": 133036, "start": 1340.74, "end": 1343.82, "text": " But even G-equivalence is often too strict for everyday language.", "tokens": [50884, 583, 754, 460, 12, 12816, 3576, 655, 307, 2049, 886, 10910, 337, 7429, 2856, 13, 51038], "temperature": 0.0, "avg_logprob": -0.20891801366266213, "compression_ratio": 1.6213991769547325, "no_speech_prob": 1.9891256610587993e-12}, {"id": 527, "seek": 133036, "start": 1343.9199999999998, "end": 1344.4799999999998, "text": " So what do we do?", "tokens": [51043, 407, 437, 360, 321, 360, 30, 51071], "temperature": 0.0, "avg_logprob": -0.20891801366266213, "compression_ratio": 1.6213991769547325, "no_speech_prob": 1.9891256610587993e-12}, {"id": 528, "seek": 133036, "start": 1344.76, "end": 1349.5, "text": " We build categories specifically as trash cans for the futures we find irrelevant.", "tokens": [51085, 492, 1322, 10479, 4682, 382, 11321, 21835, 337, 264, 26071, 321, 915, 28682, 13, 51322], "temperature": 0.0, "avg_logprob": -0.20891801366266213, "compression_ratio": 1.6213991769547325, "no_speech_prob": 1.9891256610587993e-12}, {"id": 529, "seek": 133036, "start": 1349.8999999999999, "end": 1350.3999999999999, "text": " Wow.", "tokens": [51342, 3153, 13, 51367], "temperature": 0.0, "avg_logprob": -0.20891801366266213, "compression_ratio": 1.6213991769547325, "no_speech_prob": 1.9891256610587993e-12}, {"id": 530, "seek": 133036, "start": 1350.9399999999998, "end": 1354.06, "text": " Words as trash cans for irrelevant futures.", "tokens": [51394, 32857, 382, 11321, 21835, 337, 28682, 26071, 13, 51550], "temperature": 0.0, "avg_logprob": -0.20891801366266213, "compression_ratio": 1.6213991769547325, "no_speech_prob": 1.9891256610587993e-12}, {"id": 531, "seek": 133036, "start": 1354.3999999999999, "end": 1356.1399999999999, "text": " I want you to really internalize this.", "tokens": [51567, 286, 528, 291, 281, 534, 6920, 1125, 341, 13, 51654], "temperature": 0.0, "avg_logprob": -0.20891801366266213, "compression_ratio": 1.6213991769547325, "no_speech_prob": 1.9891256610587993e-12}, {"id": 532, "seek": 135614, "start": 1356.14, "end": 1360.14, "text": " Think about the doctor's charts that you rely on in your own work or your own life.", "tokens": [50365, 6557, 466, 264, 4631, 311, 17767, 300, 291, 10687, 322, 294, 428, 1065, 589, 420, 428, 1065, 993, 13, 50565], "temperature": 0.0, "avg_logprob": -0.13511931511663622, "compression_ratio": 1.5317460317460319, "no_speech_prob": 1.7858867596559636e-12}, {"id": 533, "seek": 135614, "start": 1360.5600000000002, "end": 1366.46, "text": " Like a KPI dashboard at the office, a weekly summary report, a credit score, a grade on", "tokens": [50586, 1743, 257, 591, 31701, 18342, 412, 264, 3398, 11, 257, 12460, 12691, 2275, 11, 257, 5397, 6175, 11, 257, 7204, 322, 50881], "temperature": 0.0, "avg_logprob": -0.13511931511663622, "compression_ratio": 1.5317460317460319, "no_speech_prob": 1.7858867596559636e-12}, {"id": 534, "seek": 135614, "start": 1366.46, "end": 1366.98, "text": " a test.", "tokens": [50881, 257, 1500, 13, 50907], "temperature": 0.0, "avg_logprob": -0.13511931511663622, "compression_ratio": 1.5317460317460319, "no_speech_prob": 1.7858867596559636e-12}, {"id": 535, "seek": 135614, "start": 1367.16, "end": 1367.64, "text": " Exactly.", "tokens": [50916, 7587, 13, 50940], "temperature": 0.0, "avg_logprob": -0.13511931511663622, "compression_ratio": 1.5317460317460319, "no_speech_prob": 1.7858867596559636e-12}, {"id": 536, "seek": 135614, "start": 1368.3000000000002, "end": 1373.9, "text": " What critical future branching variables are totally invisible on that dashboard?", "tokens": [50973, 708, 4924, 2027, 9819, 278, 9102, 366, 3879, 14603, 322, 300, 18342, 30, 51253], "temperature": 0.0, "avg_logprob": -0.13511931511663622, "compression_ratio": 1.5317460317460319, "no_speech_prob": 1.7858867596559636e-12}, {"id": 537, "seek": 135614, "start": 1374.1000000000001, "end": 1374.7800000000002, "text": " Probably a lot of them.", "tokens": [51263, 9210, 257, 688, 295, 552, 13, 51297], "temperature": 0.0, "avg_logprob": -0.13511931511663622, "compression_ratio": 1.5317460317460319, "no_speech_prob": 1.7858867596559636e-12}, {"id": 538, "seek": 135614, "start": 1375.2800000000002, "end": 1379.5, "text": " Your project management software might say two different initiatives are both labeled green", "tokens": [51322, 2260, 1716, 4592, 4722, 1062, 584, 732, 819, 16194, 366, 1293, 21335, 3092, 51533], "temperature": 0.0, "avg_logprob": -0.13511931511663622, "compression_ratio": 1.5317460317460319, "no_speech_prob": 1.7858867596559636e-12}, {"id": 539, "seek": 137950, "start": 1379.5, "end": 1386.28, "text": " on track, but one project is cruising on autopilot with a brilliant team, and the other project", "tokens": [50365, 322, 2837, 11, 457, 472, 1716, 307, 42180, 322, 31090, 31516, 365, 257, 10248, 1469, 11, 293, 264, 661, 1716, 50704], "temperature": 0.0, "avg_logprob": -0.1300625299152575, "compression_ratio": 1.6952054794520548, "no_speech_prob": 1.7147351247248643e-12}, {"id": 540, "seek": 137950, "start": 1386.28, "end": 1391.18, "text": " is a ticking time bomb of technical debt being held together by one stressed-out employee.", "tokens": [50704, 307, 257, 33999, 565, 7851, 295, 6191, 7831, 885, 5167, 1214, 538, 472, 14471, 12, 346, 10738, 13, 50949], "temperature": 0.0, "avg_logprob": -0.1300625299152575, "compression_ratio": 1.6952054794520548, "no_speech_prob": 1.7147351247248643e-12}, {"id": 541, "seek": 137950, "start": 1391.56, "end": 1393.66, "text": " And the dashboard is completely state-insufficient.", "tokens": [50968, 400, 264, 18342, 307, 2584, 1785, 12, 1292, 30664, 13, 51073], "temperature": 0.0, "avg_logprob": -0.1300625299152575, "compression_ratio": 1.6952054794520548, "no_speech_prob": 1.7147351247248643e-12}, {"id": 542, "seek": 137950, "start": 1394.08, "end": 1398.12, "text": " It is a semantic compromise that is hiding a collapsed future from you.", "tokens": [51094, 467, 307, 257, 47982, 18577, 300, 307, 10596, 257, 24578, 2027, 490, 291, 13, 51296], "temperature": 0.0, "avg_logprob": -0.1300625299152575, "compression_ratio": 1.6952054794520548, "no_speech_prob": 1.7147351247248643e-12}, {"id": 543, "seek": 137950, "start": 1398.66, "end": 1403.26, "text": " Acknowledging that your dashboard is insufficient is just the first step to surviving a complex", "tokens": [51323, 316, 7678, 1493, 3249, 300, 428, 18342, 307, 41709, 307, 445, 264, 700, 1823, 281, 24948, 257, 3997, 51553], "temperature": 0.0, "avg_logprob": -0.1300625299152575, "compression_ratio": 1.6952054794520548, "no_speech_prob": 1.7147351247248643e-12}, {"id": 544, "seek": 137950, "start": 1403.26, "end": 1407.22, "text": " system, but the text introduces a terrifying secondary problem.", "tokens": [51553, 1185, 11, 457, 264, 2487, 31472, 257, 18106, 11396, 1154, 13, 51751], "temperature": 0.0, "avg_logprob": -0.1300625299152575, "compression_ratio": 1.6952054794520548, "no_speech_prob": 1.7147351247248643e-12}, {"id": 545, "seek": 137950, "start": 1407.34, "end": 1408.24, "text": " Oh great, it gets worse.", "tokens": [51757, 876, 869, 11, 309, 2170, 5324, 13, 51802], "temperature": 0.0, "avg_logprob": -0.1300625299152575, "compression_ratio": 1.6952054794520548, "no_speech_prob": 1.7147351247248643e-12}, {"id": 546, "seek": 140824, "start": 1408.24, "end": 1409.6, "text": " You can have a perfect dashboard.", "tokens": [50365, 509, 393, 362, 257, 2176, 18342, 13, 50433], "temperature": 0.0, "avg_logprob": -0.16058011018028556, "compression_ratio": 1.7413793103448276, "no_speech_prob": 1.661731949959e-12}, {"id": 547, "seek": 140824, "start": 1409.92, "end": 1412.68, "text": " You can have an observation map that loses zero distinction.", "tokens": [50449, 509, 393, 362, 364, 14816, 4471, 300, 18293, 4018, 16844, 13, 50587], "temperature": 0.0, "avg_logprob": -0.16058011018028556, "compression_ratio": 1.7413793103448276, "no_speech_prob": 1.661731949959e-12}, {"id": 548, "seek": 140824, "start": 1413.46, "end": 1418.72, "text": " And it can still be completely, utterly useless to you because it is infected by time or because", "tokens": [50626, 400, 309, 393, 920, 312, 2584, 11, 30251, 14115, 281, 291, 570, 309, 307, 15414, 538, 565, 420, 570, 50889], "temperature": 0.0, "avg_logprob": -0.16058011018028556, "compression_ratio": 1.7413793103448276, "no_speech_prob": 1.661731949959e-12}, {"id": 549, "seek": 140824, "start": 1418.72, "end": 1420.56, "text": " it's mapping the wrong universe entirely.", "tokens": [50889, 309, 311, 18350, 264, 2085, 6445, 7696, 13, 50981], "temperature": 0.0, "avg_logprob": -0.16058011018028556, "compression_ratio": 1.7413793103448276, "no_speech_prob": 1.661731949959e-12}, {"id": 550, "seek": 140824, "start": 1420.76, "end": 1422.38, "text": " Ah, the scouting report analogy.", "tokens": [50991, 2438, 11, 264, 795, 24500, 2275, 21663, 13, 51072], "temperature": 0.0, "avg_logprob": -0.16058011018028556, "compression_ratio": 1.7413793103448276, "no_speech_prob": 1.661731949959e-12}, {"id": 551, "seek": 140824, "start": 1422.8, "end": 1425.64, "text": " This part of the book completely rewired how I think about data.", "tokens": [51093, 639, 644, 295, 264, 1446, 2584, 319, 86, 1824, 577, 286, 519, 466, 1412, 13, 51235], "temperature": 0.0, "avg_logprob": -0.16058011018028556, "compression_ratio": 1.7413793103448276, "no_speech_prob": 1.661731949959e-12}, {"id": 552, "seek": 140824, "start": 1425.74, "end": 1426.36, "text": " It's so good.", "tokens": [51240, 467, 311, 370, 665, 13, 51271], "temperature": 0.0, "avg_logprob": -0.16058011018028556, "compression_ratio": 1.7413793103448276, "no_speech_prob": 1.661731949959e-12}, {"id": 553, "seek": 140824, "start": 1426.6200000000001, "end": 1432.16, "text": " A scouting report sent back from the front lines can fail you for two completely distinct mathematical", "tokens": [51284, 316, 795, 24500, 2275, 2279, 646, 490, 264, 1868, 3876, 393, 3061, 291, 337, 732, 2584, 10644, 18894, 51561], "temperature": 0.0, "avg_logprob": -0.16058011018028556, "compression_ratio": 1.7413793103448276, "no_speech_prob": 1.661731949959e-12}, {"id": 554, "seek": 140824, "start": 1432.16, "end": 1432.76, "text": " reasons.", "tokens": [51561, 4112, 13, 51591], "temperature": 0.0, "avg_logprob": -0.16058011018028556, "compression_ratio": 1.7413793103448276, "no_speech_prob": 1.661731949959e-12}, {"id": 555, "seek": 140824, "start": 1433.24, "end": 1435.66, "text": " Reason number one, staleness.", "tokens": [51615, 39693, 1230, 472, 11, 49875, 15264, 13, 51736], "temperature": 0.0, "avg_logprob": -0.16058011018028556, "compression_ratio": 1.7413793103448276, "no_speech_prob": 1.661731949959e-12}, {"id": 556, "seek": 140824, "start": 1435.82, "end": 1436.92, "text": " Right, staleness.", "tokens": [51744, 1779, 11, 49875, 15264, 13, 51799], "temperature": 0.0, "avg_logprob": -0.16058011018028556, "compression_ratio": 1.7413793103448276, "no_speech_prob": 1.661731949959e-12}, {"id": 557, "seek": 143692, "start": 1436.92, "end": 1443.28, "text": " The scout climbed a hill, looked down, and reported the enemy's position with 100% accuracy.", "tokens": [50365, 440, 34392, 28691, 257, 10997, 11, 2956, 760, 11, 293, 7055, 264, 5945, 311, 2535, 365, 2319, 4, 14170, 13, 50683], "temperature": 0.0, "avg_logprob": -0.1853395519834576, "compression_ratio": 1.4915254237288136, "no_speech_prob": 1.9430435992812134e-12}, {"id": 558, "seek": 143692, "start": 1443.48, "end": 1444.5800000000002, "text": " But that was three days ago.", "tokens": [50693, 583, 300, 390, 1045, 1708, 2057, 13, 50748], "temperature": 0.0, "avg_logprob": -0.1853395519834576, "compression_ratio": 1.4915254237288136, "no_speech_prob": 1.9430435992812134e-12}, {"id": 559, "seek": 143692, "start": 1444.8000000000002, "end": 1445.2, "text": " Exactly.", "tokens": [50759, 7587, 13, 50779], "temperature": 0.0, "avg_logprob": -0.1853395519834576, "compression_ratio": 1.4915254237288136, "no_speech_prob": 1.9430435992812134e-12}, {"id": 560, "seek": 143692, "start": 1445.64, "end": 1448.1200000000001, "text": " The enemy has marched 20 miles since then.", "tokens": [50801, 440, 5945, 575, 43565, 945, 6193, 1670, 550, 13, 50925], "temperature": 0.0, "avg_logprob": -0.1853395519834576, "compression_ratio": 1.4915254237288136, "no_speech_prob": 1.9430435992812134e-12}, {"id": 561, "seek": 143692, "start": 1448.28, "end": 1450.04, "text": " Your perfect map is just old.", "tokens": [50933, 2260, 2176, 4471, 307, 445, 1331, 13, 51021], "temperature": 0.0, "avg_logprob": -0.1853395519834576, "compression_ratio": 1.4915254237288136, "no_speech_prob": 1.9430435992812134e-12}, {"id": 562, "seek": 143692, "start": 1450.3600000000001, "end": 1452.28, "text": " But reason number two is much more insidious.", "tokens": [51037, 583, 1778, 1230, 732, 307, 709, 544, 1028, 327, 851, 13, 51133], "temperature": 0.0, "avg_logprob": -0.1853395519834576, "compression_ratio": 1.4915254237288136, "no_speech_prob": 1.9430435992812134e-12}, {"id": 563, "seek": 143692, "start": 1452.76, "end": 1453.28, "text": " What is it?", "tokens": [51157, 708, 307, 309, 30, 51183], "temperature": 0.0, "avg_logprob": -0.1853395519834576, "compression_ratio": 1.4915254237288136, "no_speech_prob": 1.9430435992812134e-12}, {"id": 564, "seek": 143692, "start": 1453.5600000000002, "end": 1455.04, "text": " The scout's map isn't old.", "tokens": [51197, 440, 34392, 311, 4471, 1943, 380, 1331, 13, 51271], "temperature": 0.0, "avg_logprob": -0.1853395519834576, "compression_ratio": 1.4915254237288136, "no_speech_prob": 1.9430435992812134e-12}, {"id": 565, "seek": 143692, "start": 1455.66, "end": 1458.9, "text": " The scout surveyed a completely disconnected region of reality.", "tokens": [51302, 440, 34392, 8984, 292, 257, 2584, 29426, 4458, 295, 4103, 13, 51464], "temperature": 0.0, "avg_logprob": -0.1853395519834576, "compression_ratio": 1.4915254237288136, "no_speech_prob": 1.9430435992812134e-12}, {"id": 566, "seek": 145890, "start": 1458.9, "end": 1463.48, "text": " The book calls this an invariant decomposition or an invariant block.", "tokens": [50365, 440, 1446, 5498, 341, 364, 33270, 394, 48356, 420, 364, 33270, 394, 3461, 13, 50594], "temperature": 0.0, "avg_logprob": -0.15869259577925487, "compression_ratio": 1.5769230769230769, "no_speech_prob": 1.7691691210977578e-12}, {"id": 567, "seek": 145890, "start": 1463.8600000000001, "end": 1467.5600000000002, "text": " Let's dig into the math of staleness first because it's not just a flat line of error,", "tokens": [50613, 961, 311, 2528, 666, 264, 5221, 295, 49875, 15264, 700, 570, 309, 311, 406, 445, 257, 4962, 1622, 295, 6713, 11, 50798], "temperature": 0.0, "avg_logprob": -0.15869259577925487, "compression_ratio": 1.5769230769230769, "no_speech_prob": 1.7691691210977578e-12}, {"id": 568, "seek": 145890, "start": 1467.68, "end": 1467.8400000000001, "text": " right?", "tokens": [50804, 558, 30, 50812], "temperature": 0.0, "avg_logprob": -0.15869259577925487, "compression_ratio": 1.5769230769230769, "no_speech_prob": 1.7691691210977578e-12}, {"id": 569, "seek": 145890, "start": 1467.9, "end": 1468.8200000000002, "text": " It compounds.", "tokens": [50815, 467, 21810, 13, 50861], "temperature": 0.0, "avg_logprob": -0.15869259577925487, "compression_ratio": 1.5769230769230769, "no_speech_prob": 1.7691691210977578e-12}, {"id": 570, "seek": 145890, "start": 1469.22, "end": 1470.68, "text": " Staleness grows exponentially.", "tokens": [50881, 745, 304, 15264, 13156, 37330, 13, 50954], "temperature": 0.0, "avg_logprob": -0.15869259577925487, "compression_ratio": 1.5769230769230769, "no_speech_prob": 1.7691691210977578e-12}, {"id": 571, "seek": 145890, "start": 1471.3400000000001, "end": 1474.4, "text": " Fliction proves this using the Grunewald inequality bound.", "tokens": [50987, 3235, 4105, 25019, 341, 1228, 264, 2606, 409, 1023, 3976, 16970, 5472, 13, 51140], "temperature": 0.0, "avg_logprob": -0.15869259577925487, "compression_ratio": 1.5769230769230769, "no_speech_prob": 1.7691691210977578e-12}, {"id": 572, "seek": 145890, "start": 1474.5600000000002, "end": 1476.24, "text": " The Grunewald inequality bound.", "tokens": [51148, 440, 2606, 409, 1023, 3976, 16970, 5472, 13, 51232], "temperature": 0.0, "avg_logprob": -0.15869259577925487, "compression_ratio": 1.5769230769230769, "no_speech_prob": 1.7691691210977578e-12}, {"id": 573, "seek": 145890, "start": 1476.3400000000001, "end": 1477.3600000000001, "text": " Okay, spell that out for me.", "tokens": [51237, 1033, 11, 9827, 300, 484, 337, 385, 13, 51288], "temperature": 0.0, "avg_logprob": -0.15869259577925487, "compression_ratio": 1.5769230769230769, "no_speech_prob": 1.7691691210977578e-12}, {"id": 574, "seek": 147736, "start": 1477.36, "end": 1481.24, "text": " It's an equation that basically states that the distance between your stale observation", "tokens": [50365, 467, 311, 364, 5367, 300, 1936, 4368, 300, 264, 4560, 1296, 428, 342, 1220, 14816, 50559], "temperature": 0.0, "avg_logprob": -0.11010359800778903, "compression_ratio": 1.5034482758620689, "no_speech_prob": 1.6161229255892695e-12}, {"id": 575, "seek": 147736, "start": 1481.24, "end": 1487.78, "text": " data and the true currently evolving reality of the system grows at a rate of e to the", "tokens": [50559, 1412, 293, 264, 2074, 4362, 21085, 4103, 295, 264, 1185, 13156, 412, 257, 3314, 295, 308, 281, 264, 50886], "temperature": 0.0, "avg_logprob": -0.11010359800778903, "compression_ratio": 1.5034482758620689, "no_speech_prob": 1.6161229255892695e-12}, {"id": 576, "seek": 147736, "start": 1487.78, "end": 1490.36, "text": " power of a constant times the elapsed time.", "tokens": [50886, 1347, 295, 257, 5754, 1413, 264, 806, 2382, 292, 565, 13, 51015], "temperature": 0.0, "avg_logprob": -0.11010359800778903, "compression_ratio": 1.5034482758620689, "no_speech_prob": 1.6161229255892695e-12}, {"id": 577, "seek": 149036, "start": 1490.36, "end": 1495.06, "text": " Okay, I see the formula on the page, the d0 times e to the l delta t.", "tokens": [50365, 1033, 11, 286, 536, 264, 8513, 322, 264, 3028, 11, 264, 274, 15, 1413, 308, 281, 264, 287, 8289, 256, 13, 50600], "temperature": 0.0, "avg_logprob": -0.12776763222434304, "compression_ratio": 1.624031007751938, "no_speech_prob": 1.6881516800779095e-12}, {"id": 578, "seek": 149036, "start": 1495.76, "end": 1498.1, "text": " But physically, what does that actually mean?", "tokens": [50635, 583, 9762, 11, 437, 775, 300, 767, 914, 30, 50752], "temperature": 0.0, "avg_logprob": -0.12776763222434304, "compression_ratio": 1.624031007751938, "no_speech_prob": 1.6881516800779095e-12}, {"id": 579, "seek": 149036, "start": 1498.3999999999999, "end": 1502.5, "text": " Why is it exponential and not just a straight line of them walking away?", "tokens": [50767, 1545, 307, 309, 21510, 293, 406, 445, 257, 2997, 1622, 295, 552, 4494, 1314, 30, 50972], "temperature": 0.0, "avg_logprob": -0.12776763222434304, "compression_ratio": 1.624031007751938, "no_speech_prob": 1.6881516800779095e-12}, {"id": 580, "seek": 149036, "start": 1502.58, "end": 1505.82, "text": " Because the system isn't just moving, it's interacting with itself.", "tokens": [50976, 1436, 264, 1185, 1943, 380, 445, 2684, 11, 309, 311, 18017, 365, 2564, 13, 51138], "temperature": 0.0, "avg_logprob": -0.12776763222434304, "compression_ratio": 1.624031007751938, "no_speech_prob": 1.6881516800779095e-12}, {"id": 581, "seek": 149036, "start": 1506.0, "end": 1506.9399999999998, "text": " Interacting with itself.", "tokens": [51147, 5751, 41090, 365, 2564, 13, 51194], "temperature": 0.0, "avg_logprob": -0.12776763222434304, "compression_ratio": 1.624031007751938, "no_speech_prob": 1.6881516800779095e-12}, {"id": 582, "seek": 149036, "start": 1507.1, "end": 1507.32, "text": " Right.", "tokens": [51202, 1779, 13, 51213], "temperature": 0.0, "avg_logprob": -0.12776763222434304, "compression_ratio": 1.624031007751938, "no_speech_prob": 1.6881516800779095e-12}, {"id": 583, "seek": 149036, "start": 1507.86, "end": 1514.1, "text": " Every tiny drift in the initial error creates new cascading effects that push the reality", "tokens": [51240, 2048, 5870, 19699, 294, 264, 5883, 6713, 7829, 777, 3058, 66, 8166, 5065, 300, 2944, 264, 4103, 51552], "temperature": 0.0, "avg_logprob": -0.12776763222434304, "compression_ratio": 1.624031007751938, "no_speech_prob": 1.6881516800779095e-12}, {"id": 584, "seek": 149036, "start": 1514.1, "end": 1516.1, "text": " further and further from your stale map.", "tokens": [51552, 3052, 293, 3052, 490, 428, 342, 1220, 4471, 13, 51652], "temperature": 0.0, "avg_logprob": -0.12776763222434304, "compression_ratio": 1.624031007751938, "no_speech_prob": 1.6881516800779095e-12}, {"id": 585, "seek": 151610, "start": 1516.1, "end": 1521.12, "text": " The rate at which the error grows is proportional to how much error already exists.", "tokens": [50365, 440, 3314, 412, 597, 264, 6713, 13156, 307, 24969, 281, 577, 709, 6713, 1217, 8198, 13, 50616], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 586, "seek": 151610, "start": 1521.28, "end": 1521.8, "text": " It spirals.", "tokens": [50624, 467, 10733, 1124, 13, 50650], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 587, "seek": 151610, "start": 1521.86, "end": 1522.6599999999999, "text": " Oh, that makes sense.", "tokens": [50653, 876, 11, 300, 1669, 2020, 13, 50693], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 588, "seek": 151610, "start": 1523.12, "end": 1524.62, "text": " It's like my knowledge of pop culture.", "tokens": [50716, 467, 311, 411, 452, 3601, 295, 1665, 3713, 13, 50791], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 589, "seek": 151610, "start": 1524.8799999999999, "end": 1525.8999999999999, "text": " Your pop culture knowledge?", "tokens": [50804, 2260, 1665, 3713, 3601, 30, 50855], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 590, "seek": 151610, "start": 1526.06, "end": 1526.28, "text": " Yeah.", "tokens": [50863, 865, 13, 50874], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 591, "seek": 151610, "start": 1526.84, "end": 1530.5, "text": " My understanding of what teenagers think is cool drifts exponentially.", "tokens": [50902, 1222, 3701, 295, 437, 23618, 519, 307, 1627, 1224, 8065, 37330, 13, 51085], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 592, "seek": 151610, "start": 1531.08, "end": 1533.82, "text": " Every week I don't open TikTok or look at social media.", "tokens": [51114, 2048, 1243, 286, 500, 380, 1269, 20211, 420, 574, 412, 2093, 3021, 13, 51251], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 593, "seek": 151610, "start": 1534.1799999999998, "end": 1535.62, "text": " My map gets further from reality.", "tokens": [51269, 1222, 4471, 2170, 3052, 490, 4103, 13, 51341], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 594, "seek": 151610, "start": 1536.06, "end": 1540.9399999999998, "text": " And because I don't know the new slang, I misunderstand the context of the slang I do hear.", "tokens": [51363, 400, 570, 286, 500, 380, 458, 264, 777, 42517, 11, 286, 35736, 264, 4319, 295, 264, 42517, 286, 360, 1568, 13, 51607], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 595, "seek": 151610, "start": 1541.34, "end": 1542.4399999999998, "text": " So the error compounds.", "tokens": [51627, 407, 264, 6713, 21810, 13, 51682], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 596, "seek": 151610, "start": 1542.6599999999999, "end": 1543.08, "text": " Exactly.", "tokens": [51693, 7587, 13, 51714], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 597, "seek": 151610, "start": 1543.24, "end": 1543.6599999999999, "text": " It spirals.", "tokens": [51722, 467, 10733, 1124, 13, 51743], "temperature": 0.0, "avg_logprob": -0.1866148478949248, "compression_ratio": 1.6375838926174497, "no_speech_prob": 1.6817321190146228e-12}, {"id": 598, "seek": 154366, "start": 1543.66, "end": 1546.72, "text": " But the beauty of staleness is that I can instantly fix it.", "tokens": [50365, 583, 264, 6643, 295, 49875, 15264, 307, 300, 286, 393, 13518, 3191, 309, 13, 50518], "temperature": 0.0, "avg_logprob": -0.15887915819211113, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.2399253715780767e-12}, {"id": 599, "seek": 154366, "start": 1547.02, "end": 1551.28, "text": " I just go online, read a new article about pop culture, resample the data, and boom.", "tokens": [50533, 286, 445, 352, 2950, 11, 1401, 257, 777, 7222, 466, 1665, 3713, 11, 725, 335, 781, 264, 1412, 11, 293, 9351, 13, 50746], "temperature": 0.0, "avg_logprob": -0.15887915819211113, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.2399253715780767e-12}, {"id": 600, "seek": 154366, "start": 1551.44, "end": 1553.1000000000001, "text": " The Grinwall clock resets to zero.", "tokens": [50754, 440, 2606, 259, 16256, 7830, 725, 1385, 281, 4018, 13, 50837], "temperature": 0.0, "avg_logprob": -0.15887915819211113, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.2399253715780767e-12}, {"id": 601, "seek": 154366, "start": 1553.3000000000002, "end": 1554.52, "text": " My map is fresh again.", "tokens": [50847, 1222, 4471, 307, 4451, 797, 13, 50908], "temperature": 0.0, "avg_logprob": -0.15887915819211113, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.2399253715780767e-12}, {"id": 602, "seek": 154366, "start": 1555.0, "end": 1556.6200000000001, "text": " Staleness is curable by speed.", "tokens": [50932, 745, 304, 15264, 307, 1262, 712, 538, 3073, 13, 51013], "temperature": 0.0, "avg_logprob": -0.15887915819211113, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.2399253715780767e-12}, {"id": 603, "seek": 154366, "start": 1557.0800000000002, "end": 1558.3600000000001, "text": " You just send a faster scout.", "tokens": [51036, 509, 445, 2845, 257, 4663, 34392, 13, 51100], "temperature": 0.0, "avg_logprob": -0.15887915819211113, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.2399253715780767e-12}, {"id": 604, "seek": 154366, "start": 1558.72, "end": 1560.0, "text": " You pull the system more frequently.", "tokens": [51118, 509, 2235, 264, 1185, 544, 10374, 13, 51182], "temperature": 0.0, "avg_logprob": -0.15887915819211113, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.2399253715780767e-12}, {"id": 605, "seek": 154366, "start": 1560.94, "end": 1563.7, "text": " But what happens when you encounter an invariant block?", "tokens": [51229, 583, 437, 2314, 562, 291, 8593, 364, 33270, 394, 3461, 30, 51367], "temperature": 0.0, "avg_logprob": -0.15887915819211113, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.2399253715780767e-12}, {"id": 606, "seek": 154366, "start": 1564.46, "end": 1565.48, "text": " That's the real problem.", "tokens": [51405, 663, 311, 264, 957, 1154, 13, 51456], "temperature": 0.0, "avg_logprob": -0.15887915819211113, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.2399253715780767e-12}, {"id": 607, "seek": 154366, "start": 1565.52, "end": 1572.16, "text": " An invariant block is like me trying to understand quantum physics by reading more pop culture articles.", "tokens": [51458, 1107, 33270, 394, 3461, 307, 411, 385, 1382, 281, 1223, 13018, 10649, 538, 3760, 544, 1665, 3713, 11290, 13, 51790], "temperature": 0.0, "avg_logprob": -0.15887915819211113, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.2399253715780767e-12}, {"id": 608, "seek": 157216, "start": 1572.16, "end": 1574.64, "text": " That is a phenomenal way to visualize it.", "tokens": [50365, 663, 307, 257, 17778, 636, 281, 23273, 309, 13, 50489], "temperature": 0.0, "avg_logprob": -0.12700891136226797, "compression_ratio": 1.792387543252595, "no_speech_prob": 1.5241415985203788e-12}, {"id": 609, "seek": 157216, "start": 1574.78, "end": 1577.6000000000001, "text": " It fundamentally does not matter how fresh my data is.", "tokens": [50496, 467, 17879, 775, 406, 1871, 577, 4451, 452, 1412, 307, 13, 50637], "temperature": 0.0, "avg_logprob": -0.12700891136226797, "compression_ratio": 1.792387543252595, "no_speech_prob": 1.5241415985203788e-12}, {"id": 610, "seek": 157216, "start": 1577.7, "end": 1581.7, "text": " It doesn't matter if I refresh my pop culture feed every millisecond.", "tokens": [50642, 467, 1177, 380, 1871, 498, 286, 15134, 452, 1665, 3713, 3154, 633, 27940, 18882, 13, 50842], "temperature": 0.0, "avg_logprob": -0.12700891136226797, "compression_ratio": 1.792387543252595, "no_speech_prob": 1.5241415985203788e-12}, {"id": 611, "seek": 157216, "start": 1581.9, "end": 1584.5400000000002, "text": " I am looking in a structurally irrelevant universe.", "tokens": [50852, 286, 669, 1237, 294, 257, 6594, 6512, 28682, 6445, 13, 50984], "temperature": 0.0, "avg_logprob": -0.12700891136226797, "compression_ratio": 1.792387543252595, "no_speech_prob": 1.5241415985203788e-12}, {"id": 612, "seek": 157216, "start": 1584.8400000000001, "end": 1586.68, "text": " I am trapped in a topological wall.", "tokens": [50999, 286, 669, 14994, 294, 257, 1192, 4383, 2929, 13, 51091], "temperature": 0.0, "avg_logprob": -0.12700891136226797, "compression_ratio": 1.792387543252595, "no_speech_prob": 1.5241415985203788e-12}, {"id": 613, "seek": 157216, "start": 1587.18, "end": 1593.3400000000001, "text": " An invariant block is a region of a mathematical system that is causally sealed off from the rest of the system.", "tokens": [51116, 1107, 33270, 394, 3461, 307, 257, 4458, 295, 257, 18894, 1185, 300, 307, 3302, 379, 21514, 766, 490, 264, 1472, 295, 264, 1185, 13, 51424], "temperature": 0.0, "avg_logprob": -0.12700891136226797, "compression_ratio": 1.792387543252595, "no_speech_prob": 1.5241415985203788e-12}, {"id": 614, "seek": 157216, "start": 1593.5800000000002, "end": 1594.8000000000002, "text": " Causally sealed off?", "tokens": [51436, 7544, 301, 379, 21514, 766, 30, 51497], "temperature": 0.0, "avg_logprob": -0.12700891136226797, "compression_ratio": 1.792387543252595, "no_speech_prob": 1.5241415985203788e-12}, {"id": 615, "seek": 157216, "start": 1594.8600000000001, "end": 1595.1000000000001, "text": " Right.", "tokens": [51500, 1779, 13, 51512], "temperature": 0.0, "avg_logprob": -0.12700891136226797, "compression_ratio": 1.792387543252595, "no_speech_prob": 1.5241415985203788e-12}, {"id": 616, "seek": 157216, "start": 1595.3200000000002, "end": 1597.8400000000001, "text": " Trajectories that start inside the block never leave it.", "tokens": [51523, 5403, 1020, 2083, 300, 722, 1854, 264, 3461, 1128, 1856, 309, 13, 51649], "temperature": 0.0, "avg_logprob": -0.12700891136226797, "compression_ratio": 1.792387543252595, "no_speech_prob": 1.5241415985203788e-12}, {"id": 617, "seek": 157216, "start": 1598.16, "end": 1600.9, "text": " And trajectories that start outside the block can never enter it.", "tokens": [51665, 400, 18257, 2083, 300, 722, 2380, 264, 3461, 393, 1128, 3242, 309, 13, 51802], "temperature": 0.0, "avg_logprob": -0.12700891136226797, "compression_ratio": 1.792387543252595, "no_speech_prob": 1.5241415985203788e-12}, {"id": 618, "seek": 160090, "start": 1600.9, "end": 1603.92, "text": " So no amount of sampling is going to pierce that wall.", "tokens": [50365, 407, 572, 2372, 295, 21179, 307, 516, 281, 9766, 384, 300, 2929, 13, 50516], "temperature": 0.0, "avg_logprob": -0.14625907766407933, "compression_ratio": 1.62, "no_speech_prob": 1.567538525197587e-12}, {"id": 619, "seek": 160090, "start": 1604.3400000000001, "end": 1611.5, "text": " The mathematical remedy for staleness, which is resampling the data, does absolutely nothing to reveal a hidden invariant block.", "tokens": [50537, 440, 18894, 31648, 337, 49875, 15264, 11, 597, 307, 725, 335, 11970, 264, 1412, 11, 775, 3122, 1825, 281, 10658, 257, 7633, 33270, 394, 3461, 13, 50895], "temperature": 0.0, "avg_logprob": -0.14625907766407933, "compression_ratio": 1.62, "no_speech_prob": 1.567538525197587e-12}, {"id": 620, "seek": 160090, "start": 1611.64, "end": 1613.1200000000001, "text": " They are completely different problems.", "tokens": [50902, 814, 366, 2584, 819, 2740, 13, 50976], "temperature": 0.0, "avg_logprob": -0.14625907766407933, "compression_ratio": 1.62, "no_speech_prob": 1.567538525197587e-12}, {"id": 621, "seek": 160090, "start": 1613.3400000000001, "end": 1619.8000000000002, "text": " Infliction rigorously separates these two concepts in the text specifically to warn system designers.", "tokens": [50987, 682, 3423, 4105, 42191, 5098, 34149, 613, 732, 10392, 294, 264, 2487, 4682, 281, 12286, 1185, 16196, 13, 51310], "temperature": 0.0, "avg_logprob": -0.14625907766407933, "compression_ratio": 1.62, "no_speech_prob": 1.567538525197587e-12}, {"id": 622, "seek": 160090, "start": 1620.22, "end": 1621.3400000000001, "text": " You see this all the time in business.", "tokens": [51331, 509, 536, 341, 439, 264, 565, 294, 1606, 13, 51387], "temperature": 0.0, "avg_logprob": -0.14625907766407933, "compression_ratio": 1.62, "no_speech_prob": 1.567538525197587e-12}, {"id": 623, "seek": 160090, "start": 1621.72, "end": 1622.5, "text": " Oh, definitely.", "tokens": [51406, 876, 11, 2138, 13, 51445], "temperature": 0.0, "avg_logprob": -0.14625907766407933, "compression_ratio": 1.62, "no_speech_prob": 1.567538525197587e-12}, {"id": 624, "seek": 160090, "start": 1622.8600000000001, "end": 1626.5600000000002, "text": " A company is entirely blind to a massive demographic of the market.", "tokens": [51463, 316, 2237, 307, 7696, 6865, 281, 257, 5994, 26331, 295, 264, 2142, 13, 51648], "temperature": 0.0, "avg_logprob": -0.14625907766407933, "compression_ratio": 1.62, "no_speech_prob": 1.567538525197587e-12}, {"id": 625, "seek": 160090, "start": 1626.96, "end": 1628.9, "text": " They assume their data is just stale.", "tokens": [51668, 814, 6552, 641, 1412, 307, 445, 342, 1220, 13, 51765], "temperature": 0.0, "avg_logprob": -0.14625907766407933, "compression_ratio": 1.62, "no_speech_prob": 1.567538525197587e-12}, {"id": 626, "seek": 162890, "start": 1628.9, "end": 1637.6200000000001, "text": " So they spend millions of dollars running faster, more frequent focus groups on the exact same customer base they already have.", "tokens": [50365, 407, 436, 3496, 6803, 295, 3808, 2614, 4663, 11, 544, 18004, 1879, 3935, 322, 264, 1900, 912, 5474, 3096, 436, 1217, 362, 13, 50801], "temperature": 0.0, "avg_logprob": -0.12437318111288137, "compression_ratio": 1.4035087719298245, "no_speech_prob": 2.2804993570629817e-12}, {"id": 627, "seek": 162890, "start": 1637.8600000000001, "end": 1641.14, "text": " Trying to fix a map error with a faster stopwatch.", "tokens": [50813, 20180, 281, 3191, 257, 4471, 6713, 365, 257, 4663, 1590, 15219, 13, 50977], "temperature": 0.0, "avg_logprob": -0.12437318111288137, "compression_ratio": 1.4035087719298245, "no_speech_prob": 2.2804993570629817e-12}, {"id": 628, "seek": 162890, "start": 1641.24, "end": 1641.94, "text": " It's madness.", "tokens": [50982, 467, 311, 28736, 13, 51017], "temperature": 0.0, "avg_logprob": -0.12437318111288137, "compression_ratio": 1.4035087719298245, "no_speech_prob": 2.2804993570629817e-12}, {"id": 629, "seek": 162890, "start": 1642.24, "end": 1644.6200000000001, "text": " They are trapped in an invariant decomposition.", "tokens": [51032, 814, 366, 14994, 294, 364, 33270, 394, 48356, 13, 51151], "temperature": 0.0, "avg_logprob": -0.12437318111288137, "compression_ratio": 1.4035087719298245, "no_speech_prob": 2.2804993570629817e-12}, {"id": 630, "seek": 164462, "start": 1644.62, "end": 1650.8999999999999, "text": " They don't have the causal pathways, the cultural reach, the product alignment to ever enter the other block.", "tokens": [50365, 814, 500, 380, 362, 264, 38755, 22988, 11, 264, 6988, 2524, 11, 264, 1674, 18515, 281, 1562, 3242, 264, 661, 3461, 13, 50679], "temperature": 0.0, "avg_logprob": -0.10561336255541035, "compression_ratio": 1.6374045801526718, "no_speech_prob": 1.8977428135891206e-12}, {"id": 631, "seek": 164462, "start": 1651.2199999999998, "end": 1654.1599999999999, "text": " You cannot pull your way out of topological isolation.", "tokens": [50695, 509, 2644, 2235, 428, 636, 484, 295, 1192, 4383, 16001, 13, 50842], "temperature": 0.0, "avg_logprob": -0.10561336255541035, "compression_ratio": 1.6374045801526718, "no_speech_prob": 1.8977428135891206e-12}, {"id": 632, "seek": 164462, "start": 1654.4799999999998, "end": 1657.1399999999999, "text": " Up to this point, we've been observing the boundaries of the future.", "tokens": [50858, 5858, 281, 341, 935, 11, 321, 600, 668, 22107, 264, 13180, 295, 264, 2027, 13, 50991], "temperature": 0.0, "avg_logprob": -0.10561336255541035, "compression_ratio": 1.6374045801526718, "no_speech_prob": 1.8977428135891206e-12}, {"id": 633, "seek": 164462, "start": 1657.54, "end": 1665.7199999999998, "text": " We've talked about charting them with the doctor's map, failing to chart them with the lazy traffic light code, and hitting the invisible walls of invariant block.", "tokens": [51011, 492, 600, 2825, 466, 6927, 278, 552, 365, 264, 4631, 311, 4471, 11, 18223, 281, 6927, 552, 365, 264, 14847, 6419, 1442, 3089, 11, 293, 8850, 264, 14603, 7920, 295, 33270, 394, 3461, 13, 51420], "temperature": 0.0, "avg_logprob": -0.10561336255541035, "compression_ratio": 1.6374045801526718, "no_speech_prob": 1.8977428135891206e-12}, {"id": 634, "seek": 164462, "start": 1665.86, "end": 1666.06, "text": " Right.", "tokens": [51427, 1779, 13, 51437], "temperature": 0.0, "avg_logprob": -0.10561336255541035, "compression_ratio": 1.6374045801526718, "no_speech_prob": 1.8977428135891206e-12}, {"id": 635, "seek": 164462, "start": 1666.2399999999998, "end": 1667.52, "text": " All passive observation.", "tokens": [51446, 1057, 14975, 14816, 13, 51510], "temperature": 0.0, "avg_logprob": -0.10561336255541035, "compression_ratio": 1.6374045801526718, "no_speech_prob": 1.8977428135891206e-12}, {"id": 636, "seek": 166752, "start": 1667.52, "end": 1670.48, "text": " But what happens when we refuse to just observe?", "tokens": [50365, 583, 437, 2314, 562, 321, 16791, 281, 445, 11441, 30, 50513], "temperature": 0.0, "avg_logprob": -0.19674338507898076, "compression_ratio": 1.6554621848739495, "no_speech_prob": 1.6173036217551062e-12}, {"id": 637, "seek": 166752, "start": 1670.7, "end": 1673.76, "text": " What happens when we actively intervene to change those boundaries?", "tokens": [50524, 708, 2314, 562, 321, 13022, 30407, 281, 1319, 729, 13180, 30, 50677], "temperature": 0.0, "avg_logprob": -0.19674338507898076, "compression_ratio": 1.6554621848739495, "no_speech_prob": 1.6173036217551062e-12}, {"id": 638, "seek": 166752, "start": 1674.32, "end": 1677.3799999999999, "text": " We step into the realm of investment-movable admissibility.", "tokens": [50705, 492, 1823, 666, 264, 15355, 295, 6078, 12, 3280, 17915, 5910, 891, 2841, 13, 50858], "temperature": 0.0, "avg_logprob": -0.19674338507898076, "compression_ratio": 1.6554621848739495, "no_speech_prob": 1.6173036217551062e-12}, {"id": 639, "seek": 166752, "start": 1677.7, "end": 1679.48, "text": " Investment-movable admissibility.", "tokens": [50874, 43427, 12, 3280, 17915, 5910, 891, 2841, 13, 50963], "temperature": 0.0, "avg_logprob": -0.19674338507898076, "compression_ratio": 1.6554621848739495, "no_speech_prob": 1.6173036217551062e-12}, {"id": 640, "seek": 166752, "start": 1679.92, "end": 1685.34, "text": " Throughout the early chapters of the text, constraints and boundaries were treated as hard, fixed lines.", "tokens": [50985, 22775, 264, 2440, 20013, 295, 264, 2487, 11, 18491, 293, 13180, 645, 8668, 382, 1152, 11, 6806, 3876, 13, 51256], "temperature": 0.0, "avg_logprob": -0.19674338507898076, "compression_ratio": 1.6554621848739495, "no_speech_prob": 1.6173036217551062e-12}, {"id": 641, "seek": 166752, "start": 1685.92, "end": 1687.86, "text": " A mathematical wall you just bounce off of.", "tokens": [51285, 316, 18894, 2929, 291, 445, 15894, 766, 295, 13, 51382], "temperature": 0.0, "avg_logprob": -0.19674338507898076, "compression_ratio": 1.6554621848739495, "no_speech_prob": 1.6173036217551062e-12}, {"id": 642, "seek": 166752, "start": 1687.92, "end": 1689.34, "text": " Like the invariant block.", "tokens": [51385, 1743, 264, 33270, 394, 3461, 13, 51456], "temperature": 0.0, "avg_logprob": -0.19674338507898076, "compression_ratio": 1.6554621848739495, "no_speech_prob": 1.6173036217551062e-12}, {"id": 643, "seek": 166752, "start": 1689.56, "end": 1690.12, "text": " Exactly.", "tokens": [51467, 7587, 13, 51495], "temperature": 0.0, "avg_logprob": -0.19674338507898076, "compression_ratio": 1.6554621848739495, "no_speech_prob": 1.6173036217551062e-12}, {"id": 644, "seek": 169012, "start": 1690.12, "end": 1693.6, "text": " But Flexion points out that reality is far more pliable.", "tokens": [50365, 583, 29208, 313, 2793, 484, 300, 4103, 307, 1400, 544, 499, 9364, 13, 50539], "temperature": 0.0, "avg_logprob": -0.15928136522524824, "compression_ratio": 1.6227106227106227, "no_speech_prob": 1.531233148090172e-12}, {"id": 645, "seek": 169012, "start": 1694.04, "end": 1695.6999999999998, "text": " Not all boundaries are absolute.", "tokens": [50561, 1726, 439, 13180, 366, 8236, 13, 50644], "temperature": 0.0, "avg_logprob": -0.15928136522524824, "compression_ratio": 1.6227106227106227, "no_speech_prob": 1.531233148090172e-12}, {"id": 646, "seek": 169012, "start": 1695.9399999999998, "end": 1697.86, "text": " Some boundaries are hard physical limits, sure.", "tokens": [50656, 2188, 13180, 366, 1152, 4001, 10406, 11, 988, 13, 50752], "temperature": 0.0, "avg_logprob": -0.15928136522524824, "compression_ratio": 1.6227106227106227, "no_speech_prob": 1.531233148090172e-12}, {"id": 647, "seek": 169012, "start": 1698.26, "end": 1705.9399999999998, "text": " If you have a biological species that strictly requires oxygen to survive, a zero-oxygen environment is a hard-excluded set.", "tokens": [50772, 759, 291, 362, 257, 13910, 6172, 300, 20792, 7029, 9169, 281, 7867, 11, 257, 4018, 12, 5230, 8647, 2823, 307, 257, 1152, 12, 27855, 44412, 992, 13, 51156], "temperature": 0.0, "avg_logprob": -0.15928136522524824, "compression_ratio": 1.6227106227106227, "no_speech_prob": 1.531233148090172e-12}, {"id": 648, "seek": 169012, "start": 1706.12, "end": 1706.32, "text": " Right.", "tokens": [51165, 1779, 13, 51175], "temperature": 0.0, "avg_logprob": -0.15928136522524824, "compression_ratio": 1.6227106227106227, "no_speech_prob": 1.531233148090172e-12}, {"id": 649, "seek": 169012, "start": 1706.4399999999998, "end": 1712.78, "text": " No amount of corporate budgeting or sheer willpower changes the biological thermodynamics of that species.", "tokens": [51181, 883, 2372, 295, 10896, 47855, 420, 23061, 486, 9513, 2962, 264, 13910, 8810, 35483, 295, 300, 6172, 13, 51498], "temperature": 0.0, "avg_logprob": -0.15928136522524824, "compression_ratio": 1.6227106227106227, "no_speech_prob": 1.531233148090172e-12}, {"id": 650, "seek": 169012, "start": 1713.08, "end": 1713.86, "text": " They will die.", "tokens": [51513, 814, 486, 978, 13, 51552], "temperature": 0.0, "avg_logprob": -0.15928136522524824, "compression_ratio": 1.6227106227106227, "no_speech_prob": 1.531233148090172e-12}, {"id": 651, "seek": 169012, "start": 1713.9399999999998, "end": 1716.56, "text": " But other boundaries are permeable based on effort.", "tokens": [51556, 583, 661, 13180, 366, 30287, 712, 2361, 322, 4630, 13, 51687], "temperature": 0.0, "avg_logprob": -0.15928136522524824, "compression_ratio": 1.6227106227106227, "no_speech_prob": 1.531233148090172e-12}, {"id": 652, "seek": 171656, "start": 1716.56, "end": 1721.48, "text": " The text uses the grand example of terraforming a planet's atmosphere.", "tokens": [50365, 440, 2487, 4960, 264, 2697, 1365, 295, 26298, 48610, 257, 5054, 311, 8018, 13, 50611], "temperature": 0.0, "avg_logprob": -0.16914914659232147, "compression_ratio": 1.6838487972508591, "no_speech_prob": 2.052242924210912e-12}, {"id": 653, "seek": 171656, "start": 1721.96, "end": 1722.3999999999999, "text": " Terraforming.", "tokens": [50635, 25366, 48610, 13, 50657], "temperature": 0.0, "avg_logprob": -0.16914914659232147, "compression_ratio": 1.6838487972508591, "no_speech_prob": 2.052242924210912e-12}, {"id": 654, "seek": 171656, "start": 1722.7, "end": 1724.34, "text": " That is quite a leap from a traffic light.", "tokens": [50672, 663, 307, 1596, 257, 19438, 490, 257, 6419, 1442, 13, 50754], "temperature": 0.0, "avg_logprob": -0.16914914659232147, "compression_ratio": 1.6838487972508591, "no_speech_prob": 2.052242924210912e-12}, {"id": 655, "seek": 171656, "start": 1724.3999999999999, "end": 1726.44, "text": " It really is, but it scales perfectly.", "tokens": [50757, 467, 534, 307, 11, 457, 309, 17408, 6239, 13, 50859], "temperature": 0.0, "avg_logprob": -0.16914914659232147, "compression_ratio": 1.6838487972508591, "no_speech_prob": 2.052242924210912e-12}, {"id": 656, "seek": 171656, "start": 1726.74, "end": 1730.26, "text": " Terraforming utilizes what the book calls expansive operators.", "tokens": [50874, 25366, 48610, 4976, 5660, 437, 264, 1446, 5498, 46949, 19077, 13, 51050], "temperature": 0.0, "avg_logprob": -0.16914914659232147, "compression_ratio": 1.6838487972508591, "no_speech_prob": 2.052242924210912e-12}, {"id": 657, "seek": 171656, "start": 1730.76, "end": 1732.62, "text": " You aren't just navigating the existing future.", "tokens": [51075, 509, 3212, 380, 445, 32054, 264, 6741, 2027, 13, 51168], "temperature": 0.0, "avg_logprob": -0.16914914659232147, "compression_ratio": 1.6838487972508591, "no_speech_prob": 2.052242924210912e-12}, {"id": 658, "seek": 171656, "start": 1732.82, "end": 1734.6399999999999, "text": " You are building an investment schedule.", "tokens": [51178, 509, 366, 2390, 364, 6078, 7567, 13, 51269], "temperature": 0.0, "avg_logprob": -0.16914914659232147, "compression_ratio": 1.6838487972508591, "no_speech_prob": 2.052242924210912e-12}, {"id": 659, "seek": 171656, "start": 1734.96, "end": 1737.98, "text": " You spend vast amounts of effort, energy, and resources.", "tokens": [51285, 509, 3496, 8369, 11663, 295, 4630, 11, 2281, 11, 293, 3593, 13, 51436], "temperature": 0.0, "avg_logprob": -0.16914914659232147, "compression_ratio": 1.6838487972508591, "no_speech_prob": 2.052242924210912e-12}, {"id": 660, "seek": 171656, "start": 1738.4199999999998, "end": 1743.76, "text": " And the boundary of what is viable, what is admissible for your species, physically recedes.", "tokens": [51458, 400, 264, 12866, 295, 437, 307, 22024, 11, 437, 307, 5910, 41073, 337, 428, 6172, 11, 9762, 850, 48490, 13, 51725], "temperature": 0.0, "avg_logprob": -0.16914914659232147, "compression_ratio": 1.6838487972508591, "no_speech_prob": 2.052242924210912e-12}, {"id": 661, "seek": 171656, "start": 1743.8799999999999, "end": 1744.86, "text": " The boundary expands.", "tokens": [51731, 440, 12866, 33706, 13, 51780], "temperature": 0.0, "avg_logprob": -0.16914914659232147, "compression_ratio": 1.6838487972508591, "no_speech_prob": 2.052242924210912e-12}, {"id": 662, "seek": 174486, "start": 1744.86, "end": 1748.1799999999998, "text": " And the math treats this as a one-way ratchet, really.", "tokens": [50365, 400, 264, 5221, 19566, 341, 382, 257, 472, 12, 676, 45885, 11, 534, 13, 50531], "temperature": 0.0, "avg_logprob": -0.15131405421665736, "compression_ratio": 1.5817490494296578, "no_speech_prob": 1.6684867463340192e-12}, {"id": 663, "seek": 174486, "start": 1748.1799999999998, "end": 1748.56, "text": " It does.", "tokens": [50531, 467, 775, 13, 50550], "temperature": 0.0, "avg_logprob": -0.15131405421665736, "compression_ratio": 1.5817490494296578, "no_speech_prob": 1.6684867463340192e-12}, {"id": 664, "seek": 174486, "start": 1748.9799999999998, "end": 1753.78, "text": " Once you invest the required energy to push the state into viability, the boundary holds.", "tokens": [50571, 3443, 291, 1963, 264, 4739, 2281, 281, 2944, 264, 1785, 666, 1932, 2310, 11, 264, 12866, 9190, 13, 50811], "temperature": 0.0, "avg_logprob": -0.15131405421665736, "compression_ratio": 1.5817490494296578, "no_speech_prob": 1.6684867463340192e-12}, {"id": 665, "seek": 174486, "start": 1754.0, "end": 1757.26, "text": " It doesn't instantly collapse back on you just because you stop pushing.", "tokens": [50822, 467, 1177, 380, 13518, 15584, 646, 322, 291, 445, 570, 291, 1590, 7380, 13, 50985], "temperature": 0.0, "avg_logprob": -0.15131405421665736, "compression_ratio": 1.5817490494296578, "no_speech_prob": 1.6684867463340192e-12}, {"id": 666, "seek": 174486, "start": 1757.74, "end": 1762.84, "text": " So investment physically alters this topological landscape of your possible futures.", "tokens": [51009, 407, 6078, 9762, 419, 1559, 341, 1192, 4383, 9661, 295, 428, 1944, 26071, 13, 51264], "temperature": 0.0, "avg_logprob": -0.15131405421665736, "compression_ratio": 1.5817490494296578, "no_speech_prob": 1.6684867463340192e-12}, {"id": 667, "seek": 174486, "start": 1763.12, "end": 1763.4799999999998, "text": " Exactly.", "tokens": [51278, 7587, 13, 51296], "temperature": 0.0, "avg_logprob": -0.15131405421665736, "compression_ratio": 1.5817490494296578, "no_speech_prob": 1.6684867463340192e-12}, {"id": 668, "seek": 174486, "start": 1763.8999999999999, "end": 1768.58, "text": " But this introduces perhaps the most dangerous trap in the entire book.", "tokens": [51317, 583, 341, 31472, 4317, 264, 881, 5795, 11487, 294, 264, 2302, 1446, 13, 51551], "temperature": 0.0, "avg_logprob": -0.15131405421665736, "compression_ratio": 1.5817490494296578, "no_speech_prob": 1.6684867463340192e-12}, {"id": 669, "seek": 174486, "start": 1768.6399999999999, "end": 1768.86, "text": " Okay.", "tokens": [51554, 1033, 13, 51565], "temperature": 0.0, "avg_logprob": -0.15131405421665736, "compression_ratio": 1.5817490494296578, "no_speech_prob": 1.6684867463340192e-12}, {"id": 670, "seek": 174486, "start": 1769.2199999999998, "end": 1770.24, "text": " What is the trap?", "tokens": [51583, 708, 307, 264, 11487, 30, 51634], "temperature": 0.0, "avg_logprob": -0.15131405421665736, "compression_ratio": 1.5817490494296578, "no_speech_prob": 1.6684867463340192e-12}, {"id": 671, "seek": 177024, "start": 1770.24, "end": 1776.04, "text": " We have to talk about the catastrophic difference between representational loss and operational loss.", "tokens": [50365, 492, 362, 281, 751, 466, 264, 34915, 2649, 1296, 2906, 1478, 4470, 293, 16607, 4470, 13, 50655], "temperature": 0.0, "avg_logprob": -0.15995034304532138, "compression_ratio": 1.6334841628959276, "no_speech_prob": 1.525267108795636e-12}, {"id": 672, "seek": 177024, "start": 1776.72, "end": 1778.4, "text": " Representational versus operational.", "tokens": [50689, 19945, 1478, 5717, 16607, 13, 50773], "temperature": 0.0, "avg_logprob": -0.15995034304532138, "compression_ratio": 1.6334841628959276, "no_speech_prob": 1.525267108795636e-12}, {"id": 673, "seek": 177024, "start": 1778.8, "end": 1784.84, "text": " Because when you start intervening in a system, changing the boundaries, it can look mathematically", "tokens": [50793, 1436, 562, 291, 722, 17104, 278, 294, 257, 1185, 11, 4473, 264, 13180, 11, 309, 393, 574, 44003, 51095], "temperature": 0.0, "avg_logprob": -0.15995034304532138, "compression_ratio": 1.6334841628959276, "no_speech_prob": 1.525267108795636e-12}, {"id": 674, "seek": 177024, "start": 1784.84, "end": 1791.22, "text": " identical on a stride sheet to just relabeling the system, even though the real-world consequences", "tokens": [51095, 14800, 322, 257, 1056, 482, 8193, 281, 445, 1039, 455, 11031, 264, 1185, 11, 754, 1673, 264, 957, 12, 13217, 10098, 51414], "temperature": 0.0, "avg_logprob": -0.15995034304532138, "compression_ratio": 1.6334841628959276, "no_speech_prob": 1.525267108795636e-12}, {"id": 675, "seek": 177024, "start": 1791.22, "end": 1792.36, "text": " are complete opposites.", "tokens": [51414, 366, 3566, 4665, 3324, 13, 51471], "temperature": 0.0, "avg_logprob": -0.15995034304532138, "compression_ratio": 1.6334841628959276, "no_speech_prob": 1.525267108795636e-12}, {"id": 676, "seek": 179236, "start": 1792.36, "end": 1797.34, "text": " To see this trap clearly, we need to return to our intersection with the lazy traffic light", "tokens": [50365, 1407, 536, 341, 11487, 4448, 11, 321, 643, 281, 2736, 281, 527, 15236, 365, 264, 14847, 6419, 1442, 50614], "temperature": 0.0, "avg_logprob": -0.14254783565162593, "compression_ratio": 1.713768115942029, "no_speech_prob": 1.3457219279894295e-12}, {"id": 677, "seek": 179236, "start": 1797.34, "end": 1797.78, "text": " engineer.", "tokens": [50614, 11403, 13, 50636], "temperature": 0.0, "avg_logprob": -0.14254783565162593, "compression_ratio": 1.713768115942029, "no_speech_prob": 1.3457219279894295e-12}, {"id": 678, "seek": 179236, "start": 1797.9799999999998, "end": 1798.6, "text": " Let's do it.", "tokens": [50646, 961, 311, 360, 309, 13, 50677], "temperature": 0.0, "avg_logprob": -0.14254783565162593, "compression_ratio": 1.713768115942029, "no_speech_prob": 1.3457219279894295e-12}, {"id": 679, "seek": 179236, "start": 1798.8, "end": 1803.9799999999998, "text": " So earlier we talked about the lazy engineer writing software that just clears the crosswalk", "tokens": [50687, 407, 3071, 321, 2825, 466, 264, 14847, 11403, 3579, 4722, 300, 445, 47033, 264, 3278, 12490, 50946], "temperature": 0.0, "avg_logprob": -0.14254783565162593, "compression_ratio": 1.713768115942029, "no_speech_prob": 1.3457219279894295e-12}, {"id": 680, "seek": 179236, "start": 1803.9799999999998, "end": 1805.5, "text": " memory whenever the light is red.", "tokens": [50946, 4675, 5699, 264, 1442, 307, 2182, 13, 51022], "temperature": 0.0, "avg_logprob": -0.14254783565162593, "compression_ratio": 1.713768115942029, "no_speech_prob": 1.3457219279894295e-12}, {"id": 681, "seek": 179236, "start": 1805.56, "end": 1805.78, "text": " Right.", "tokens": [51025, 1779, 13, 51036], "temperature": 0.0, "avg_logprob": -0.14254783565162593, "compression_ratio": 1.713768115942029, "no_speech_prob": 1.3457219279894295e-12}, {"id": 682, "seek": 179236, "start": 1805.8799999999999, "end": 1806.56, "text": " The bad software.", "tokens": [51041, 440, 1578, 4722, 13, 51075], "temperature": 0.0, "avg_logprob": -0.14254783565162593, "compression_ratio": 1.713768115942029, "no_speech_prob": 1.3457219279894295e-12}, {"id": 683, "seek": 179236, "start": 1806.56, "end": 1808.4599999999998, "text": " Its software label is just too coarse.", "tokens": [51075, 6953, 4722, 7645, 307, 445, 886, 39312, 13, 51170], "temperature": 0.0, "avg_logprob": -0.14254783565162593, "compression_ratio": 1.713768115942029, "no_speech_prob": 1.3457219279894295e-12}, {"id": 684, "seek": 179236, "start": 1808.7199999999998, "end": 1812.7199999999998, "text": " It forces two different physical realities to share the same name in the code.", "tokens": [51183, 467, 5874, 732, 819, 4001, 27785, 281, 2073, 264, 912, 1315, 294, 264, 3089, 13, 51383], "temperature": 0.0, "avg_logprob": -0.14254783565162593, "compression_ratio": 1.713768115942029, "no_speech_prob": 1.3457219279894295e-12}, {"id": 685, "seek": 179236, "start": 1813.1999999999998, "end": 1814.9399999999998, "text": " That is representational loss.", "tokens": [51407, 663, 307, 2906, 1478, 4470, 13, 51494], "temperature": 0.0, "avg_logprob": -0.14254783565162593, "compression_ratio": 1.713768115942029, "no_speech_prob": 1.3457219279894295e-12}, {"id": 686, "seek": 179236, "start": 1815.1399999999999, "end": 1817.3, "text": " Because the physics of the intersection are totally fine.", "tokens": [51504, 1436, 264, 10649, 295, 264, 15236, 366, 3879, 2489, 13, 51612], "temperature": 0.0, "avg_logprob": -0.14254783565162593, "compression_ratio": 1.713768115942029, "no_speech_prob": 1.3457219279894295e-12}, {"id": 687, "seek": 181730, "start": 1817.3, "end": 1817.7, "text": " Exactly.", "tokens": [50365, 7587, 13, 50385], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 688, "seek": 181730, "start": 1818.18, "end": 1820.5, "text": " The pedestrian is still physically pushing the button.", "tokens": [50409, 440, 33947, 307, 920, 9762, 7380, 264, 2960, 13, 50525], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 689, "seek": 181730, "start": 1820.6399999999999, "end": 1822.8799999999999, "text": " The electrical circuit in the button is still closing.", "tokens": [50532, 440, 12147, 9048, 294, 264, 2960, 307, 920, 10377, 13, 50644], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 690, "seek": 181730, "start": 1823.26, "end": 1824.7, "text": " The software just ignores it.", "tokens": [50663, 440, 4722, 445, 5335, 2706, 309, 13, 50735], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 691, "seek": 181730, "start": 1824.86, "end": 1826.54, "text": " Contrast that with operational loss.", "tokens": [50743, 4839, 4148, 300, 365, 16607, 4470, 13, 50827], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 692, "seek": 181730, "start": 1826.6399999999999, "end": 1826.8799999999999, "text": " Okay.", "tokens": [50832, 1033, 13, 50844], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 693, "seek": 181730, "start": 1827.08, "end": 1832.52, "text": " Imagine a disgruntled city worker drives out to the intersection in a bucket truck, takes", "tokens": [50854, 11739, 257, 32632, 2760, 1493, 2307, 11346, 11754, 484, 281, 264, 15236, 294, 257, 13058, 5898, 11, 2516, 51126], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 694, "seek": 181730, "start": 1832.52, "end": 1837.34, "text": " out a pair of wire cutters, and physically severs the electrical wire connecting the button", "tokens": [51126, 484, 257, 6119, 295, 6234, 1723, 1559, 11, 293, 9762, 369, 840, 264, 12147, 6234, 11015, 264, 2960, 51367], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 695, "seek": 181730, "start": 1837.34, "end": 1837.8, "text": " to the pole.", "tokens": [51367, 281, 264, 13208, 13, 51390], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 696, "seek": 181730, "start": 1837.84, "end": 1839.04, "text": " They unwire the button.", "tokens": [51392, 814, 14853, 621, 264, 2960, 13, 51452], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 697, "seek": 181730, "start": 1839.1599999999999, "end": 1839.46, "text": " Yes.", "tokens": [51458, 1079, 13, 51473], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 698, "seek": 181730, "start": 1839.96, "end": 1845.84, "text": " If you look at the system's output on a diagnostic screen back at City Hall, both the lazy software", "tokens": [51498, 759, 291, 574, 412, 264, 1185, 311, 5598, 322, 257, 27897, 2568, 646, 412, 4392, 5434, 11, 1293, 264, 14847, 4722, 51792], "temperature": 0.0, "avg_logprob": -0.13229689453587387, "compression_ratio": 1.7457627118644068, "no_speech_prob": 1.6881567758281202e-12}, {"id": 699, "seek": 184584, "start": 1845.84, "end": 1848.8999999999999, "text": " and the cut wire look mathematically identical.", "tokens": [50365, 293, 264, 1723, 6234, 574, 44003, 14800, 13, 50518], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 700, "seek": 184584, "start": 1849.36, "end": 1849.6399999999999, "text": " Wait.", "tokens": [50541, 3802, 13, 50555], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 701, "seek": 184584, "start": 1849.8799999999999, "end": 1850.1599999999999, "text": " Really?", "tokens": [50567, 4083, 30, 50581], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 702, "seek": 184584, "start": 1850.74, "end": 1851.34, "text": " Identical?", "tokens": [50610, 25905, 804, 30, 50640], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 703, "seek": 184584, "start": 1851.52, "end": 1855.52, "text": " Both actions result in a distinction loss of exactly one bit.", "tokens": [50649, 6767, 5909, 1874, 294, 257, 16844, 4470, 295, 2293, 472, 857, 13, 50849], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 704, "seek": 184584, "start": 1855.74, "end": 1855.9599999999998, "text": " Yeah.", "tokens": [50860, 865, 13, 50871], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 705, "seek": 184584, "start": 1856.1599999999999, "end": 1860.82, "text": " In both scenarios, the log count of distinct futures is reduced by the same amount.", "tokens": [50881, 682, 1293, 15077, 11, 264, 3565, 1207, 295, 10644, 26071, 307, 9212, 538, 264, 912, 2372, 13, 51114], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 706, "seek": 184584, "start": 1861.32, "end": 1864.28, "text": " The screen says, button press equals zero.", "tokens": [51139, 440, 2568, 1619, 11, 2960, 1886, 6915, 4018, 13, 51287], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 707, "seek": 184584, "start": 1864.58, "end": 1866.34, "text": " But the reality is completely different.", "tokens": [51302, 583, 264, 4103, 307, 2584, 819, 13, 51390], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 708, "seek": 184584, "start": 1866.5, "end": 1867.1599999999999, "text": " Radically different.", "tokens": [51398, 9654, 984, 819, 13, 51431], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 709, "seek": 184584, "start": 1867.62, "end": 1869.48, "text": " Representational loss can be fixed for free.", "tokens": [51454, 19945, 1478, 4470, 393, 312, 6806, 337, 1737, 13, 51547], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 710, "seek": 184584, "start": 1869.82, "end": 1874.1999999999998, "text": " You just hire a better engineer, rewrite the software label to be more precise, and boom,", "tokens": [51564, 509, 445, 11158, 257, 1101, 11403, 11, 28132, 264, 4722, 7645, 281, 312, 544, 13600, 11, 293, 9351, 11, 51783], "temperature": 0.0, "avg_logprob": -0.20146134694417317, "compression_ratio": 1.6223776223776223, "no_speech_prob": 2.2103373818749272e-12}, {"id": 711, "seek": 187420, "start": 1874.2, "end": 1877.8, "text": " the system remembers the button press again because the physical data was always there.", "tokens": [50365, 264, 1185, 26228, 264, 2960, 1886, 797, 570, 264, 4001, 1412, 390, 1009, 456, 13, 50545], "temperature": 0.0, "avg_logprob": -0.13032963871955872, "compression_ratio": 1.8556701030927836, "no_speech_prob": 1.9354671944998847e-12}, {"id": 712, "seek": 187420, "start": 1878.06, "end": 1880.5, "text": " The continuation space was just hidden behind a bad label.", "tokens": [50558, 440, 29357, 1901, 390, 445, 7633, 2261, 257, 1578, 7645, 13, 50680], "temperature": 0.0, "avg_logprob": -0.13032963871955872, "compression_ratio": 1.8556701030927836, "no_speech_prob": 1.9354671944998847e-12}, {"id": 713, "seek": 187420, "start": 1880.68, "end": 1882.22, "text": " But the operational loss.", "tokens": [50689, 583, 264, 16607, 4470, 13, 50766], "temperature": 0.0, "avg_logprob": -0.13032963871955872, "compression_ratio": 1.8556701030927836, "no_speech_prob": 1.9354671944998847e-12}, {"id": 714, "seek": 187420, "start": 1882.76, "end": 1885.64, "text": " The worker who cut the wire intervened in the physical system.", "tokens": [50793, 440, 11346, 567, 1723, 264, 6234, 17104, 292, 294, 264, 4001, 1185, 13, 50937], "temperature": 0.0, "avg_logprob": -0.13032963871955872, "compression_ratio": 1.8556701030927836, "no_speech_prob": 1.9354671944998847e-12}, {"id": 715, "seek": 187420, "start": 1886.24, "end": 1890.02, "text": " They applied an operator that forced the states to a common target in reality.", "tokens": [50967, 814, 6456, 364, 12973, 300, 7579, 264, 4368, 281, 257, 2689, 3779, 294, 4103, 13, 51156], "temperature": 0.0, "avg_logprob": -0.13032963871955872, "compression_ratio": 1.8556701030927836, "no_speech_prob": 1.9354671944998847e-12}, {"id": 716, "seek": 187420, "start": 1890.42, "end": 1893.26, "text": " The history of the button press isn't hidden behind a bad label.", "tokens": [51176, 440, 2503, 295, 264, 2960, 1886, 1943, 380, 7633, 2261, 257, 1578, 7645, 13, 51318], "temperature": 0.0, "avg_logprob": -0.13032963871955872, "compression_ratio": 1.8556701030927836, "no_speech_prob": 1.9354671944998847e-12}, {"id": 717, "seek": 187420, "start": 1893.72, "end": 1896.68, "text": " It is physically erased from the universe of that intersection.", "tokens": [51341, 467, 307, 9762, 38359, 490, 264, 6445, 295, 300, 15236, 13, 51489], "temperature": 0.0, "avg_logprob": -0.13032963871955872, "compression_ratio": 1.8556701030927836, "no_speech_prob": 1.9354671944998847e-12}, {"id": 718, "seek": 187420, "start": 1896.82, "end": 1897.9, "text": " The data is gone.", "tokens": [51496, 440, 1412, 307, 2780, 13, 51550], "temperature": 0.0, "avg_logprob": -0.13032963871955872, "compression_ratio": 1.8556701030927836, "no_speech_prob": 1.9354671944998847e-12}, {"id": 719, "seek": 187420, "start": 1898.0800000000002, "end": 1899.2, "text": " The current cannot flow.", "tokens": [51559, 440, 2190, 2644, 3095, 13, 51615], "temperature": 0.0, "avg_logprob": -0.13032963871955872, "compression_ratio": 1.8556701030927836, "no_speech_prob": 1.9354671944998847e-12}, {"id": 720, "seek": 187420, "start": 1899.3400000000001, "end": 1902.76, "text": " You cannot fix a severed wire with a software update.", "tokens": [51622, 509, 2644, 3191, 257, 2802, 292, 6234, 365, 257, 4722, 5623, 13, 51793], "temperature": 0.0, "avg_logprob": -0.13032963871955872, "compression_ratio": 1.8556701030927836, "no_speech_prob": 1.9354671944998847e-12}, {"id": 721, "seek": 190276, "start": 1902.76, "end": 1906.32, "text": " And Fliction issues a dire warning about this, doesn't he?", "tokens": [50365, 400, 3235, 4105, 2663, 257, 1264, 9164, 466, 341, 11, 1177, 380, 415, 30, 50543], "temperature": 0.0, "avg_logprob": -0.16734178287466778, "compression_ratio": 1.6666666666666667, "no_speech_prob": 1.5922788261513166e-12}, {"id": 722, "seek": 190276, "start": 1906.4, "end": 1906.76, "text": " He does.", "tokens": [50547, 634, 775, 13, 50565], "temperature": 0.0, "avg_logprob": -0.16734178287466778, "compression_ratio": 1.6666666666666667, "no_speech_prob": 1.5922788261513166e-12}, {"id": 723, "seek": 190276, "start": 1907.24, "end": 1912.6, "text": " Mistaking operational loss for representational loss is a catastrophic failure of management.", "tokens": [50589, 20166, 2456, 16607, 4470, 337, 2906, 1478, 4470, 307, 257, 34915, 7763, 295, 4592, 13, 50857], "temperature": 0.0, "avg_logprob": -0.16734178287466778, "compression_ratio": 1.6666666666666667, "no_speech_prob": 1.5922788261513166e-12}, {"id": 724, "seek": 190276, "start": 1913.12, "end": 1915.3799999999999, "text": " You see, organizations do this constantly.", "tokens": [50883, 509, 536, 11, 6150, 360, 341, 6460, 13, 50996], "temperature": 0.0, "avg_logprob": -0.16734178287466778, "compression_ratio": 1.6666666666666667, "no_speech_prob": 1.5922788261513166e-12}, {"id": 725, "seek": 190276, "start": 1915.62, "end": 1919.5, "text": " Like when a department loses the ability to perform a certain function,", "tokens": [51008, 1743, 562, 257, 5882, 18293, 264, 3485, 281, 2042, 257, 1629, 2445, 11, 51202], "temperature": 0.0, "avg_logprob": -0.16734178287466778, "compression_ratio": 1.6666666666666667, "no_speech_prob": 1.5922788261513166e-12}, {"id": 726, "seek": 190276, "start": 1920.08, "end": 1922.74, "text": " they lose the physical capability or the talent.", "tokens": [51231, 436, 3624, 264, 4001, 13759, 420, 264, 8301, 13, 51364], "temperature": 0.0, "avg_logprob": -0.16734178287466778, "compression_ratio": 1.6666666666666667, "no_speech_prob": 1.5922788261513166e-12}, {"id": 727, "seek": 190276, "start": 1923.3, "end": 1925.22, "text": " The future collapses operationally.", "tokens": [51392, 440, 2027, 48765, 6916, 379, 13, 51488], "temperature": 0.0, "avg_logprob": -0.16734178287466778, "compression_ratio": 1.6666666666666667, "no_speech_prob": 1.5922788261513166e-12}, {"id": 728, "seek": 190276, "start": 1925.44, "end": 1928.4, "text": " But management assumes it's just a representational error.", "tokens": [51499, 583, 4592, 37808, 309, 311, 445, 257, 2906, 1478, 6713, 13, 51647], "temperature": 0.0, "avg_logprob": -0.16734178287466778, "compression_ratio": 1.6666666666666667, "no_speech_prob": 1.5922788261513166e-12}, {"id": 729, "seek": 192840, "start": 1928.4, "end": 1932.5600000000002, "text": " They think they can just update the database schema, redesign the org chart,", "tokens": [50365, 814, 519, 436, 393, 445, 5623, 264, 8149, 34078, 11, 39853, 264, 14045, 6927, 11, 50573], "temperature": 0.0, "avg_logprob": -0.11517757839626735, "compression_ratio": 1.5345454545454544, "no_speech_prob": 1.8977480177595485e-12}, {"id": 730, "seek": 192840, "start": 1932.76, "end": 1935.76, "text": " or invent a new KPI label to recover the lost productivity.", "tokens": [50583, 420, 7962, 257, 777, 591, 31701, 7645, 281, 8114, 264, 2731, 15604, 13, 50733], "temperature": 0.0, "avg_logprob": -0.11517757839626735, "compression_ratio": 1.5345454545454544, "no_speech_prob": 1.8977480177595485e-12}, {"id": 731, "seek": 192840, "start": 1935.96, "end": 1940.92, "text": " Completely unaware that the physical mechanism required to generate those futures has been destroyed.", "tokens": [50743, 39978, 32065, 300, 264, 4001, 7513, 4739, 281, 8460, 729, 26071, 575, 668, 8937, 13, 50991], "temperature": 0.0, "avg_logprob": -0.11517757839626735, "compression_ratio": 1.5345454545454544, "no_speech_prob": 1.8977480177595485e-12}, {"id": 732, "seek": 192840, "start": 1941.14, "end": 1943.0400000000002, "text": " You can't chart your way out of a severed wire.", "tokens": [51002, 509, 393, 380, 6927, 428, 636, 484, 295, 257, 2802, 292, 6234, 13, 51097], "temperature": 0.0, "avg_logprob": -0.11517757839626735, "compression_ratio": 1.5345454545454544, "no_speech_prob": 1.8977480177595485e-12}, {"id": 733, "seek": 192840, "start": 1943.16, "end": 1946.96, "text": " Which brings us incredibly to the grand finale of this text.", "tokens": [51103, 3013, 5607, 505, 6252, 281, 264, 2697, 23510, 295, 341, 2487, 13, 51293], "temperature": 0.0, "avg_logprob": -0.11517757839626735, "compression_ratio": 1.5345454545454544, "no_speech_prob": 1.8977480177595485e-12}, {"id": 734, "seek": 192840, "start": 1947.38, "end": 1950.42, "text": " Scaling this microscopic geometry up to the infinite.", "tokens": [51314, 2747, 4270, 341, 47897, 18426, 493, 281, 264, 13785, 13, 51466], "temperature": 0.0, "avg_logprob": -0.11517757839626735, "compression_ratio": 1.5345454545454544, "no_speech_prob": 1.8977480177595485e-12}, {"id": 735, "seek": 192840, "start": 1950.6000000000001, "end": 1951.48, "text": " The really big data.", "tokens": [51475, 440, 534, 955, 1412, 13, 51519], "temperature": 0.0, "avg_logprob": -0.11517757839626735, "compression_ratio": 1.5345454545454544, "no_speech_prob": 1.8977480177595485e-12}, {"id": 736, "seek": 195148, "start": 1951.48, "end": 1956.44, "text": " How does all of this, the one-bit traffic lights, the ferns, the doctor's charts,", "tokens": [50365, 1012, 775, 439, 295, 341, 11, 264, 472, 12, 5260, 6419, 5811, 11, 264, 283, 1248, 82, 11, 264, 4631, 311, 17767, 11, 50613], "temperature": 0.0, "avg_logprob": -0.1437461632342378, "compression_ratio": 1.5851063829787233, "no_speech_prob": 1.6047216723838464e-12}, {"id": 737, "seek": 195148, "start": 1956.98, "end": 1961.94, "text": " apply to the massive, messy, infinite real world of big data and artificial intelligence?", "tokens": [50640, 3079, 281, 264, 5994, 11, 16191, 11, 13785, 957, 1002, 295, 955, 1412, 293, 11677, 7599, 30, 50888], "temperature": 0.0, "avg_logprob": -0.1437461632342378, "compression_ratio": 1.5851063829787233, "no_speech_prob": 1.6047216723838464e-12}, {"id": 738, "seek": 195148, "start": 1962.6, "end": 1964.8600000000001, "text": " We look at Chapter 10's Graphing the Infinite.", "tokens": [50921, 492, 574, 412, 18874, 1266, 311, 460, 4007, 571, 264, 43368, 13, 51034], "temperature": 0.0, "avg_logprob": -0.1437461632342378, "compression_ratio": 1.5851063829787233, "no_speech_prob": 1.6047216723838464e-12}, {"id": 739, "seek": 195148, "start": 1965.04, "end": 1967.34, "text": " We enter the world of RDF triple stores.", "tokens": [51043, 492, 3242, 264, 1002, 295, 49488, 37, 15508, 9512, 13, 51158], "temperature": 0.0, "avg_logprob": -0.1437461632342378, "compression_ratio": 1.5851063829787233, "no_speech_prob": 1.6047216723838464e-12}, {"id": 740, "seek": 195148, "start": 1967.7, "end": 1969.82, "text": " Okay, what is an RDF triple store?", "tokens": [51176, 1033, 11, 437, 307, 364, 49488, 37, 15508, 3531, 30, 51282], "temperature": 0.0, "avg_logprob": -0.1437461632342378, "compression_ratio": 1.5851063829787233, "no_speech_prob": 1.6047216723838464e-12}, {"id": 741, "seek": 195148, "start": 1970.1200000000001, "end": 1974.66, "text": " To understand this, you have to abandon the idea of a relational database.", "tokens": [51297, 1407, 1223, 341, 11, 291, 362, 281, 9072, 264, 1558, 295, 257, 38444, 8149, 13, 51524], "temperature": 0.0, "avg_logprob": -0.1437461632342378, "compression_ratio": 1.5851063829787233, "no_speech_prob": 1.6047216723838464e-12}, {"id": 742, "seek": 195148, "start": 1975.3, "end": 1977.78, "text": " Most people think of data like an Excel spreadsheet.", "tokens": [51556, 4534, 561, 519, 295, 1412, 411, 364, 19060, 27733, 13, 51680], "temperature": 0.0, "avg_logprob": -0.1437461632342378, "compression_ratio": 1.5851063829787233, "no_speech_prob": 1.6047216723838464e-12}, {"id": 743, "seek": 195148, "start": 1977.98, "end": 1979.06, "text": " Right, columns and rows.", "tokens": [51690, 1779, 11, 13766, 293, 13241, 13, 51744], "temperature": 0.0, "avg_logprob": -0.1437461632342378, "compression_ratio": 1.5851063829787233, "no_speech_prob": 1.6047216723838464e-12}, {"id": 744, "seek": 197906, "start": 1979.06, "end": 1982.12, "text": " You have entities as the rows and properties as the columns.", "tokens": [50365, 509, 362, 16667, 382, 264, 13241, 293, 7221, 382, 264, 13766, 13, 50518], "temperature": 0.0, "avg_logprob": -0.15841409895155165, "compression_ratio": 1.73992673992674, "no_speech_prob": 3.2406076520136162e-12}, {"id": 745, "seek": 197906, "start": 1983.08, "end": 1984.72, "text": " It is a neat, rigid grid.", "tokens": [50566, 467, 307, 257, 10654, 11, 22195, 10748, 13, 50648], "temperature": 0.0, "avg_logprob": -0.15841409895155165, "compression_ratio": 1.73992673992674, "no_speech_prob": 3.2406076520136162e-12}, {"id": 746, "seek": 197906, "start": 1985.32, "end": 1987.76, "text": " But a graph database works entirely differently.", "tokens": [50678, 583, 257, 4295, 8149, 1985, 7696, 7614, 13, 50800], "temperature": 0.0, "avg_logprob": -0.15841409895155165, "compression_ratio": 1.73992673992674, "no_speech_prob": 3.2406076520136162e-12}, {"id": 747, "seek": 197906, "start": 1988.24, "end": 1989.8999999999999, "text": " It is built entirely out of relations.", "tokens": [50824, 467, 307, 3094, 7696, 484, 295, 2299, 13, 50907], "temperature": 0.0, "avg_logprob": -0.15841409895155165, "compression_ratio": 1.73992673992674, "no_speech_prob": 3.2406076520136162e-12}, {"id": 748, "seek": 197906, "start": 1990.04, "end": 1991.02, "text": " So no rows and columns?", "tokens": [50914, 407, 572, 13241, 293, 13766, 30, 50963], "temperature": 0.0, "avg_logprob": -0.15841409895155165, "compression_ratio": 1.73992673992674, "no_speech_prob": 3.2406076520136162e-12}, {"id": 749, "seek": 197906, "start": 1991.3799999999999, "end": 1991.6399999999999, "text": " None.", "tokens": [50981, 14492, 13, 50994], "temperature": 0.0, "avg_logprob": -0.15841409895155165, "compression_ratio": 1.73992673992674, "no_speech_prob": 3.2406076520136162e-12}, {"id": 750, "seek": 197906, "start": 1992.36, "end": 1995.8999999999999, "text": " A single fact in this database, like Paris is the capital of France,", "tokens": [51030, 316, 2167, 1186, 294, 341, 8149, 11, 411, 8380, 307, 264, 4238, 295, 6190, 11, 51207], "temperature": 0.0, "avg_logprob": -0.15841409895155165, "compression_ratio": 1.73992673992674, "no_speech_prob": 3.2406076520136162e-12}, {"id": 751, "seek": 197906, "start": 1996.1, "end": 1997.46, "text": " is not a row and a table.", "tokens": [51217, 307, 406, 257, 5386, 293, 257, 3199, 13, 51285], "temperature": 0.0, "avg_logprob": -0.15841409895155165, "compression_ratio": 1.73992673992674, "no_speech_prob": 3.2406076520136162e-12}, {"id": 752, "seek": 197906, "start": 1997.9199999999998, "end": 2001.1399999999999, "text": " It is an edge, a literal line, connecting two independent nodes.", "tokens": [51308, 467, 307, 364, 4691, 11, 257, 20411, 1622, 11, 11015, 732, 6695, 13891, 13, 51469], "temperature": 0.0, "avg_logprob": -0.15841409895155165, "compression_ratio": 1.73992673992674, "no_speech_prob": 3.2406076520136162e-12}, {"id": 753, "seek": 197906, "start": 2001.34, "end": 2004.08, "text": " And when you build an entire database out of relational edges,", "tokens": [51479, 400, 562, 291, 1322, 364, 2302, 8149, 484, 295, 38444, 8819, 11, 51616], "temperature": 0.0, "avg_logprob": -0.15841409895155165, "compression_ratio": 1.73992673992674, "no_speech_prob": 3.2406076520136162e-12}, {"id": 754, "seek": 197906, "start": 2004.4199999999998, "end": 2006.96, "text": " it stops behaving like a static filing cabinet.", "tokens": [51633, 309, 10094, 35263, 411, 257, 13437, 26854, 15188, 13, 51760], "temperature": 0.0, "avg_logprob": -0.15841409895155165, "compression_ratio": 1.73992673992674, "no_speech_prob": 3.2406076520136162e-12}, {"id": 755, "seek": 200696, "start": 2006.96, "end": 2010.18, "text": " And it starts behaving exactly like the branching cobological features", "tokens": [50365, 400, 309, 3719, 35263, 2293, 411, 264, 9819, 278, 39527, 4383, 4122, 50526], "temperature": 0.0, "avg_logprob": -0.2275858296976461, "compression_ratio": 1.5118483412322274, "no_speech_prob": 1.3881435063922698e-12}, {"id": 756, "seek": 200696, "start": 2010.18, "end": 2011.66, "text": " we've been talking about this whole time.", "tokens": [50526, 321, 600, 668, 1417, 466, 341, 1379, 565, 13, 50600], "temperature": 0.0, "avg_logprob": -0.2275858296976461, "compression_ratio": 1.5118483412322274, "no_speech_prob": 1.3881435063922698e-12}, {"id": 757, "seek": 200696, "start": 2011.78, "end": 2015.38, "text": " It becomes a massive geometric space defined by reachability closure.", "tokens": [50606, 467, 3643, 257, 5994, 33246, 1901, 7642, 538, 2524, 2310, 24653, 13, 50786], "temperature": 0.0, "avg_logprob": -0.2275858296976461, "compression_ratio": 1.5118483412322274, "no_speech_prob": 1.3881435063922698e-12}, {"id": 758, "seek": 200696, "start": 2015.58, "end": 2016.6200000000001, "text": " Reachability closure.", "tokens": [50796, 35904, 2310, 24653, 13, 50848], "temperature": 0.0, "avg_logprob": -0.2275858296976461, "compression_ratio": 1.5118483412322274, "no_speech_prob": 1.3881435063922698e-12}, {"id": 759, "seek": 200696, "start": 2017.04, "end": 2020.38, "text": " In a graph network, neighborhoods don't grow linearly.", "tokens": [50869, 682, 257, 4295, 3209, 11, 20052, 500, 380, 1852, 43586, 13, 51036], "temperature": 0.0, "avg_logprob": -0.2275858296976461, "compression_ratio": 1.5118483412322274, "no_speech_prob": 1.3881435063922698e-12}, {"id": 760, "seek": 200696, "start": 2021.18, "end": 2021.96, "text": " They grow combinatorially.", "tokens": [51076, 814, 1852, 2512, 31927, 2270, 13, 51115], "temperature": 0.0, "avg_logprob": -0.2275858296976461, "compression_ratio": 1.5118483412322274, "no_speech_prob": 1.3881435063922698e-12}, {"id": 761, "seek": 200696, "start": 2022.7, "end": 2023.88, "text": " What does that mean in practice?", "tokens": [51152, 708, 775, 300, 914, 294, 3124, 30, 51211], "temperature": 0.0, "avg_logprob": -0.2275858296976461, "compression_ratio": 1.5118483412322274, "no_speech_prob": 1.3881435063922698e-12}, {"id": 762, "seek": 202388, "start": 2023.88, "end": 2028.88, "text": " If you want to query everything connected to a specific node within a T-step radius,", "tokens": [50365, 759, 291, 528, 281, 14581, 1203, 4582, 281, 257, 2685, 9984, 1951, 257, 314, 12, 16792, 15845, 11, 50615], "temperature": 0.0, "avg_logprob": -0.15545810185945952, "compression_ratio": 1.6564885496183206, "no_speech_prob": 1.5191852767090785e-12}, {"id": 763, "seek": 202388, "start": 2029.44, "end": 2032.6200000000001, "text": " say everything that is four hops away from Paris,", "tokens": [50643, 584, 1203, 300, 307, 1451, 47579, 1314, 490, 8380, 11, 50802], "temperature": 0.0, "avg_logprob": -0.15545810185945952, "compression_ratio": 1.6564885496183206, "no_speech_prob": 1.5191852767090785e-12}, {"id": 764, "seek": 202388, "start": 2033.1000000000001, "end": 2038.5600000000002, "text": " that neighborhood expands at a terrifying exponential rate.", "tokens": [50826, 300, 7630, 33706, 412, 257, 18106, 21510, 3314, 13, 51099], "temperature": 0.0, "avg_logprob": -0.15545810185945952, "compression_ratio": 1.6564885496183206, "no_speech_prob": 1.5191852767090785e-12}, {"id": 765, "seek": 202388, "start": 2038.66, "end": 2042.3400000000001, "text": " The text drops a statistic here that absolutely broke my brain.", "tokens": [51104, 440, 2487, 11438, 257, 29588, 510, 300, 3122, 6902, 452, 3567, 13, 51288], "temperature": 0.0, "avg_logprob": -0.15545810185945952, "compression_ratio": 1.6564885496183206, "no_speech_prob": 1.5191852767090785e-12}, {"id": 766, "seek": 202388, "start": 2042.48, "end": 2043.16, "text": " The storage one.", "tokens": [51295, 440, 6725, 472, 13, 51329], "temperature": 0.0, "avg_logprob": -0.15545810185945952, "compression_ratio": 1.6564885496183206, "no_speech_prob": 1.5191852767090785e-12}, {"id": 767, "seek": 202388, "start": 2043.2600000000002, "end": 2043.5200000000002, "text": " Yes.", "tokens": [51334, 1079, 13, 51347], "temperature": 0.0, "avg_logprob": -0.15545810185945952, "compression_ratio": 1.6564885496183206, "no_speech_prob": 1.5191852767090785e-12}, {"id": 768, "seek": 202388, "start": 2043.8000000000002, "end": 2049.7000000000003, "text": " It proves that, structurally, a T-step neighborhood can actually contain more volumetric data", "tokens": [51361, 467, 25019, 300, 11, 6594, 6512, 11, 257, 314, 12, 16792, 7630, 393, 767, 5304, 544, 1996, 449, 17475, 1412, 51656], "temperature": 0.0, "avg_logprob": -0.15545810185945952, "compression_ratio": 1.6564885496183206, "no_speech_prob": 1.5191852767090785e-12}, {"id": 769, "seek": 202388, "start": 2049.7000000000003, "end": 2053.04, "text": " than the total edge storage of the entire physical network.", "tokens": [51656, 813, 264, 3217, 4691, 6725, 295, 264, 2302, 4001, 3209, 13, 51823], "temperature": 0.0, "avg_logprob": -0.15545810185945952, "compression_ratio": 1.6564885496183206, "no_speech_prob": 1.5191852767090785e-12}, {"id": 770, "seek": 205304, "start": 2053.04, "end": 2055.54, "text": " Which just sounds impossible when you first hear it.", "tokens": [50365, 3013, 445, 3263, 6243, 562, 291, 700, 1568, 309, 13, 50490], "temperature": 0.0, "avg_logprob": -0.16920359802246093, "compression_ratio": 1.6720257234726688, "no_speech_prob": 1.8324736259650587e-12}, {"id": 771, "seek": 205304, "start": 2055.88, "end": 2058.18, "text": " Let me say that again, because it really does sound impossible.", "tokens": [50507, 961, 385, 584, 300, 797, 11, 570, 309, 534, 775, 1626, 6243, 13, 50622], "temperature": 0.0, "avg_logprob": -0.16920359802246093, "compression_ratio": 1.6720257234726688, "no_speech_prob": 1.8324736259650587e-12}, {"id": 772, "seek": 205304, "start": 2058.74, "end": 2061.6, "text": " The volume of the possible pathways you can take through the data", "tokens": [50650, 440, 5523, 295, 264, 1944, 22988, 291, 393, 747, 807, 264, 1412, 50793], "temperature": 0.0, "avg_logprob": -0.16920359802246093, "compression_ratio": 1.6720257234726688, "no_speech_prob": 1.8324736259650587e-12}, {"id": 773, "seek": 205304, "start": 2061.6, "end": 2065.04, "text": " exceeds the physical hard drive space holding the data itself.", "tokens": [50793, 43305, 264, 4001, 1152, 3332, 1901, 5061, 264, 1412, 2564, 13, 50965], "temperature": 0.0, "avg_logprob": -0.16920359802246093, "compression_ratio": 1.6720257234726688, "no_speech_prob": 1.8324736259650587e-12}, {"id": 774, "seek": 205304, "start": 2065.32, "end": 2068.38, "text": " Because the network isn't storing every completed pathway.", "tokens": [50979, 1436, 264, 3209, 1943, 380, 26085, 633, 7365, 18590, 13, 51132], "temperature": 0.0, "avg_logprob": -0.16920359802246093, "compression_ratio": 1.6720257234726688, "no_speech_prob": 1.8324736259650587e-12}, {"id": 775, "seek": 205304, "start": 2068.68, "end": 2072.2599999999998, "text": " It is storing the combinatorial rules to generate them on the fly.", "tokens": [51147, 467, 307, 26085, 264, 2512, 31927, 831, 4474, 281, 8460, 552, 322, 264, 3603, 13, 51326], "temperature": 0.0, "avg_logprob": -0.16920359802246093, "compression_ratio": 1.6720257234726688, "no_speech_prob": 1.8324736259650587e-12}, {"id": 776, "seek": 205304, "start": 2072.46, "end": 2075.0, "text": " Just like the Hutchinson operators generating the FERN.", "tokens": [51336, 1449, 411, 264, 48499, 14321, 19077, 17746, 264, 479, 1598, 45, 13, 51463], "temperature": 0.0, "avg_logprob": -0.16920359802246093, "compression_ratio": 1.6720257234726688, "no_speech_prob": 1.8324736259650587e-12}, {"id": 777, "seek": 205304, "start": 2075.04, "end": 2075.38, "text": " Exactly.", "tokens": [51465, 7587, 13, 51482], "temperature": 0.0, "avg_logprob": -0.16920359802246093, "compression_ratio": 1.6720257234726688, "no_speech_prob": 1.8324736259650587e-12}, {"id": 778, "seek": 205304, "start": 2075.52, "end": 2078.02, "text": " But with one critical, terrifying difference.", "tokens": [51489, 583, 365, 472, 4924, 11, 18106, 2649, 13, 51614], "temperature": 0.0, "avg_logprob": -0.16920359802246093, "compression_ratio": 1.6720257234726688, "no_speech_prob": 1.8324736259650587e-12}, {"id": 779, "seek": 205304, "start": 2078.12, "end": 2080.68, "text": " The FERN is governed by contractions.", "tokens": [51619, 440, 479, 1598, 45, 307, 35529, 538, 4364, 626, 13, 51747], "temperature": 0.0, "avg_logprob": -0.16920359802246093, "compression_ratio": 1.6720257234726688, "no_speech_prob": 1.8324736259650587e-12}, {"id": 780, "seek": 208068, "start": 2080.68, "end": 2081.6, "text": " It converges.", "tokens": [50365, 467, 9652, 2880, 13, 50411], "temperature": 0.0, "avg_logprob": -0.19537586170238452, "compression_ratio": 1.519650655021834, "no_speech_prob": 1.7622716437168395e-12}, {"id": 781, "seek": 208068, "start": 2082.0, "end": 2084.16, "text": " The graph database is governed by accumulation.", "tokens": [50431, 440, 4295, 8149, 307, 35529, 538, 35647, 13, 50539], "temperature": 0.0, "avg_logprob": -0.19537586170238452, "compression_ratio": 1.519650655021834, "no_speech_prob": 1.7622716437168395e-12}, {"id": 782, "seek": 208068, "start": 2084.74, "end": 2086.8999999999996, "text": " It grows outward without a limit shape.", "tokens": [50568, 467, 13156, 26914, 1553, 257, 4948, 3909, 13, 50676], "temperature": 0.0, "avg_logprob": -0.19537586170238452, "compression_ratio": 1.519650655021834, "no_speech_prob": 1.7622716437168395e-12}, {"id": 783, "seek": 208068, "start": 2087.2999999999997, "end": 2090.1, "text": " It is spilling water on the floor, but the water is multiplying.", "tokens": [50696, 467, 307, 637, 7345, 1281, 322, 264, 4123, 11, 457, 264, 1281, 307, 30955, 13, 50836], "temperature": 0.0, "avg_logprob": -0.19537586170238452, "compression_ratio": 1.519650655021834, "no_speech_prob": 1.7622716437168395e-12}, {"id": 784, "seek": 208068, "start": 2090.94, "end": 2096.16, "text": " And in a space that massive and explosive, context becomes a matter of pure survival.", "tokens": [50878, 400, 294, 257, 1901, 300, 5994, 293, 24630, 11, 4319, 3643, 257, 1871, 295, 6075, 12559, 13, 51139], "temperature": 0.0, "avg_logprob": -0.19537586170238452, "compression_ratio": 1.519650655021834, "no_speech_prob": 1.7622716437168395e-12}, {"id": 785, "seek": 208068, "start": 2096.52, "end": 2096.96, "text": " Oh, so.", "tokens": [51157, 876, 11, 370, 13, 51179], "temperature": 0.0, "avg_logprob": -0.19537586170238452, "compression_ratio": 1.519650655021834, "no_speech_prob": 1.7622716437168395e-12}, {"id": 786, "seek": 208068, "start": 2097.24, "end": 2099.98, "text": " The book introduces context coordinates to manage this.", "tokens": [51193, 440, 1446, 31472, 4319, 21056, 281, 3067, 341, 13, 51330], "temperature": 0.0, "avg_logprob": -0.19537586170238452, "compression_ratio": 1.519650655021834, "no_speech_prob": 1.7622716437168395e-12}, {"id": 787, "seek": 208068, "start": 2100.56, "end": 2101.52, "text": " Let's look at a simple example.", "tokens": [51359, 961, 311, 574, 412, 257, 2199, 1365, 13, 51407], "temperature": 0.0, "avg_logprob": -0.19537586170238452, "compression_ratio": 1.519650655021834, "no_speech_prob": 1.7622716437168395e-12}, {"id": 788, "seek": 210152, "start": 2101.52, "end": 2105.2, "text": " A database holds employment records for a woman named Alice.", "tokens": [50365, 316, 8149, 9190, 11949, 7724, 337, 257, 3059, 4926, 16004, 13, 50549], "temperature": 0.0, "avg_logprob": -0.21040828807933912, "compression_ratio": 1.664092664092664, "no_speech_prob": 1.6750210159871548e-12}, {"id": 789, "seek": 210152, "start": 2105.72, "end": 2108.74, "text": " In 2024, Alice worked at Acme Corp.", "tokens": [50575, 682, 45237, 11, 16004, 2732, 412, 5097, 1398, 3925, 79, 13, 50726], "temperature": 0.0, "avg_logprob": -0.21040828807933912, "compression_ratio": 1.664092664092664, "no_speech_prob": 1.6750210159871548e-12}, {"id": 790, "seek": 210152, "start": 2109.5, "end": 2112.12, "text": " In 2026, Alice worked at Beta Corp.", "tokens": [50764, 682, 945, 10880, 11, 16004, 2732, 412, 33286, 3925, 79, 13, 50895], "temperature": 0.0, "avg_logprob": -0.21040828807933912, "compression_ratio": 1.664092664092664, "no_speech_prob": 1.6750210159871548e-12}, {"id": 791, "seek": 210152, "start": 2112.28, "end": 2112.5, "text": " Okay.", "tokens": [50903, 1033, 13, 50914], "temperature": 0.0, "avg_logprob": -0.21040828807933912, "compression_ratio": 1.664092664092664, "no_speech_prob": 1.6750210159871548e-12}, {"id": 792, "seek": 210152, "start": 2112.84, "end": 2114.34, "text": " Two different jobs, two different times.", "tokens": [50931, 4453, 819, 4782, 11, 732, 819, 1413, 13, 51006], "temperature": 0.0, "avg_logprob": -0.21040828807933912, "compression_ratio": 1.664092664092664, "no_speech_prob": 1.6750210159871548e-12}, {"id": 793, "seek": 210152, "start": 2114.46, "end": 2117.42, "text": " If your database schema is poorly designed and you drop the year,", "tokens": [51012, 759, 428, 8149, 34078, 307, 22271, 4761, 293, 291, 3270, 264, 1064, 11, 51160], "temperature": 0.0, "avg_logprob": -0.21040828807933912, "compression_ratio": 1.664092664092664, "no_speech_prob": 1.6750210159871548e-12}, {"id": 794, "seek": 210152, "start": 2118.02, "end": 2120.72, "text": " if you fail to include the context coordinate,", "tokens": [51190, 498, 291, 3061, 281, 4090, 264, 4319, 15670, 11, 51325], "temperature": 0.0, "avg_logprob": -0.21040828807933912, "compression_ratio": 1.664092664092664, "no_speech_prob": 1.6750210159871548e-12}, {"id": 795, "seek": 210152, "start": 2121.9, "end": 2124.3, "text": " the system collapses those two facts.", "tokens": [51384, 264, 1185, 48765, 729, 732, 9130, 13, 51504], "temperature": 0.0, "avg_logprob": -0.21040828807933912, "compression_ratio": 1.664092664092664, "no_speech_prob": 1.6750210159871548e-12}, {"id": 796, "seek": 210152, "start": 2124.4, "end": 2126.08, "text": " It suffers representational loss.", "tokens": [51509, 467, 33776, 2906, 1478, 4470, 13, 51593], "temperature": 0.0, "avg_logprob": -0.21040828807933912, "compression_ratio": 1.664092664092664, "no_speech_prob": 1.6750210159871548e-12}, {"id": 797, "seek": 210152, "start": 2126.42, "end": 2129.52, "text": " The system now believes that Alice works both jobs simultaneously.", "tokens": [51610, 440, 1185, 586, 12307, 300, 16004, 1985, 1293, 4782, 16561, 13, 51765], "temperature": 0.0, "avg_logprob": -0.21040828807933912, "compression_ratio": 1.664092664092664, "no_speech_prob": 1.6750210159871548e-12}, {"id": 798, "seek": 212952, "start": 2129.52, "end": 2129.96, "text": " Exactly.", "tokens": [50365, 7587, 13, 50387], "temperature": 0.0, "avg_logprob": -0.1543739891052246, "compression_ratio": 1.5643939393939394, "no_speech_prob": 1.6878762927260982e-12}, {"id": 799, "seek": 212952, "start": 2130.46, "end": 2133.84, "text": " And if the database physically isn't built to hold a context tag,", "tokens": [50412, 400, 498, 264, 8149, 9762, 1943, 380, 3094, 281, 1797, 257, 4319, 6162, 11, 50581], "temperature": 0.0, "avg_logprob": -0.1543739891052246, "compression_ratio": 1.5643939393939394, "no_speech_prob": 1.6878762927260982e-12}, {"id": 800, "seek": 212952, "start": 2134.04, "end": 2137.94, "text": " if there is no column for year, it crosses over into operational loss.", "tokens": [50591, 498, 456, 307, 572, 7738, 337, 1064, 11, 309, 28467, 670, 666, 16607, 4470, 13, 50786], "temperature": 0.0, "avg_logprob": -0.1543739891052246, "compression_ratio": 1.5643939393939394, "no_speech_prob": 1.6878762927260982e-12}, {"id": 801, "seek": 212952, "start": 2138.14, "end": 2139.32, "text": " The past is erased.", "tokens": [50796, 440, 1791, 307, 38359, 13, 50855], "temperature": 0.0, "avg_logprob": -0.1543739891052246, "compression_ratio": 1.5643939393939394, "no_speech_prob": 1.6878762927260982e-12}, {"id": 802, "seek": 212952, "start": 2139.6, "end": 2145.02, "text": " The chronological geometry of Alice's life is permanently collapsed into a flat, contradictory state.", "tokens": [50869, 440, 19393, 4383, 18426, 295, 16004, 311, 993, 307, 24042, 24578, 666, 257, 4962, 11, 49555, 1785, 13, 51140], "temperature": 0.0, "avg_logprob": -0.1543739891052246, "compression_ratio": 1.5643939393939394, "no_speech_prob": 1.6878762927260982e-12}, {"id": 803, "seek": 212952, "start": 2145.2599999999998, "end": 2150.48, "text": " This maps perfectly onto the cutting edge of how modern artificial intelligence and graph embeddings operate.", "tokens": [51152, 639, 11317, 6239, 3911, 264, 6492, 4691, 295, 577, 4363, 11677, 7599, 293, 4295, 12240, 29432, 9651, 13, 51413], "temperature": 0.0, "avg_logprob": -0.1543739891052246, "compression_ratio": 1.5643939393939394, "no_speech_prob": 1.6878762927260982e-12}, {"id": 804, "seek": 212952, "start": 2150.54, "end": 2152.02, "text": " Oh, this is the AI connection.", "tokens": [51416, 876, 11, 341, 307, 264, 7318, 4984, 13, 51490], "temperature": 0.0, "avg_logprob": -0.1543739891052246, "compression_ratio": 1.5643939393939394, "no_speech_prob": 1.6878762927260982e-12}, {"id": 805, "seek": 212952, "start": 2152.4, "end": 2152.74, "text": " Yes.", "tokens": [51509, 1079, 13, 51526], "temperature": 0.0, "avg_logprob": -0.1543739891052246, "compression_ratio": 1.5643939393939394, "no_speech_prob": 1.6878762927260982e-12}, {"id": 806, "seek": 215274, "start": 2152.74, "end": 2158.08, "text": " When an AI model looks at one of these massive combinatorial graph databases,", "tokens": [50365, 1133, 364, 7318, 2316, 1542, 412, 472, 295, 613, 5994, 2512, 31927, 831, 4295, 22380, 11, 50632], "temperature": 0.0, "avg_logprob": -0.17414621777004666, "compression_ratio": 1.5697211155378485, "no_speech_prob": 1.9968885486137955e-12}, {"id": 807, "seek": 215274, "start": 2158.62, "end": 2163.52, "text": " it does not attempt to compute the literal exact equality of futures.", "tokens": [50659, 309, 775, 406, 5217, 281, 14722, 264, 20411, 1900, 14949, 295, 26071, 13, 50904], "temperature": 0.0, "avg_logprob": -0.17414621777004666, "compression_ratio": 1.5697211155378485, "no_speech_prob": 1.9968885486137955e-12}, {"id": 808, "seek": 215274, "start": 2163.8399999999997, "end": 2166.2, "text": " Because it knows what we learned from the doctor's chart.", "tokens": [50920, 1436, 309, 3255, 437, 321, 3264, 490, 264, 4631, 311, 6927, 13, 51038], "temperature": 0.0, "avg_logprob": -0.17414621777004666, "compression_ratio": 1.5697211155378485, "no_speech_prob": 1.9968885486137955e-12}, {"id": 809, "seek": 215274, "start": 2166.64, "end": 2169.68, "text": " Demanding exact gamma equivalents destroys meaning.", "tokens": [51060, 4686, 42389, 1900, 15546, 9052, 791, 36714, 3620, 13, 51212], "temperature": 0.0, "avg_logprob": -0.17414621777004666, "compression_ratio": 1.5697211155378485, "no_speech_prob": 1.9968885486137955e-12}, {"id": 810, "seek": 215274, "start": 2170.16, "end": 2175.2799999999997, "text": " And the compute required to find perfect matches in an infinite graph would literally break the machine.", "tokens": [51236, 400, 264, 14722, 4739, 281, 915, 2176, 10676, 294, 364, 13785, 4295, 576, 3736, 1821, 264, 3479, 13, 51492], "temperature": 0.0, "avg_logprob": -0.17414621777004666, "compression_ratio": 1.5697211155378485, "no_speech_prob": 1.9968885486137955e-12}, {"id": 811, "seek": 215274, "start": 2175.4199999999996, "end": 2176.9599999999996, "text": " So what does the AI do instead?", "tokens": [51499, 407, 437, 775, 264, 7318, 360, 2602, 30, 51576], "temperature": 0.0, "avg_logprob": -0.17414621777004666, "compression_ratio": 1.5697211155378485, "no_speech_prob": 1.9968885486137955e-12}, {"id": 812, "seek": 217696, "start": 2176.96, "end": 2178.88, "text": " It computes a distance metric.", "tokens": [50365, 467, 715, 1819, 257, 4560, 20678, 13, 50461], "temperature": 0.0, "avg_logprob": -0.1600254531455251, "compression_ratio": 1.6445993031358885, "no_speech_prob": 2.416572150720775e-12}, {"id": 813, "seek": 217696, "start": 2179.46, "end": 2180.78, "text": " It uses D gamma.", "tokens": [50490, 467, 4960, 413, 15546, 13, 50556], "temperature": 0.0, "avg_logprob": -0.1600254531455251, "compression_ratio": 1.6445993031358885, "no_speech_prob": 2.416572150720775e-12}, {"id": 814, "seek": 217696, "start": 2181.06, "end": 2182.38, "text": " The distance between futures.", "tokens": [50570, 440, 4560, 1296, 26071, 13, 50636], "temperature": 0.0, "avg_logprob": -0.1600254531455251, "compression_ratio": 1.6445993031358885, "no_speech_prob": 2.416572150720775e-12}, {"id": 815, "seek": 217696, "start": 2182.62, "end": 2182.84, "text": " Right.", "tokens": [50648, 1779, 13, 50659], "temperature": 0.0, "avg_logprob": -0.1600254531455251, "compression_ratio": 1.6445993031358885, "no_speech_prob": 2.416572150720775e-12}, {"id": 816, "seek": 217696, "start": 2183.16, "end": 2187.98, "text": " The algorithm aggregates the massive T-hop neighborhoods of data and simply asks,", "tokens": [50675, 440, 9284, 16743, 1024, 264, 5994, 314, 12, 9050, 20052, 295, 1412, 293, 2935, 8962, 11, 50916], "temperature": 0.0, "avg_logprob": -0.1600254531455251, "compression_ratio": 1.6445993031358885, "no_speech_prob": 2.416572150720775e-12}, {"id": 817, "seek": 217696, "start": 2188.38, "end": 2192.84, "text": " how structurally similar are these two sprawling forests of information?", "tokens": [50936, 577, 6594, 6512, 2531, 366, 613, 732, 22734, 1688, 21700, 295, 1589, 30, 51159], "temperature": 0.0, "avg_logprob": -0.1600254531455251, "compression_ratio": 1.6445993031358885, "no_speech_prob": 2.416572150720775e-12}, {"id": 818, "seek": 217696, "start": 2193.06, "end": 2197.86, "text": " It looks for the G equivalents we talked about earlier and measures the topological distance between histories.", "tokens": [51170, 467, 1542, 337, 264, 460, 9052, 791, 321, 2825, 466, 3071, 293, 8000, 264, 1192, 4383, 4560, 1296, 30631, 13, 51410], "temperature": 0.0, "avg_logprob": -0.1600254531455251, "compression_ratio": 1.6445993031358885, "no_speech_prob": 2.416572150720775e-12}, {"id": 819, "seek": 217696, "start": 2198.36, "end": 2203.4, "text": " I want to connect this directly to how recommendation algorithms work for you, the listener.", "tokens": [51435, 286, 528, 281, 1745, 341, 3838, 281, 577, 11879, 14642, 589, 337, 291, 11, 264, 31569, 13, 51687], "temperature": 0.0, "avg_logprob": -0.1600254531455251, "compression_ratio": 1.6445993031358885, "no_speech_prob": 2.416572150720775e-12}, {"id": 820, "seek": 217696, "start": 2203.62, "end": 2204.76, "text": " Yeah, bring it home for us.", "tokens": [51698, 865, 11, 1565, 309, 1280, 337, 505, 13, 51755], "temperature": 0.0, "avg_logprob": -0.1600254531455251, "compression_ratio": 1.6445993031358885, "no_speech_prob": 2.416572150720775e-12}, {"id": 821, "seek": 220476, "start": 2204.76, "end": 2208.6600000000003, "text": " Think about the algorithm suggesting your next YouTube video or your next Amazon purchase.", "tokens": [50365, 6557, 466, 264, 9284, 18094, 428, 958, 3088, 960, 420, 428, 958, 6795, 8110, 13, 50560], "temperature": 0.0, "avg_logprob": -0.13461270422305702, "compression_ratio": 1.6789667896678966, "no_speech_prob": 1.72118742869376e-12}, {"id": 822, "seek": 220476, "start": 2209.0800000000004, "end": 2210.7000000000003, "text": " That AI does not care about your name.", "tokens": [50581, 663, 7318, 775, 406, 1127, 466, 428, 1315, 13, 50662], "temperature": 0.0, "avg_logprob": -0.13461270422305702, "compression_ratio": 1.6789667896678966, "no_speech_prob": 1.72118742869376e-12}, {"id": 823, "seek": 220476, "start": 2211.1400000000003, "end": 2214.78, "text": " It doesn't care about your representational label or your semantic category.", "tokens": [50684, 467, 1177, 380, 1127, 466, 428, 2906, 1478, 7645, 420, 428, 47982, 7719, 13, 50866], "temperature": 0.0, "avg_logprob": -0.13461270422305702, "compression_ratio": 1.6789667896678966, "no_speech_prob": 1.72118742869376e-12}, {"id": 824, "seek": 220476, "start": 2214.86, "end": 2218.1000000000004, "text": " It cares exclusively about your T-hop neighborhood of clicks.", "tokens": [50870, 467, 12310, 20638, 466, 428, 314, 12, 9050, 7630, 295, 18521, 13, 51032], "temperature": 0.0, "avg_logprob": -0.13461270422305702, "compression_ratio": 1.6789667896678966, "no_speech_prob": 1.72118742869376e-12}, {"id": 825, "seek": 220476, "start": 2218.5200000000004, "end": 2223.7200000000003, "text": " It looks at the massive branching, combinatorial geometry of your past behavior,", "tokens": [51053, 467, 1542, 412, 264, 5994, 9819, 278, 11, 2512, 31927, 831, 18426, 295, 428, 1791, 5223, 11, 51313], "temperature": 0.0, "avg_logprob": -0.13461270422305702, "compression_ratio": 1.6789667896678966, "no_speech_prob": 1.72118742869376e-12}, {"id": 826, "seek": 220476, "start": 2224.1200000000003, "end": 2227.5600000000004, "text": " your watch history, the time you spent hovering over a thumbnail.", "tokens": [51333, 428, 1159, 2503, 11, 264, 565, 291, 4418, 44923, 670, 257, 26746, 13, 51505], "temperature": 0.0, "avg_logprob": -0.13461270422305702, "compression_ratio": 1.6789667896678966, "no_speech_prob": 1.72118742869376e-12}, {"id": 827, "seek": 220476, "start": 2228.0800000000004, "end": 2230.34, "text": " It maps that chaotic fern of your life.", "tokens": [51531, 467, 11317, 300, 27013, 283, 1248, 295, 428, 993, 13, 51644], "temperature": 0.0, "avg_logprob": -0.13461270422305702, "compression_ratio": 1.6789667896678966, "no_speech_prob": 1.72118742869376e-12}, {"id": 828, "seek": 223034, "start": 2230.34, "end": 2237.56, "text": " And it scours the database to find another user whose branching geometry looks structurally similar to yours.", "tokens": [50365, 400, 309, 795, 5067, 264, 8149, 281, 915, 1071, 4195, 6104, 9819, 278, 18426, 1542, 6594, 6512, 2531, 281, 6342, 13, 50726], "temperature": 0.0, "avg_logprob": -0.15531020363171896, "compression_ratio": 1.5851851851851853, "no_speech_prob": 1.7144808793154165e-12}, {"id": 829, "seek": 223034, "start": 2237.7200000000003, "end": 2241.46, "text": " The algorithm is applying continuation geometry at a planetary scale.", "tokens": [50734, 440, 9284, 307, 9275, 29357, 18426, 412, 257, 35788, 4373, 13, 50921], "temperature": 0.0, "avg_logprob": -0.15531020363171896, "compression_ratio": 1.5851851851851853, "no_speech_prob": 1.7144808793154165e-12}, {"id": 830, "seek": 223034, "start": 2241.7200000000003, "end": 2247.7400000000002, "text": " It is predicting your future by finding the confluence where your river merges with someone else's.", "tokens": [50934, 467, 307, 32884, 428, 2027, 538, 5006, 264, 1497, 40432, 689, 428, 6810, 3551, 2880, 365, 1580, 1646, 311, 13, 51235], "temperature": 0.0, "avg_logprob": -0.15531020363171896, "compression_ratio": 1.5851851851851853, "no_speech_prob": 1.7144808793154165e-12}, {"id": 831, "seek": 223034, "start": 2247.92, "end": 2250.2200000000003, "text": " Which brings us to Flixian's closing thoughts.", "tokens": [51244, 3013, 5607, 505, 281, 3235, 970, 952, 311, 10377, 4598, 13, 51359], "temperature": 0.0, "avg_logprob": -0.15531020363171896, "compression_ratio": 1.5851851851851853, "no_speech_prob": 1.7144808793154165e-12}, {"id": 832, "seek": 223034, "start": 2250.7200000000003, "end": 2254.6600000000003, "text": " The profound mathematical irony that ties this entire journey together.", "tokens": [51384, 440, 14382, 18894, 35365, 300, 14039, 341, 2302, 4671, 1214, 13, 51581], "temperature": 0.0, "avg_logprob": -0.15531020363171896, "compression_ratio": 1.5851851851851853, "no_speech_prob": 1.7144808793154165e-12}, {"id": 833, "seek": 223034, "start": 2254.78, "end": 2255.6200000000003, "text": " The title of the book, right?", "tokens": [51587, 440, 4876, 295, 264, 1446, 11, 558, 30, 51629], "temperature": 0.0, "avg_logprob": -0.15531020363171896, "compression_ratio": 1.5851851851851853, "no_speech_prob": 1.7144808793154165e-12}, {"id": 834, "seek": 225562, "start": 2255.62, "end": 2258.22, "text": " The book is titled Generative Continuation Geometry.", "tokens": [50365, 440, 1446, 307, 19841, 15409, 1166, 14674, 16073, 2876, 34730, 13, 50495], "temperature": 0.0, "avg_logprob": -0.14110436282315098, "compression_ratio": 1.5685483870967742, "no_speech_prob": 1.7689024073633264e-12}, {"id": 835, "seek": 225562, "start": 2258.8399999999997, "end": 2265.4, "text": " But by the end, the author admits that there are actually four central threads running through the math, not just two.", "tokens": [50526, 583, 538, 264, 917, 11, 264, 3793, 46682, 300, 456, 366, 767, 1451, 5777, 19314, 2614, 807, 264, 5221, 11, 406, 445, 732, 13, 50854], "temperature": 0.0, "avg_logprob": -0.14110436282315098, "compression_ratio": 1.5685483870967742, "no_speech_prob": 1.7689024073633264e-12}, {"id": 836, "seek": 225562, "start": 2265.6, "end": 2268.38, "text": " It's not simply a binary of generation and collapse.", "tokens": [50864, 467, 311, 406, 2935, 257, 17434, 295, 5125, 293, 15584, 13, 51003], "temperature": 0.0, "avg_logprob": -0.14110436282315098, "compression_ratio": 1.5685483870967742, "no_speech_prob": 1.7689024073633264e-12}, {"id": 837, "seek": 225562, "start": 2268.62, "end": 2277.94, "text": " No, it is a highly intricate web of generation, quotienting, which is the merging of river state sufficiency and the irreversible dynamics of time and intervention.", "tokens": [51015, 883, 11, 309, 307, 257, 5405, 38015, 3670, 295, 5125, 11, 9641, 1196, 278, 11, 597, 307, 264, 44559, 295, 6810, 1785, 459, 49086, 293, 264, 16014, 840, 964, 15679, 295, 565, 293, 13176, 13, 51481], "temperature": 0.0, "avg_logprob": -0.14110436282315098, "compression_ratio": 1.5685483870967742, "no_speech_prob": 1.7689024073633264e-12}, {"id": 838, "seek": 227794, "start": 2277.94, "end": 2279.18, "text": " It's unbelievable.", "tokens": [50365, 467, 311, 16605, 13, 50427], "temperature": 0.0, "avg_logprob": -0.12670379680591626, "compression_ratio": 1.5816733067729083, "no_speech_prob": 1.4779816910268084e-12}, {"id": 839, "seek": 227794, "start": 2279.78, "end": 2294.48, "text": " A book named after how futures are generated spends almost all of its massive page count rigorously, obsessively proving how futures are lost, mislabeled, confined by invariant blocks, and poisoned by staleness.", "tokens": [50457, 316, 1446, 4926, 934, 577, 26071, 366, 10833, 25620, 1920, 439, 295, 1080, 5994, 3028, 1207, 42191, 5098, 11, 35803, 3413, 27221, 577, 26071, 366, 2731, 11, 3346, 75, 18657, 292, 11, 31745, 538, 33270, 394, 8474, 11, 293, 36677, 538, 49875, 15264, 13, 51192], "temperature": 0.0, "avg_logprob": -0.12670379680591626, "compression_ratio": 1.5816733067729083, "no_speech_prob": 1.4779816910268084e-12}, {"id": 840, "seek": 227794, "start": 2295.2000000000003, "end": 2296.18, "text": " But it has to.", "tokens": [51228, 583, 309, 575, 281, 13, 51277], "temperature": 0.0, "avg_logprob": -0.12670379680591626, "compression_ratio": 1.5816733067729083, "no_speech_prob": 1.4779816910268084e-12}, {"id": 841, "seek": 227794, "start": 2296.76, "end": 2304.5, "text": " A theory of generation that has nothing to say about loss wouldn't be able to tell a brilliant architectural design from a lazy traffic light engineer.", "tokens": [51306, 316, 5261, 295, 5125, 300, 575, 1825, 281, 584, 466, 4470, 2759, 380, 312, 1075, 281, 980, 257, 10248, 26621, 1715, 490, 257, 14847, 6419, 1442, 11403, 13, 51693], "temperature": 0.0, "avg_logprob": -0.12670379680591626, "compression_ratio": 1.5816733067729083, "no_speech_prob": 1.4779816910268084e-12}, {"id": 842, "seek": 230450, "start": 2304.5, "end": 2311.26, "text": " And a theory of loss that has no generation would have no baseline, no fern, to measure what was actually lost.", "tokens": [50365, 400, 257, 5261, 295, 4470, 300, 575, 572, 5125, 576, 362, 572, 20518, 11, 572, 283, 1248, 11, 281, 3481, 437, 390, 767, 2731, 13, 50703], "temperature": 0.0, "avg_logprob": -0.09674505216885457, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.035547078116373e-12}, {"id": 843, "seek": 230450, "start": 2311.62, "end": 2314.38, "text": " Generation and collapse are locked in a mathematical dance.", "tokens": [50721, 23898, 293, 15584, 366, 9376, 294, 257, 18894, 4489, 13, 50859], "temperature": 0.0, "avg_logprob": -0.09674505216885457, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.035547078116373e-12}, {"id": 844, "seek": 230450, "start": 2314.92, "end": 2318.84, "text": " You cannot define the shape of the future without defining the empty space around it.", "tokens": [50886, 509, 2644, 6964, 264, 3909, 295, 264, 2027, 1553, 17827, 264, 6707, 1901, 926, 309, 13, 51082], "temperature": 0.0, "avg_logprob": -0.09674505216885457, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.035547078116373e-12}, {"id": 845, "seek": 230450, "start": 2318.96, "end": 2322.7, "text": " Let's take a deep breath and recap the sheer scale of the journey we just went on.", "tokens": [51088, 961, 311, 747, 257, 2452, 6045, 293, 20928, 264, 23061, 4373, 295, 264, 4671, 321, 445, 1437, 322, 13, 51275], "temperature": 0.0, "avg_logprob": -0.09674505216885457, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.035547078116373e-12}, {"id": 846, "seek": 230450, "start": 2322.78, "end": 2323.64, "text": " It was a long one.", "tokens": [51279, 467, 390, 257, 938, 472, 13, 51322], "temperature": 0.0, "avg_logprob": -0.09674505216885457, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.035547078116373e-12}, {"id": 847, "seek": 230450, "start": 2323.8, "end": 2330.54, "text": " We started with the Bannock fixed point theorem, watching mathematical rules contract to grow infinitely detailed ferns.", "tokens": [51330, 492, 1409, 365, 264, 363, 969, 1560, 6806, 935, 20904, 11, 1976, 18894, 4474, 4364, 281, 1852, 36227, 9942, 283, 1248, 82, 13, 51667], "temperature": 0.0, "avg_logprob": -0.09674505216885457, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.035547078116373e-12}, {"id": 848, "seek": 233054, "start": 2330.54, "end": 2338.88, "text": " We watched two rivers collide in a valley to prove that once futures merge, the history of where you came from becomes completely mathematically irrelevant.", "tokens": [50365, 492, 6337, 732, 18361, 49093, 294, 257, 17636, 281, 7081, 300, 1564, 26071, 22183, 11, 264, 2503, 295, 689, 291, 1361, 490, 3643, 2584, 44003, 28682, 13, 50782], "temperature": 0.0, "avg_logprob": -0.08889936870998806, "compression_ratio": 1.64453125, "no_speech_prob": 2.253955268954888e-12}, {"id": 849, "seek": 233054, "start": 2339.22, "end": 2343.74, "text": " We stood at the foot of a hospital bed and realized that our everyday words are semantic compromises.", "tokens": [50799, 492, 9371, 412, 264, 2671, 295, 257, 4530, 2901, 293, 5334, 300, 527, 7429, 2283, 366, 47982, 11482, 3598, 13, 51025], "temperature": 0.0, "avg_logprob": -0.08889936870998806, "compression_ratio": 1.64453125, "no_speech_prob": 2.253955268954888e-12}, {"id": 850, "seek": 233054, "start": 2344.44, "end": 2347.6, "text": " We literally destroy the future just so we can speak to each other.", "tokens": [51060, 492, 3736, 5293, 264, 2027, 445, 370, 321, 393, 1710, 281, 1184, 661, 13, 51218], "temperature": 0.0, "avg_logprob": -0.08889936870998806, "compression_ratio": 1.64453125, "no_speech_prob": 2.253955268954888e-12}, {"id": 851, "seek": 233054, "start": 2347.96, "end": 2353.52, "text": " We learned that you can never fix a structural blind spot by checking your stale watch faster.", "tokens": [51236, 492, 3264, 300, 291, 393, 1128, 3191, 257, 15067, 6865, 4008, 538, 8568, 428, 342, 1220, 1159, 4663, 13, 51514], "temperature": 0.0, "avg_logprob": -0.08889936870998806, "compression_ratio": 1.64453125, "no_speech_prob": 2.253955268954888e-12}, {"id": 852, "seek": 235352, "start": 2353.52, "end": 2362.2599999999998, "text": " We watched a city worker physically unwire a crosswalk button to prove that erased history cannot be fixed by better database labels.", "tokens": [50365, 492, 6337, 257, 2307, 11346, 9762, 14853, 621, 257, 3278, 12490, 2960, 281, 7081, 300, 38359, 2503, 2644, 312, 6806, 538, 1101, 8149, 16949, 13, 50802], "temperature": 0.0, "avg_logprob": -0.0864847654937416, "compression_ratio": 1.5957446808510638, "no_speech_prob": 1.782771087872892e-12}, {"id": 853, "seek": 235352, "start": 2362.7599999999998, "end": 2369.8, "text": " And we watched simple facts explode into combinatorial universes that AI uses to map the geometry of our behaviors.", "tokens": [50827, 400, 321, 6337, 2199, 9130, 21411, 666, 2512, 31927, 831, 50168, 300, 7318, 4960, 281, 4471, 264, 18426, 295, 527, 15501, 13, 51179], "temperature": 0.0, "avg_logprob": -0.0864847654937416, "compression_ratio": 1.5957446808510638, "no_speech_prob": 1.782771087872892e-12}, {"id": 854, "seek": 235352, "start": 2370.02, "end": 2375.6, "text": " It is a profound, demanding framework for seeing the invisible architecture of consequences.", "tokens": [51190, 467, 307, 257, 14382, 11, 19960, 8388, 337, 2577, 264, 14603, 9482, 295, 10098, 13, 51469], "temperature": 0.0, "avg_logprob": -0.0864847654937416, "compression_ratio": 1.5957446808510638, "no_speech_prob": 1.782771087872892e-12}, {"id": 855, "seek": 235352, "start": 2375.84, "end": 2381.96, "text": " It forces you to realize that every label, every rule, and every intervention carries a topological weight.", "tokens": [51481, 467, 5874, 291, 281, 4325, 300, 633, 7645, 11, 633, 4978, 11, 293, 633, 13176, 16402, 257, 1192, 4383, 3364, 13, 51787], "temperature": 0.0, "avg_logprob": -0.0864847654937416, "compression_ratio": 1.5957446808510638, "no_speech_prob": 1.782771087872892e-12}, {"id": 856, "seek": 238196, "start": 2381.96, "end": 2382.86, "text": " It really does.", "tokens": [50365, 467, 534, 775, 13, 50410], "temperature": 0.0, "avg_logprob": -0.11155179009508731, "compression_ratio": 1.5777777777777777, "no_speech_prob": 1.8686083496505246e-12}, {"id": 857, "seek": 238196, "start": 2383.16, "end": 2386.98, "text": " And I want to leave you, the listener, with a final reflection to chew on.", "tokens": [50425, 400, 286, 528, 281, 1856, 291, 11, 264, 31569, 11, 365, 257, 2572, 12914, 281, 21200, 322, 13, 50616], "temperature": 0.0, "avg_logprob": -0.11155179009508731, "compression_ratio": 1.5777777777777777, "no_speech_prob": 1.8686083496505246e-12}, {"id": 858, "seek": 238196, "start": 2387.1, "end": 2388.0, "text": " A takeaway for them.", "tokens": [50622, 316, 30681, 337, 552, 13, 50667], "temperature": 0.0, "avg_logprob": -0.11155179009508731, "compression_ratio": 1.5777777777777777, "no_speech_prob": 1.8686083496505246e-12}, {"id": 859, "seek": 238196, "start": 2388.12, "end": 2388.34, "text": " Yeah.", "tokens": [50673, 865, 13, 50684], "temperature": 0.0, "avg_logprob": -0.11155179009508731, "compression_ratio": 1.5777777777777777, "no_speech_prob": 1.8686083496505246e-12}, {"id": 860, "seek": 238196, "start": 2388.56, "end": 2396.1, "text": " We spent a massive amount of time today talking about how futures are lost, constrained, or erased by bad maps and lazy code.", "tokens": [50695, 492, 4418, 257, 5994, 2372, 295, 565, 965, 1417, 466, 577, 26071, 366, 2731, 11, 38901, 11, 420, 38359, 538, 1578, 11317, 293, 14847, 3089, 13, 51072], "temperature": 0.0, "avg_logprob": -0.11155179009508731, "compression_ratio": 1.5777777777777777, "no_speech_prob": 1.8686083496505246e-12}, {"id": 861, "seek": 238196, "start": 2396.2400000000002, "end": 2396.98, "text": " Too much time, maybe.", "tokens": [51079, 11395, 709, 565, 11, 1310, 13, 51116], "temperature": 0.0, "avg_logprob": -0.11155179009508731, "compression_ratio": 1.5777777777777777, "no_speech_prob": 1.8686083496505246e-12}, {"id": 862, "seek": 238196, "start": 2397.44, "end": 2401.28, "text": " But I want you to go back to the concept of investment-movable admissibility.", "tokens": [51139, 583, 286, 528, 291, 281, 352, 646, 281, 264, 3410, 295, 6078, 12, 3280, 17915, 5910, 891, 2841, 13, 51331], "temperature": 0.0, "avg_logprob": -0.11155179009508731, "compression_ratio": 1.5777777777777777, "no_speech_prob": 1.8686083496505246e-12}, {"id": 863, "seek": 238196, "start": 2401.58, "end": 2402.4, "text": " The terraforming.", "tokens": [51346, 440, 26298, 48610, 13, 51387], "temperature": 0.0, "avg_logprob": -0.11155179009508731, "compression_ratio": 1.5777777777777777, "no_speech_prob": 1.8686083496505246e-12}, {"id": 864, "seek": 238196, "start": 2402.7400000000002, "end": 2408.04, "text": " Think about a boundary in your own life that you have always inherently treated as a hard, excluded set.", "tokens": [51404, 6557, 466, 257, 12866, 294, 428, 1065, 993, 300, 291, 362, 1009, 27993, 8668, 382, 257, 1152, 11, 29486, 992, 13, 51669], "temperature": 0.0, "avg_logprob": -0.11155179009508731, "compression_ratio": 1.5777777777777777, "no_speech_prob": 1.8686083496505246e-12}, {"id": 865, "seek": 238196, "start": 2408.26, "end": 2410.18, "text": " A permanent, topological wall.", "tokens": [51680, 316, 10996, 11, 1192, 4383, 2929, 13, 51776], "temperature": 0.0, "avg_logprob": -0.11155179009508731, "compression_ratio": 1.5777777777777777, "no_speech_prob": 1.8686083496505246e-12}, {"id": 866, "seek": 241018, "start": 2410.18, "end": 2412.3599999999997, "text": " A trait you genuinely thought you lacked.", "tokens": [50365, 316, 22538, 291, 17839, 1194, 291, 41481, 13, 50474], "temperature": 0.0, "avg_logprob": -0.09416059789986446, "compression_ratio": 1.7263157894736842, "no_speech_prob": 1.8179218980868272e-12}, {"id": 867, "seek": 241018, "start": 2412.7599999999998, "end": 2416.1, "text": " A career path you assumed was structurally closed off to you.", "tokens": [50494, 316, 3988, 3100, 291, 15895, 390, 6594, 6512, 5395, 766, 281, 291, 13, 50661], "temperature": 0.0, "avg_logprob": -0.09416059789986446, "compression_ratio": 1.7263157894736842, "no_speech_prob": 1.8179218980868272e-12}, {"id": 868, "seek": 241018, "start": 2416.52, "end": 2419.3399999999997, "text": " A relationship you decided was an invariant block.", "tokens": [50682, 316, 2480, 291, 3047, 390, 364, 33270, 394, 3461, 13, 50823], "temperature": 0.0, "avg_logprob": -0.09416059789986446, "compression_ratio": 1.7263157894736842, "no_speech_prob": 1.8179218980868272e-12}, {"id": 869, "seek": 241018, "start": 2419.5, "end": 2421.18, "text": " What if it isn't an invariant block at all?", "tokens": [50831, 708, 498, 309, 1943, 380, 364, 33270, 394, 3461, 412, 439, 30, 50915], "temperature": 0.0, "avg_logprob": -0.09416059789986446, "compression_ratio": 1.7263157894736842, "no_speech_prob": 1.8179218980868272e-12}, {"id": 870, "seek": 241018, "start": 2421.54, "end": 2425.8599999999997, "text": " What if it's just a boundary waiting for the right expansive investment operator?", "tokens": [50933, 708, 498, 309, 311, 445, 257, 12866, 3806, 337, 264, 558, 46949, 6078, 12973, 30, 51149], "temperature": 0.0, "avg_logprob": -0.09416059789986446, "compression_ratio": 1.7263157894736842, "no_speech_prob": 1.8179218980868272e-12}, {"id": 871, "seek": 241018, "start": 2426.08, "end": 2433.7999999999997, "text": " The rigorous math we explored today, the very geometry of the universe, says that the boundary can recede.", "tokens": [51160, 440, 29882, 5221, 321, 24016, 965, 11, 264, 588, 18426, 295, 264, 6445, 11, 1619, 300, 264, 12866, 393, 850, 4858, 13, 51546], "temperature": 0.0, "avg_logprob": -0.09416059789986446, "compression_ratio": 1.7263157894736842, "no_speech_prob": 1.8179218980868272e-12}, {"id": 872, "seek": 241018, "start": 2433.9199999999996, "end": 2439.3199999999997, "text": " It says that you can terraform the atmosphere of your own potential and expand your universe of futures.", "tokens": [51552, 467, 1619, 300, 291, 393, 26298, 837, 264, 8018, 295, 428, 1065, 3995, 293, 5268, 428, 6445, 295, 26071, 13, 51822], "temperature": 0.0, "avg_logprob": -0.09416059789986446, "compression_ratio": 1.7263157894736842, "no_speech_prob": 1.8179218980868272e-12}, {"id": 873, "seek": 243932, "start": 2439.32, "end": 2441.6600000000003, "text": " But it only happens if you invest the energy.", "tokens": [50365, 583, 309, 787, 2314, 498, 291, 1963, 264, 2281, 13, 50482], "temperature": 0.0, "avg_logprob": -0.1978125088456748, "compression_ratio": 1.5272727272727273, "no_speech_prob": 1.7281797737647708e-12}, {"id": 874, "seek": 243932, "start": 2442.1400000000003, "end": 2443.88, "text": " The wall only moves if you push on it.", "tokens": [50506, 440, 2929, 787, 6067, 498, 291, 2944, 322, 309, 13, 50593], "temperature": 0.0, "avg_logprob": -0.1978125088456748, "compression_ratio": 1.5272727272727273, "no_speech_prob": 1.7281797737647708e-12}, {"id": 875, "seek": 243932, "start": 2444.1200000000003, "end": 2446.56, "text": " The future doesn't generate itself without the operator.", "tokens": [50605, 440, 2027, 1177, 380, 8460, 2564, 1553, 264, 12973, 13, 50727], "temperature": 0.0, "avg_logprob": -0.1978125088456748, "compression_ratio": 1.5272727272727273, "no_speech_prob": 1.7281797737647708e-12}, {"id": 876, "seek": 243932, "start": 2446.76, "end": 2447.1400000000003, "text": " Exactly.", "tokens": [50737, 7587, 13, 50756], "temperature": 0.0, "avg_logprob": -0.1978125088456748, "compression_ratio": 1.5272727272727273, "no_speech_prob": 1.7281797737647708e-12}, {"id": 877, "seek": 243932, "start": 2447.42, "end": 2448.94, "text": " Keep pushing on those boundaries.", "tokens": [50770, 5527, 7380, 322, 729, 13180, 13, 50846], "temperature": 0.0, "avg_logprob": -0.1978125088456748, "compression_ratio": 1.5272727272727273, "no_speech_prob": 1.7281797737647708e-12}, {"id": 878, "seek": 243932, "start": 2449.34, "end": 2450.6000000000004, "text": " Keep generating your future.", "tokens": [50866, 5527, 17746, 428, 2027, 13, 50929], "temperature": 0.0, "avg_logprob": -0.1978125088456748, "compression_ratio": 1.5272727272727273, "no_speech_prob": 1.7281797737647708e-12}, {"id": 879, "seek": 243932, "start": 2451.1000000000004, "end": 2452.9, "text": " We'll catch you on the next Deep Dive.", "tokens": [50954, 492, 603, 3745, 291, 322, 264, 958, 14895, 413, 488, 13, 51044], "temperature": 0.0, "avg_logprob": -0.1978125088456748, "compression_ratio": 1.5272727272727273, "no_speech_prob": 1.7281797737647708e-12}], "language": "en"}
