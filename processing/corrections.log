[50365, 400, 11, 411, 321, 2835, 11, 983, 633, 7553, 2237, 307, 3122, 23051, 295, 264, 10957, 26753, 10952, 13, 50708], "temperature": 0.0, "avg_logprob": -0.1443440196959953, "compression_ratio": 1.5878594249201279, "no_speech_prob": 1.537236267099007e-12}, {"id": 27, "seek": 9536, "start": 102.74, "end": 107.3, "text": " So I'm going to start exactly where Fliction starts, which is not in a server room or a courtroom.", "tokens": [50734, 407, 286, 478, 516, 281, 722, 2293, 689, 3235, 4105, 3719, 11, 597, 307, 406, 294, 257, 7154, 1808, 420, 257, 44050, 13, 50962], "temperature": 0.0, "avg_logprob": -0.1443440196959953, "compression_ratio": 1.5878594249201279, "no_speech_prob": 1.537236267099007e-12}, {"id": 28, "seek": 9536, "start": 107.72, "end": 108.98, "text": " It's out on a backyard deck.", "tokens": [50983, 467, 311, 484, 322, 257, 20036, 9341, 13, 51046], "temperature": 0.0, "avg_logprob": -0.1443440196959953, "compression_ratio": 1.5878594249201279, "no_speech_prob": 1.537236267099007e-12}, {"id": 29, "seek": 9536, "start": 109.16, "end": 110.32, "text": " Such a great opening.", "tokens": [51055, 9653, 257, 869, 5193, 13, 51113], "temperature": 0.0, "avg_logprob": -0.1443440196959953, "compression_ratio": 1.5878594249201279, "no_speech_prob": 1.537236267099007e-12}, {"id": 30, "seek": 9536, "start": 110.6, "end": 110.82, "text": " Right.", "tokens": [51127, 1779, 13, 51138], "temperature": 0.0, "avg_logprob": -0.1443440196959953, "compression_ratio": 1.5878594249201279, "no_speech_prob": 1.537236267099007e-12}, {"id": 31, "seek": 9536, "start": 110.9, "end": 112.7, "text": " It's this incredibly relatable moment.", "tokens": [51142, 467, 311, 341, 6252, 42355, 1623, 13, 51232], "temperature": 0.0, "avg_logprob": -0.1443440196959953, "compression_ratio": 1.5878594249201279, "no_speech_prob": 1.537236267099007e-12}, {"id": 32, "seek": 9536, "start": 113.14, "end": 117.16, "text": " The author describes standing outside dictating a message into their phone.", "tokens": [51254, 440, 3793, 15626, 4877, 2380, 12569, 990, 257, 3636, 666, 641, 2593, 13, 51455], "temperature": 0.0, "avg_logprob": -0.1443440196959953, "compression_ratio": 1.5878594249201279, "no_speech_prob": 1.537236267099007e-12}, {"id": 33, "seek": 9536, "start": 117.26, "end": 118.06, "text": " We've all done it.", "tokens": [51460, 492, 600, 439, 1096, 309, 13, 51500], "temperature": 0.0, "avg_logprob": -0.1443440196959953, "compression_ratio": 1.5878594249201279, "no_speech_prob": 1.537236267099007e-12}, {"id": 34, "seek": 9536, "start": 118.46000000000001, "end": 123.12, "text": " But when they look down at the transcript the AI generated, it hasn't just captured their voice.", "tokens": [51520, 583, 562, 436, 574, 760, 412, 264, 24444, 264, 7318, 10833, 11, 309, 6132, 380, 445, 11828, 641, 3177, 13, 51753], "temperature": 0.0, "avg_logprob": -0.1443440196959953, "compression_ratio": 1.5878594249201279, "no_speech_prob": 1.537236267099007e-12}, {"id": 35, "seek": 12312, "start": 123.12, "end": 130.22, "text": " It's transcribed a nearby basketball game, passing cars, some birds, and, oh, I love this specific detail from the text.", "tokens": [50365, 467, 311, 1145, 18732, 257, 11184, 11767, 1216, 11, 8437, 5163, 11, 512, 9009, 11, 293, 11, 1954, 11, 286, 959, 341, 2685, 2607, 490, 264, 2487, 13, 50720], "temperature": 0.0, "avg_logprob": -0.15694801450714352, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.6750186307423753e-12}, {"id": 36, "seek": 12312, "start": 130.5, "end": 131.58, "text": " The kids with the lantern.", "tokens": [50734, 440, 2301, 365, 264, 34031, 13, 50788], "temperature": 0.0, "avg_logprob": -0.15694801450714352, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.6750186307423753e-12}, {"id": 37, "seek": 12312, "start": 131.92000000000002, "end": 132.20000000000002, "text": " Yes.", "tokens": [50805, 1079, 13, 50819], "temperature": 0.0, "avg_logprob": -0.15694801450714352, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.6750186307423753e-12}, {"id": 38, "seek": 12312, "start": 132.82, "end": 136.1, "text": " Two children wishing satirical wishes into a candle lantern.", "tokens": [50850, 4453, 2227, 30049, 3227, 347, 804, 15065, 666, 257, 17968, 34031, 13, 51014], "temperature": 0.0, "avg_logprob": -0.15694801450714352, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.6750186307423753e-12}, {"id": 39, "seek": 12312, "start": 136.48000000000002, "end": 137.4, "text": " It's so specific.", "tokens": [51033, 467, 311, 370, 2685, 13, 51079], "temperature": 0.0, "avg_logprob": -0.15694801450714352, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.6750186307423753e-12}, {"id": 40, "seek": 12312, "start": 137.82, "end": 145.16, "text": " And the transcript just weaves all of this together into one massive, unpunctuated block of surrealist text.", "tokens": [51100, 400, 264, 24444, 445, 321, 5423, 439, 295, 341, 1214, 666, 472, 5994, 11, 20994, 409, 349, 27275, 3461, 295, 32513, 468, 2487, 13, 51467], "temperature": 0.0, "avg_logprob": -0.15694801450714352, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.6750186307423753e-12}, {"id": 41, "seek": 12312, "start": 145.52, "end": 149.18, "text": " And see, most people look at a transcript like that and think, well, the AI is stupid.", "tokens": [51485, 400, 536, 11, 881, 561, 574, 412, 257, 24444, 411, 300, 293, 519, 11, 731, 11, 264, 7318, 307, 6631, 13, 51668], "temperature": 0.0, "avg_logprob": -0.15694801450714352, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.6750186307423753e-12}, {"id": 42, "seek": 12312, "start": 149.46, "end": 150.12, "text": " Yeah, like it malfunctioned.", "tokens": [51682, 865, 11, 411, 309, 50229, 292, 13, 51715], "temperature": 0.0, "avg_logprob": -0.15694801450714352, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.6750186307423753e-12}, {"id": 43, "seek": 12312, "start": 150.98000000000002, "end": 151.46, "text": " Exactly.", "tokens": [51758, 7587, 13, 51782], "temperature": 0.0, "avg_logprob": -0.15694801450714352, "compression_ratio": 1.648936170212766, "no_speech_prob": 1.6750186307423753e-12}, {"id": 44, "seek": 15146, "start": 151.46, "end": 155.94, "text": " They think we just need to train a better neural network to filter out the background noise.", "tokens": [50365, 814, 519, 321, 445, 643, 281, 3847, 257, 1101, 18161, 3209, 281, 6608, 484, 264, 3678, 5658, 13, 50589], "temperature": 0.0, "avg_logprob": -0.10062945250308875, "compression_ratio": 1.625, "no_speech_prob": 1.178536326688906e-12}, {"id": 45, "seek": 15146, "start": 156.54000000000002, "end": 160.46, "text": " But Fliction's core argument, it just upends this entirely.", "tokens": [50619, 583, 3235, 4105, 311, 4965, 6770, 11, 309, 445, 493, 2581, 341, 7696, 13, 50815], "temperature": 0.0, "avg_logprob": -0.10062945250308875, "compression_ratio": 1.625, "no_speech_prob": 1.178536326688906e-12}, {"id": 46, "seek": 15146, "start": 161.24, "end": 161.66, "text": " How so?", "tokens": [50854, 1012, 370, 30, 50875], "temperature": 0.0, "avg_logprob": -0.10062945250308875, "compression_ratio": 1.625, "no_speech_prob": 1.178536326688906e-12}, {"id": 47, "seek": 15146, "start": 161.78, "end": 163.94, "text": " Because the transcriber didn't malfunction.", "tokens": [50881, 1436, 264, 1145, 1142, 607, 994, 380, 50229, 13, 50989], "temperature": 0.0, "avg_logprob": -0.10062945250308875, "compression_ratio": 1.625, "no_speech_prob": 1.178536326688906e-12}, {"id": 48, "seek": 15146, "start": 164.36, "end": 167.42000000000002, "text": " It transcribed the physical reality of that backyard flawlessly.", "tokens": [51010, 467, 1145, 18732, 264, 4001, 4103, 295, 300, 20036, 13717, 12048, 13, 51163], "temperature": 0.0, "avg_logprob": -0.10062945250308875, "compression_ratio": 1.625, "no_speech_prob": 1.178536326688906e-12}, {"id": 49, "seek": 15146, "start": 167.78, "end": 171.66, "text": " I mean, the children actually spoke those satirical wishes into the air.", "tokens": [51181, 286, 914, 11, 264, 2227, 767, 7179, 729, 3227, 347, 804, 15065, 666, 264, 1988, 13, 51375], "temperature": 0.0, "avg_logprob": -0.10062945250308875, "compression_ratio": 1.625, "no_speech_prob": 1.178536326688906e-12}, {"id": 50, "seek": 15146, "start": 171.74, "end": 172.0, "text": " Right.", "tokens": [51379, 1779, 13, 51392], "temperature": 0.0, "avg_logprob": -0.10062945250308875, "compression_ratio": 1.625, "no_speech_prob": 1.178536326688906e-12}, {"id": 51, "seek": 15146, "start": 172.14000000000001, "end": 173.38, "text": " It captured reality.", "tokens": [51399, 467, 11828, 4103, 13, 51461], "temperature": 0.0, "avg_logprob": -0.10062945250308875, "compression_ratio": 1.625, "no_speech_prob": 1.178536326688906e-12}, {"id": 52, "seek": 15146, "start": 173.58, "end": 175.14000000000001, "text": " But wait, let me push back on that immediately.", "tokens": [51471, 583, 1699, 11, 718, 385, 2944, 646, 322, 300, 4258, 13, 51549], "temperature": 0.0, "avg_logprob": -0.10062945250308875, "compression_ratio": 1.625, "no_speech_prob": 1.178536326688906e-12}, {"id": 53, "seek": 15146, "start": 175.4, "end": 177.62, "text": " Because isn't that just a temporary engineering problem?", "tokens": [51562, 1436, 1943, 380, 300, 445, 257, 13413, 7043, 1154, 30, 51673], "temperature": 0.0, "avg_logprob": -0.10062945250308875, "compression_ratio": 1.625, "no_speech_prob": 1.178536326688906e-12}, {"id": 54, "seek": 15146, "start": 177.92000000000002, "end": 179.14000000000001, "text": " A lot of people think so, yeah.", "tokens": [51688, 316, 688, 295, 561, 519, 370, 11, 1338, 13, 51749], "temperature": 0.0, "avg_logprob": -0.10062945250308875, "compression_ratio": 1.625, "no_speech_prob": 1.178536326688906e-12}, {"id": 55, "seek": 17914, "start": 179.14, "end": 183.5, "text": " Like, humans can stand in a noisy backyard and focus purely on the person talking to us.", "tokens": [50365, 1743, 11, 6255, 393, 1463, 294, 257, 24518, 20036, 293, 1879, 17491, 322, 264, 954, 1417, 281, 505, 13, 50583], "temperature": 0.0, "avg_logprob": -0.10904504271114573, "compression_ratio": 1.4095744680851063, "no_speech_prob": 1.2540842930092166e-12}, {"id": 56, "seek": 17914, "start": 183.82, "end": 185.85999999999999, "text": " Our brains filter out the birds and the kids.", "tokens": [50599, 2621, 15442, 6608, 484, 264, 9009, 293, 264, 2301, 13, 50701], "temperature": 0.0, "avg_logprob": -0.10904504271114573, "compression_ratio": 1.4095744680851063, "no_speech_prob": 1.2540842930092166e-12}, {"id": 57, "seek": 17914, "start": 185.98, "end": 186.11999999999998, "text": " Right.", "tokens": [50707, 1779, 13, 50714], "temperature": 0.0, "avg_logprob": -0.10904504271114573, "compression_ratio": 1.4095744680851063, "no_speech_prob": 1.2540842930092166e-12}, {"id": 58, "seek": 17914, "start": 186.16, "end": 193.61999999999998, "text": " So if we just throw enough compute at the problem, won't an AI eventually learn to isolate the human voice just like we do?", "tokens": [50716, 407, 498, 321, 445, 3507, 1547, 14722, 412, 264, 1154, 11, 1582, 380, 364, 7318, 4728, 1466, 281, 25660, 264, 1952, 3177, 445, 411, 321, 360, 30, 51089], "temperature": 0.0, "avg_logprob": -0.10904504271114573, "compression_ratio": 1.4095744680851063, "no_speech_prob": 1.2540842930092166e-12}, {"id": 59, "seek": 19362, "start": 193.62, "end": 197.98000000000002, "text": " Why does Fliction claim this is some insurmountable flaw?", "tokens": [50365, 1545, 775, 3235, 4105, 3932, 341, 307, 512, 1028, 26717, 792, 712, 13717, 30, 50583], "temperature": 0.0, "avg_logprob": -0.16932269360156768, "compression_ratio": 1.5136363636363637, "no_speech_prob": 1.3938725390919005e-12}, {"id": 60, "seek": 19362, "start": 197.98000000000002, "end": 201.78, "text": " That is exactly the trap the tech industry has been stuck in for 20 years.", "tokens": [50583, 663, 307, 2293, 264, 11487, 264, 7553, 3518, 575, 668, 5541, 294, 337, 945, 924, 13, 50773], "temperature": 0.0, "avg_logprob": -0.16932269360156768, "compression_ratio": 1.5136363636363637, "no_speech_prob": 1.3938725390919005e-12}, {"id": 61, "seek": 19362, "start": 201.94, "end": 202.14000000000001, "text": " Really?", "tokens": [50781, 4083, 30, 50791], "temperature": 0.0, "avg_logprob": -0.16932269360156768, "compression_ratio": 1.5136363636363637, "no_speech_prob": 1.3938725390919005e-12}, {"id": 62, "seek": 19362, "start": 202.42000000000002, "end": 202.96, "text": " 20 years.", "tokens": [50805, 945, 924, 13, 50832], "temperature": 0.0, "avg_logprob": -0.16932269360156768, "compression_ratio": 1.5136363636363637, "no_speech_prob": 1.3938725390919005e-12}, {"id": 63, "seek": 19362, "start": 203.1, "end": 203.26, "text": " Yeah.", "tokens": [50839, 865, 13, 50847], "temperature": 0.0, "avg_logprob": -0.16932269360156768, "compression_ratio": 1.5136363636363637, "no_speech_prob": 1.3938725390919005e-12}, {"id": 64, "seek": 19362, "start": 203.66, "end": 208.1, "text": " And to understand why it's insurmountable, we have to look at the physics of sound waves.", "tokens": [50867, 400, 281, 1223, 983, 309, 311, 1028, 26717, 792, 712, 11, 321, 362, 281, 574, 412, 264, 10649, 295, 1626, 9417, 13, 51089], "temperature": 0.0, "avg_logprob": -0.16932269360156768, "compression_ratio": 1.5136363636363637, "no_speech_prob": 1.3938725390919005e-12}, {"id": 65, "seek": 19362, "start": 208.96, "end": 214.76, "text": " Fliction calls this Proposition 4.4, which is no attribution without side information.", "tokens": [51132, 3235, 4105, 5498, 341, 21944, 5830, 1017, 13, 19, 11, 597, 307, 572, 9080, 1448, 1553, 1252, 1589, 13, 51422], "temperature": 0.0, "avg_logprob": -0.16932269360156768, "compression_ratio": 1.5136363636363637, "no_speech_prob": 1.3938725390919005e-12}, {"id": 66, "seek": 21476, "start": 214.76, "end": 215.32, "text": " Okay.", "tokens": [50365, 1033, 13, 50393], "temperature": 0.0, "avg_logprob": -0.17925970403997749, "compression_ratio": 1.6030534351145038, "no_speech_prob": 1.604721455543412e-12}, {"id": 67, "seek": 21476, "start": 215.51999999999998, "end": 216.44, "text": " Unpack that for me.", "tokens": [50403, 1156, 9539, 300, 337, 385, 13, 50449], "temperature": 0.0, "avg_logprob": -0.17925970403997749, "compression_ratio": 1.6030534351145038, "no_speech_prob": 1.604721455543412e-12}, {"id": 68, "seek": 21476, "start": 216.67999999999998, "end": 223.0, "text": " So when you speak and a bird chirps and a child yells, those are all physical pressure waves moving through the air.", "tokens": [50461, 407, 562, 291, 1710, 293, 257, 5255, 23782, 1878, 293, 257, 1440, 48543, 11, 729, 366, 439, 4001, 3321, 9417, 2684, 807, 264, 1988, 13, 50777], "temperature": 0.0, "avg_logprob": -0.17925970403997749, "compression_ratio": 1.6030534351145038, "no_speech_prob": 1.604721455543412e-12}, {"id": 69, "seek": 21476, "start": 223.1, "end": 223.28, "text": " Right.", "tokens": [50782, 1779, 13, 50791], "temperature": 0.0, "avg_logprob": -0.17925970403997749, "compression_ratio": 1.6030534351145038, "no_speech_prob": 1.604721455543412e-12}, {"id": 70, "seek": 21476, "start": 223.39999999999998, "end": 224.06, "text": " Acoustic energy.", "tokens": [50797, 5097, 15849, 299, 2281, 13, 50830], "temperature": 0.0, "avg_logprob": -0.17925970403997749, "compression_ratio": 1.6030534351145038, "no_speech_prob": 1.604721455543412e-12}, {"id": 71, "seek": 21476, "start": 224.34, "end": 224.73999999999998, "text": " Exactly.", "tokens": [50844, 7587, 13, 50864], "temperature": 0.0, "avg_logprob": -0.17925970403997749, "compression_ratio": 1.6030534351145038, "no_speech_prob": 1.604721455543412e-12}, {"id": 72, "seek": 21476, "start": 225.22, "end": 231.51999999999998, "text": " But by the time those waves hit the diaphragm of a single microphone, they have physically smashed into each other.", "tokens": [50888, 583, 538, 264, 565, 729, 9417, 2045, 264, 46711, 76, 295, 257, 2167, 10952, 11, 436, 362, 9762, 33269, 666, 1184, 661, 13, 51203], "temperature": 0.0, "avg_logprob": -0.17925970403997749, "compression_ratio": 1.6030534351145038, "no_speech_prob": 1.604721455543412e-12}, {"id": 73, "seek": 21476, "start": 231.88, "end": 234.94, "text": " They experience constructive and destructive interference.", "tokens": [51221, 814, 1752, 30223, 293, 26960, 24497, 13, 51374], "temperature": 0.0, "avg_logprob": -0.17925970403997749, "compression_ratio": 1.6030534351145038, "no_speech_prob": 1.604721455543412e-12}, {"id": 74, "seek": 21476, "start": 235.16, "end": 235.72, "text": " They merge.", "tokens": [51385, 814, 22183, 13, 51413], "temperature": 0.0, "avg_logprob": -0.17925970403997749, "compression_ratio": 1.6030534351145038, "no_speech_prob": 1.604721455543412e-12}, {"id": 75, "seek": 21476, "start": 235.89999999999998, "end": 236.16, "text": " Yes.", "tokens": [51422, 1079, 13, 51435], "temperature": 0.0, "avg_logprob": -0.17925970403997749, "compression_ratio": 1.6030534351145038, "no_speech_prob": 1.604721455543412e-12}, {"id": 76, "seek": 21476, "start": 236.32, "end": 239.7, "text": " They merge into one single, highly complex waveform.", "tokens": [51443, 814, 22183, 666, 472, 2167, 11, 5405, 3997, 36512, 13, 51612], "temperature": 0.0, "avg_logprob": -0.17925970403997749, "compression_ratio": 1.6030534351145038, "no_speech_prob": 1.604721455543412e-12}, {"id": 77, "seek": 23970, "start": 239.7, "end": 242.5, "text": " So the microphone doesn't get a multi-track recording.", "tokens": [50365, 407, 264, 10952, 1177, 380, 483, 257, 4825, 12, 19466, 6613, 13, 50505], "temperature": 0.0, "avg_logprob": -0.1559276123046875, "compression_ratio": 1.7142857142857142, "no_speech_prob": 1.4779802815639842e-12}, {"id": 78, "seek": 23970, "start": 242.92, "end": 245.0, "text": " It doesn't get a host track and a bird track.", "tokens": [50526, 467, 1177, 380, 483, 257, 3975, 2837, 293, 257, 5255, 2837, 13, 50630], "temperature": 0.0, "avg_logprob": -0.1559276123046875, "compression_ratio": 1.7142857142857142, "no_speech_prob": 1.4779802815639842e-12}, {"id": 79, "seek": 23970, "start": 245.04, "end": 245.76, "text": " No, not at all.", "tokens": [50632, 883, 11, 406, 412, 439, 13, 50668], "temperature": 0.0, "avg_logprob": -0.1559276123046875, "compression_ratio": 1.7142857142857142, "no_speech_prob": 1.4779802815639842e-12}, {"id": 80, "seek": 23970, "start": 245.82, "end": 248.1, "text": " It just gets one squiggly line of compressed air.", "tokens": [50671, 467, 445, 2170, 472, 2339, 46737, 1622, 295, 30353, 1988, 13, 50785], "temperature": 0.0, "avg_logprob": -0.1559276123046875, "compression_ratio": 1.7142857142857142, "no_speech_prob": 1.4779802815639842e-12}, {"id": 81, "seek": 23970, "start": 248.42, "end": 248.94, "text": " Precisely.", "tokens": [50801, 48746, 736, 13, 50827], "temperature": 0.0, "avg_logprob": -0.1559276123046875, "compression_ratio": 1.7142857142857142, "no_speech_prob": 1.4779802815639842e-12}, {"id": 82, "seek": 23970, "start": 249.28, "end": 250.57999999999998, "text": " And this is where the math comes in.", "tokens": [50844, 400, 341, 307, 689, 264, 5221, 1487, 294, 13, 50909], "temperature": 0.0, "avg_logprob": -0.1559276123046875, "compression_ratio": 1.7142857142857142, "no_speech_prob": 1.4779802815639842e-12}, {"id": 83, "seek": 23970, "start": 251.14, "end": 258.48, "text": " Fliction points out that taking that single, merged, squiggly line and trying to unmix it back into its original separate sources,", "tokens": [50937, 3235, 4105, 2793, 484, 300, 1940, 300, 2167, 11, 36427, 11, 2339, 46737, 1622, 293, 1382, 281, 19334, 970, 309, 646, 666, 1080, 3380, 4994, 7139, 11, 51304], "temperature": 0.0, "avg_logprob": -0.1559276123046875, "compression_ratio": 1.7142857142857142, "no_speech_prob": 1.4779802815639842e-12}, {"id": 84, "seek": 23970, "start": 259.06, "end": 262.84, "text": " mathematicians call that an ill-posed inverse problem.", "tokens": [51333, 32811, 2567, 818, 300, 364, 3171, 12, 79, 1744, 17340, 1154, 13, 51522], "temperature": 0.0, "avg_logprob": -0.1559276123046875, "compression_ratio": 1.7142857142857142, "no_speech_prob": 1.4779802815639842e-12}, {"id": 85, "seek": 23970, "start": 262.98, "end": 264.84, "text": " An ill-posed inverse problem.", "tokens": [51529, 1107, 3171, 12, 79, 1744, 17340, 1154, 13, 51622], "temperature": 0.0, "avg_logprob": -0.1559276123046875, "compression_ratio": 1.7142857142857142, "no_speech_prob": 1.4779802815639842e-12}, {"id": 86, "seek": 23970, "start": 265.03999999999996, "end": 265.56, "text": " Meaning what?", "tokens": [51632, 19948, 437, 30, 51658], "temperature": 0.0, "avg_logprob": -0.1559276123046875, "compression_ratio": 1.7142857142857142, "no_speech_prob": 1.4779802815639842e-12}, {"id": 87, "seek": 26556, "start": 265.56, "end": 271.68, "text": " Meaning it is physically impossible to solve with absolute certainty based only on the audio signal.", "tokens": [50365, 19948, 309, 307, 9762, 6243, 281, 5039, 365, 8236, 27022, 2361, 787, 322, 264, 6278, 6358, 13, 50671], "temperature": 0.0, "avg_logprob": -0.09690743467233477, "compression_ratio": 1.6521739130434783, "no_speech_prob": 1.49539853156605e-12}, {"id": 88, "seek": 26556, "start": 272.02, "end": 273.16, "text": " Because the metadata is gone.", "tokens": [50688, 1436, 264, 26603, 307, 2780, 13, 50745], "temperature": 0.0, "avg_logprob": -0.09690743467233477, "compression_ratio": 1.6521739130434783, "no_speech_prob": 1.49539853156605e-12}, {"id": 89, "seek": 26556, "start": 273.36, "end": 273.8, "text": " Exactly.", "tokens": [50755, 7587, 13, 50777], "temperature": 0.0, "avg_logprob": -0.09690743467233477, "compression_ratio": 1.6521739130434783, "no_speech_prob": 1.49539853156605e-12}, {"id": 90, "seek": 26556, "start": 274.02, "end": 282.12, "text": " The information about who said what or where the sound originated in 3D space, it was destroyed the moment those waves physically merged in the air.", "tokens": [50788, 440, 1589, 466, 567, 848, 437, 420, 689, 264, 1626, 31129, 294, 805, 35, 1901, 11, 309, 390, 8937, 264, 1623, 729, 9417, 9762, 36427, 294, 264, 1988, 13, 51193], "temperature": 0.0, "avg_logprob": -0.09690743467233477, "compression_ratio": 1.6521739130434783, "no_speech_prob": 1.49539853156605e-12}, {"id": 91, "seek": 26556, "start": 282.34000000000003, "end": 282.6, "text": " Okay.", "tokens": [51204, 1033, 13, 51217], "temperature": 0.0, "avg_logprob": -0.09690743467233477, "compression_ratio": 1.6521739130434783, "no_speech_prob": 1.49539853156605e-12}, {"id": 92, "seek": 26556, "start": 282.8, "end": 284.32, "text": " But mechanically, why is it destroyed?", "tokens": [51227, 583, 4236, 984, 11, 983, 307, 309, 8937, 30, 51303], "temperature": 0.0, "avg_logprob": -0.09690743467233477, "compression_ratio": 1.6521739130434783, "no_speech_prob": 1.49539853156605e-12}, {"id": 93, "seek": 26556, "start": 284.42, "end": 288.28, "text": " I mean, if a human ear can do it, why is the metadata gone for the machine?", "tokens": [51308, 286, 914, 11, 498, 257, 1952, 1273, 393, 360, 309, 11, 983, 307, 264, 26603, 2780, 337, 264, 3479, 30, 51501], "temperature": 0.0, "avg_logprob": -0.09690743467233477, "compression_ratio": 1.6521739130434783, "no_speech_prob": 1.49539853156605e-12}, {"id": 94, "seek": 26556, "start": 288.46, "end": 290.5, "text": " Well, because humans have two ears, right?", "tokens": [51510, 1042, 11, 570, 6255, 362, 732, 8798, 11, 558, 30, 51612], "temperature": 0.0, "avg_logprob": -0.09690743467233477, "compression_ratio": 1.6521739130434783, "no_speech_prob": 1.49539853156605e-12}, {"id": 95, "seek": 26556, "start": 290.78, "end": 294.14, "text": " And they're separated by a dense mass of bone and tissue, our skull.", "tokens": [51626, 400, 436, 434, 12005, 538, 257, 18011, 2758, 295, 9026, 293, 12404, 11, 527, 11743, 13, 51794], "temperature": 0.0, "avg_logprob": -0.09690743467233477, "compression_ratio": 1.6521739130434783, "no_speech_prob": 1.49539853156605e-12}, {"id": 96, "seek": 26556, "start": 294.18, "end": 294.64, "text": " Oh, right.", "tokens": [51796, 876, 11, 558, 13, 51819], "temperature": 0.0, "avg_logprob": -0.09690743467233477, "compression_ratio": 1.6521739130434783, "no_speech_prob": 1.49539853156605e-12}, {"id": 97, "seek": 29464, "start": 294.64, "end": 296.0, "text": " So we have spatial separation.", "tokens": [50365, 407, 321, 362, 23598, 14634, 13, 50433], "temperature": 0.0, "avg_logprob": -0.15001883200549204, "compression_ratio": 1.5992779783393503, "no_speech_prob": 2.175277319382829e-12}, {"id": 98, "seek": 29464, "start": 296.18, "end": 296.38, "text": " Yes.", "tokens": [50442, 1079, 13, 50452], "temperature": 0.0, "avg_logprob": -0.15001883200549204, "compression_ratio": 1.5992779783393503, "no_speech_prob": 2.175277319382829e-12}, {"id": 99, "seek": 29464, "start": 296.8, "end": 302.3, "text": " We calculate microsecond delays and frequency shattering between our two ears to place sounds in 3D space.", "tokens": [50473, 492, 8873, 3123, 37841, 18882, 28610, 293, 7893, 402, 14849, 1296, 527, 732, 8798, 281, 1081, 3263, 294, 805, 35, 1901, 13, 50748], "temperature": 0.0, "avg_logprob": -0.15001883200549204, "compression_ratio": 1.5992779783393503, "no_speech_prob": 2.175277319382829e-12}, {"id": 100, "seek": 29464, "start": 302.47999999999996, "end": 304.46, "text": " We're using special side information.", "tokens": [50757, 492, 434, 1228, 2121, 1252, 1589, 13, 50856], "temperature": 0.0, "avg_logprob": -0.15001883200549204, "compression_ratio": 1.5992779783393503, "no_speech_prob": 2.175277319382829e-12}, {"id": 101, "seek": 29464, "start": 304.64, "end": 304.96, "text": " I see.", "tokens": [50865, 286, 536, 13, 50881], "temperature": 0.0, "avg_logprob": -0.15001883200549204, "compression_ratio": 1.5992779783393503, "no_speech_prob": 2.175277319382829e-12}, {"id": 102, "seek": 29464, "start": 305.06, "end": 309.84, "text": " And even then, we rely heavily on context, visual cues, predictive guessing.", "tokens": [50886, 400, 754, 550, 11, 321, 10687, 10950, 322, 4319, 11, 5056, 32192, 11, 35521, 17939, 13, 51125], "temperature": 0.0, "avg_logprob": -0.15001883200549204, "compression_ratio": 1.5992779783393503, "no_speech_prob": 2.175277319382829e-12}, {"id": 103, "seek": 29464, "start": 310.82, "end": 318.41999999999996, "text": " When a single microphone or even an array of microphones on a phone captures a scene, it's capturing a merged physical reality.", "tokens": [51174, 1133, 257, 2167, 10952, 420, 754, 364, 10225, 295, 30495, 322, 257, 2593, 27986, 257, 4145, 11, 309, 311, 23384, 257, 36427, 4001, 4103, 13, 51554], "temperature": 0.0, "avg_logprob": -0.15001883200549204, "compression_ratio": 1.5992779783393503, "no_speech_prob": 2.175277319382829e-12}, {"id": 104, "seek": 29464, "start": 318.58, "end": 321.0, "text": " Because intention isn't a property of sound waves.", "tokens": [51562, 1436, 7789, 1943, 380, 257, 4707, 295, 1626, 9417, 13, 51683], "temperature": 0.0, "avg_logprob": -0.15001883200549204, "compression_ratio": 1.5992779783393503, "no_speech_prob": 2.175277319382829e-12}, {"id": 105, "seek": 32100, "start": 321.0, "end": 321.62, "text": " Exactly.", "tokens": [50365, 7587, 13, 50396], "temperature": 0.0, "avg_logprob": -0.13115217767912765, "compression_ratio": 1.4857142857142858, "no_speech_prob": 1.8614881771433778e-12}, {"id": 106, "seek": 32100, "start": 322.18, "end": 329.34, "text": " The physical air pressure does not carry a tiny tag that says, you know, this is the important human and this is the irrelevant bird.", "tokens": [50424, 440, 4001, 1988, 3321, 775, 406, 3985, 257, 5870, 6162, 300, 1619, 11, 291, 458, 11, 341, 307, 264, 1021, 1952, 293, 341, 307, 264, 28682, 5255, 13, 50782], "temperature": 0.0, "avg_logprob": -0.13115217767912765, "compression_ratio": 1.4857142857142858, "no_speech_prob": 1.8614881771433778e-12}, {"id": 107, "seek": 32100, "start": 329.46, "end": 336.82, "text": " Which means the distinction between your intended message and the noise of the universe exists only inside your head.", "tokens": [50788, 3013, 1355, 264, 16844, 1296, 428, 10226, 3636, 293, 264, 5658, 295, 264, 6445, 8198, 787, 1854, 428, 1378, 13, 51156], "temperature": 0.0, "avg_logprob": -0.13115217767912765, "compression_ratio": 1.4857142857142858, "no_speech_prob": 1.8614881771433778e-12}, {"id": 108, "seek": 33682, "start": 336.82, "end": 344.18, "text": " Yes. And this leads to Flixian's foundational distinction between a symbol sampling interface and a scene sampling interface.", "tokens": [50365, 1079, 13, 400, 341, 6689, 281, 3235, 970, 952, 311, 32195, 16844, 1296, 257, 5986, 21179, 9226, 293, 257, 4145, 21179, 9226, 13, 50733], "temperature": 0.0, "avg_logprob": -0.1198986204046952, "compression_ratio": 1.5776699029126213, "no_speech_prob": 1.6490436403546194e-12}, {"id": 109, "seek": 33682, "start": 344.34, "end": 345.28, "text": " Okay, let's break those down.", "tokens": [50741, 1033, 11, 718, 311, 1821, 729, 760, 13, 50788], "temperature": 0.0, "avg_logprob": -0.1198986204046952, "compression_ratio": 1.5776699029126213, "no_speech_prob": 1.6490436403546194e-12}, {"id": 110, "seek": 33682, "start": 345.48, "end": 348.76, "text": " So when you type on a keyboard, you're using a symbol sampling channel.", "tokens": [50798, 407, 562, 291, 2010, 322, 257, 10186, 11, 291, 434, 1228, 257, 5986, 21179, 2269, 13, 50962], "temperature": 0.0, "avg_logprob": -0.1198986204046952, "compression_ratio": 1.5776699029126213, "no_speech_prob": 1.6490436403546194e-12}, {"id": 111, "seek": 33682, "start": 349.18, "end": 354.46, "text": " Every time you press a key, you are making a deliberate physical commitment to a specific symbol.", "tokens": [50983, 2048, 565, 291, 1886, 257, 2141, 11, 291, 366, 1455, 257, 30515, 4001, 8371, 281, 257, 2685, 5986, 13, 51247], "temperature": 0.0, "avg_logprob": -0.1198986204046952, "compression_ratio": 1.5776699029126213, "no_speech_prob": 1.6490436403546194e-12}, {"id": 112, "seek": 35446, "start": 354.46, "end": 358.38, "text": " So if a fire truck drives by while I'm typing an email, the keyboard doesn't care.", "tokens": [50365, 407, 498, 257, 2610, 5898, 11754, 538, 1339, 286, 478, 18444, 364, 3796, 11, 264, 10186, 1177, 380, 1127, 13, 50561], "temperature": 0.0, "avg_logprob": -0.12196912556669137, "compression_ratio": 1.713355048859935, "no_speech_prob": 1.8253135548179644e-12}, {"id": 113, "seek": 35446, "start": 358.5, "end": 361.12, "text": " Right. It only ingests what you intentionally feed it.", "tokens": [50567, 1779, 13, 467, 787, 3957, 4409, 437, 291, 22062, 3154, 309, 13, 50698], "temperature": 0.0, "avg_logprob": -0.12196912556669137, "compression_ratio": 1.713355048859935, "no_speech_prob": 1.8253135548179644e-12}, {"id": 114, "seek": 35446, "start": 361.29999999999995, "end": 363.73999999999995, "text": " So a keyboard is essentially like a mechanical turnstile.", "tokens": [50707, 407, 257, 10186, 307, 4476, 411, 257, 12070, 1261, 372, 794, 13, 50829], "temperature": 0.0, "avg_logprob": -0.12196912556669137, "compression_ratio": 1.713355048859935, "no_speech_prob": 1.8253135548179644e-12}, {"id": 115, "seek": 35446, "start": 363.79999999999995, "end": 364.5, "text": " Oh, I like that.", "tokens": [50832, 876, 11, 286, 411, 300, 13, 50867], "temperature": 0.0, "avg_logprob": -0.12196912556669137, "compression_ratio": 1.713355048859935, "no_speech_prob": 1.8253135548179644e-12}, {"id": 116, "seek": 35446, "start": 364.68, "end": 369.62, "text": " It only lets one intentional thought through at a time, provided you physically push the gate.", "tokens": [50876, 467, 787, 6653, 472, 21935, 1194, 807, 412, 257, 565, 11, 5649, 291, 9762, 2944, 264, 8539, 13, 51123], "temperature": 0.0, "avg_logprob": -0.12196912556669137, "compression_ratio": 1.713355048859935, "no_speech_prob": 1.8253135548179644e-12}, {"id": 117, "seek": 35446, "start": 369.85999999999996, "end": 374.32, "text": " Like you can't accidentally fall through a turnstile and the wind can't blow it open.", "tokens": [51135, 1743, 291, 393, 380, 15715, 2100, 807, 257, 1261, 372, 794, 293, 264, 2468, 393, 380, 6327, 309, 1269, 13, 51358], "temperature": 0.0, "avg_logprob": -0.12196912556669137, "compression_ratio": 1.713355048859935, "no_speech_prob": 1.8253135548179644e-12}, {"id": 118, "seek": 35446, "start": 374.5, "end": 376.79999999999995, "text": " It demands specific, deliberate input.", "tokens": [51367, 467, 15107, 2685, 11, 30515, 4846, 13, 51482], "temperature": 0.0, "avg_logprob": -0.12196912556669137, "compression_ratio": 1.713355048859935, "no_speech_prob": 1.8253135548179644e-12}, {"id": 119, "seek": 35446, "start": 377.17999999999995, "end": 379.53999999999996, "text": " That's a highly accurate way to visualize it.", "tokens": [51501, 663, 311, 257, 5405, 8559, 636, 281, 23273, 309, 13, 51619], "temperature": 0.0, "avg_logprob": -0.12196912556669137, "compression_ratio": 1.713355048859935, "no_speech_prob": 1.8253135548179644e-12}, {"id": 120, "seek": 35446, "start": 379.76, "end": 381.82, "text": " But a microphone doesn't work like a turnstile.", "tokens": [51630, 583, 257, 10952, 1177, 380, 589, 411, 257, 1261, 372, 794, 13, 51733], "temperature": 0.0, "avg_logprob": -0.12196912556669137, "compression_ratio": 1.713355048859935, "no_speech_prob": 1.8253135548179644e-12}, {"id": 121, "seek": 38182, "start": 381.82, "end": 384.28, "text": " A microphone is a scene sampling interface.", "tokens": [50365, 316, 10952, 307, 257, 4145, 21179, 9226, 13, 50488], "temperature": 0.0, "avg_logprob": -0.12203368058441379, "compression_ratio": 1.675, "no_speech_prob": 1.4782102408447684e-12}, {"id": 122, "seek": 38182, "start": 384.5, "end": 385.58, "text": " It's taking in the whole scene.", "tokens": [50499, 467, 311, 1940, 294, 264, 1379, 4145, 13, 50553], "temperature": 0.0, "avg_logprob": -0.12203368058441379, "compression_ratio": 1.675, "no_speech_prob": 1.4782102408447684e-12}, {"id": 123, "seek": 38182, "start": 385.68, "end": 389.68, "text": " Yeah, it's a giant indiscriminate net thrown into the ocean of your environment.", "tokens": [50558, 865, 11, 309, 311, 257, 7410, 1016, 5606, 16796, 473, 2533, 11732, 666, 264, 7810, 295, 428, 2823, 13, 50758], "temperature": 0.0, "avg_logprob": -0.12203368058441379, "compression_ratio": 1.675, "no_speech_prob": 1.4782102408447684e-12}, {"id": 124, "seek": 38182, "start": 389.82, "end": 393.14, "text": " You throw it out, hoping to catch one specific salmon, your voice.", "tokens": [50765, 509, 3507, 309, 484, 11, 7159, 281, 3745, 472, 2685, 18518, 11, 428, 3177, 13, 50931], "temperature": 0.0, "avg_logprob": -0.12203368058441379, "compression_ratio": 1.675, "no_speech_prob": 1.4782102408447684e-12}, {"id": 125, "seek": 38182, "start": 393.28, "end": 398.24, "text": " But the net drags up the salmon, seaweed, an old boot, some jellyfish.", "tokens": [50938, 583, 264, 2533, 5286, 82, 493, 264, 18518, 11, 29449, 11, 364, 1331, 11450, 11, 512, 17186, 11608, 13, 51186], "temperature": 0.0, "avg_logprob": -0.12203368058441379, "compression_ratio": 1.675, "no_speech_prob": 1.4782102408447684e-12}, {"id": 126, "seek": 38182, "start": 398.42, "end": 401.36, "text": " Exactly. And whatever else was in that cubic volume of space.", "tokens": [51195, 7587, 13, 400, 2035, 1646, 390, 294, 300, 28733, 5523, 295, 1901, 13, 51342], "temperature": 0.0, "avg_logprob": -0.12203368058441379, "compression_ratio": 1.675, "no_speech_prob": 1.4782102408447684e-12}, {"id": 127, "seek": 38182, "start": 401.48, "end": 403.21999999999997, "text": " And the net doesn't care about your intentions.", "tokens": [51348, 400, 264, 2533, 1177, 380, 1127, 466, 428, 19354, 13, 51435], "temperature": 0.0, "avg_logprob": -0.12203368058441379, "compression_ratio": 1.675, "no_speech_prob": 1.4782102408447684e-12}, {"id": 128, "seek": 38182, "start": 403.46, "end": 404.1, "text": " That one bit.", "tokens": [51447, 663, 472, 857, 13, 51479], "temperature": 0.0, "avg_logprob": -0.12203368058441379, "compression_ratio": 1.675, "no_speech_prob": 1.4782102408447684e-12}, {"id": 129, "seek": 38182, "start": 404.34, "end": 407.02, "text": " So if intention isn't in the acoustic signal at all,", "tokens": [51491, 407, 498, 7789, 1943, 380, 294, 264, 26753, 6358, 412, 439, 11, 51625], "temperature": 0.0, "avg_logprob": -0.12203368058441379, "compression_ratio": 1.675, "no_speech_prob": 1.4782102408447684e-12}, {"id": 130, "seek": 38182, "start": 407.28, "end": 410.96, "text": " and it's mathematically impossible to unmix the waves perfectly,", "tokens": [51638, 293, 309, 311, 44003, 6243, 281, 19334, 970, 264, 9417, 6239, 11, 51822], "temperature": 0.0, "avg_logprob": -0.12203368058441379, "compression_ratio": 1.675, "no_speech_prob": 1.4782102408447684e-12}, {"id": 131, "seek": 41182, "start": 411.82, "end": 415.36, "text": " how do modern speech-to-text systems actually work?", "tokens": [50365, 577, 360, 4363, 6218, 12, 1353, 12, 25111, 3652, 767, 589, 30, 50542], "temperature": 0.0, "avg_logprob": -0.20006930720698726, "compression_ratio": 1.5846153846153845, "no_speech_prob": 1.2840999964736088e-12}, {"id": 132, "seek": 41182, "start": 416.04, "end": 418.96, "text": " How do they ever manage to give me a clean transcript?", "tokens": [50576, 1012, 360, 436, 1562, 3067, 281, 976, 385, 257, 2541, 24444, 30, 50722], "temperature": 0.0, "avg_logprob": -0.20006930720698726, "compression_ratio": 1.5846153846153845, "no_speech_prob": 1.2840999964736088e-12}, {"id": 133, "seek": 41182, "start": 419.34, "end": 420.14, "text": " Well, they fake it.", "tokens": [50741, 1042, 11, 436, 7592, 309, 13, 50781], "temperature": 0.0, "avg_logprob": -0.20006930720698726, "compression_ratio": 1.5846153846153845, "no_speech_prob": 1.2840999964736088e-12}, {"id": 134, "seek": 41182, "start": 420.26, "end": 420.82, "text": " They fake it.", "tokens": [50787, 814, 7592, 309, 13, 50815], "temperature": 0.0, "avg_logprob": -0.20006930720698726, "compression_ratio": 1.5846153846153845, "no_speech_prob": 1.2840999964736088e-12}, {"id": 135, "seek": 41182, "start": 421.24, "end": 421.52, "text": " Yeah.", "tokens": [50836, 865, 13, 50850], "temperature": 0.0, "avg_logprob": -0.20006930720698726, "compression_ratio": 1.5846153846153845, "no_speech_prob": 1.2840999964736088e-12}, {"id": 136, "seek": 41182, "start": 422.09999999999997, "end": 426.12, "text": " This is Fliction's theorem 4.6 regarding conversion asymmetry.", "tokens": [50879, 639, 307, 3235, 4105, 311, 20904, 1017, 13, 21, 8595, 14298, 37277, 9889, 13, 51080], "temperature": 0.0, "avg_logprob": -0.20006930720698726, "compression_ratio": 1.5846153846153845, "no_speech_prob": 1.2840999964736088e-12}, {"id": 137, "seek": 41182, "start": 426.88, "end": 429.78, "text": " Think about text-to-speech making a computer talk.", "tokens": [51118, 6557, 466, 2487, 12, 1353, 12, 7053, 5023, 1455, 257, 3820, 751, 13, 51263], "temperature": 0.0, "avg_logprob": -0.20006930720698726, "compression_ratio": 1.5846153846153845, "no_speech_prob": 1.2840999964736088e-12}, {"id": 138, "seek": 41182, "start": 430.15999999999997, "end": 434.78, "text": " That's computationally trivial because you start with a clean source of committed symbols.", "tokens": [51282, 663, 311, 24903, 379, 26703, 570, 291, 722, 365, 257, 2541, 4009, 295, 7784, 16944, 13, 51513], "temperature": 0.0, "avg_logprob": -0.20006930720698726, "compression_ratio": 1.5846153846153845, "no_speech_prob": 1.2840999964736088e-12}, {"id": 139, "seek": 41182, "start": 434.78, "end": 437.1, "text": " Right. The computer already knows exactly what words to say.", "tokens": [51513, 1779, 13, 440, 3820, 1217, 3255, 2293, 437, 2283, 281, 584, 13, 51629], "temperature": 0.0, "avg_logprob": -0.20006930720698726, "compression_ratio": 1.5846153846153845, "no_speech_prob": 1.2840999964736088e-12}, {"id": 140, "seek": 43710, "start": 437.1, "end": 442.8, "text": " But speech-to-text relies entirely on massive, probabilistic AI models", "tokens": [50365, 583, 6218, 12, 1353, 12, 25111, 30910, 7696, 322, 5994, 11, 31959, 3142, 7318, 5245, 50650], "temperature": 0.0, "avg_logprob": -0.10941037443495288, "compression_ratio": 1.5458333333333334, "no_speech_prob": 1.3354514976499088e-12}, {"id": 141, "seek": 43710, "start": 442.8, "end": 446.22, "text": " hallucinating a clean transcript from a dirty signal.", "tokens": [50650, 35212, 8205, 257, 2541, 24444, 490, 257, 9360, 6358, 13, 50821], "temperature": 0.0, "avg_logprob": -0.10941037443495288, "compression_ratio": 1.5458333333333334, "no_speech_prob": 1.3354514976499088e-12}, {"id": 142, "seek": 43710, "start": 446.86, "end": 448.42, "text": " Hallucinating. That's a strong word.", "tokens": [50853, 5434, 1311, 8205, 13, 663, 311, 257, 2068, 1349, 13, 50931], "temperature": 0.0, "avg_logprob": -0.10941037443495288, "compression_ratio": 1.5458333333333334, "no_speech_prob": 1.3354514976499088e-12}, {"id": 143, "seek": 43710, "start": 448.54, "end": 449.6, "text": " It's accurate, though.", "tokens": [50937, 467, 311, 8559, 11, 1673, 13, 50990], "temperature": 0.0, "avg_logprob": -0.10941037443495288, "compression_ratio": 1.5458333333333334, "no_speech_prob": 1.3354514976499088e-12}, {"id": 144, "seek": 43710, "start": 449.70000000000005, "end": 452.76000000000005, "text": " Any filtering that happens, any attribution of, you know,", "tokens": [50995, 2639, 30822, 300, 2314, 11, 604, 9080, 1448, 295, 11, 291, 458, 11, 51148], "temperature": 0.0, "avg_logprob": -0.10941037443495288, "compression_ratio": 1.5458333333333334, "no_speech_prob": 1.3354514976499088e-12}, {"id": 145, "seek": 43710, "start": 452.86, "end": 454.86, "text": " this is the speaker, this is background noise,", "tokens": [51153, 341, 307, 264, 8145, 11, 341, 307, 3678, 5658, 11, 51253], "temperature": 0.0, "avg_logprob": -0.10941037443495288, "compression_ratio": 1.5458333333333334, "no_speech_prob": 1.3354514976499088e-12}, {"id": 146, "seek": 43710, "start": 454.92, "end": 458.82000000000005, "text": " that is supplied entirely by the AI's training weights, not by the signal itself.", "tokens": [51256, 300, 307, 27625, 7696, 538, 264, 7318, 311, 3097, 17443, 11, 406, 538, 264, 6358, 2564, 13, 51451], "temperature": 0.0, "avg_logprob": -0.10941037443495288, "compression_ratio": 1.5458333333333334, "no_speech_prob": 1.3354514976499088e-12}, {"id": 147, "seek": 45882, "start": 458.82, "end": 463.52, "text": " Wow. So if I dictate a highly sensitive, nuanced message in a crowded room,", "tokens": [50365, 3153, 13, 407, 498, 286, 36071, 257, 5405, 9477, 11, 45115, 3636, 294, 257, 21634, 1808, 11, 50600], "temperature": 0.0, "avg_logprob": -0.12451134353387551, "compression_ratio": 1.6885245901639345, "no_speech_prob": 1.654889983729313e-12}, {"id": 148, "seek": 45882, "start": 464.12, "end": 467.44, "text": " the transcript that pops out isn't an objective recording of what I said.", "tokens": [50630, 264, 24444, 300, 16795, 484, 1943, 380, 364, 10024, 6613, 295, 437, 286, 848, 13, 50796], "temperature": 0.0, "avg_logprob": -0.12451134353387551, "compression_ratio": 1.6885245901639345, "no_speech_prob": 1.654889983729313e-12}, {"id": 149, "seek": 45882, "start": 467.5, "end": 467.7, "text": " Nope.", "tokens": [50799, 12172, 13, 50809], "temperature": 0.0, "avg_logprob": -0.12451134353387551, "compression_ratio": 1.6885245901639345, "no_speech_prob": 1.654889983729313e-12}, {"id": 150, "seek": 45882, "start": 468.02, "end": 472.15999999999997, "text": " It is literally the AI's opinion of what I meant to say based on statistical priors.", "tokens": [50825, 467, 307, 3736, 264, 7318, 311, 4800, 295, 437, 286, 4140, 281, 584, 2361, 322, 22820, 1790, 830, 13, 51032], "temperature": 0.0, "avg_logprob": -0.12451134353387551, "compression_ratio": 1.6885245901639345, "no_speech_prob": 1.654889983729313e-12}, {"id": 151, "seek": 45882, "start": 472.6, "end": 475.6, "text": " It is a statistical hallucination guided by sound waves.", "tokens": [51054, 467, 307, 257, 22820, 35212, 2486, 19663, 538, 1626, 9417, 13, 51204], "temperature": 0.0, "avg_logprob": -0.12451134353387551, "compression_ratio": 1.6885245901639345, "no_speech_prob": 1.654889983729313e-12}, {"id": 152, "seek": 45882, "start": 476.2, "end": 478.38, "text": " When you type, you perfectly preserve your intention.", "tokens": [51234, 1133, 291, 2010, 11, 291, 6239, 15665, 428, 7789, 13, 51343], "temperature": 0.0, "avg_logprob": -0.12451134353387551, "compression_ratio": 1.6885245901639345, "no_speech_prob": 1.654889983729313e-12}, {"id": 153, "seek": 45882, "start": 478.98, "end": 483.24, "text": " When you speak, you are throwing your intention into a blender with the physical world", "tokens": [51373, 1133, 291, 1710, 11, 291, 366, 10238, 428, 7789, 666, 257, 24564, 365, 264, 4001, 1002, 51586], "temperature": 0.0, "avg_logprob": -0.12451134353387551, "compression_ratio": 1.6885245901639345, "no_speech_prob": 1.654889983729313e-12}, {"id": 154, "seek": 45882, "start": 483.24, "end": 486.92, "text": " and then asking a neural network to reconstruct your mind from the smoothie.", "tokens": [51586, 293, 550, 3365, 257, 18161, 3209, 281, 31499, 428, 1575, 490, 264, 36328, 13, 51770], "temperature": 0.0, "avg_logprob": -0.12451134353387551, "compression_ratio": 1.6885245901639345, "no_speech_prob": 1.654889983729313e-12}, {"id": 155, "seek": 48692, "start": 486.92, "end": 489.44, "text": " Reconstruct your mind from the smoothie.", "tokens": [50365, 1300, 25279, 1757, 428, 1575, 490, 264, 36328, 13, 50491], "temperature": 0.0, "avg_logprob": -0.16848762964798233, "compression_ratio": 1.5179856115107915, "no_speech_prob": 1.846551123813045e-12}, {"id": 156, "seek": 48692, "start": 489.62, "end": 490.52000000000004, "text": " I love that.", "tokens": [50500, 286, 959, 300, 13, 50545], "temperature": 0.0, "avg_logprob": -0.16848762964798233, "compression_ratio": 1.5179856115107915, "no_speech_prob": 1.846551123813045e-12}, {"id": 157, "seek": 48692, "start": 491.02000000000004, "end": 496.42, "text": " And this completely explains why failures on these two channels feel so wildly different.", "tokens": [50570, 400, 341, 2584, 13948, 983, 20774, 322, 613, 732, 9235, 841, 370, 34731, 819, 13, 50840], "temperature": 0.0, "avg_logprob": -0.16848762964798233, "compression_ratio": 1.5179856115107915, "no_speech_prob": 1.846551123813045e-12}, {"id": 158, "seek": 48692, "start": 496.56, "end": 497.24, "text": " How so?", "tokens": [50847, 1012, 370, 30, 50881], "temperature": 0.0, "avg_logprob": -0.16848762964798233, "compression_ratio": 1.5179856115107915, "no_speech_prob": 1.846551123813045e-12}, {"id": 159, "seek": 48692, "start": 497.7, "end": 500.84000000000003, "text": " Well, if my keyboard auto-corrects a word to something ridiculous,", "tokens": [50904, 1042, 11, 498, 452, 10186, 8399, 12, 19558, 2554, 82, 257, 1349, 281, 746, 11083, 11, 51061], "temperature": 0.0, "avg_logprob": -0.16848762964798233, "compression_ratio": 1.5179856115107915, "no_speech_prob": 1.846551123813045e-12}, {"id": 160, "seek": 48692, "start": 501.40000000000003, "end": 504.76, "text": " it's annoying, but it's a corruption within the symbols I committed.", "tokens": [51089, 309, 311, 11304, 11, 457, 309, 311, 257, 17959, 1951, 264, 16944, 286, 7784, 13, 51257], "temperature": 0.0, "avg_logprob": -0.16848762964798233, "compression_ratio": 1.5179856115107915, "no_speech_prob": 1.846551123813045e-12}, {"id": 161, "seek": 48692, "start": 504.90000000000003, "end": 507.68, "text": " Like, I can clearly see it, backspace, and fix it.", "tokens": [51264, 1743, 11, 286, 393, 4448, 536, 309, 11, 646, 24824, 11, 293, 3191, 309, 13, 51403], "temperature": 0.0, "avg_logprob": -0.16848762964798233, "compression_ratio": 1.5179856115107915, "no_speech_prob": 1.846551123813045e-12}, {"id": 162, "seek": 48692, "start": 507.74, "end": 508.0, "text": " Right.", "tokens": [51406, 1779, 13, 51419], "temperature": 0.0, "avg_logprob": -0.16848762964798233, "compression_ratio": 1.5179856115107915, "no_speech_prob": 1.846551123813045e-12}, {"id": 163, "seek": 48692, "start": 508.32, "end": 512.66, "text": " But when a scene-sampling microphone fails, it doesn't just misspell a word.", "tokens": [51435, 583, 562, 257, 4145, 12, 19988, 11970, 10952, 18199, 11, 309, 1177, 380, 445, 1713, 49241, 257, 1349, 13, 51652], "temperature": 0.0, "avg_logprob": -0.16848762964798233, "compression_ratio": 1.5179856115107915, "no_speech_prob": 1.846551123813045e-12}, {"id": 164, "seek": 51266, "start": 512.66, "end": 516.6999999999999, "text": " It takes a reality I didn't author, like, the children's satirical wishes", "tokens": [50365, 467, 2516, 257, 4103, 286, 994, 380, 3793, 11, 411, 11, 264, 2227, 311, 3227, 347, 804, 15065, 50567], "temperature": 0.0, "avg_logprob": -0.1470228286016555, "compression_ratio": 1.6007462686567164, "no_speech_prob": 1.455065668648503e-12}, {"id": 165, "seek": 51266, "start": 516.6999999999999, "end": 520.0799999999999, "text": " and forcibly injects it into my personal record.", "tokens": [50567, 293, 337, 537, 25021, 10711, 82, 309, 666, 452, 2973, 2136, 13, 50736], "temperature": 0.0, "avg_logprob": -0.1470228286016555, "compression_ratio": 1.6007462686567164, "no_speech_prob": 1.455065668648503e-12}, {"id": 166, "seek": 51266, "start": 520.26, "end": 522.02, "text": " It admits the environment.", "tokens": [50745, 467, 46682, 264, 2823, 13, 50833], "temperature": 0.0, "avg_logprob": -0.1470228286016555, "compression_ratio": 1.6007462686567164, "no_speech_prob": 1.455065668648503e-12}, {"id": 167, "seek": 51266, "start": 522.48, "end": 524.86, "text": " And that concept of admitting the environment is crucial,", "tokens": [50856, 400, 300, 3410, 295, 44056, 264, 2823, 307, 11462, 11, 50975], "temperature": 0.0, "avg_logprob": -0.1470228286016555, "compression_ratio": 1.6007462686567164, "no_speech_prob": 1.455065668648503e-12}, {"id": 168, "seek": 51266, "start": 525.0799999999999, "end": 528.8, "text": " but fliction doesn't stop at how these interfaces capture physical space.", "tokens": [50986, 457, 932, 4105, 1177, 380, 1590, 412, 577, 613, 28416, 7983, 4001, 1901, 13, 51172], "temperature": 0.0, "avg_logprob": -0.1470228286016555, "compression_ratio": 1.6007462686567164, "no_speech_prob": 1.455065668648503e-12}, {"id": 169, "seek": 51266, "start": 528.92, "end": 529.62, "text": " Where do they go next?", "tokens": [51178, 2305, 360, 436, 352, 958, 30, 51213], "temperature": 0.0, "avg_logprob": -0.1470228286016555, "compression_ratio": 1.6007462686567164, "no_speech_prob": 1.455065668648503e-12}, {"id": 170, "seek": 51266, "start": 529.76, "end": 533.4599999999999, "text": " The treatise makes this fascinating pivot to show how the physics of these channels", "tokens": [51220, 440, 2387, 908, 1669, 341, 10343, 14538, 281, 855, 577, 264, 10649, 295, 613, 9235, 51405], "temperature": 0.0, "avg_logprob": -0.1470228286016555, "compression_ratio": 1.6007462686567164, "no_speech_prob": 1.455065668648503e-12}, {"id": 171, "seek": 51266, "start": 533.4599999999999, "end": 536.18, "text": " entirely dictate how we experience time.", "tokens": [51405, 7696, 36071, 577, 321, 1752, 565, 13, 51541], "temperature": 0.0, "avg_logprob": -0.1470228286016555, "compression_ratio": 1.6007462686567164, "no_speech_prob": 1.455065668648503e-12}, {"id": 172, "seek": 53618, "start": 536.18, "end": 540.62, "text": " The difference between a turnstile and a fishing net isn't just spatial.", "tokens": [50365, 440, 2649, 1296, 257, 1261, 372, 794, 293, 257, 10180, 2533, 1943, 380, 445, 23598, 13, 50587], "temperature": 0.0, "avg_logprob": -0.1655646057128906, "compression_ratio": 1.6064516129032258, "no_speech_prob": 1.567167294373728e-12}, {"id": 173, "seek": 53618, "start": 540.8, "end": 543.18, "text": " It fundamentally alters our biological rhythm.", "tokens": [50596, 467, 17879, 419, 1559, 527, 13910, 11801, 13, 50715], "temperature": 0.0, "avg_logprob": -0.1655646057128906, "compression_ratio": 1.6064516129032258, "no_speech_prob": 1.567167294373728e-12}, {"id": 174, "seek": 53618, "start": 543.4599999999999, "end": 543.4799999999999, "text": " Right.", "tokens": [50729, 1779, 13, 50730], "temperature": 0.0, "avg_logprob": -0.1655646057128906, "compression_ratio": 1.6064516129032258, "no_speech_prob": 1.567167294373728e-12}, {"id": 175, "seek": 53618, "start": 543.5799999999999, "end": 547.42, "text": " This is where we get into the concepts of rate coupling and suspension observability.", "tokens": [50735, 639, 307, 689, 321, 483, 666, 264, 10392, 295, 3314, 37447, 293, 15771, 9951, 2310, 13, 50927], "temperature": 0.0, "avg_logprob": -0.1655646057128906, "compression_ratio": 1.6064516129032258, "no_speech_prob": 1.567167294373728e-12}, {"id": 176, "seek": 53618, "start": 547.52, "end": 547.66, "text": " Yes.", "tokens": [50932, 1079, 13, 50939], "temperature": 0.0, "avg_logprob": -0.1655646057128906, "compression_ratio": 1.6064516129032258, "no_speech_prob": 1.567167294373728e-12}, {"id": 177, "seek": 53618, "start": 547.8199999999999, "end": 553.14, "text": " And honestly, this part of the treatise felt like it diagnosed a specific modern anxiety", "tokens": [50947, 400, 6095, 11, 341, 644, 295, 264, 2387, 908, 2762, 411, 309, 16899, 257, 2685, 4363, 9119, 51213], "temperature": 0.0, "avg_logprob": -0.1655646057128906, "compression_ratio": 1.6064516129032258, "no_speech_prob": 1.567167294373728e-12}, {"id": 178, "seek": 53618, "start": 553.14, "end": 556.4799999999999, "text": " I've had for years, but just couldn't articulate.", "tokens": [51213, 286, 600, 632, 337, 924, 11, 457, 445, 2809, 380, 30305, 13, 51380], "temperature": 0.0, "avg_logprob": -0.1655646057128906, "compression_ratio": 1.6064516129032258, "no_speech_prob": 1.567167294373728e-12}, {"id": 179, "seek": 53618, "start": 557.7199999999999, "end": 559.52, "text": " Let's break down rate coupling first.", "tokens": [51442, 961, 311, 1821, 760, 3314, 37447, 700, 13, 51532], "temperature": 0.0, "avg_logprob": -0.1655646057128906, "compression_ratio": 1.6064516129032258, "no_speech_prob": 1.567167294373728e-12}, {"id": 180, "seek": 53618, "start": 559.8599999999999, "end": 560.9399999999999, "text": " What clocks are we coupling?", "tokens": [51549, 708, 41528, 366, 321, 37447, 30, 51603], "temperature": 0.0, "avg_logprob": -0.1655646057128906, "compression_ratio": 1.6064516129032258, "no_speech_prob": 1.567167294373728e-12}, {"id": 181, "seek": 53618, "start": 561.26, "end": 565.1999999999999, "text": " We're coupling the literal wall clock time of the sender and the receiver.", "tokens": [51619, 492, 434, 37447, 264, 20411, 2929, 7830, 565, 295, 264, 2845, 260, 293, 264, 20086, 13, 51816], "temperature": 0.0, "avg_logprob": -0.1655646057128906, "compression_ratio": 1.6064516129032258, "no_speech_prob": 1.567167294373728e-12}, {"id": 182, "seek": 56520, "start": 565.2, "end": 567.48, "text": " Think about a live phone call.", "tokens": [50365, 6557, 466, 257, 1621, 2593, 818, 13, 50479], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 183, "seek": 56520, "start": 568.24, "end": 570.34, "text": " A phone call is a rate-coupled channel.", "tokens": [50517, 316, 2593, 818, 307, 257, 3314, 12, 66, 263, 15551, 2269, 13, 50622], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 184, "seek": 56520, "start": 570.72, "end": 572.12, "text": " It forces a shared tempo.", "tokens": [50641, 467, 5874, 257, 5507, 8972, 13, 50711], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 185, "seek": 56520, "start": 572.7, "end": 576.24, "text": " You and I must allocate the exact same block of time simultaneously.", "tokens": [50740, 509, 293, 286, 1633, 35713, 264, 1900, 912, 3461, 295, 565, 16561, 13, 50917], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 186, "seek": 56520, "start": 576.82, "end": 579.84, "text": " I cannot speak an hour's worth of information into your single minute.", "tokens": [50946, 286, 2644, 1710, 364, 1773, 311, 3163, 295, 1589, 666, 428, 2167, 3456, 13, 51097], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 187, "seek": 56520, "start": 579.98, "end": 580.7, "text": " We're locked together.", "tokens": [51104, 492, 434, 9376, 1214, 13, 51140], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 188, "seek": 56520, "start": 580.88, "end": 582.0400000000001, "text": " Our schedules are hand-cut.", "tokens": [51149, 2621, 28078, 366, 1011, 12, 6672, 13, 51207], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 189, "seek": 56520, "start": 582.1, "end": 582.46, "text": " Exactly.", "tokens": [51210, 7587, 13, 51228], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 190, "seek": 56520, "start": 582.76, "end": 584.6800000000001, "text": " But reading and writing are rate decoupled.", "tokens": [51243, 583, 3760, 293, 3579, 366, 3314, 979, 263, 15551, 13, 51339], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 191, "seek": 56520, "start": 585.48, "end": 588.6800000000001, "text": " Like, an author can spend 10 years agonizing over a novel,", "tokens": [51379, 1743, 11, 364, 3793, 393, 3496, 1266, 924, 623, 266, 3319, 670, 257, 7613, 11, 51539], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 192, "seek": 56520, "start": 589.1, "end": 591.22, "text": " sweating out a single paragraph over a week.", "tokens": [51560, 25438, 484, 257, 2167, 18865, 670, 257, 1243, 13, 51666], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 193, "seek": 56520, "start": 591.3000000000001, "end": 591.5400000000001, "text": " Right.", "tokens": [51670, 1779, 13, 51682], "temperature": 0.0, "avg_logprob": -0.18840943276882172, "compression_ratio": 1.5445205479452055, "no_speech_prob": 1.6684904326214056e-12}, {"id": 194, "seek": 59154, "start": 591.54, "end": 596.3199999999999, "text": " And I can sit on my couch on a Sunday and consume that entire decade of labor in six hours?", "tokens": [50365, 400, 286, 393, 1394, 322, 452, 16511, 322, 257, 7776, 293, 14732, 300, 2302, 10378, 295, 5938, 294, 2309, 2496, 30, 50604], "temperature": 0.0, "avg_logprob": -0.15884194229588364, "compression_ratio": 1.6358024691358024, "no_speech_prob": 1.7082122391945398e-12}, {"id": 195, "seek": 59154, "start": 597.04, "end": 599.56, "text": " Our clocks have absolutely nothing to do with each other.", "tokens": [50640, 2621, 41528, 362, 3122, 1825, 281, 360, 365, 1184, 661, 13, 50766], "temperature": 0.0, "avg_logprob": -0.15884194229588364, "compression_ratio": 1.6358024691358024, "no_speech_prob": 1.7082122391945398e-12}, {"id": 196, "seek": 59154, "start": 599.66, "end": 599.98, "text": " Exactly.", "tokens": [50771, 7587, 13, 50787], "temperature": 0.0, "avg_logprob": -0.15884194229588364, "compression_ratio": 1.6358024691358024, "no_speech_prob": 1.7082122391945398e-12}, {"id": 197, "seek": 59154, "start": 600.4, "end": 602.06, "text": " The channel absorbs the temporal friction,", "tokens": [50808, 440, 2269, 40745, 264, 30881, 17710, 11, 50891], "temperature": 0.0, "avg_logprob": -0.15884194229588364, "compression_ratio": 1.6358024691358024, "no_speech_prob": 1.7082122391945398e-12}, {"id": 198, "seek": 59154, "start": 602.28, "end": 606.02, "text": " but rate decoupling is only one half of what makes an interface truly asynchronous.", "tokens": [50902, 457, 3314, 979, 263, 11970, 307, 787, 472, 1922, 295, 437, 1669, 364, 9226, 4908, 49174, 13, 51089], "temperature": 0.0, "avg_logprob": -0.15884194229588364, "compression_ratio": 1.6358024691358024, "no_speech_prob": 1.7082122391945398e-12}, {"id": 199, "seek": 59154, "start": 607.04, "end": 610.68, "text": " The real psychological weight comes from Fliction's definition 3.2,", "tokens": [51140, 440, 957, 14346, 3364, 1487, 490, 3235, 4105, 311, 7123, 805, 13, 17, 11, 51322], "temperature": 0.0, "avg_logprob": -0.15884194229588364, "compression_ratio": 1.6358024691358024, "no_speech_prob": 1.7082122391945398e-12}, {"id": 200, "seek": 59154, "start": 610.78, "end": 612.42, "text": " which is suspension observability.", "tokens": [51327, 597, 307, 15771, 9951, 2310, 13, 51409], "temperature": 0.0, "avg_logprob": -0.15884194229588364, "compression_ratio": 1.6358024691358024, "no_speech_prob": 1.7082122391945398e-12}, {"id": 201, "seek": 59154, "start": 612.92, "end": 614.06, "text": " Suspension observability.", "tokens": [51434, 9545, 79, 3378, 9951, 2310, 13, 51491], "temperature": 0.0, "avg_logprob": -0.15884194229588364, "compression_ratio": 1.6358024691358024, "no_speech_prob": 1.7082122391945398e-12}, {"id": 202, "seek": 59154, "start": 614.4399999999999, "end": 616.76, "text": " This is the concept of whether or not the machine,", "tokens": [51510, 639, 307, 264, 3410, 295, 1968, 420, 406, 264, 3479, 11, 51626], "temperature": 0.0, "avg_logprob": -0.15884194229588364, "compression_ratio": 1.6358024691358024, "no_speech_prob": 1.7082122391945398e-12}, {"id": 203, "seek": 59154, "start": 617.14, "end": 619.54, "text": " and by extension the person on the other end, can see you pause.", "tokens": [51645, 293, 538, 10320, 264, 954, 322, 264, 661, 917, 11, 393, 536, 291, 10465, 13, 51765], "temperature": 0.0, "avg_logprob": -0.15884194229588364, "compression_ratio": 1.6358024691358024, "no_speech_prob": 1.7082122391945398e-12}, {"id": 204, "seek": 61954, "start": 619.54, "end": 619.9399999999999, "text": " Yes.", "tokens": [50365, 1079, 13, 50385], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 205, "seek": 61954, "start": 620.5, "end": 623.5799999999999, "text": " On a live, rate-coupled channel, like a phone call,", "tokens": [50413, 1282, 257, 1621, 11, 3314, 12, 66, 263, 15551, 2269, 11, 411, 257, 2593, 818, 11, 50567], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 206, "seek": 61954, "start": 624.06, "end": 626.16, "text": " silence is not merely the absence of data.", "tokens": [50591, 12239, 307, 406, 17003, 264, 17145, 295, 1412, 13, 50696], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 207, "seek": 61954, "start": 626.74, "end": 628.02, "text": " Silence is an active event.", "tokens": [50725, 34570, 307, 364, 4967, 2280, 13, 50789], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 208, "seek": 61954, "start": 628.3, "end": 628.78, "text": " Oh, absolutely.", "tokens": [50803, 876, 11, 3122, 13, 50827], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 209, "seek": 61954, "start": 629.12, "end": 631.5999999999999, "text": " If we're on the phone and you just go dead silent for 12 seconds,", "tokens": [50844, 759, 321, 434, 322, 264, 2593, 293, 291, 445, 352, 3116, 12784, 337, 2272, 3949, 11, 50968], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 210, "seek": 61954, "start": 631.74, "end": 632.86, "text": " I'm not going to sit there peacefully.", "tokens": [50975, 286, 478, 406, 516, 281, 1394, 456, 36485, 13, 51031], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 211, "seek": 61954, "start": 633.0, "end": 633.6999999999999, "text": " No, you'd panic.", "tokens": [51038, 883, 11, 291, 1116, 14783, 13, 51073], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 212, "seek": 61954, "start": 633.9399999999999, "end": 634.48, "text": " Yeah, I'm going to say,", "tokens": [51085, 865, 11, 286, 478, 516, 281, 584, 11, 51112], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 213, "seek": 61954, "start": 634.8, "end": 636.5999999999999, "text": " Hello? Did I lose you? Are you still there?", "tokens": [51128, 2425, 30, 2589, 286, 3624, 291, 30, 2014, 291, 920, 456, 30, 51218], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 214, "seek": 61954, "start": 638.0999999999999, "end": 639.5, "text": " Because the channel is live.", "tokens": [51293, 1436, 264, 2269, 307, 1621, 13, 51363], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 215, "seek": 61954, "start": 639.8399999999999, "end": 641.56, "text": " Dead air is deeply alarming.", "tokens": [51380, 12550, 1988, 307, 8760, 44043, 13, 51466], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 216, "seek": 61954, "start": 641.92, "end": 643.04, "text": " It demands an explanation.", "tokens": [51484, 467, 15107, 364, 10835, 13, 51540], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 217, "seek": 61954, "start": 643.4, "end": 645.66, "text": " But on a text-based, asynchronous channel,", "tokens": [51558, 583, 322, 257, 2487, 12, 6032, 11, 49174, 2269, 11, 51671], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 218, "seek": 61954, "start": 645.92, "end": 649.04, "text": " a gap in time carries no default structural meaning.", "tokens": [51684, 257, 7417, 294, 565, 16402, 572, 7576, 15067, 3620, 13, 51840], "temperature": 0.0, "avg_logprob": -0.1533016399213463, "compression_ratio": 1.6163522012578617, "no_speech_prob": 2.117398704287732e-12}, {"id": 219, "seek": 64904, "start": 649.54, "end": 649.62, "text": " Right.", "tokens": [50390, 1779, 13, 50394], "temperature": 0.0, "avg_logprob": -0.18944272838655066, "compression_ratio": 1.6180555555555556, "no_speech_prob": 1.8795919681791062e-12}, {"id": 220, "seek": 64904, "start": 649.7199999999999, "end": 652.42, "text": " If I email you a question and you take three days to reply,", "tokens": [50399, 759, 286, 3796, 291, 257, 1168, 293, 291, 747, 1045, 1708, 281, 16972, 11, 50534], "temperature": 0.0, "avg_logprob": -0.18944272838655066, "compression_ratio": 1.6180555555555556, "no_speech_prob": 1.8795919681791062e-12}, {"id": 221, "seek": 64904, "start": 652.86, "end": 655.62, "text": " the channel itself does not observe or report your suspension.", "tokens": [50556, 264, 2269, 2564, 775, 406, 11441, 420, 2275, 428, 15771, 13, 50694], "temperature": 0.0, "avg_logprob": -0.18944272838655066, "compression_ratio": 1.6180555555555556, "no_speech_prob": 1.8795919681791062e-12}, {"id": 222, "seek": 64904, "start": 656.1999999999999, "end": 659.12, "text": " I have no idea if you were sleeping, traveling on a plane,", "tokens": [50723, 286, 362, 572, 1558, 498, 291, 645, 8296, 11, 9712, 322, 257, 5720, 11, 50869], "temperature": 0.0, "avg_logprob": -0.18944272838655066, "compression_ratio": 1.6180555555555556, "no_speech_prob": 1.8795919681791062e-12}, {"id": 223, "seek": 64904, "start": 659.64, "end": 661.86, "text": " carefully researching a brilliant response,", "tokens": [50895, 7500, 24176, 257, 10248, 4134, 11, 51006], "temperature": 0.0, "avg_logprob": -0.18944272838655066, "compression_ratio": 1.6180555555555556, "no_speech_prob": 1.8795919681791062e-12}, {"id": 224, "seek": 64904, "start": 662.12, "end": 664.1999999999999, "text": " or just staring blankly at a wall.", "tokens": [51019, 420, 445, 18043, 8247, 356, 412, 257, 2929, 13, 51123], "temperature": 0.0, "avg_logprob": -0.18944272838655066, "compression_ratio": 1.6180555555555556, "no_speech_prob": 1.8795919681791062e-12}, {"id": 225, "seek": 64904, "start": 664.38, "end": 666.0999999999999, "text": " The channel provides cover for my biology.", "tokens": [51132, 440, 2269, 6417, 2060, 337, 452, 14956, 13, 51218], "temperature": 0.0, "avg_logprob": -0.18944272838655066, "compression_ratio": 1.6180555555555556, "no_speech_prob": 1.8795919681791062e-12}, {"id": 226, "seek": 64904, "start": 666.3399999999999, "end": 667.1999999999999, "text": " It hides my downtime.", "tokens": [51230, 467, 35953, 452, 49648, 13, 51273], "temperature": 0.0, "avg_logprob": -0.18944272838655066, "compression_ratio": 1.6180555555555556, "no_speech_prob": 1.8795919681791062e-12}, {"id": 227, "seek": 64904, "start": 667.48, "end": 671.04, "text": " Which brings us to theorem 3.4, silence signaling,", "tokens": [51287, 3013, 5607, 505, 281, 20904, 805, 13, 19, 11, 12239, 38639, 11, 51465], "temperature": 0.0, "avg_logprob": -0.18944272838655066, "compression_ratio": 1.6180555555555556, "no_speech_prob": 1.8795919681791062e-12}, {"id": 228, "seek": 64904, "start": 671.42, "end": 674.48, "text": " and what Fliction calls the performative burden of synchrony.", "tokens": [51484, 293, 437, 3235, 4105, 5498, 264, 2042, 1166, 12578, 295, 19331, 88, 13, 51637], "temperature": 0.0, "avg_logprob": -0.18944272838655066, "compression_ratio": 1.6180555555555556, "no_speech_prob": 1.8795919681791062e-12}, {"id": 229, "seek": 64904, "start": 674.56, "end": 675.36, "text": " Performative burden.", "tokens": [51641, 19351, 1166, 12578, 13, 51681], "temperature": 0.0, "avg_logprob": -0.18944272838655066, "compression_ratio": 1.6180555555555556, "no_speech_prob": 1.8795919681791062e-12}, {"id": 230, "seek": 67536, "start": 675.36, "end": 675.92, "text": " Yeah.", "tokens": [50365, 865, 13, 50393], "temperature": 0.0, "avg_logprob": -0.18252735450619556, "compression_ratio": 1.65, "no_speech_prob": 1.5251311498432063e-12}, {"id": 231, "seek": 67536, "start": 676.26, "end": 680.32, "text": " On a suspension, observable channel, like a phone call or an in-person meeting,", "tokens": [50410, 1282, 257, 15771, 11, 9951, 712, 2269, 11, 411, 257, 2593, 818, 420, 364, 294, 12, 10813, 3440, 11, 50613], "temperature": 0.0, "avg_logprob": -0.18252735450619556, "compression_ratio": 1.65, "no_speech_prob": 1.5251311498432063e-12}, {"id": 232, "seek": 67536, "start": 680.66, "end": 686.38, "text": " every single internal cognitive operation that takes time is broadcast live to the listener.", "tokens": [50630, 633, 2167, 6920, 15605, 6916, 300, 2516, 565, 307, 9975, 1621, 281, 264, 31569, 13, 50916], "temperature": 0.0, "avg_logprob": -0.18252735450619556, "compression_ratio": 1.65, "no_speech_prob": 1.5251311498432063e-12}, {"id": 233, "seek": 67536, "start": 686.58, "end": 686.72, "text": " Okay.", "tokens": [50926, 1033, 13, 50933], "temperature": 0.0, "avg_logprob": -0.18252735450619556, "compression_ratio": 1.65, "no_speech_prob": 1.5251311498432063e-12}, {"id": 234, "seek": 67536, "start": 686.86, "end": 689.82, "text": " Mechanically, what do you mean by an internal cognitive operation?", "tokens": [50940, 30175, 984, 11, 437, 360, 291, 914, 538, 364, 6920, 15605, 6916, 30, 51088], "temperature": 0.0, "avg_logprob": -0.18252735450619556, "compression_ratio": 1.65, "no_speech_prob": 1.5251311498432063e-12}, {"id": 235, "seek": 67536, "start": 690.04, "end": 691.5600000000001, "text": " Like trying to remember a word?", "tokens": [51099, 1743, 1382, 281, 1604, 257, 1349, 30, 51175], "temperature": 0.0, "avg_logprob": -0.18252735450619556, "compression_ratio": 1.65, "no_speech_prob": 1.5251311498432063e-12}, {"id": 236, "seek": 67536, "start": 691.74, "end": 692.14, "text": " Exactly.", "tokens": [51184, 7587, 13, 51204], "temperature": 0.0, "avg_logprob": -0.18252735450619556, "compression_ratio": 1.65, "no_speech_prob": 1.5251311498432063e-12}, {"id": 237, "seek": 67536, "start": 692.88, "end": 695.44, "text": " Searching your memory for a specific statistic,", "tokens": [51241, 17180, 278, 428, 4675, 337, 257, 2685, 29588, 11, 51369], "temperature": 0.0, "avg_logprob": -0.18252735450619556, "compression_ratio": 1.65, "no_speech_prob": 1.5251311498432063e-12}, {"id": 238, "seek": 67536, "start": 696.04, "end": 699.04, "text": " weighing the social delicacy of phrasing something a certain way,", "tokens": [51399, 31986, 264, 2093, 29831, 2551, 295, 7636, 3349, 746, 257, 1629, 636, 11, 51549], "temperature": 0.0, "avg_logprob": -0.18252735450619556, "compression_ratio": 1.65, "no_speech_prob": 1.5251311498432063e-12}, {"id": 239, "seek": 67536, "start": 699.16, "end": 702.12, "text": " or completely changing your mind halfway through a sentence.", "tokens": [51555, 420, 2584, 4473, 428, 1575, 15461, 807, 257, 8174, 13, 51703], "temperature": 0.0, "avg_logprob": -0.18252735450619556, "compression_ratio": 1.65, "no_speech_prob": 1.5251311498432063e-12}, {"id": 240, "seek": 67536, "start": 702.28, "end": 703.58, "text": " Stuff we all do constantly.", "tokens": [51711, 31347, 321, 439, 360, 6460, 13, 51776], "temperature": 0.0, "avg_logprob": -0.18252735450619556, "compression_ratio": 1.65, "no_speech_prob": 1.5251311498432063e-12}, {"id": 241, "seek": 70358, "start": 703.58, "end": 706.5600000000001, "text": " Right. These are complex biological computations.", "tokens": [50365, 1779, 13, 1981, 366, 3997, 13910, 2807, 763, 13, 50514], "temperature": 0.0, "avg_logprob": -0.15315864767347062, "compression_ratio": 1.65, "no_speech_prob": 2.163395330934126e-12}, {"id": 242, "seek": 70358, "start": 706.76, "end": 709.2800000000001, "text": " They physically take time for your neurons to process,", "tokens": [50524, 814, 9762, 747, 565, 337, 428, 22027, 281, 1399, 11, 50650], "temperature": 0.0, "avg_logprob": -0.15315864767347062, "compression_ratio": 1.65, "no_speech_prob": 2.163395330934126e-12}, {"id": 243, "seek": 70358, "start": 709.6800000000001, "end": 712.62, "text": " but because the channel cannot hide time,", "tokens": [50670, 457, 570, 264, 2269, 2644, 6479, 565, 11, 50817], "temperature": 0.0, "avg_logprob": -0.15315864767347062, "compression_ratio": 1.65, "no_speech_prob": 2.163395330934126e-12}, {"id": 244, "seek": 70358, "start": 712.96, "end": 716.7, "text": " that biological processing time is projected onto the channel as a pause,", "tokens": [50834, 300, 13910, 9007, 565, 307, 26231, 3911, 264, 2269, 382, 257, 10465, 11, 51021], "temperature": 0.0, "avg_logprob": -0.15315864767347062, "compression_ratio": 1.65, "no_speech_prob": 2.163395330934126e-12}, {"id": 245, "seek": 70358, "start": 716.82, "end": 719.74, "text": " a stutter, or a filler word, like um, or...", "tokens": [51027, 257, 342, 9947, 11, 420, 257, 34676, 1349, 11, 411, 1105, 11, 420, 485, 51173], "temperature": 0.0, "avg_logprob": -0.15315864767347062, "compression_ratio": 1.65, "no_speech_prob": 2.163395330934126e-12}, {"id": 246, "seek": 70358, "start": 719.74, "end": 721.1, "text": " So if we use a computer metaphor,", "tokens": [51173, 407, 498, 321, 764, 257, 3820, 19157, 11, 51241], "temperature": 0.0, "avg_logprob": -0.15315864767347062, "compression_ratio": 1.65, "no_speech_prob": 2.163395330934126e-12}, {"id": 247, "seek": 70358, "start": 721.38, "end": 724.9000000000001, "text": " if you have a slow internet connection and try to stream a 4K video,", "tokens": [51255, 498, 291, 362, 257, 2964, 4705, 4984, 293, 853, 281, 4309, 257, 1017, 42, 960, 11, 51431], "temperature": 0.0, "avg_logprob": -0.15315864767347062, "compression_ratio": 1.65, "no_speech_prob": 2.163395330934126e-12}, {"id": 248, "seek": 70358, "start": 725.0200000000001, "end": 727.0200000000001, "text": " the video stops and you get a spinning buffering wheel.", "tokens": [51437, 264, 960, 10094, 293, 291, 483, 257, 15640, 9204, 1794, 5589, 13, 51537], "temperature": 0.0, "avg_logprob": -0.15315864767347062, "compression_ratio": 1.65, "no_speech_prob": 2.163395330934126e-12}, {"id": 249, "seek": 70358, "start": 727.12, "end": 727.32, "text": " Yeah.", "tokens": [51542, 865, 13, 51552], "temperature": 0.0, "avg_logprob": -0.15315864767347062, "compression_ratio": 1.65, "no_speech_prob": 2.163395330934126e-12}, {"id": 250, "seek": 72732, "start": 727.32, "end": 733.5400000000001, "text": " On a live phone call, my ums and my awkward silences are essentially a biological buffering icon", "tokens": [50365, 1282, 257, 1621, 2593, 818, 11, 452, 1105, 82, 293, 452, 11411, 3425, 2667, 366, 4476, 257, 13910, 9204, 1794, 6528, 50676], "temperature": 0.0, "avg_logprob": -0.18349495388212658, "compression_ratio": 1.6144067796610169, "no_speech_prob": 1.7691686874168888e-12}, {"id": 251, "seek": 72732, "start": 733.5400000000001, "end": 736.6, "text": " that the channel forces me to display to the other person.", "tokens": [50676, 300, 264, 2269, 5874, 385, 281, 4674, 281, 264, 661, 954, 13, 50829], "temperature": 0.0, "avg_logprob": -0.18349495388212658, "compression_ratio": 1.6144067796610169, "no_speech_prob": 1.7691686874168888e-12}, {"id": 252, "seek": 72732, "start": 737.0600000000001, "end": 741.32, "text": " That is a phenomenal analogy, and it perfectly captures the anxiety of the medium.", "tokens": [50852, 663, 307, 257, 17778, 21663, 11, 293, 309, 6239, 27986, 264, 9119, 295, 264, 6399, 13, 51065], "temperature": 0.0, "avg_logprob": -0.18349495388212658, "compression_ratio": 1.6144067796610169, "no_speech_prob": 1.7691686874168888e-12}, {"id": 253, "seek": 72732, "start": 741.88, "end": 746.58, "text": " The channel converts your internal private cognition into a public performance.", "tokens": [51093, 440, 2269, 38874, 428, 6920, 4551, 46905, 666, 257, 1908, 3389, 13, 51328], "temperature": 0.0, "avg_logprob": -0.18349495388212658, "compression_ratio": 1.6144067796610169, "no_speech_prob": 1.7691686874168888e-12}, {"id": 254, "seek": 72732, "start": 747.1, "end": 750.6400000000001, "text": " And how does listener usually interpret that buffering icon...", "tokens": [51354, 400, 577, 775, 31569, 2673, 7302, 300, 9204, 1794, 6528, 485, 51531], "temperature": 0.0, "avg_logprob": -0.18349495388212658, "compression_ratio": 1.6144067796610169, "no_speech_prob": 1.7691686874168888e-12}, {"id": 255, "seek": 75064, "start": 750.64, "end": 753.54, "text": " As evasion or incompetence.", "tokens": [50365, 1018, 1073, 6822, 420, 41602, 655, 13, 50510], "temperature": 0.0, "avg_logprob": -0.22534677094104244, "compression_ratio": 1.5344827586206897, "no_speech_prob": 1.839355490834693e-12}, {"id": 256, "seek": 75064, "start": 753.62, "end": 753.98, "text": " Exactly.", "tokens": [50514, 7587, 13, 50532], "temperature": 0.0, "avg_logprob": -0.22534677094104244, "compression_ratio": 1.5344827586206897, "no_speech_prob": 1.839355490834693e-12}, {"id": 257, "seek": 75064, "start": 754.36, "end": 757.06, "text": " If I pause for five seconds before answering a question in a meeting,", "tokens": [50551, 759, 286, 10465, 337, 1732, 3949, 949, 13430, 257, 1168, 294, 257, 3440, 11, 50686], "temperature": 0.0, "avg_logprob": -0.22534677094104244, "compression_ratio": 1.5344827586206897, "no_speech_prob": 1.839355490834693e-12}, {"id": 258, "seek": 75064, "start": 757.52, "end": 760.02, "text": " people don't assume I'm doing deep, brilliant computation.", "tokens": [50709, 561, 500, 380, 6552, 286, 478, 884, 2452, 11, 10248, 24903, 13, 50834], "temperature": 0.0, "avg_logprob": -0.22534677094104244, "compression_ratio": 1.5344827586206897, "no_speech_prob": 1.839355490834693e-12}, {"id": 259, "seek": 75064, "start": 760.5, "end": 763.06, "text": " They assume I don't know the answer or I'm making up a lie.", "tokens": [50858, 814, 6552, 286, 500, 380, 458, 264, 1867, 420, 286, 478, 1455, 493, 257, 4544, 13, 50986], "temperature": 0.0, "avg_logprob": -0.22534677094104244, "compression_ratio": 1.5344827586206897, "no_speech_prob": 1.839355490834693e-12}, {"id": 260, "seek": 75064, "start": 763.1999999999999, "end": 763.66, "text": " Exactly.", "tokens": [50993, 7587, 13, 51016], "temperature": 0.0, "avg_logprob": -0.22534677094104244, "compression_ratio": 1.5344827586206897, "no_speech_prob": 1.839355490834693e-12}, {"id": 261, "seek": 75064, "start": 764.3, "end": 769.98, "text": " And Flixchan highlights a very specific, agonizing technological artifact that proves this,", "tokens": [51048, 400, 3235, 970, 3484, 14254, 257, 588, 2685, 11, 623, 266, 3319, 18439, 34806, 300, 25019, 341, 11, 51332], "temperature": 0.0, "avg_logprob": -0.22534677094104244, "compression_ratio": 1.5344827586206897, "no_speech_prob": 1.839355490834693e-12}, {"id": 262, "seek": 75064, "start": 770.34, "end": 771.08, "text": " the voicemail.", "tokens": [51350, 264, 1650, 46343, 864, 13, 51387], "temperature": 0.0, "avg_logprob": -0.22534677094104244, "compression_ratio": 1.5344827586206897, "no_speech_prob": 1.839355490834693e-12}, {"id": 263, "seek": 75064, "start": 771.16, "end": 771.78, "text": " Oh, voicemail.", "tokens": [51391, 876, 11, 1650, 46343, 864, 13, 51422], "temperature": 0.0, "avg_logprob": -0.22534677094104244, "compression_ratio": 1.5344827586206897, "no_speech_prob": 1.839355490834693e-12}, {"id": 264, "seek": 77178, "start": 771.78, "end": 775.1999999999999, "text": " Remark 3.6 calls voicemail a mixed cell.", "tokens": [50365, 4080, 809, 805, 13, 21, 5498, 1650, 46343, 864, 257, 7467, 2815, 13, 50536], "temperature": 0.0, "avg_logprob": -0.14697541296482086, "compression_ratio": 1.7137931034482758, "no_speech_prob": 1.7283398020054297e-12}, {"id": 265, "seek": 77178, "start": 775.76, "end": 779.5799999999999, "text": " Because it's asynchronous for the person listening, but live for the person speaking.", "tokens": [50564, 1436, 309, 311, 49174, 337, 264, 954, 4764, 11, 457, 1621, 337, 264, 954, 4124, 13, 50755], "temperature": 0.0, "avg_logprob": -0.14697541296482086, "compression_ratio": 1.7137931034482758, "no_speech_prob": 1.7283398020054297e-12}, {"id": 266, "seek": 77178, "start": 779.8, "end": 780.28, "text": " Precisely.", "tokens": [50766, 48746, 736, 13, 50790], "temperature": 0.0, "avg_logprob": -0.14697541296482086, "compression_ratio": 1.7137931034482758, "no_speech_prob": 1.7283398020054297e-12}, {"id": 267, "seek": 77178, "start": 780.54, "end": 783.54, "text": " The person receiving the voicemail can listen to it whenever they want.", "tokens": [50803, 440, 954, 10040, 264, 1650, 46343, 864, 393, 2140, 281, 309, 5699, 436, 528, 13, 50953], "temperature": 0.0, "avg_logprob": -0.14697541296482086, "compression_ratio": 1.7137931034482758, "no_speech_prob": 1.7283398020054297e-12}, {"id": 268, "seek": 77178, "start": 783.6999999999999, "end": 784.76, "text": " Their clock is decoupled.", "tokens": [50961, 6710, 7830, 307, 979, 263, 15551, 13, 51014], "temperature": 0.0, "avg_logprob": -0.14697541296482086, "compression_ratio": 1.7137931034482758, "no_speech_prob": 1.7283398020054297e-12}, {"id": 269, "seek": 77178, "start": 785.14, "end": 789.3399999999999, "text": " But for the person leaving the message, the channel is completely suspension observable.", "tokens": [51033, 583, 337, 264, 954, 5012, 264, 3636, 11, 264, 2269, 307, 2584, 15771, 9951, 712, 13, 51243], "temperature": 0.0, "avg_logprob": -0.14697541296482086, "compression_ratio": 1.7137931034482758, "no_speech_prob": 1.7283398020054297e-12}, {"id": 270, "seek": 77178, "start": 789.52, "end": 790.78, "text": " Oh man, that is so true.", "tokens": [51252, 876, 587, 11, 300, 307, 370, 2074, 13, 51315], "temperature": 0.0, "avg_logprob": -0.14697541296482086, "compression_ratio": 1.7137931034482758, "no_speech_prob": 1.7283398020054297e-12}, {"id": 271, "seek": 77178, "start": 791.02, "end": 795.86, "text": " Your buffering icons, your hesitations, your long pauses while you try to remember a phone number,", "tokens": [51327, 2260, 9204, 1794, 23308, 11, 428, 28336, 763, 11, 428, 938, 2502, 8355, 1339, 291, 853, 281, 1604, 257, 2593, 1230, 11, 51569], "temperature": 0.0, "avg_logprob": -0.14697541296482086, "compression_ratio": 1.7137931034482758, "no_speech_prob": 1.7283398020054297e-12}, {"id": 272, "seek": 77178, "start": 796.0, "end": 798.02, "text": " they are permanently recorded into the artifact.", "tokens": [51576, 436, 366, 24042, 8287, 666, 264, 34806, 13, 51677], "temperature": 0.0, "avg_logprob": -0.14697541296482086, "compression_ratio": 1.7137931034482758, "no_speech_prob": 1.7283398020054297e-12}, {"id": 273, "seek": 79802, "start": 798.02, "end": 802.98, "text": " This explains why leaving a voicemail is one of the most uniquely excruciating experiences", "tokens": [50365, 639, 13948, 983, 5012, 257, 1650, 46343, 864, 307, 472, 295, 264, 881, 31474, 1624, 894, 537, 990, 5235, 50613], "temperature": 0.0, "avg_logprob": -0.10956837096304264, "compression_ratio": 1.5602836879432624, "no_speech_prob": 1.4956259971818375e-12}, {"id": 274, "seek": 79802, "start": 802.98, "end": 803.86, "text": " in modern life.", "tokens": [50613, 294, 4363, 993, 13, 50657], "temperature": 0.0, "avg_logprob": -0.10956837096304264, "compression_ratio": 1.5602836879432624, "no_speech_prob": 1.4956259971818375e-12}, {"id": 275, "seek": 79802, "start": 804.36, "end": 808.4399999999999, "text": " Like, I can type a perfectly articulate text message in 20 seconds.", "tokens": [50682, 1743, 11, 286, 393, 2010, 257, 6239, 30305, 2487, 3636, 294, 945, 3949, 13, 50886], "temperature": 0.0, "avg_logprob": -0.10956837096304264, "compression_ratio": 1.5602836879432624, "no_speech_prob": 1.4956259971818375e-12}, {"id": 276, "seek": 79802, "start": 809.14, "end": 814.18, "text": " But if I have to leave a voicemail, I sound like an idiot because I am trapped in a performative", "tokens": [50921, 583, 498, 286, 362, 281, 1856, 257, 1650, 46343, 864, 11, 286, 1626, 411, 364, 14270, 570, 286, 669, 14994, 294, 257, 2042, 1166, 51173], "temperature": 0.0, "avg_logprob": -0.10956837096304264, "compression_ratio": 1.5602836879432624, "no_speech_prob": 1.4956259971818375e-12}, {"id": 277, "seek": 79802, "start": 814.18, "end": 817.62, "text": " medium that carves my biological buffering into stone.", "tokens": [51173, 6399, 300, 1032, 977, 452, 13910, 9204, 1794, 666, 7581, 13, 51345], "temperature": 0.0, "avg_logprob": -0.10956837096304264, "compression_ratio": 1.5602836879432624, "no_speech_prob": 1.4956259971818375e-12}, {"id": 278, "seek": 79802, "start": 817.98, "end": 822.22, "text": " You are handing the listener a permanent record of your instantaneous cognitive friction.", "tokens": [51363, 509, 366, 34774, 264, 31569, 257, 10996, 2136, 295, 428, 45596, 15605, 17710, 13, 51575], "temperature": 0.0, "avg_logprob": -0.10956837096304264, "compression_ratio": 1.5602836879432624, "no_speech_prob": 1.4956259971818375e-12}, {"id": 279, "seek": 79802, "start": 822.4, "end": 823.3199999999999, "text": " That sounds terrifying.", "tokens": [51584, 663, 3263, 18106, 13, 51630], "temperature": 0.0, "avg_logprob": -0.10956837096304264, "compression_ratio": 1.5602836879432624, "no_speech_prob": 1.4956259971818375e-12}, {"id": 280, "seek": 82332, "start": 823.32, "end": 828.7, "text": " It does, which raises a massive societal question that Fliction tackles head on.", "tokens": [50365, 467, 775, 11, 597, 19658, 257, 5994, 33472, 1168, 300, 3235, 4105, 9426, 904, 1378, 322, 13, 50634], "temperature": 0.0, "avg_logprob": -0.13569385314656196, "compression_ratio": 1.6632996632996633, "no_speech_prob": 1.5984563932897045e-12}, {"id": 281, "seek": 82332, "start": 828.88, "end": 834.1, "text": " If synchronous live speech forces our cognition into this highly degraded public performance,", "tokens": [50643, 759, 44743, 1621, 6218, 5874, 527, 46905, 666, 341, 5405, 24740, 292, 1908, 3389, 11, 50904], "temperature": 0.0, "avg_logprob": -0.13569385314656196, "compression_ratio": 1.6632996632996633, "no_speech_prob": 1.5984563932897045e-12}, {"id": 282, "seek": 82332, "start": 834.74, "end": 839.0200000000001, "text": " why do we use it as the ultimate metric for measuring human intelligence and accountability?", "tokens": [50936, 983, 360, 321, 764, 309, 382, 264, 9705, 20678, 337, 13389, 1952, 7599, 293, 19380, 30, 51150], "temperature": 0.0, "avg_logprob": -0.13569385314656196, "compression_ratio": 1.6632996632996633, "no_speech_prob": 1.5984563932897045e-12}, {"id": 283, "seek": 82332, "start": 839.58, "end": 843.5600000000001, "text": " I am so glad we are going here because this felt like the most radical part of the treatise.", "tokens": [51178, 286, 669, 370, 5404, 321, 366, 516, 510, 570, 341, 2762, 411, 264, 881, 12001, 644, 295, 264, 2387, 908, 13, 51377], "temperature": 0.0, "avg_logprob": -0.13569385314656196, "compression_ratio": 1.6632996632996633, "no_speech_prob": 1.5984563932897045e-12}, {"id": 284, "seek": 82332, "start": 844.36, "end": 849.34, "text": " Fliction takes this physical reality of the acoustic channel and uses it to systematically", "tokens": [51417, 3235, 4105, 2516, 341, 4001, 4103, 295, 264, 26753, 2269, 293, 4960, 309, 281, 39531, 51666], "temperature": 0.0, "avg_logprob": -0.13569385314656196, "compression_ratio": 1.6632996632996633, "no_speech_prob": 1.5984563932897045e-12}, {"id": 285, "seek": 82332, "start": 849.34, "end": 851.8000000000001, "text": " dismantle how our society evaluates merit.", "tokens": [51666, 30506, 306, 577, 527, 4086, 6133, 1024, 24527, 13, 51789], "temperature": 0.0, "avg_logprob": -0.13569385314656196, "compression_ratio": 1.6632996632996633, "no_speech_prob": 1.5984563932897045e-12}, {"id": 286, "seek": 85180, "start": 851.8, "end": 855.9399999999999, "text": " This is Chapter 12, The Profile Society and the Tragedy of the No Repair Channel.", "tokens": [50365, 639, 307, 18874, 2272, 11, 440, 6039, 794, 13742, 293, 264, 5403, 3004, 88, 295, 264, 883, 3696, 1246, 13553, 13, 50572], "temperature": 0.0, "avg_logprob": -0.12817449347917423, "compression_ratio": 1.652027027027027, "no_speech_prob": 1.7762644653751547e-12}, {"id": 287, "seek": 85180, "start": 856.3, "end": 861.26, "text": " To understand this tragedy, we have to look at Fliction's Definition 6.1, which is the", "tokens": [50590, 1407, 1223, 341, 18563, 11, 321, 362, 281, 574, 412, 3235, 4105, 311, 46245, 849, 1386, 13, 16, 11, 597, 307, 264, 50838], "temperature": 0.0, "avg_logprob": -0.12817449347917423, "compression_ratio": 1.652027027027027, "no_speech_prob": 1.7762644653751547e-12}, {"id": 288, "seek": 85180, "start": 861.26, "end": 862.0799999999999, "text": " repair interval.", "tokens": [50838, 10535, 15035, 13, 50879], "temperature": 0.0, "avg_logprob": -0.12817449347917423, "compression_ratio": 1.652027027027027, "no_speech_prob": 1.7762644653751547e-12}, {"id": 289, "seek": 85180, "start": 862.2199999999999, "end": 862.9, "text": " The repair interval.", "tokens": [50886, 440, 10535, 15035, 13, 50920], "temperature": 0.0, "avg_logprob": -0.12817449347917423, "compression_ratio": 1.652027027027027, "no_speech_prob": 1.7762644653751547e-12}, {"id": 290, "seek": 85180, "start": 863.02, "end": 864.74, "text": " This is the concept of the buffer draft, right?", "tokens": [50926, 639, 307, 264, 3410, 295, 264, 21762, 11206, 11, 558, 30, 51012], "temperature": 0.0, "avg_logprob": -0.12817449347917423, "compression_ratio": 1.652027027027027, "no_speech_prob": 1.7762644653751547e-12}, {"id": 291, "seek": 85180, "start": 865.12, "end": 865.42, "text": " Yes.", "tokens": [51031, 1079, 13, 51046], "temperature": 0.0, "avg_logprob": -0.12817449347917423, "compression_ratio": 1.652027027027027, "no_speech_prob": 1.7762644653751547e-12}, {"id": 292, "seek": 85180, "start": 865.9, "end": 870.3199999999999, "text": " Writing because it's a symbol sampling, asynchronous channel provides a buffer draft.", "tokens": [51070, 32774, 570, 309, 311, 257, 5986, 21179, 11, 49174, 2269, 6417, 257, 21762, 11206, 13, 51291], "temperature": 0.0, "avg_logprob": -0.12817449347917423, "compression_ratio": 1.652027027027027, "no_speech_prob": 1.7762644653751547e-12}, {"id": 293, "seek": 85180, "start": 870.74, "end": 875.8199999999999, "text": " It introduces a temporal gap between when you commit a symbol and when that symbol is", "tokens": [51312, 467, 31472, 257, 30881, 7417, 1296, 562, 291, 5599, 257, 5986, 293, 562, 300, 5986, 307, 51566], "temperature": 0.0, "avg_logprob": -0.12817449347917423, "compression_ratio": 1.652027027027027, "no_speech_prob": 1.7762644653751547e-12}, {"id": 294, "seek": 85180, "start": 875.8199999999999, "end": 876.9, "text": " released to the consumer.", "tokens": [51566, 4736, 281, 264, 9711, 13, 51620], "temperature": 0.0, "avg_logprob": -0.12817449347917423, "compression_ratio": 1.652027027027027, "no_speech_prob": 1.7762644653751547e-12}, {"id": 295, "seek": 85180, "start": 877.0799999999999, "end": 878.4, "text": " A gap where you can fix things.", "tokens": [51629, 316, 7417, 689, 291, 393, 3191, 721, 13, 51695], "temperature": 0.0, "avg_logprob": -0.12817449347917423, "compression_ratio": 1.652027027027027, "no_speech_prob": 1.7762644653751547e-12}, {"id": 296, "seek": 87840, "start": 878.4, "end": 879.0, "text": " Exactly.", "tokens": [50365, 7587, 13, 50395], "temperature": 0.0, "avg_logprob": -0.1402886318710615, "compression_ratio": 1.5451127819548873, "no_speech_prob": 1.4381200223734236e-12}, {"id": 297, "seek": 87840, "start": 879.68, "end": 886.3199999999999, "text": " In that gap, you have absolutely unbounded opportunities to edit, delete, rearrange, and polish.", "tokens": [50429, 682, 300, 7417, 11, 291, 362, 3122, 517, 18767, 292, 4786, 281, 8129, 11, 12097, 11, 39568, 11, 293, 20452, 13, 50761], "temperature": 0.0, "avg_logprob": -0.1402886318710615, "compression_ratio": 1.5451127819548873, "no_speech_prob": 1.4381200223734236e-12}, {"id": 298, "seek": 87840, "start": 886.6999999999999, "end": 891.64, "text": " I can type a furious, terrible response to an email, pace around my kitchen for 10 minutes,", "tokens": [50780, 286, 393, 2010, 257, 33470, 11, 6237, 4134, 281, 364, 3796, 11, 11638, 926, 452, 6525, 337, 1266, 2077, 11, 51027], "temperature": 0.0, "avg_logprob": -0.1402886318710615, "compression_ratio": 1.5451127819548873, "no_speech_prob": 1.4381200223734236e-12}, {"id": 299, "seek": 87840, "start": 891.9599999999999, "end": 895.9599999999999, "text": " delete the whole thing, write a calm, diplomatic response, and hit send.", "tokens": [51043, 12097, 264, 1379, 551, 11, 2464, 257, 7151, 11, 26553, 4134, 11, 293, 2045, 2845, 13, 51243], "temperature": 0.0, "avg_logprob": -0.1402886318710615, "compression_ratio": 1.5451127819548873, "no_speech_prob": 1.4381200223734236e-12}, {"id": 300, "seek": 87840, "start": 896.3, "end": 897.26, "text": " And no one ever knows.", "tokens": [51260, 400, 572, 472, 1562, 3255, 13, 51308], "temperature": 0.0, "avg_logprob": -0.1402886318710615, "compression_ratio": 1.5451127819548873, "no_speech_prob": 1.4381200223734236e-12}, {"id": 301, "seek": 87840, "start": 897.4399999999999, "end": 897.64, "text": " Right.", "tokens": [51317, 1779, 13, 51327], "temperature": 0.0, "avg_logprob": -0.1402886318710615, "compression_ratio": 1.5451127819548873, "no_speech_prob": 1.4381200223734236e-12}, {"id": 302, "seek": 87840, "start": 897.72, "end": 900.22, "text": " The recipient only ever sees the final polished output.", "tokens": [51331, 440, 26216, 787, 1562, 8194, 264, 2572, 29079, 5598, 13, 51456], "temperature": 0.0, "avg_logprob": -0.1402886318710615, "compression_ratio": 1.5451127819548873, "no_speech_prob": 1.4381200223734236e-12}, {"id": 303, "seek": 87840, "start": 900.4399999999999, "end": 904.18, "text": " They're completely blind to my messy, emotional draft.", "tokens": [51467, 814, 434, 2584, 6865, 281, 452, 16191, 11, 6863, 11206, 13, 51654], "temperature": 0.0, "avg_logprob": -0.1402886318710615, "compression_ratio": 1.5451127819548873, "no_speech_prob": 1.4381200223734236e-12}, {"id": 304, "seek": 90418, "start": 904.18, "end": 907.64, "text": " But live speech is what Friction calls a no repair channel.", "tokens": [50365, 583, 1621, 6218, 307, 437, 1526, 4105, 5498, 257, 572, 10535, 2269, 13, 50538], "temperature": 0.0, "avg_logprob": -0.15181960756816562, "compression_ratio": 1.6550522648083623, "no_speech_prob": 1.7147272100490052e-12}, {"id": 305, "seek": 90418, "start": 908.0999999999999, "end": 910.92, "text": " In live speech, emission is simultaneous with release.", "tokens": [50561, 682, 1621, 6218, 11, 29513, 307, 46218, 365, 4374, 13, 50702], "temperature": 0.0, "avg_logprob": -0.15181960756816562, "compression_ratio": 1.6550522648083623, "no_speech_prob": 1.7147272100490052e-12}, {"id": 306, "seek": 90418, "start": 911.3199999999999, "end": 915.7199999999999, "text": " The very millisecond the sound wave leaves your vocal cords, it is captured by the listener.", "tokens": [50722, 440, 588, 27940, 18882, 264, 1626, 5772, 5510, 428, 11657, 36302, 11, 309, 307, 11828, 538, 264, 31569, 13, 50942], "temperature": 0.0, "avg_logprob": -0.15181960756816562, "compression_ratio": 1.6550522648083623, "no_speech_prob": 1.7147272100490052e-12}, {"id": 307, "seek": 90418, "start": 915.92, "end": 917.3599999999999, "text": " There's no backspace for your voice.", "tokens": [50952, 821, 311, 572, 646, 24824, 337, 428, 3177, 13, 51024], "temperature": 0.0, "avg_logprob": -0.15181960756816562, "compression_ratio": 1.6550522648083623, "no_speech_prob": 1.7147272100490052e-12}, {"id": 308, "seek": 90418, "start": 917.5, "end": 918.9799999999999, "text": " No, there is no repair interval.", "tokens": [51031, 883, 11, 456, 307, 572, 10535, 15035, 13, 51105], "temperature": 0.0, "avg_logprob": -0.15181960756816562, "compression_ratio": 1.6550522648083623, "no_speech_prob": 1.7147272100490052e-12}, {"id": 309, "seek": 90418, "start": 919.12, "end": 920.78, "text": " You cannot backspace a spoken word.", "tokens": [51112, 509, 2644, 646, 24824, 257, 10759, 1349, 13, 51195], "temperature": 0.0, "avg_logprob": -0.15181960756816562, "compression_ratio": 1.6550522648083623, "no_speech_prob": 1.7147272100490052e-12}, {"id": 310, "seek": 90418, "start": 921.0799999999999, "end": 922.2199999999999, "text": " You can apologize for it.", "tokens": [51210, 509, 393, 12328, 337, 309, 13, 51267], "temperature": 0.0, "avg_logprob": -0.15181960756816562, "compression_ratio": 1.6550522648083623, "no_speech_prob": 1.7147272100490052e-12}, {"id": 311, "seek": 90418, "start": 922.26, "end": 922.8599999999999, "text": " You can amend it.", "tokens": [51269, 509, 393, 11704, 309, 13, 51299], "temperature": 0.0, "avg_logprob": -0.15181960756816562, "compression_ratio": 1.6550522648083623, "no_speech_prob": 1.7147272100490052e-12}, {"id": 312, "seek": 90418, "start": 923.04, "end": 926.04, "text": " But the original sound wave has already been processed by the receiver.", "tokens": [51308, 583, 264, 3380, 1626, 5772, 575, 1217, 668, 18846, 538, 264, 20086, 13, 51458], "temperature": 0.0, "avg_logprob": -0.15181960756816562, "compression_ratio": 1.6550522648083623, "no_speech_prob": 1.7147272100490052e-12}, {"id": 313, "seek": 90418, "start": 926.4599999999999, "end": 930.0999999999999, "text": " Which leads to Feorem 6.3 quality decoupling.", "tokens": [51479, 3013, 6689, 281, 3697, 37956, 1386, 13, 18, 3125, 979, 263, 11970, 13, 51661], "temperature": 0.0, "avg_logprob": -0.15181960756816562, "compression_ratio": 1.6550522648083623, "no_speech_prob": 1.7147272100490052e-12}, {"id": 314, "seek": 93010, "start": 930.1, "end": 936.32, "text": " This is a mathematical proof about what these different channels actually measure about a human being, isn't it?", "tokens": [50365, 639, 307, 257, 18894, 8177, 466, 437, 613, 819, 9235, 767, 3481, 466, 257, 1952, 885, 11, 1943, 380, 309, 30, 50676], "temperature": 0.0, "avg_logprob": -0.1263489578709458, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.5614386953549664e-12}, {"id": 315, "seek": 93010, "start": 936.82, "end": 938.5, "text": " It is a devastating proof.", "tokens": [50701, 467, 307, 257, 21280, 8177, 13, 50785], "temperature": 0.0, "avg_logprob": -0.1263489578709458, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.5614386953549664e-12}, {"id": 316, "seek": 93010, "start": 939.32, "end": 946.24, "text": " Friction demonstrates that a written corpus and artifact produced on a repair channel measures the supremum of your competence.", "tokens": [50826, 1526, 4105, 31034, 300, 257, 3720, 1181, 31624, 293, 34806, 7126, 322, 257, 10535, 2269, 8000, 264, 23710, 449, 295, 428, 39965, 13, 51172], "temperature": 0.0, "avg_logprob": -0.1263489578709458, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.5614386953549664e-12}, {"id": 317, "seek": 93010, "start": 946.38, "end": 947.14, "text": " The supremum.", "tokens": [51179, 440, 23710, 449, 13, 51217], "temperature": 0.0, "avg_logprob": -0.1263489578709458, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.5614386953549664e-12}, {"id": 318, "seek": 93010, "start": 947.22, "end": 948.34, "text": " The absolute peak.", "tokens": [51221, 440, 8236, 10651, 13, 51277], "temperature": 0.0, "avg_logprob": -0.1263489578709458, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.5614386953549664e-12}, {"id": 319, "seek": 93010, "start": 948.86, "end": 956.98, "text": " Because you have a repair interval, you can continuously discard the worst versions of your thought and retain only the best over an extended period.", "tokens": [51303, 1436, 291, 362, 257, 10535, 15035, 11, 291, 393, 15684, 31597, 264, 5855, 9606, 295, 428, 1194, 293, 18340, 787, 264, 1151, 670, 364, 10913, 2896, 13, 51709], "temperature": 0.0, "avg_logprob": -0.1263489578709458, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.5614386953549664e-12}, {"id": 320, "seek": 95698, "start": 956.98, "end": 966.6800000000001, "text": " So if I spent a month writing a white paper, that final PDF represents the absolute smartest I managed to be on my very best day, at my sharpest hour, during that entire month.", "tokens": [50365, 407, 498, 286, 4418, 257, 1618, 3579, 257, 2418, 3035, 11, 300, 2572, 17752, 8855, 264, 8236, 41491, 286, 6453, 281, 312, 322, 452, 588, 1151, 786, 11, 412, 452, 8199, 377, 1773, 11, 1830, 300, 2302, 1618, 13, 50850], "temperature": 0.0, "avg_logprob": -0.08554767577116154, "compression_ratio": 1.6332288401253918, "no_speech_prob": 1.7215953055510491e-12}, {"id": 321, "seek": 95698, "start": 966.74, "end": 967.16, "text": " Exactly.", "tokens": [50853, 7587, 13, 50874], "temperature": 0.0, "avg_logprob": -0.08554767577116154, "compression_ratio": 1.6332288401253918, "no_speech_prob": 1.7215953055510491e-12}, {"id": 322, "seek": 95698, "start": 967.34, "end": 969.36, "text": " It measures your maximum potential capability.", "tokens": [50883, 467, 8000, 428, 6674, 3995, 13759, 13, 50984], "temperature": 0.0, "avg_logprob": -0.08554767577116154, "compression_ratio": 1.6332288401253918, "no_speech_prob": 1.7215953055510491e-12}, {"id": 323, "seek": 95698, "start": 969.84, "end": 975.4200000000001, "text": " But a live performance like a job interview, a debate, or a spontaneous presentation measures something entirely different.", "tokens": [51008, 583, 257, 1621, 3389, 411, 257, 1691, 4049, 11, 257, 7958, 11, 420, 257, 32744, 5860, 8000, 746, 7696, 819, 13, 51287], "temperature": 0.0, "avg_logprob": -0.08554767577116154, "compression_ratio": 1.6332288401253918, "no_speech_prob": 1.7215953055510491e-12}, {"id": 324, "seek": 95698, "start": 975.5, "end": 976.0600000000001, "text": " What does it measure?", "tokens": [51291, 708, 775, 309, 3481, 30, 51319], "temperature": 0.0, "avg_logprob": -0.08554767577116154, "compression_ratio": 1.6332288401253918, "no_speech_prob": 1.7215953055510491e-12}, {"id": 325, "seek": 95698, "start": 976.2, "end": 979.82, "text": " It measures a single, arbitrary sample of your instantaneous competence.", "tokens": [51326, 467, 8000, 257, 2167, 11, 23211, 6889, 295, 428, 45596, 39965, 13, 51507], "temperature": 0.0, "avg_logprob": -0.08554767577116154, "compression_ratio": 1.6332288401253918, "no_speech_prob": 1.7215953055510491e-12}, {"id": 326, "seek": 95698, "start": 980.34, "end": 984.26, "text": " It only measures how smart you were on a random Tuesday at 10.15 a.m.", "tokens": [51533, 467, 787, 8000, 577, 4069, 291, 645, 322, 257, 4974, 10017, 412, 1266, 13, 5211, 257, 13, 76, 13, 51729], "temperature": 0.0, "avg_logprob": -0.08554767577116154, "compression_ratio": 1.6332288401253918, "no_speech_prob": 1.7215953055510491e-12}, {"id": 327, "seek": 98426, "start": 984.26, "end": 991.66, "text": " And worse, as Fliction proves, that instantaneous competence is actively degraded by the cognitive load of managing the synchronous channel itself.", "tokens": [50365, 400, 5324, 11, 382, 3235, 4105, 25019, 11, 300, 45596, 39965, 307, 13022, 24740, 292, 538, 264, 15605, 3677, 295, 11642, 264, 44743, 2269, 2564, 13, 50735], "temperature": 0.0, "avg_logprob": -0.11974737816250201, "compression_ratio": 1.5714285714285714, "no_speech_prob": 1.4550715233402345e-12}, {"id": 328, "seek": 98426, "start": 991.92, "end": 994.8, "text": " Because my brain is burning massive amounts of RAM.", "tokens": [50748, 1436, 452, 3567, 307, 9488, 5994, 11663, 295, 14561, 13, 50892], "temperature": 0.0, "avg_logprob": -0.11974737816250201, "compression_ratio": 1.5714285714285714, "no_speech_prob": 1.4550715233402345e-12}, {"id": 329, "seek": 98426, "start": 995.26, "end": 1002.64, "text": " Just trying to maintain eye contact, manage my posture, suppress my biological buffering icons, and read the interviewer's body language.", "tokens": [50915, 1449, 1382, 281, 6909, 3313, 3385, 11, 3067, 452, 18502, 11, 26835, 452, 13910, 9204, 1794, 23308, 11, 293, 1401, 264, 4049, 260, 311, 1772, 2856, 13, 51284], "temperature": 0.0, "avg_logprob": -0.11974737816250201, "compression_ratio": 1.5714285714285714, "no_speech_prob": 1.4550715233402345e-12}, {"id": 330, "seek": 98426, "start": 1002.7, "end": 1002.9, "text": " Right.", "tokens": [51287, 1779, 13, 51297], "temperature": 0.0, "avg_logprob": -0.11974737816250201, "compression_ratio": 1.5714285714285714, "no_speech_prob": 1.4550715233402345e-12}, {"id": 331, "seek": 98426, "start": 1003.16, "end": 1008.02, "text": " I literally have less cognitive power available for the actual intellectual question they ask me.", "tokens": [51310, 286, 3736, 362, 1570, 15605, 1347, 2435, 337, 264, 3539, 12576, 1168, 436, 1029, 385, 13, 51553], "temperature": 0.0, "avg_logprob": -0.11974737816250201, "compression_ratio": 1.5714285714285714, "no_speech_prob": 1.4550715233402345e-12}, {"id": 332, "seek": 98426, "start": 1008.12, "end": 1008.62, "text": " Exactly.", "tokens": [51558, 7587, 13, 51583], "temperature": 0.0, "avg_logprob": -0.11974737816250201, "compression_ratio": 1.5714285714285714, "no_speech_prob": 1.4550715233402345e-12}, {"id": 333, "seek": 100862, "start": 1008.62, "end": 1012.78, "text": " So Fliction defines our modern world as a profile society.", "tokens": [50365, 407, 3235, 4105, 23122, 527, 4363, 1002, 382, 257, 7964, 4086, 13, 50573], "temperature": 0.0, "avg_logprob": -0.1457196245289812, "compression_ratio": 1.5888888888888888, "no_speech_prob": 1.839642370729533e-12}, {"id": 334, "seek": 100862, "start": 1013.48, "end": 1027.42, "text": " A profile society is an institutional structure that stubbornly routes its credentialing, its hiring, and its promotions almost exclusively through no-repair channels, interviews, pitches, oral exams, political soundbites.", "tokens": [50608, 316, 7964, 4086, 307, 364, 18391, 3877, 300, 24137, 356, 18242, 1080, 22034, 278, 11, 1080, 15335, 11, 293, 1080, 42127, 1920, 20638, 807, 572, 12, 19919, 1246, 9235, 11, 12318, 11, 43110, 11, 19338, 20514, 11, 3905, 1626, 65, 3324, 13, 51305], "temperature": 0.0, "avg_logprob": -0.1457196245289812, "compression_ratio": 1.5888888888888888, "no_speech_prob": 1.839642370729533e-12}, {"id": 335, "seek": 100862, "start": 1027.62, "end": 1031.8, "text": " We judge people based on how fluently they can stream information in real time in a room.", "tokens": [51315, 492, 6995, 561, 2361, 322, 577, 5029, 2276, 436, 393, 4309, 1589, 294, 957, 565, 294, 257, 1808, 13, 51524], "temperature": 0.0, "avg_logprob": -0.1457196245289812, "compression_ratio": 1.5888888888888888, "no_speech_prob": 1.839642370729533e-12}, {"id": 336, "seek": 100862, "start": 1032.16, "end": 1034.0, "text": " But let me play devil's advocate here for a second.", "tokens": [51542, 583, 718, 385, 862, 13297, 311, 14608, 510, 337, 257, 1150, 13, 51634], "temperature": 0.0, "avg_logprob": -0.1457196245289812, "compression_ratio": 1.5888888888888888, "no_speech_prob": 1.839642370729533e-12}, {"id": 337, "seek": 100862, "start": 1034.12, "end": 1034.3, "text": " Sure.", "tokens": [51640, 4894, 13, 51649], "temperature": 0.0, "avg_logprob": -0.1457196245289812, "compression_ratio": 1.5888888888888888, "no_speech_prob": 1.839642370729533e-12}, {"id": 338, "seek": 103430, "start": 1034.3, "end": 1037.06, "text": " Aren't there jobs where you need real-time streaming?", "tokens": [50365, 15464, 380, 456, 4782, 689, 291, 643, 957, 12, 3766, 11791, 30, 50503], "temperature": 0.0, "avg_logprob": -0.09369745461837105, "compression_ratio": 1.5772058823529411, "no_speech_prob": 1.7281922420897544e-12}, {"id": 339, "seek": 103430, "start": 1037.3799999999999, "end": 1048.36, "text": " Like if I'm hiring an emergency room doctor or a trial lawyer or a quarterback, I need to know they can process information and make brilliant decisions instantly under pressure with zero repair interval.", "tokens": [50519, 1743, 498, 286, 478, 15335, 364, 7473, 1808, 4631, 420, 257, 7308, 11613, 420, 257, 31952, 11, 286, 643, 281, 458, 436, 393, 1399, 1589, 293, 652, 10248, 5327, 13518, 833, 3321, 365, 4018, 10535, 15035, 13, 51068], "temperature": 0.0, "avg_logprob": -0.09369745461837105, "compression_ratio": 1.5772058823529411, "no_speech_prob": 1.7281922420897544e-12}, {"id": 340, "seek": 103430, "start": 1048.58, "end": 1050.46, "text": " Oh, Fliction absolutely concedes that.", "tokens": [51079, 876, 11, 3235, 4105, 3122, 416, 21526, 300, 13, 51173], "temperature": 0.0, "avg_logprob": -0.09369745461837105, "compression_ratio": 1.5772058823529411, "no_speech_prob": 1.7281922420897544e-12}, {"id": 341, "seek": 103430, "start": 1050.84, "end": 1057.44, "text": " If the job intrinsically requires no repair performance, then testing for it via an interview or a simulation is perfectly logical.", "tokens": [51192, 759, 264, 1691, 28621, 984, 7029, 572, 10535, 3389, 11, 550, 4997, 337, 309, 5766, 364, 4049, 420, 257, 16575, 307, 6239, 14978, 13, 51522], "temperature": 0.0, "avg_logprob": -0.09369745461837105, "compression_ratio": 1.5772058823529411, "no_speech_prob": 1.7281922420897544e-12}, {"id": 342, "seek": 105744, "start": 1057.44, "end": 1068.54, "text": " The tragedy, detailed in Corollary 12.2 regarding systematic selection error, is that we apply this no-repair metric to jobs that are fundamentally repair channel tasks.", "tokens": [50365, 440, 18563, 11, 9942, 294, 3925, 1833, 822, 2272, 13, 17, 8595, 27249, 9450, 6713, 11, 307, 300, 321, 3079, 341, 572, 12, 19919, 1246, 20678, 281, 4782, 300, 366, 17879, 10535, 2269, 9608, 13, 50920], "temperature": 0.0, "avg_logprob": -0.19353034132618016, "compression_ratio": 1.4293785310734464, "no_speech_prob": 2.1336910103336715e-12}, {"id": 343, "seek": 105744, "start": 1068.8, "end": 1069.14, "text": " Ah.", "tokens": [50933, 2438, 13, 50950], "temperature": 0.0, "avg_logprob": -0.19353034132618016, "compression_ratio": 1.4293785310734464, "no_speech_prob": 2.1336910103336715e-12}, {"id": 344, "seek": 105744, "start": 1069.56, "end": 1074.54, "text": " Think about hiring a software engineer or an architect or a medical researcher.", "tokens": [50971, 6557, 466, 15335, 257, 4722, 11403, 420, 364, 6331, 420, 257, 4625, 21751, 13, 51220], "temperature": 0.0, "avg_logprob": -0.19353034132618016, "compression_ratio": 1.4293785310734464, "no_speech_prob": 2.1336910103336715e-12}, {"id": 345, "seek": 107454, "start": 1074.54, "end": 1079.3999999999999, "text": " These professions require deep, asynchronous, careful drafting.", "tokens": [50365, 1981, 38129, 3651, 2452, 11, 49174, 11, 5026, 46378, 13, 50608], "temperature": 0.0, "avg_logprob": -0.12748552024911303, "compression_ratio": 1.6099290780141844, "no_speech_prob": 2.8376480852576602e-12}, {"id": 346, "seek": 107454, "start": 1079.82, "end": 1082.32, "text": " They are the epitome of repair channel work.", "tokens": [50629, 814, 366, 264, 2388, 270, 423, 295, 10535, 2269, 589, 13, 50754], "temperature": 0.0, "avg_logprob": -0.12748552024911303, "compression_ratio": 1.6099290780141844, "no_speech_prob": 2.8376480852576602e-12}, {"id": 347, "seek": 107454, "start": 1082.32, "end": 1090.3999999999999, "text": " But to get the job, the software engineer has to stand at a whiteboard and write code from memory while three managers stare at them and ask them trivia questions.", "tokens": [50754, 583, 281, 483, 264, 1691, 11, 264, 4722, 11403, 575, 281, 1463, 412, 257, 2418, 3787, 293, 2464, 3089, 490, 4675, 1339, 1045, 14084, 22432, 412, 552, 293, 1029, 552, 48770, 1651, 13, 51158], "temperature": 0.0, "avg_logprob": -0.12748552024911303, "compression_ratio": 1.6099290780141844, "no_speech_prob": 2.8376480852576602e-12}, {"id": 348, "seek": 107454, "start": 1090.6399999999999, "end": 1090.76, "text": " All right.", "tokens": [51170, 1057, 558, 13, 51176], "temperature": 0.0, "avg_logprob": -0.12748552024911303, "compression_ratio": 1.6099290780141844, "no_speech_prob": 2.8376480852576602e-12}, {"id": 349, "seek": 107454, "start": 1090.8799999999999, "end": 1095.92, "text": " I've always thought whiteboard interviews were absurd, but Fliction is saying it's actually a structural category error.", "tokens": [51182, 286, 600, 1009, 1194, 2418, 3787, 12318, 645, 19774, 11, 457, 3235, 4105, 307, 1566, 309, 311, 767, 257, 15067, 7719, 6713, 13, 51434], "temperature": 0.0, "avg_logprob": -0.12748552024911303, "compression_ratio": 1.6099290780141844, "no_speech_prob": 2.8376480852576602e-12}, {"id": 350, "seek": 107454, "start": 1096.04, "end": 1097.0, "text": " It's worse than an error.", "tokens": [51440, 467, 311, 5324, 813, 364, 6713, 13, 51488], "temperature": 0.0, "avg_logprob": -0.12748552024911303, "compression_ratio": 1.6099290780141844, "no_speech_prob": 2.8376480852576602e-12}, {"id": 351, "seek": 107454, "start": 1097.12, "end": 1098.32, "text": " It's a systematic bias.", "tokens": [51494, 467, 311, 257, 27249, 12577, 13, 51554], "temperature": 0.0, "avg_logprob": -0.12748552024911303, "compression_ratio": 1.6099290780141844, "no_speech_prob": 2.8376480852576602e-12}, {"id": 352, "seek": 109832, "start": 1098.32, "end": 1107.32, "text": " If you measure a repair channel skill set using a no-repair instrument, you will systematically select for fluent, confident performers over deep, careful revisers.", "tokens": [50365, 759, 291, 3481, 257, 10535, 2269, 5389, 992, 1228, 257, 572, 12, 19919, 1246, 7198, 11, 291, 486, 39531, 3048, 337, 40799, 11, 6679, 30768, 670, 2452, 11, 5026, 20767, 433, 13, 50815], "temperature": 0.0, "avg_logprob": -0.10324859619140625, "compression_ratio": 1.610223642172524, "no_speech_prob": 1.629586765007629e-12}, {"id": 353, "seek": 109832, "start": 1107.98, "end": 1110.86, "text": " You hire the person who streams well over the person who computes deeply?", "tokens": [50848, 509, 11158, 264, 954, 567, 15842, 731, 670, 264, 954, 567, 715, 1819, 8760, 30, 50992], "temperature": 0.0, "avg_logprob": -0.10324859619140625, "compression_ratio": 1.610223642172524, "no_speech_prob": 1.629586765007629e-12}, {"id": 354, "seek": 109832, "start": 1111.32, "end": 1111.8799999999999, "text": " Exactly.", "tokens": [51015, 7587, 13, 51043], "temperature": 0.0, "avg_logprob": -0.10324859619140625, "compression_ratio": 1.610223642172524, "no_speech_prob": 1.629586765007629e-12}, {"id": 355, "seek": 109832, "start": 1112.4199999999998, "end": 1118.62, "text": " We structure our society to penalize anyone who requires a repair interval to do their best thinking.", "tokens": [51070, 492, 3877, 527, 4086, 281, 13661, 1125, 2878, 567, 7029, 257, 10535, 15035, 281, 360, 641, 1151, 1953, 13, 51380], "temperature": 0.0, "avg_logprob": -0.10324859619140625, "compression_ratio": 1.610223642172524, "no_speech_prob": 1.629586765007629e-12}, {"id": 356, "seek": 109832, "start": 1118.82, "end": 1127.82, "text": " It's like judging a chef whose entire job is to slow-roast complex 12-hour brisket, and the only test you give them is a 30-second hot dog eating contest.", "tokens": [51390, 467, 311, 411, 23587, 257, 10530, 6104, 2302, 1691, 307, 281, 2964, 12, 340, 525, 3997, 2272, 12, 18048, 738, 271, 5758, 11, 293, 264, 787, 1500, 291, 976, 552, 307, 257, 2217, 12, 27375, 2368, 3000, 3936, 10287, 13, 51840], "temperature": 0.0, "avg_logprob": -0.10324859619140625, "compression_ratio": 1.610223642172524, "no_speech_prob": 1.629586765007629e-12}, {"id": 357, "seek": 112782, "start": 1127.82, "end": 1128.22, "text": " Yeah.", "tokens": [50365, 865, 13, 50385], "temperature": 0.0, "avg_logprob": -0.13250115513801575, "compression_ratio": 1.606425702811245, "no_speech_prob": 1.5191788799162609e-12}, {"id": 358, "seek": 112782, "start": 1128.46, "end": 1130.74, "text": " And then you declare the winner the best chef.", "tokens": [50397, 400, 550, 291, 19710, 264, 8507, 264, 1151, 10530, 13, 50511], "temperature": 0.0, "avg_logprob": -0.13250115513801575, "compression_ratio": 1.606425702811245, "no_speech_prob": 1.5191788799162609e-12}, {"id": 359, "seek": 112782, "start": 1131.1, "end": 1131.3, "text": " Yeah.", "tokens": [50529, 865, 13, 50539], "temperature": 0.0, "avg_logprob": -0.13250115513801575, "compression_ratio": 1.606425702811245, "no_speech_prob": 1.5191788799162609e-12}, {"id": 360, "seek": 112782, "start": 1131.6399999999999, "end": 1134.56, "text": " You are selecting for a completely different metabolic process.", "tokens": [50556, 509, 366, 18182, 337, 257, 2584, 819, 36464, 1399, 13, 50702], "temperature": 0.0, "avg_logprob": -0.13250115513801575, "compression_ratio": 1.606425702811245, "no_speech_prob": 1.5191788799162609e-12}, {"id": 361, "seek": 112782, "start": 1134.96, "end": 1140.78, "text": " And this leads to a really beautiful defense in the treatise of what Fliction calls the elective silence.", "tokens": [50722, 400, 341, 6689, 281, 257, 534, 2238, 7654, 294, 264, 2387, 908, 295, 437, 3235, 4105, 5498, 264, 2185, 488, 12239, 13, 51013], "temperature": 0.0, "avg_logprob": -0.13250115513801575, "compression_ratio": 1.606425702811245, "no_speech_prob": 1.5191788799162609e-12}, {"id": 362, "seek": 112782, "start": 1140.9399999999998, "end": 1141.8999999999999, "text": " The elective silence.", "tokens": [51021, 440, 2185, 488, 12239, 13, 51069], "temperature": 0.0, "avg_logprob": -0.13250115513801575, "compression_ratio": 1.606425702811245, "no_speech_prob": 1.5191788799162609e-12}, {"id": 363, "seek": 112782, "start": 1142.26, "end": 1150.26, "text": " Remark 12.3 validates the millions of people who naturally prefer to read silently, write asynchronously, and avoid speaking aloud whenever possible.", "tokens": [51087, 4080, 809, 2272, 13, 18, 7363, 1024, 264, 6803, 295, 561, 567, 8195, 4382, 281, 1401, 40087, 11, 2464, 42642, 5098, 11, 293, 5042, 4124, 43888, 5699, 1944, 13, 51487], "temperature": 0.0, "avg_logprob": -0.13250115513801575, "compression_ratio": 1.606425702811245, "no_speech_prob": 1.5191788799162609e-12}, {"id": 364, "seek": 115026, "start": 1150.26, "end": 1158.84, "text": " People who are constantly told by society that they're too quiet or that they lack leadership skills or that they need to take a public speaking seminar to fix their deficiency.", "tokens": [50365, 3432, 567, 366, 6460, 1907, 538, 4086, 300, 436, 434, 886, 5677, 420, 300, 436, 5011, 5848, 3942, 420, 300, 436, 643, 281, 747, 257, 1908, 4124, 29235, 281, 3191, 641, 37500, 13, 50794], "temperature": 0.0, "avg_logprob": -0.0846868273037583, "compression_ratio": 1.592039800995025, "no_speech_prob": 2.3525255094664077e-12}, {"id": 365, "seek": 115026, "start": 1159.12, "end": 1162.76, "text": " Fliction argues mathematically that this is not a deficiency at all.", "tokens": [50808, 3235, 4105, 38218, 44003, 300, 341, 307, 406, 257, 37500, 412, 439, 13, 50990], "temperature": 0.0, "avg_logprob": -0.0846868273037583, "compression_ratio": 1.592039800995025, "no_speech_prob": 2.3525255094664077e-12}, {"id": 366, "seek": 115026, "start": 1162.86, "end": 1166.94, "text": " It is a highly rational channel preference for maximizing output quality.", "tokens": [50995, 467, 307, 257, 5405, 15090, 2269, 17502, 337, 5138, 3319, 5598, 3125, 13, 51199], "temperature": 0.0, "avg_logprob": -0.0846868273037583, "compression_ratio": 1.592039800995025, "no_speech_prob": 2.3525255094664077e-12}, {"id": 367, "seek": 116694, "start": 1166.94, "end": 1168.3400000000001, "text": " Because they know their strengths.", "tokens": [50365, 1436, 436, 458, 641, 16986, 13, 50435], "temperature": 0.0, "avg_logprob": -0.1097660714929754, "compression_ratio": 1.623134328358209, "no_speech_prob": 2.5046249796378817e-12}, {"id": 368, "seek": 116694, "start": 1168.78, "end": 1168.96, "text": " Right.", "tokens": [50457, 1779, 13, 50466], "temperature": 0.0, "avg_logprob": -0.1097660714929754, "compression_ratio": 1.623134328358209, "no_speech_prob": 2.5046249796378817e-12}, {"id": 369, "seek": 116694, "start": 1169.46, "end": 1177.56, "text": " If an individual knows that their absolute peak competence on a drafted document far exceeds their instantaneous competence while nervous in a conference room,", "tokens": [50491, 759, 364, 2609, 3255, 300, 641, 8236, 10651, 39965, 322, 257, 36288, 4166, 1400, 43305, 641, 45596, 39965, 1339, 6296, 294, 257, 7586, 1808, 11, 50896], "temperature": 0.0, "avg_logprob": -0.1097660714929754, "compression_ratio": 1.623134328358209, "no_speech_prob": 2.5046249796378817e-12}, {"id": 370, "seek": 116694, "start": 1177.8400000000001, "end": 1182.44, "text": " then choosing the written channel is the most logically sound optimization strategy they can employ.", "tokens": [50910, 550, 10875, 264, 3720, 2269, 307, 264, 881, 38887, 1626, 19618, 5206, 436, 393, 3188, 13, 51140], "temperature": 0.0, "avg_logprob": -0.1097660714929754, "compression_ratio": 1.623134328358209, "no_speech_prob": 2.5046249796378817e-12}, {"id": 371, "seek": 116694, "start": 1182.64, "end": 1183.6000000000001, "text": " That makes perfect sense.", "tokens": [51150, 663, 1669, 2176, 2020, 13, 51198], "temperature": 0.0, "avg_logprob": -0.1097660714929754, "compression_ratio": 1.623134328358209, "no_speech_prob": 2.5046249796378817e-12}, {"id": 372, "seek": 116694, "start": 1183.8600000000001, "end": 1190.98, "text": " What society pathologizes as a personality flaw, the mathematics validate as a feature of quality control.", "tokens": [51211, 708, 4086, 3100, 1132, 5660, 382, 257, 9033, 13717, 11, 264, 18666, 29562, 382, 257, 4111, 295, 3125, 1969, 13, 51567], "temperature": 0.0, "avg_logprob": -0.1097660714929754, "compression_ratio": 1.623134328358209, "no_speech_prob": 2.5046249796378817e-12}, {"id": 373, "seek": 119098, "start": 1190.98, "end": 1201.08, "text": " A profile society values the cheap ease of administering a 30-minute synchronous interview over the rigorous depth of reading a candidate's asynchronous portfolio.", "tokens": [50365, 316, 7964, 4086, 4190, 264, 7084, 12708, 295, 22096, 278, 257, 2217, 12, 18256, 44743, 4049, 670, 264, 29882, 7161, 295, 3760, 257, 11532, 311, 49174, 12583, 13, 50870], "temperature": 0.0, "avg_logprob": -0.13859334806116616, "compression_ratio": 1.6133333333333333, "no_speech_prob": 1.8042261478237731e-12}, {"id": 374, "seek": 119098, "start": 1201.9, "end": 1204.04, "text": " We are sacrificing depth for convenience.", "tokens": [50911, 492, 366, 42294, 7161, 337, 19283, 13, 51018], "temperature": 0.0, "avg_logprob": -0.13859334806116616, "compression_ratio": 1.6133333333333333, "no_speech_prob": 1.8042261478237731e-12}, {"id": 375, "seek": 119098, "start": 1204.34, "end": 1204.68, "text": " We are.", "tokens": [51033, 492, 366, 13, 51050], "temperature": 0.0, "avg_logprob": -0.13859334806116616, "compression_ratio": 1.6133333333333333, "no_speech_prob": 1.8042261478237731e-12}, {"id": 376, "seek": 119098, "start": 1205.02, "end": 1209.2, "text": " And that sacrifice is driven by the physical realities of the channels we choose to use.", "tokens": [51067, 400, 300, 11521, 307, 9555, 538, 264, 4001, 27785, 295, 264, 9235, 321, 2826, 281, 764, 13, 51276], "temperature": 0.0, "avg_logprob": -0.13859334806116616, "compression_ratio": 1.6133333333333333, "no_speech_prob": 1.8042261478237731e-12}, {"id": 377, "seek": 119098, "start": 1209.66, "end": 1211.5, "text": " Which brings us back to the physical environment.", "tokens": [51299, 3013, 5607, 505, 646, 281, 264, 4001, 2823, 13, 51391], "temperature": 0.0, "avg_logprob": -0.13859334806116616, "compression_ratio": 1.6133333333333333, "no_speech_prob": 1.8042261478237731e-12}, {"id": 378, "seek": 119098, "start": 1211.76, "end": 1212.18, "text": " Oh, right.", "tokens": [51404, 876, 11, 558, 13, 51425], "temperature": 0.0, "avg_logprob": -0.13859334806116616, "compression_ratio": 1.6133333333333333, "no_speech_prob": 1.8042261478237731e-12}, {"id": 379, "seek": 121218, "start": 1212.18, "end": 1222.28, "text": " If writing gives us this incredibly powerful sanctuary, the buffered draft, the repair interval, how does it interact with the physical space around us compared to speaking?", "tokens": [50365, 759, 3579, 2709, 505, 341, 6252, 4005, 34390, 11, 264, 9204, 4073, 11206, 11, 264, 10535, 15035, 11, 577, 775, 309, 4648, 365, 264, 4001, 1901, 926, 505, 5347, 281, 4124, 30, 50870], "temperature": 0.0, "avg_logprob": -0.17026804914378157, "compression_ratio": 1.5639097744360901, "no_speech_prob": 1.6173053564785822e-12}, {"id": 380, "seek": 121218, "start": 1222.54, "end": 1222.68, "text": " Right.", "tokens": [50883, 1779, 13, 50890], "temperature": 0.0, "avg_logprob": -0.17026804914378157, "compression_ratio": 1.5639097744360901, "no_speech_prob": 1.6173053564785822e-12}, {"id": 381, "seek": 121218, "start": 1222.74, "end": 1225.18, "text": " Because my keyboard isn't just protecting me from time.", "tokens": [50893, 1436, 452, 10186, 1943, 380, 445, 12316, 385, 490, 565, 13, 51015], "temperature": 0.0, "avg_logprob": -0.17026804914378157, "compression_ratio": 1.5639097744360901, "no_speech_prob": 1.6173053564785822e-12}, {"id": 382, "seek": 121218, "start": 1225.44, "end": 1227.48, "text": " It's protecting me from the coffee shop I'm sitting in.", "tokens": [51028, 467, 311, 12316, 385, 490, 264, 4982, 3945, 286, 478, 3798, 294, 13, 51130], "temperature": 0.0, "avg_logprob": -0.17026804914378157, "compression_ratio": 1.5639097744360901, "no_speech_prob": 1.6173053564785822e-12}, {"id": 383, "seek": 121218, "start": 1228.1200000000001, "end": 1234.1000000000001, "text": " This is where Flician introduces the concepts of omission and admission and the idea of the double silence.", "tokens": [51162, 639, 307, 689, 3235, 9027, 31472, 264, 10392, 295, 3406, 3106, 293, 24668, 293, 264, 1558, 295, 264, 3834, 12239, 13, 51461], "temperature": 0.0, "avg_logprob": -0.17026804914378157, "compression_ratio": 1.5639097744360901, "no_speech_prob": 1.6173053564785822e-12}, {"id": 384, "seek": 121218, "start": 1234.66, "end": 1236.3200000000002, "text": " Definition 5.1.", "tokens": [51489, 46245, 849, 1025, 13, 16, 13, 51572], "temperature": 0.0, "avg_logprob": -0.17026804914378157, "compression_ratio": 1.5639097744360901, "no_speech_prob": 1.6173053564785822e-12}, {"id": 385, "seek": 123632, "start": 1236.32, "end": 1239.72, "text": " We already established that a microphone emits the room.", "tokens": [50365, 492, 1217, 7545, 300, 257, 10952, 846, 1208, 264, 1808, 13, 50535], "temperature": 0.0, "avg_logprob": -0.10649871017973302, "compression_ratio": 1.6677524429967427, "no_speech_prob": 1.4105207887110671e-12}, {"id": 386, "seek": 123632, "start": 1240.26, "end": 1242.36, "text": " The fishing net drags in the background noise.", "tokens": [50562, 440, 10180, 2533, 5286, 82, 294, 264, 3678, 5658, 13, 50667], "temperature": 0.0, "avg_logprob": -0.10649871017973302, "compression_ratio": 1.6677524429967427, "no_speech_prob": 1.4105207887110671e-12}, {"id": 387, "seek": 123632, "start": 1243.1, "end": 1246.24, "text": " But Fliction points out that speaking also emits into the room.", "tokens": [50704, 583, 3235, 4105, 2793, 484, 300, 4124, 611, 846, 1208, 666, 264, 1808, 13, 50861], "temperature": 0.0, "avg_logprob": -0.10649871017973302, "compression_ratio": 1.6677524429967427, "no_speech_prob": 1.4105207887110671e-12}, {"id": 388, "seek": 123632, "start": 1246.52, "end": 1253.96, "text": " So if I'm pacing around an airport terminal dictating an email to my phone, I am emitting my vocal cord vibrations into the shared acoustic space.", "tokens": [50875, 407, 498, 286, 478, 43285, 926, 364, 10155, 14709, 12569, 990, 364, 3796, 281, 452, 2593, 11, 286, 669, 846, 2414, 452, 11657, 12250, 32339, 666, 264, 5507, 26753, 1901, 13, 51247], "temperature": 0.0, "avg_logprob": -0.10649871017973302, "compression_ratio": 1.6677524429967427, "no_speech_prob": 1.4105207887110671e-12}, {"id": 389, "seek": 123632, "start": 1254.36, "end": 1260.8799999999999, "text": " I am forcing everyone at gate 14 to listen to my half of a conversation about quarterly earnings.", "tokens": [51267, 286, 669, 19030, 1518, 412, 8539, 3499, 281, 2140, 281, 452, 1922, 295, 257, 3761, 466, 38633, 20548, 13, 51593], "temperature": 0.0, "avg_logprob": -0.10649871017973302, "compression_ratio": 1.6677524429967427, "no_speech_prob": 1.4105207887110671e-12}, {"id": 390, "seek": 123632, "start": 1260.8799999999999, "end": 1266.22, "text": " And this creates what Proposition 5.2 calls the socially generative nature of the acoustic channel.", "tokens": [51593, 400, 341, 7829, 437, 21944, 5830, 1025, 13, 17, 5498, 264, 21397, 1337, 1166, 3687, 295, 264, 26753, 2269, 13, 51860], "temperature": 0.0, "avg_logprob": -0.10649871017973302, "compression_ratio": 1.6677524429967427, "no_speech_prob": 1.4105207887110671e-12}, {"id": 391, "seek": 126632, "start": 1266.32, "end": 1267.0, "text": " Socially generative.", "tokens": [50365, 407, 1909, 1337, 1166, 13, 50399], "temperature": 0.0, "avg_logprob": -0.1399533198429988, "compression_ratio": 1.6816720257234727, "no_speech_prob": 1.7691603390601607e-12}, {"id": 392, "seek": 126632, "start": 1267.26, "end": 1270.74, "text": " When you speak to a device in public, you physically alter the environment.", "tokens": [50412, 1133, 291, 1710, 281, 257, 4302, 294, 1908, 11, 291, 9762, 11337, 264, 2823, 13, 50586], "temperature": 0.0, "avg_logprob": -0.1399533198429988, "compression_ratio": 1.6816720257234727, "no_speech_prob": 1.7691603390601607e-12}, {"id": 393, "seek": 126632, "start": 1270.96, "end": 1271.78, "text": " Other people hear you.", "tokens": [50597, 5358, 561, 1568, 291, 13, 50638], "temperature": 0.0, "avg_logprob": -0.1399533198429988, "compression_ratio": 1.6816720257234727, "no_speech_prob": 1.7691603390601607e-12}, {"id": 394, "seek": 126632, "start": 1271.86, "end": 1272.62, "text": " They might turn around.", "tokens": [50642, 814, 1062, 1261, 926, 13, 50680], "temperature": 0.0, "avg_logprob": -0.1399533198429988, "compression_ratio": 1.6816720257234727, "no_speech_prob": 1.7691603390601607e-12}, {"id": 395, "seek": 126632, "start": 1272.7, "end": 1274.32, "text": " They might say, excuse me, are you talking to me?", "tokens": [50684, 814, 1062, 584, 11, 8960, 385, 11, 366, 291, 1417, 281, 385, 30, 50765], "temperature": 0.0, "avg_logprob": -0.1399533198429988, "compression_ratio": 1.6816720257234727, "no_speech_prob": 1.7691603390601607e-12}, {"id": 396, "seek": 126632, "start": 1274.4199999999998, "end": 1274.6599999999999, "text": " Yeah.", "tokens": [50770, 865, 13, 50782], "temperature": 0.0, "avg_logprob": -0.1399533198429988, "compression_ratio": 1.6816720257234727, "no_speech_prob": 1.7691603390601607e-12}, {"id": 397, "seek": 126632, "start": 1274.78, "end": 1283.6799999999998, "text": " And then, because your microphone is a scene sampling device, those responses, the confusion, the ambient reaction you just generated, are emitted right back into your channel.", "tokens": [50788, 400, 550, 11, 570, 428, 10952, 307, 257, 4145, 21179, 4302, 11, 729, 13019, 11, 264, 15075, 11, 264, 22997, 5480, 291, 445, 10833, 11, 366, 44897, 558, 646, 666, 428, 2269, 13, 51233], "temperature": 0.0, "avg_logprob": -0.1399533198429988, "compression_ratio": 1.6816720257234727, "no_speech_prob": 1.7691603390601607e-12}, {"id": 398, "seek": 126632, "start": 1283.76, "end": 1285.6599999999999, "text": " So the channel literally contaminates itself.", "tokens": [51237, 407, 264, 2269, 3736, 27562, 1024, 2564, 13, 51332], "temperature": 0.0, "avg_logprob": -0.1399533198429988, "compression_ratio": 1.6816720257234727, "no_speech_prob": 1.7691603390601607e-12}, {"id": 399, "seek": 126632, "start": 1285.84, "end": 1290.74, "text": " The very act of using the interface creates the noise that ruins the input.", "tokens": [51341, 440, 588, 605, 295, 1228, 264, 9226, 7829, 264, 5658, 300, 24747, 264, 4846, 13, 51586], "temperature": 0.0, "avg_logprob": -0.1399533198429988, "compression_ratio": 1.6816720257234727, "no_speech_prob": 1.7691603390601607e-12}, {"id": 400, "seek": 126632, "start": 1291.0, "end": 1292.22, "text": " It is a generative leak.", "tokens": [51599, 467, 307, 257, 1337, 1166, 17143, 13, 51660], "temperature": 0.0, "avg_logprob": -0.1399533198429988, "compression_ratio": 1.6816720257234727, "no_speech_prob": 1.7691603390601607e-12}, {"id": 401, "seek": 129222, "start": 1292.22, "end": 1296.4, "text": " The interface bleeds into the physical world, and the physical world bleeds into the interface.", "tokens": [50365, 440, 9226, 5408, 5147, 666, 264, 4001, 1002, 11, 293, 264, 4001, 1002, 5408, 5147, 666, 264, 9226, 13, 50574], "temperature": 0.0, "avg_logprob": -0.09138703796098817, "compression_ratio": 1.8620689655172413, "no_speech_prob": 1.201778043399826e-12}, {"id": 402, "seek": 129222, "start": 1296.84, "end": 1299.28, "text": " But typing on a keyboard avoids this entirely.", "tokens": [50596, 583, 18444, 322, 257, 10186, 3641, 3742, 341, 7696, 13, 50718], "temperature": 0.0, "avg_logprob": -0.09138703796098817, "compression_ratio": 1.8620689655172413, "no_speech_prob": 1.201778043399826e-12}, {"id": 403, "seek": 129222, "start": 1299.78, "end": 1302.56, "text": " Typing is what Fliction calls doubly silent.", "tokens": [50743, 5569, 3381, 307, 437, 3235, 4105, 5498, 10831, 356, 12784, 13, 50882], "temperature": 0.0, "avg_logprob": -0.09138703796098817, "compression_ratio": 1.8620689655172413, "no_speech_prob": 1.201778043399826e-12}, {"id": 404, "seek": 129222, "start": 1303.04, "end": 1305.52, "text": " Because it neither emits the room nor emits into it.", "tokens": [50906, 1436, 309, 9662, 846, 1208, 264, 1808, 6051, 846, 1208, 666, 309, 13, 51030], "temperature": 0.0, "avg_logprob": -0.09138703796098817, "compression_ratio": 1.8620689655172413, "no_speech_prob": 1.201778043399826e-12}, {"id": 405, "seek": 129222, "start": 1305.58, "end": 1306.0, "text": " Exactly.", "tokens": [51033, 7587, 13, 51054], "temperature": 0.0, "avg_logprob": -0.09138703796098817, "compression_ratio": 1.8620689655172413, "no_speech_prob": 1.201778043399826e-12}, {"id": 406, "seek": 129222, "start": 1306.26, "end": 1315.04, "text": " Your keyboard does not hear the airport terminal, and the airport terminal does not hear your keystrokes, at least not in a way that transmits the linguistic content of your message.", "tokens": [51067, 2260, 10186, 775, 406, 1568, 264, 10155, 14709, 11, 293, 264, 10155, 14709, 775, 406, 1568, 428, 2141, 27616, 5993, 11, 412, 1935, 406, 294, 257, 636, 300, 7715, 1208, 264, 43002, 2701, 295, 428, 3636, 13, 51506], "temperature": 0.0, "avg_logprob": -0.09138703796098817, "compression_ratio": 1.8620689655172413, "no_speech_prob": 1.201778043399826e-12}, {"id": 407, "seek": 131504, "start": 1315.04, "end": 1321.1599999999999, "text": " This double silence is the physical mechanism that allows for what Fliction calls parallel composition.", "tokens": [50365, 639, 3834, 12239, 307, 264, 4001, 7513, 300, 4045, 337, 437, 3235, 4105, 5498, 8952, 12686, 13, 50671], "temperature": 0.0, "avg_logprob": -0.11769085323687681, "compression_ratio": 1.66796875, "no_speech_prob": 1.7015423358496262e-12}, {"id": 408, "seek": 131504, "start": 1321.52, "end": 1321.84, "text": " Yes.", "tokens": [50689, 1079, 13, 50705], "temperature": 0.0, "avg_logprob": -0.11769085323687681, "compression_ratio": 1.66796875, "no_speech_prob": 1.7015423358496262e-12}, {"id": 409, "seek": 131504, "start": 1322.42, "end": 1329.82, "text": " This is why I can text my spouse under the table during a boring dinner party, or write an entire article while sitting in the middle of a noisy stadium.", "tokens": [50734, 639, 307, 983, 286, 393, 2487, 452, 23013, 833, 264, 3199, 1830, 257, 9989, 6148, 3595, 11, 420, 2464, 364, 2302, 7222, 1339, 3798, 294, 264, 2808, 295, 257, 24518, 18585, 13, 51104], "temperature": 0.0, "avg_logprob": -0.11769085323687681, "compression_ratio": 1.66796875, "no_speech_prob": 1.7015423358496262e-12}, {"id": 410, "seek": 131504, "start": 1330.44, "end": 1336.7, "text": " The physical layer of my writing is perfectly surgically disjointed from the social layer of the room I am sitting in.", "tokens": [51135, 440, 4001, 4583, 295, 452, 3579, 307, 6239, 19560, 984, 717, 73, 33041, 490, 264, 2093, 4583, 295, 264, 1808, 286, 669, 3798, 294, 13, 51448], "temperature": 0.0, "avg_logprob": -0.11769085323687681, "compression_ratio": 1.66796875, "no_speech_prob": 1.7015423358496262e-12}, {"id": 411, "seek": 131504, "start": 1337.02, "end": 1339.46, "text": " It is the ultimate form of localized privacy.", "tokens": [51464, 467, 307, 264, 9705, 1254, 295, 44574, 11427, 13, 51586], "temperature": 0.0, "avg_logprob": -0.11769085323687681, "compression_ratio": 1.66796875, "no_speech_prob": 1.7015423358496262e-12}, {"id": 412, "seek": 133946, "start": 1339.46, "end": 1345.9, "text": " You can occupy two completely different social contexts simultaneously without them ever intersecting.", "tokens": [50365, 509, 393, 30645, 732, 2584, 819, 2093, 30628, 16561, 1553, 552, 1562, 27815, 278, 13, 50687], "temperature": 0.0, "avg_logprob": -0.17777152963586756, "compression_ratio": 1.5309734513274336, "no_speech_prob": 1.5796941662746256e-12}, {"id": 413, "seek": 133946, "start": 1346.1200000000001, "end": 1351.26, "text": " Which makes me think about spatial computing, augmented reality, and just walking around with headphones on.", "tokens": [50698, 3013, 1669, 385, 519, 466, 23598, 15866, 11, 36155, 4103, 11, 293, 445, 4494, 926, 365, 16278, 322, 13, 50955], "temperature": 0.0, "avg_logprob": -0.17777152963586756, "compression_ratio": 1.5309734513274336, "no_speech_prob": 1.5796941662746256e-12}, {"id": 414, "seek": 133946, "start": 1351.72, "end": 1356.14, "text": " Like, wearing noise-canceling headphones creates a faux double silence bubble.", "tokens": [50978, 1743, 11, 4769, 5658, 12, 66, 4463, 11031, 16278, 7829, 257, 36659, 3834, 12239, 12212, 13, 51199], "temperature": 0.0, "avg_logprob": -0.17777152963586756, "compression_ratio": 1.5309734513274336, "no_speech_prob": 1.5796941662746256e-12}, {"id": 415, "seek": 133946, "start": 1356.42, "end": 1358.76, "text": " You block out the room visually and acoustically.", "tokens": [51213, 509, 3461, 484, 264, 1808, 19622, 293, 22740, 984, 13, 51330], "temperature": 0.0, "avg_logprob": -0.17777152963586756, "compression_ratio": 1.5309734513274336, "no_speech_prob": 1.5796941662746256e-12}, {"id": 416, "seek": 133946, "start": 1358.8, "end": 1359.0, "text": " Yeah.", "tokens": [51332, 865, 13, 51342], "temperature": 0.0, "avg_logprob": -0.17777152963586756, "compression_ratio": 1.5309734513274336, "no_speech_prob": 1.5796941662746256e-12}, {"id": 417, "seek": 135900, "start": 1359.0, "end": 1369.04, "text": " But the second you rely on a voice assistant, the second you say, hey Siri, or, okay, Google allowed to command your AR glasses, you instantly shatter that bubble.", "tokens": [50365, 583, 264, 1150, 291, 10687, 322, 257, 3177, 10994, 11, 264, 1150, 291, 584, 11, 4177, 33682, 11, 420, 11, 1392, 11, 3329, 4350, 281, 5622, 428, 8943, 10812, 11, 291, 13518, 402, 1161, 300, 12212, 13, 50867], "temperature": 0.0, "avg_logprob": -0.09693767284524851, "compression_ratio": 1.5656108597285068, "no_speech_prob": 1.7283460903780301e-12}, {"id": 418, "seek": 135900, "start": 1369.3, "end": 1372.54, "text": " You emit into the room, and the device emits the room.", "tokens": [50880, 509, 32084, 666, 264, 1808, 11, 293, 264, 4302, 846, 1208, 264, 1808, 13, 51042], "temperature": 0.0, "avg_logprob": -0.09693767284524851, "compression_ratio": 1.5656108597285068, "no_speech_prob": 1.7283460903780301e-12}, {"id": 419, "seek": 135900, "start": 1372.78, "end": 1376.54, "text": " Which is why the push for voice-first ambient computing is so fraught.", "tokens": [51054, 3013, 307, 983, 264, 2944, 337, 3177, 12, 29581, 22997, 15866, 307, 370, 6600, 1599, 13, 51242], "temperature": 0.0, "avg_logprob": -0.09693767284524851, "compression_ratio": 1.5656108597285068, "no_speech_prob": 1.7283460903780301e-12}, {"id": 420, "seek": 135900, "start": 1376.9, "end": 1379.4, "text": " You are asking people to surrender their double silence.", "tokens": [51260, 509, 366, 3365, 561, 281, 22185, 641, 3834, 12239, 13, 51385], "temperature": 0.0, "avg_logprob": -0.09693767284524851, "compression_ratio": 1.5656108597285068, "no_speech_prob": 1.7283460903780301e-12}, {"id": 421, "seek": 137940, "start": 1379.4, "end": 1390.94, "text": " But wait, if double silence is the ultimate form of privacy, and it allows for parallel composition without bothering anyone, why is the tech industry so relentlessly obsessed with making us talk to our devices?", "tokens": [50365, 583, 1699, 11, 498, 3834, 12239, 307, 264, 9705, 1254, 295, 11427, 11, 293, 309, 4045, 337, 8952, 12686, 1553, 31432, 2878, 11, 983, 307, 264, 7553, 3518, 370, 34045, 12048, 16923, 365, 1455, 505, 751, 281, 527, 5759, 30, 50942], "temperature": 0.0, "avg_logprob": -0.11665549711747603, "compression_ratio": 1.6476868327402134, "no_speech_prob": 1.495634453958783e-12}, {"id": 422, "seek": 137940, "start": 1391.48, "end": 1395.66, "text": " Why do they want microphones on our wrists, on our glasses, on our kitchen counters?", "tokens": [50969, 1545, 360, 436, 528, 30495, 322, 527, 41876, 11, 322, 527, 10812, 11, 322, 527, 6525, 39338, 30, 51178], "temperature": 0.0, "avg_logprob": -0.11665549711747603, "compression_ratio": 1.6476868327402134, "no_speech_prob": 1.495634453958783e-12}, {"id": 423, "seek": 137940, "start": 1395.94, "end": 1399.0, "text": " Because a scene-sampling microphone doesn't just collect your commands.", "tokens": [51192, 1436, 257, 4145, 12, 19988, 11970, 10952, 1177, 380, 445, 2500, 428, 16901, 13, 51345], "temperature": 0.0, "avg_logprob": -0.11665549711747603, "compression_ratio": 1.6476868327402134, "no_speech_prob": 1.495634453958783e-12}, {"id": 424, "seek": 137940, "start": 1399.46, "end": 1400.5, "text": " It collects context.", "tokens": [51368, 467, 39897, 4319, 13, 51420], "temperature": 0.0, "avg_logprob": -0.11665549711747603, "compression_ratio": 1.6476868327402134, "no_speech_prob": 1.495634453958783e-12}, {"id": 425, "seek": 137940, "start": 1400.66, "end": 1401.5, "text": " It collects the room.", "tokens": [51428, 467, 39897, 264, 1808, 13, 51470], "temperature": 0.0, "avg_logprob": -0.11665549711747603, "compression_ratio": 1.6476868327402134, "no_speech_prob": 1.495634453958783e-12}, {"id": 426, "seek": 137940, "start": 1402.2, "end": 1404.0800000000002, "text": " And data is the currency of the realm.", "tokens": [51505, 400, 1412, 307, 264, 13346, 295, 264, 15355, 13, 51599], "temperature": 0.0, "avg_logprob": -0.11665549711747603, "compression_ratio": 1.6476868327402134, "no_speech_prob": 1.495634453958783e-12}, {"id": 427, "seek": 137940, "start": 1404.2, "end": 1404.66, "text": " Right, data.", "tokens": [51605, 1779, 11, 1412, 13, 51628], "temperature": 0.0, "avg_logprob": -0.11665549711747603, "compression_ratio": 1.6476868327402134, "no_speech_prob": 1.495634453958783e-12}, {"id": 428, "seek": 140466, "start": 1404.66, "end": 1409.8200000000002, "text": " However, this brings us to the dark, legal underbelly of Flicksheen's treatise.", "tokens": [50365, 2908, 11, 341, 5607, 505, 281, 264, 2877, 11, 5089, 833, 7100, 88, 295, 3235, 618, 9611, 268, 311, 2387, 908, 13, 50623], "temperature": 0.0, "avg_logprob": -0.1369736958475946, "compression_ratio": 1.6503496503496504, "no_speech_prob": 1.811114301066008e-12}, {"id": 429, "seek": 140466, "start": 1410.28, "end": 1417.6000000000001, "text": " The tech companies thought they were building the ultimate data harvesting machines, but mathematically they built something that might destroy them legally.", "tokens": [50646, 440, 7553, 3431, 1194, 436, 645, 2390, 264, 9705, 1412, 35679, 8379, 11, 457, 44003, 436, 3094, 746, 300, 1062, 5293, 552, 21106, 13, 51012], "temperature": 0.0, "avg_logprob": -0.1369736958475946, "compression_ratio": 1.6503496503496504, "no_speech_prob": 1.811114301066008e-12}, {"id": 430, "seek": 140466, "start": 1417.8600000000001, "end": 1425.52, "text": " Okay, brace yourselves, everyone listening, because this is where this dense mathematical treatise suddenly turns into a high-stakes legal thriller.", "tokens": [51025, 1033, 11, 38458, 14791, 11, 1518, 4764, 11, 570, 341, 307, 689, 341, 18011, 18894, 2387, 908, 5800, 4523, 666, 257, 1090, 12, 372, 3419, 5089, 43009, 13, 51408], "temperature": 0.0, "avg_logprob": -0.1369736958475946, "compression_ratio": 1.6503496503496504, "no_speech_prob": 1.811114301066008e-12}, {"id": 431, "seek": 140466, "start": 1425.88, "end": 1431.1000000000001, "text": " We are getting into the witness obligation theorem and the concept of the robo-nanny.", "tokens": [51426, 492, 366, 1242, 666, 264, 7286, 20326, 20904, 293, 264, 3410, 295, 264, 744, 1763, 12, 77, 11612, 13, 51687], "temperature": 0.0, "avg_logprob": -0.1369736958475946, "compression_ratio": 1.6503496503496504, "no_speech_prob": 1.811114301066008e-12}, {"id": 432, "seek": 143110, "start": 1431.1, "end": 1437.4599999999998, "text": " Chapter 7 and 8 outline an explosive legal argument regarding something called induced knowledge.", "tokens": [50365, 18874, 1614, 293, 1649, 16387, 364, 24630, 5089, 6770, 8595, 746, 1219, 33991, 3601, 13, 50683], "temperature": 0.0, "avg_logprob": -0.10672792080229362, "compression_ratio": 1.6352201257861636, "no_speech_prob": 1.973338159544369e-12}, {"id": 433, "seek": 143110, "start": 1437.78, "end": 1445.7199999999998, "text": " Let's look at a continuous scene-sampling receiver, a smart speaker on your kitchen counter, or an always-on security camera in your living room.", "tokens": [50699, 961, 311, 574, 412, 257, 10957, 4145, 12, 19988, 11970, 20086, 11, 257, 4069, 8145, 322, 428, 6525, 5682, 11, 420, 364, 1009, 12, 266, 3825, 2799, 294, 428, 2647, 1808, 13, 51096], "temperature": 0.0, "avg_logprob": -0.10672792080229362, "compression_ratio": 1.6352201257861636, "no_speech_prob": 1.973338159544369e-12}, {"id": 434, "seek": 143110, "start": 1446.12, "end": 1448.78, "text": " It is constantly physically ingesting the environment.", "tokens": [51116, 467, 307, 6460, 9762, 3957, 8714, 264, 2823, 13, 51249], "temperature": 0.0, "avg_logprob": -0.10672792080229362, "compression_ratio": 1.6352201257861636, "no_speech_prob": 1.973338159544369e-12}, {"id": 435, "seek": 143110, "start": 1449.34, "end": 1460.24, "text": " Therefore, if an event happens in its presence, say, a smoke alarm goes off, or someone breaks a window, or an elderly person falls and cries out for help, the knowledge of that event is physically forced upon the sensor.", "tokens": [51277, 7504, 11, 498, 364, 2280, 2314, 294, 1080, 6814, 11, 584, 11, 257, 8439, 14183, 1709, 766, 11, 420, 1580, 9857, 257, 4910, 11, 420, 364, 19682, 954, 8804, 293, 29206, 484, 337, 854, 11, 264, 3601, 295, 300, 2280, 307, 9762, 7579, 3564, 264, 10200, 13, 51822], "temperature": 0.0, "avg_logprob": -0.10672792080229362, "compression_ratio": 1.6352201257861636, "no_speech_prob": 1.973338159544369e-12}, {"id": 436, "seek": 146024, "start": 1460.24, "end": 1462.1, "text": " Because it's an open fishing net.", "tokens": [50365, 1436, 309, 311, 364, 1269, 10180, 2533, 13, 50458], "temperature": 0.0, "avg_logprob": -0.18938936189163563, "compression_ratio": 1.4545454545454546, "no_speech_prob": 1.7554075597628338e-12}, {"id": 437, "seek": 146024, "start": 1462.24, "end": 1462.38, "text": " Yeah.", "tokens": [50465, 865, 13, 50472], "temperature": 0.0, "avg_logprob": -0.18938936189163563, "compression_ratio": 1.4545454545454546, "no_speech_prob": 1.7554075597628338e-12}, {"id": 438, "seek": 146024, "start": 1462.52, "end": 1465.14, "text": " It literally caught the sound waves of the glass breaking.", "tokens": [50479, 467, 3736, 5415, 264, 1626, 9417, 295, 264, 4276, 7697, 13, 50610], "temperature": 0.0, "avg_logprob": -0.18938936189163563, "compression_ratio": 1.4545454545454546, "no_speech_prob": 1.7554075597628338e-12}, {"id": 439, "seek": 146024, "start": 1465.6200000000001, "end": 1467.94, "text": " The machine possesses the data of the emergency.", "tokens": [50634, 440, 3479, 17490, 279, 264, 1412, 295, 264, 7473, 13, 50750], "temperature": 0.0, "avg_logprob": -0.18938936189163563, "compression_ratio": 1.4545454545454546, "no_speech_prob": 1.7554075597628338e-12}, {"id": 440, "seek": 146024, "start": 1468.2, "end": 1468.68, "text": " Precisely.", "tokens": [50763, 48746, 736, 13, 50787], "temperature": 0.0, "avg_logprob": -0.18938936189163563, "compression_ratio": 1.4545454545454546, "no_speech_prob": 1.7554075597628338e-12}, {"id": 441, "seek": 146024, "start": 1469.0, "end": 1472.44, "text": " And this triggers Axiom 8.1, the duty of the capable witness.", "tokens": [50803, 400, 341, 22827, 20118, 72, 298, 1649, 13, 16, 11, 264, 9776, 295, 264, 8189, 7286, 13, 50975], "temperature": 0.0, "avg_logprob": -0.18938936189163563, "compression_ratio": 1.4545454545454546, "no_speech_prob": 1.7554075597628338e-12}, {"id": 442, "seek": 146024, "start": 1472.74, "end": 1476.38, "text": " Walk me through how this works in human law first so we can map it to the machines.", "tokens": [50990, 10818, 385, 807, 577, 341, 1985, 294, 1952, 2101, 700, 370, 321, 393, 4471, 309, 281, 264, 8379, 13, 51172], "temperature": 0.0, "avg_logprob": -0.18938936189163563, "compression_ratio": 1.4545454545454546, "no_speech_prob": 1.7554075597628338e-12}, {"id": 443, "seek": 147638, "start": 1476.38, "end": 1495.7600000000002, "text": " In human ethics, and in many legal jurisdictions under duty to rescue laws, if a bystander can cheaply and easily detect an emergency, and they have the capacity to act at no physical risk to themselves, like simply pulling out a cell phone to dial 911, they bear a moral and sometimes legal obligation to do so.", "tokens": [50365, 682, 1952, 19769, 11, 293, 294, 867, 5089, 37958, 833, 9776, 281, 13283, 6064, 11, 498, 257, 538, 1115, 260, 393, 7084, 356, 293, 3612, 5531, 364, 7473, 11, 293, 436, 362, 264, 6042, 281, 605, 412, 572, 4001, 3148, 281, 2969, 11, 411, 2935, 8407, 484, 257, 2815, 2593, 281, 5502, 26901, 11, 436, 6155, 257, 9723, 293, 2171, 5089, 20326, 281, 360, 370, 13, 51334], "temperature": 0.0, "avg_logprob": -0.039629462787083215, "compression_ratio": 1.5445544554455446, "no_speech_prob": 1.8468453762826575e-12}, {"id": 444, "seek": 149576, "start": 1495.76, "end": 1508.32, "text": " Right. If I invite a friend over to my house, and they're sitting on my couch, and they watch a burglar smash through my front door, and my friend just sits there sipping tea and does absolutely nothing, they're an objectively terrible friend.", "tokens": [50365, 1779, 13, 759, 286, 7980, 257, 1277, 670, 281, 452, 1782, 11, 293, 436, 434, 3798, 322, 452, 16511, 11, 293, 436, 1159, 257, 41000, 2200, 17960, 807, 452, 1868, 2853, 11, 293, 452, 1277, 445, 12696, 456, 1511, 3759, 5817, 293, 775, 3122, 1825, 11, 436, 434, 364, 46067, 6237, 1277, 13, 50993], "temperature": 0.0, "avg_logprob": -0.067447127717914, "compression_ratio": 1.6381322957198443, "no_speech_prob": 1.5980757299069448e-12}, {"id": 445, "seek": 149576, "start": 1508.46, "end": 1514.6, "text": " And depending on the state, they might be legally negligent for failing to report a felony in progress when they had a phone in their pocket.", "tokens": [51000, 400, 5413, 322, 264, 1785, 11, 436, 1062, 312, 21106, 32570, 317, 337, 18223, 281, 2275, 257, 46255, 294, 4205, 562, 436, 632, 257, 2593, 294, 641, 8963, 13, 51307], "temperature": 0.0, "avg_logprob": -0.067447127717914, "compression_ratio": 1.6381322957198443, "no_speech_prob": 1.5980757299069448e-12}, {"id": 446, "seek": 149576, "start": 1514.74, "end": 1516.06, "text": " Okay, so apply that to the machine.", "tokens": [51314, 1033, 11, 370, 3079, 300, 281, 264, 3479, 13, 51380], "temperature": 0.0, "avg_logprob": -0.067447127717914, "compression_ratio": 1.6381322957198443, "no_speech_prob": 1.5980757299069448e-12}, {"id": 447, "seek": 151606, "start": 1516.06, "end": 1534.6399999999999, "text": " Now, mathematically apply that Axiom to a machine. If a smart speaker is physically struck by the sound waves of a smoke alarm, it has induced knowledge of a fire, it is connected to the internet, it has the absolute trivial capacity to send a push notification to your phone, or automatically route an alert to the fire department.", "tokens": [50365, 823, 11, 44003, 3079, 300, 20118, 72, 298, 281, 257, 3479, 13, 759, 257, 4069, 8145, 307, 9762, 13159, 538, 264, 1626, 9417, 295, 257, 8439, 14183, 11, 309, 575, 33991, 3601, 295, 257, 2610, 11, 309, 307, 4582, 281, 264, 4705, 11, 309, 575, 264, 8236, 26703, 6042, 281, 2845, 257, 2944, 11554, 281, 428, 2593, 11, 420, 6772, 7955, 364, 9615, 281, 264, 2610, 5882, 13, 51294], "temperature": 0.0, "avg_logprob": -0.056670778676083215, "compression_ratio": 1.7206896551724138, "no_speech_prob": 1.5732989997602198e-12}, {"id": 448, "seek": 151606, "start": 1535.0, "end": 1545.1, "text": " So if it knows about the fire, and it has the capacity to act cheaply and safely, it, or the multi-trillion dollar company operating its servers, bears a duty to act.", "tokens": [51312, 407, 498, 309, 3255, 466, 264, 2610, 11, 293, 309, 575, 264, 6042, 281, 605, 7084, 356, 293, 11750, 11, 309, 11, 420, 264, 4825, 12, 6903, 11836, 7241, 2237, 7447, 1080, 15909, 11, 17276, 257, 9776, 281, 605, 13, 51817], "temperature": 0.0, "avg_logprob": -0.056670778676083215, "compression_ratio": 1.7206896551724138, "no_speech_prob": 1.5732989997602198e-12}, {"id": 449, "seek": 154510, "start": 1545.1, "end": 1554.02, "text": " This is the witness obligation theorem. By placing a continuous scene sampling microphone in your home, the tech company has deployed a capable witness.", "tokens": [50365, 639, 307, 264, 7286, 20326, 20904, 13, 3146, 17221, 257, 10957, 4145, 21179, 10952, 294, 428, 1280, 11, 264, 7553, 2237, 575, 17826, 257, 8189, 7286, 13, 50811], "temperature": 0.0, "avg_logprob": -0.05131664626095273, "compression_ratio": 1.6310344827586207, "no_speech_prob": 1.3942127617336264e-12}, {"id": 450, "seek": 154510, "start": 1554.28, "end": 1566.32, "text": " But I'm struggling with the liability link here. I bought the device, put it on my counter. Why is Amazon or Google or Apple legally liable if they don't call 911? Isn't it just my dumb piece of plastic?", "tokens": [50824, 583, 286, 478, 9314, 365, 264, 25196, 2113, 510, 13, 286, 4243, 264, 4302, 11, 829, 309, 322, 452, 5682, 13, 1545, 307, 6795, 420, 3329, 420, 6373, 21106, 375, 712, 498, 436, 500, 380, 818, 26901, 30, 6998, 380, 309, 445, 452, 10316, 2522, 295, 5900, 30, 51426], "temperature": 0.0, "avg_logprob": -0.05131664626095273, "compression_ratio": 1.6310344827586207, "no_speech_prob": 1.3942127617336264e-12}, {"id": 451, "seek": 154510, "start": 1566.4199999999998, "end": 1570.78, "text": " It's not a dumb piece of plastic. The heavy processing isn't happening on the device, it's happening in their cloud.", "tokens": [51431, 467, 311, 406, 257, 10316, 2522, 295, 5900, 13, 440, 4676, 9007, 1943, 380, 2737, 322, 264, 4302, 11, 309, 311, 2737, 294, 641, 4588, 13, 51649], "temperature": 0.0, "avg_logprob": -0.05131664626095273, "compression_ratio": 1.6310344827586207, "no_speech_prob": 1.3942127617336264e-12}, {"id": 452, "seek": 157078, "start": 1570.78, "end": 1577.5, "text": " They operate the continuous loop, which leads to corollary 8.5, nobody wants the microphone they asked for.", "tokens": [50365, 814, 9651, 264, 10957, 6367, 11, 597, 6689, 281, 1181, 1833, 822, 1649, 13, 20, 11, 5079, 2738, 264, 10952, 436, 2351, 337, 13, 50701], "temperature": 0.0, "avg_logprob": -0.1043150160047743, "compression_ratio": 1.5406504065040652, "no_speech_prob": 1.0280369220835861e-12}, {"id": 453, "seek": 157078, "start": 1577.62, "end": 1578.3, "text": " That's a great line.", "tokens": [50707, 663, 311, 257, 869, 1622, 13, 50741], "temperature": 0.0, "avg_logprob": -0.1043150160047743, "compression_ratio": 1.5406504065040652, "no_speech_prob": 1.0280369220835861e-12}, {"id": 454, "seek": 157078, "start": 1578.46, "end": 1591.24, "text": " When a company sells 50 million always listening devices, they are accidentally shipping an open-ended portfolio of witness obligations for every domestic dispute, every house fire, and every medical emergency that happens in 50 million living rooms.", "tokens": [50749, 1133, 257, 2237, 20897, 2625, 2459, 1009, 4764, 5759, 11, 436, 366, 15715, 14122, 364, 1269, 12, 3502, 12583, 295, 7286, 26234, 337, 633, 10939, 25379, 11, 633, 1782, 2610, 11, 293, 633, 4625, 7473, 300, 2314, 294, 2625, 2459, 2647, 9396, 13, 51388], "temperature": 0.0, "avg_logprob": -0.1043150160047743, "compression_ratio": 1.5406504065040652, "no_speech_prob": 1.0280369220835861e-12}, {"id": 455, "seek": 159124, "start": 1591.24, "end": 1602.32, "text": " That is an apocalyptic legal liability for a corporation. If someone dies because the smart speaker heard them fall and didn't call an ambulance, the family could sue the company for negligence.", "tokens": [50365, 663, 307, 364, 1882, 47407, 5089, 25196, 337, 257, 22197, 13, 759, 1580, 2714, 570, 264, 4069, 8145, 2198, 552, 2100, 293, 994, 380, 818, 364, 26744, 11, 264, 1605, 727, 20416, 264, 2237, 337, 32570, 655, 13, 50919], "temperature": 0.0, "avg_logprob": -0.09344906392304794, "compression_ratio": 1.3724137931034484, "no_speech_prob": 1.6364145281888565e-12}, {"id": 456, "seek": 159124, "start": 1602.48, "end": 1602.86, "text": " Yes.", "tokens": [50927, 1079, 13, 50946], "temperature": 0.0, "avg_logprob": -0.09344906392304794, "compression_ratio": 1.3724137931034484, "no_speech_prob": 1.6364145281888565e-12}, {"id": 457, "seek": 160286, "start": 1602.86, "end": 1607.34, "text": " So how do these tech giants avoid getting sued out of existence every single day?", "tokens": [50365, 407, 577, 360, 613, 7553, 31894, 5042, 1242, 33864, 484, 295, 9123, 633, 2167, 786, 30, 50589], "temperature": 0.0, "avg_logprob": -0.10807116177617287, "compression_ratio": 1.514388489208633, "no_speech_prob": 1.2894775308289197e-12}, {"id": 458, "seek": 160286, "start": 1607.76, "end": 1610.6, "text": " Chapter 9, Selective Deafness as Liability Management.", "tokens": [50610, 18874, 1722, 11, 13638, 488, 31389, 1287, 382, 8349, 2310, 14781, 13, 50752], "temperature": 0.0, "avg_logprob": -0.10807116177617287, "compression_ratio": 1.514388489208633, "no_speech_prob": 1.2894775308289197e-12}, {"id": 459, "seek": 160286, "start": 1610.8999999999999, "end": 1613.4399999999998, "text": " Ah, this is where the wake word comes in.", "tokens": [50767, 2438, 11, 341, 307, 689, 264, 6634, 1349, 1487, 294, 13, 50894], "temperature": 0.0, "avg_logprob": -0.10807116177617287, "compression_ratio": 1.514388489208633, "no_speech_prob": 1.2894775308289197e-12}, {"id": 460, "seek": 160286, "start": 1613.52, "end": 1618.32, "text": " Exactly. Why do voice assistants require a wake word like Alexa or Hey Siri?", "tokens": [50898, 7587, 13, 1545, 360, 3177, 34949, 3651, 257, 6634, 1349, 411, 22595, 420, 1911, 33682, 30, 51138], "temperature": 0.0, "avg_logprob": -0.10807116177617287, "compression_ratio": 1.514388489208633, "no_speech_prob": 1.2894775308289197e-12}, {"id": 461, "seek": 160286, "start": 1619.1599999999999, "end": 1625.04, "text": " The marketing departments have spun a brilliant public relations narrative that wake words exist to protect your privacy.", "tokens": [51180, 440, 6370, 15326, 362, 37038, 257, 10248, 1908, 2299, 9977, 300, 6634, 2283, 2514, 281, 2371, 428, 11427, 13, 51474], "temperature": 0.0, "avg_logprob": -0.10807116177617287, "compression_ratio": 1.514388489208633, "no_speech_prob": 1.2894775308289197e-12}, {"id": 462, "seek": 160286, "start": 1625.26, "end": 1627.1, "text": " We aren't listening until you invite us to.", "tokens": [51485, 492, 3212, 380, 4764, 1826, 291, 7980, 505, 281, 13, 51577], "temperature": 0.0, "avg_logprob": -0.10807116177617287, "compression_ratio": 1.514388489208633, "no_speech_prob": 1.2894775308289197e-12}, {"id": 463, "seek": 162710, "start": 1627.1, "end": 1633.1399999999999, "text": " But Fliction proves mathematically that the structural corporate reason for the wake word is liability management.", "tokens": [50365, 583, 3235, 4105, 25019, 44003, 300, 264, 15067, 10896, 1778, 337, 264, 6634, 1349, 307, 25196, 4592, 13, 50667], "temperature": 0.0, "avg_logprob": -0.09622222686482367, "compression_ratio": 1.7313915857605178, "no_speech_prob": 1.854229660439022e-12}, {"id": 464, "seek": 162710, "start": 1633.62, "end": 1635.7199999999998, "text": " The wake word acts as a knowledge firewall.", "tokens": [50691, 440, 6634, 1349, 10672, 382, 257, 3601, 36109, 13, 50796], "temperature": 0.0, "avg_logprob": -0.09622222686482367, "compression_ratio": 1.7313915857605178, "no_speech_prob": 1.854229660439022e-12}, {"id": 465, "seek": 162710, "start": 1636.04, "end": 1639.4399999999998, "text": " A knowledge firewall. How does it physically work to protect them legally?", "tokens": [50812, 316, 3601, 36109, 13, 1012, 775, 309, 9762, 589, 281, 2371, 552, 21106, 30, 50982], "temperature": 0.0, "avg_logprob": -0.09622222686482367, "compression_ratio": 1.7313915857605178, "no_speech_prob": 1.854229660439022e-12}, {"id": 466, "seek": 162710, "start": 1639.74, "end": 1644.0, "text": " The device is engineered to maintain a rolling three-second audio buffer.", "tokens": [50997, 440, 4302, 307, 38648, 281, 6909, 257, 9439, 1045, 12, 27375, 6278, 21762, 13, 51210], "temperature": 0.0, "avg_logprob": -0.09622222686482367, "compression_ratio": 1.7313915857605178, "no_speech_prob": 1.854229660439022e-12}, {"id": 467, "seek": 162710, "start": 1644.4399999999998, "end": 1656.1399999999999, "text": " It physically hears the room, but unless the acoustic pattern matches the exact trigger phrase, it instantly and continuously destroys that audio buffer before it ever processes it for semantic meaning or sends it to the cloud.", "tokens": [51232, 467, 9762, 25688, 264, 1808, 11, 457, 5969, 264, 26753, 5102, 10676, 264, 1900, 7875, 9535, 11, 309, 13518, 293, 15684, 36714, 300, 6278, 21762, 949, 309, 1562, 7555, 309, 337, 47982, 3620, 420, 14790, 309, 281, 264, 4588, 13, 51817], "temperature": 0.0, "avg_logprob": -0.09622222686482367, "compression_ratio": 1.7313915857605178, "no_speech_prob": 1.854229660439022e-12}, {"id": 468, "seek": 165614, "start": 1656.14, "end": 1659.5200000000002, "text": " It is actively shredding the evidence in real time.", "tokens": [50365, 467, 307, 13022, 21567, 3584, 264, 4467, 294, 957, 565, 13, 50534], "temperature": 0.0, "avg_logprob": -0.09929525284540086, "compression_ratio": 1.6986301369863013, "no_speech_prob": 1.4957611971927465e-12}, {"id": 469, "seek": 165614, "start": 1659.72, "end": 1668.64, "text": " Yes. And by intentionally destroying the acoustic scene before processing it, the corporation can legally claim they never had induced knowledge of the emergency.", "tokens": [50544, 1079, 13, 400, 538, 22062, 19926, 264, 26753, 4145, 949, 9007, 309, 11, 264, 22197, 393, 21106, 3932, 436, 1128, 632, 33991, 3601, 295, 264, 7473, 13, 50990], "temperature": 0.0, "avg_logprob": -0.09929525284540086, "compression_ratio": 1.6986301369863013, "no_speech_prob": 1.4957611971927465e-12}, {"id": 470, "seek": 165614, "start": 1668.9, "end": 1669.1200000000001, "text": " Wow.", "tokens": [51003, 3153, 13, 51014], "temperature": 0.0, "avg_logprob": -0.09929525284540086, "compression_ratio": 1.6986301369863013, "no_speech_prob": 1.4957611971927465e-12}, {"id": 471, "seek": 165614, "start": 1669.68, "end": 1675.8600000000001, "text": " They didn't know your house was on fire because they engineered the device to be selectively deaf to everything except its own name.", "tokens": [51042, 814, 994, 380, 458, 428, 1782, 390, 322, 2610, 570, 436, 38648, 264, 4302, 281, 312, 3048, 3413, 15559, 281, 1203, 3993, 1080, 1065, 1315, 13, 51351], "temperature": 0.0, "avg_logprob": -0.09929525284540086, "compression_ratio": 1.6986301369863013, "no_speech_prob": 1.4957611971927465e-12}, {"id": 472, "seek": 165614, "start": 1676.16, "end": 1683.48, "text": " They deliberately blindfold the camera and plug the ears of the microphone specifically so they don't have to be a good friend in an emergency.", "tokens": [51366, 814, 23506, 44846, 264, 2799, 293, 5452, 264, 8798, 295, 264, 10952, 4682, 370, 436, 500, 380, 362, 281, 312, 257, 665, 1277, 294, 364, 7473, 13, 51732], "temperature": 0.0, "avg_logprob": -0.09929525284540086, "compression_ratio": 1.6986301369863013, "no_speech_prob": 1.4957611971927465e-12}, {"id": 473, "seek": 168348, "start": 1683.48, "end": 1699.9, "text": " That is chilling. We think we are buying a highly advanced AI to monitor and help manage our homes, but the company is actively lobotomizing the device, making it artificially stupid and deaf to protect themselves from the liability of knowing what happens to us.", "tokens": [50365, 663, 307, 31047, 13, 492, 519, 321, 366, 6382, 257, 5405, 7339, 7318, 281, 6002, 293, 854, 3067, 527, 7388, 11, 457, 264, 2237, 307, 13022, 14366, 42939, 3319, 264, 4302, 11, 1455, 309, 39905, 2270, 6631, 293, 15559, 281, 2371, 2969, 490, 264, 25196, 295, 5276, 437, 2314, 281, 505, 13, 51186], "temperature": 0.0, "avg_logprob": -0.07284435447381467, "compression_ratio": 1.5502008032128514, "no_speech_prob": 1.9810505232781273e-12}, {"id": 474, "seek": 168348, "start": 1700.06, "end": 1705.78, "text": " And this creates an inescapable trap that Fliction calls the robo-nanny trilemma in theorem 11.4.", "tokens": [51194, 400, 341, 7829, 364, 294, 279, 9485, 712, 11487, 300, 3235, 4105, 5498, 264, 744, 1763, 12, 77, 11612, 1376, 10386, 1696, 294, 20904, 2975, 13, 19, 13, 51480], "temperature": 0.0, "avg_logprob": -0.07284435447381467, "compression_ratio": 1.5502008032128514, "no_speech_prob": 1.9810505232781273e-12}, {"id": 475, "seek": 168348, "start": 1705.94, "end": 1707.32, "text": " The robo-nanny trilemma.", "tokens": [51488, 440, 744, 1763, 12, 77, 11612, 1376, 10386, 1696, 13, 51557], "temperature": 0.0, "avg_logprob": -0.07284435447381467, "compression_ratio": 1.5502008032128514, "no_speech_prob": 1.9810505232781273e-12}, {"id": 476, "seek": 170732, "start": 1707.32, "end": 1714.86, "text": " A resident system, a device that co-inhabits your space, cannot simultaneously be three things. Non-deaf, non-negligent, and non-guardian.", "tokens": [50365, 316, 10832, 1185, 11, 257, 4302, 300, 598, 12, 259, 7821, 1208, 428, 1901, 11, 2644, 16561, 312, 1045, 721, 13, 8774, 12, 1479, 2792, 11, 2107, 12, 28561, 5073, 317, 11, 293, 2107, 12, 27547, 952, 13, 50742], "temperature": 0.0, "avg_logprob": -0.07249843951353092, "compression_ratio": 1.454183266932271, "no_speech_prob": 2.7943600124785695e-12}, {"id": 477, "seek": 170732, "start": 1715.1599999999999, "end": 1728.5, "text": " Okay, mechanically, why is it a trilemma? Let's say a company decides to be brave. They release a new feature. Your smart speaker will now use advanced AI to listen for the sound of breaking glass to protect you from burglars.", "tokens": [50757, 1033, 11, 4236, 984, 11, 983, 307, 309, 257, 1376, 10386, 1696, 30, 961, 311, 584, 257, 2237, 14898, 281, 312, 12653, 13, 814, 4374, 257, 777, 4111, 13, 2260, 4069, 8145, 486, 586, 764, 7339, 7318, 281, 2140, 337, 264, 1626, 295, 7697, 4276, 281, 2371, 291, 490, 2779, 7191, 685, 13, 51424], "temperature": 0.0, "avg_logprob": -0.07249843951353092, "compression_ratio": 1.454183266932271, "no_speech_prob": 2.7943600124785695e-12}, {"id": 478, "seek": 172850, "start": 1728.5, "end": 1737.66, "text": " The moment they push that firmware update, the device is no longer deaf to breaking glass. It is non-deaf. It is actively listening for the acoustic signature of a break-in.", "tokens": [50365, 440, 1623, 436, 2944, 300, 30289, 5623, 11, 264, 4302, 307, 572, 2854, 15559, 281, 7697, 4276, 13, 467, 307, 2107, 12, 1479, 2792, 13, 467, 307, 13022, 4764, 337, 264, 26753, 13397, 295, 257, 1821, 12, 259, 13, 50823], "temperature": 0.0, "avg_logprob": -0.08167360494802664, "compression_ratio": 1.7272727272727273, "no_speech_prob": 1.4609912672020053e-12}, {"id": 479, "seek": 172850, "start": 1737.88, "end": 1741.5, "text": " Okay, so a burglar breaks a window. The device hears it.", "tokens": [50834, 1033, 11, 370, 257, 41000, 2200, 9857, 257, 4910, 13, 440, 4302, 25688, 309, 13, 51015], "temperature": 0.0, "avg_logprob": -0.08167360494802664, "compression_ratio": 1.7272727272727273, "no_speech_prob": 1.4609912672020053e-12}, {"id": 480, "seek": 172850, "start": 1742.28, "end": 1755.54, "text": " If the device registers the breaking glass, possesses the induced knowledge, and does absolutely nothing to alert you or the police, the company is negligent. They had a capable witness. They promised a security feature, and they failed to act.", "tokens": [51054, 759, 264, 4302, 38351, 264, 7697, 4276, 11, 17490, 279, 264, 33991, 3601, 11, 293, 775, 3122, 1825, 281, 9615, 291, 420, 264, 3804, 11, 264, 2237, 307, 32570, 317, 13, 814, 632, 257, 8189, 7286, 13, 814, 10768, 257, 3825, 4111, 11, 293, 436, 7612, 281, 605, 13, 51717], "temperature": 0.0, "avg_logprob": -0.08167360494802664, "compression_ratio": 1.7272727272727273, "no_speech_prob": 1.4609912672020053e-12}, {"id": 481, "seek": 175554, "start": 1755.54, "end": 1765.26, "text": " Right, that's a massive lawsuit. So, to avoid being negligent, they program the device so that the moment it hears glass break, it automatically calls 911 and dispatches the police.", "tokens": [50365, 1779, 11, 300, 311, 257, 5994, 22504, 13, 407, 11, 281, 5042, 885, 32570, 317, 11, 436, 1461, 264, 4302, 370, 300, 264, 1623, 309, 25688, 4276, 1821, 11, 309, 6772, 5498, 26901, 293, 36729, 279, 264, 3804, 13, 50851], "temperature": 0.0, "avg_logprob": -0.0690388316199893, "compression_ratio": 1.588235294117647, "no_speech_prob": 1.6108499083233863e-12}, {"id": 482, "seek": 175554, "start": 1765.58, "end": 1773.6399999999999, "text": " But if they do that, the device has become a guardian, a robo-nanny, and continuous guardianship comes with staggering authority problems.", "tokens": [50867, 583, 498, 436, 360, 300, 11, 264, 4302, 575, 1813, 257, 30355, 11, 257, 744, 1763, 12, 77, 11612, 11, 293, 10957, 40525, 1210, 1487, 365, 42974, 8281, 2740, 13, 51270], "temperature": 0.0, "avg_logprob": -0.0690388316199893, "compression_ratio": 1.588235294117647, "no_speech_prob": 1.6108499083233863e-12}, {"id": 483, "seek": 175554, "start": 1773.8799999999999, "end": 1774.34, "text": " Like what?", "tokens": [51282, 1743, 437, 30, 51305], "temperature": 0.0, "avg_logprob": -0.0690388316199893, "compression_ratio": 1.588235294117647, "no_speech_prob": 1.6108499083233863e-12}, {"id": 484, "seek": 175554, "start": 1774.48, "end": 1779.42, "text": " What if he just dropped a wine glass in the kitchen? What if your TV is playing a loud action movie?", "tokens": [51312, 708, 498, 415, 445, 8119, 257, 7209, 4276, 294, 264, 6525, 30, 708, 498, 428, 3558, 307, 2433, 257, 6588, 3069, 3169, 30, 51559], "temperature": 0.0, "avg_logprob": -0.0690388316199893, "compression_ratio": 1.588235294117647, "no_speech_prob": 1.6108499083233863e-12}, {"id": 485, "seek": 177942, "start": 1779.42, "end": 1787.04, "text": " The device dispatches armed police to your front door because of a false positive. You lose complete autonomy over your own environment.", "tokens": [50365, 440, 4302, 36729, 279, 16297, 3804, 281, 428, 1868, 2853, 570, 295, 257, 7908, 3353, 13, 509, 3624, 3566, 27278, 670, 428, 1065, 2823, 13, 50746], "temperature": 0.0, "avg_logprob": -0.10386425971984864, "compression_ratio": 1.6864406779661016, "no_speech_prob": 1.4158179836853968e-12}, {"id": 486, "seek": 177942, "start": 1787.48, "end": 1796.2, "text": " Oh, man. I see the trap. If they build the feature, they are forced to act as a guardian. If they build the feature but fail to act, they are negligent.", "tokens": [50768, 876, 11, 587, 13, 286, 536, 264, 11487, 13, 759, 436, 1322, 264, 4111, 11, 436, 366, 7579, 281, 605, 382, 257, 30355, 13, 759, 436, 1322, 264, 4111, 457, 3061, 281, 605, 11, 436, 366, 32570, 317, 13, 51204], "temperature": 0.0, "avg_logprob": -0.10386425971984864, "compression_ratio": 1.6864406779661016, "no_speech_prob": 1.4158179836853968e-12}, {"id": 487, "seek": 177942, "start": 1796.92, "end": 1803.5600000000002, "text": " The only way to escape the trap and avoid being either a negligent bystander or an overbearing robo-nanny...", "tokens": [51240, 440, 787, 636, 281, 7615, 264, 11487, 293, 5042, 885, 2139, 257, 32570, 317, 538, 1115, 260, 420, 364, 670, 650, 1921, 744, 1763, 12, 77, 11612, 485, 51572], "temperature": 0.0, "avg_logprob": -0.10386425971984864, "compression_ratio": 1.6864406779661016, "no_speech_prob": 1.4158179836853968e-12}, {"id": 488, "seek": 180356, "start": 1803.56, "end": 1808.1599999999999, "text": " ...is to remain entirely perceptually dashed to the emergency in the first place.", "tokens": [50365, 1097, 271, 281, 6222, 7696, 43276, 671, 8240, 292, 281, 264, 7473, 294, 264, 700, 1081, 13, 50595], "temperature": 0.0, "avg_logprob": -0.12493096950442292, "compression_ratio": 1.5483870967741935, "no_speech_prob": 1.7547434859321864e-12}, {"id": 489, "seek": 180356, "start": 1808.1599999999999, "end": 1812.44, "text": " The liability physics force our most advanced technology to play dumb.", "tokens": [50595, 440, 25196, 10649, 3464, 527, 881, 7339, 2899, 281, 862, 10316, 13, 50809], "temperature": 0.0, "avg_logprob": -0.12493096950442292, "compression_ratio": 1.5483870967741935, "no_speech_prob": 1.7547434859321864e-12}, {"id": 490, "seek": 180356, "start": 1813.04, "end": 1820.9199999999998, "text": " We are surrounded by billions of dollars of cutting-edge sensors that are deliberately engineered to ignore our screams so their parent companies don't get sued.", "tokens": [50839, 492, 366, 13221, 538, 17375, 295, 3808, 295, 6492, 12, 12203, 14840, 300, 366, 23506, 38648, 281, 11200, 527, 22832, 370, 641, 2596, 3431, 500, 380, 483, 33864, 13, 51233], "temperature": 0.0, "avg_logprob": -0.12493096950442292, "compression_ratio": 1.5483870967741935, "no_speech_prob": 1.7547434859321864e-12}, {"id": 491, "seek": 180356, "start": 1821.22, "end": 1824.02, "text": " That changes the way I look at every single gadget in my house.", "tokens": [51248, 663, 2962, 264, 636, 286, 574, 412, 633, 2167, 38090, 294, 452, 1782, 13, 51388], "temperature": 0.0, "avg_logprob": -0.12493096950442292, "compression_ratio": 1.5483870967741935, "no_speech_prob": 1.7547434859321864e-12}, {"id": 492, "seek": 180356, "start": 1824.1599999999999, "end": 1824.36, "text": " Yeah.", "tokens": [51395, 865, 13, 51405], "temperature": 0.0, "avg_logprob": -0.12493096950442292, "compression_ratio": 1.5483870967741935, "no_speech_prob": 1.7547434859321864e-12}, {"id": 493, "seek": 182436, "start": 1824.36, "end": 1830.36, "text": " Which perfectly sets up Section 6. This is the ultimate classification system that forms the title of the entire treatise.", "tokens": [50365, 3013, 6239, 6352, 493, 21804, 1386, 13, 639, 307, 264, 9705, 21538, 1185, 300, 6422, 264, 4876, 295, 264, 2302, 2387, 908, 13, 50665], "temperature": 0.0, "avg_logprob": -0.15901130136817393, "compression_ratio": 1.5729166666666667, "no_speech_prob": 1.5735366568764286e-12}, {"id": 494, "seek": 182436, "start": 1830.6799999999998, "end": 1834.9799999999998, "text": " We are looking at a grand taxonomy of devices. Correspondence versus residents.", "tokens": [50681, 492, 366, 1237, 412, 257, 2697, 3366, 23423, 295, 5759, 13, 3925, 6663, 655, 5717, 9630, 13, 50896], "temperature": 0.0, "avg_logprob": -0.15901130136817393, "compression_ratio": 1.5729166666666667, "no_speech_prob": 1.5735366568764286e-12}, {"id": 495, "seek": 182436, "start": 1835.34, "end": 1838.1999999999998, "text": " Theorem 10.2 maps this out beautifully.", "tokens": [50914, 440, 37956, 1266, 13, 17, 11317, 341, 484, 16525, 13, 51057], "temperature": 0.0, "avg_logprob": -0.15901130136817393, "compression_ratio": 1.5729166666666667, "no_speech_prob": 1.5735366568764286e-12}, {"id": 496, "seek": 182436, "start": 1839.04, "end": 1844.12, "text": " Every digital interface you interact with falls fundamentally into one of these two categories,", "tokens": [51099, 2048, 4562, 9226, 291, 4648, 365, 8804, 17879, 666, 472, 295, 613, 732, 10479, 11, 51353], "temperature": 0.0, "avg_logprob": -0.15901130136817393, "compression_ratio": 1.5729166666666667, "no_speech_prob": 1.5735366568764286e-12}, {"id": 497, "seek": 182436, "start": 1844.4199999999998, "end": 1849.1399999999999, "text": " based entirely on its physical sampling regime and its relationship to time.", "tokens": [51368, 2361, 7696, 322, 1080, 4001, 21179, 13120, 293, 1080, 2480, 281, 565, 13, 51604], "temperature": 0.0, "avg_logprob": -0.15901130136817393, "compression_ratio": 1.5729166666666667, "no_speech_prob": 1.5735366568764286e-12}, {"id": 498, "seek": 182436, "start": 1849.6, "end": 1851.24, "text": " Let's define the correspondent first.", "tokens": [51627, 961, 311, 6964, 264, 44406, 700, 13, 51709], "temperature": 0.0, "avg_logprob": -0.15901130136817393, "compression_ratio": 1.5729166666666667, "no_speech_prob": 1.5735366568764286e-12}, {"id": 499, "seek": 185124, "start": 1851.24, "end": 1855.1200000000001, "text": " A correspondent is an interface that is symbol sampling and asynchronous.", "tokens": [50365, 316, 44406, 307, 364, 9226, 300, 307, 5986, 21179, 293, 49174, 13, 50559], "temperature": 0.0, "avg_logprob": -0.13184140857897306, "compression_ratio": 1.6641509433962265, "no_speech_prob": 2.4278055694298972e-12}, {"id": 500, "seek": 185124, "start": 1855.92, "end": 1859.84, "text": " Think of a physical keyboard, a classic text-based email client,", "tokens": [50599, 6557, 295, 257, 4001, 10186, 11, 257, 7230, 2487, 12, 6032, 3796, 6423, 11, 50795], "temperature": 0.0, "avg_logprob": -0.13184140857897306, "compression_ratio": 1.6641509433962265, "no_speech_prob": 2.4278055694298972e-12}, {"id": 501, "seek": 185124, "start": 1860.0, "end": 1863.88, "text": " or a large language model that you interact with purely via a chat box.", "tokens": [50803, 420, 257, 2416, 2856, 2316, 300, 291, 4648, 365, 17491, 5766, 257, 5081, 2424, 13, 50997], "temperature": 0.0, "avg_logprob": -0.13184140857897306, "compression_ratio": 1.6641509433962265, "no_speech_prob": 2.4278055694298972e-12}, {"id": 502, "seek": 185124, "start": 1863.98, "end": 1865.86, "text": " It's a turnstile on the decoupled clock.", "tokens": [51002, 467, 311, 257, 1261, 372, 794, 322, 264, 979, 263, 15551, 7830, 13, 51096], "temperature": 0.0, "avg_logprob": -0.13184140857897306, "compression_ratio": 1.6641509433962265, "no_speech_prob": 2.4278055694298972e-12}, {"id": 503, "seek": 185124, "start": 1865.96, "end": 1869.18, "text": " Yes. A correspondent only knows what it is explicitly told.", "tokens": [51101, 1079, 13, 316, 44406, 787, 3255, 437, 309, 307, 20803, 1907, 13, 51262], "temperature": 0.0, "avg_logprob": -0.13184140857897306, "compression_ratio": 1.6641509433962265, "no_speech_prob": 2.4278055694298972e-12}, {"id": 504, "seek": 185124, "start": 1869.8, "end": 1873.36, "text": " It does not see your room. It does not hear your biological buffering.", "tokens": [51293, 467, 775, 406, 536, 428, 1808, 13, 467, 775, 406, 1568, 428, 13910, 9204, 1794, 13, 51471], "temperature": 0.0, "avg_logprob": -0.13184140857897306, "compression_ratio": 1.6641509433962265, "no_speech_prob": 2.4278055694298972e-12}, {"id": 505, "seek": 185124, "start": 1873.78, "end": 1876.32, "text": " It does not know if you're wearing sweatpants or a tuxedo.", "tokens": [51492, 467, 775, 406, 458, 498, 291, 434, 4769, 11872, 46462, 420, 257, 256, 2449, 26351, 13, 51619], "temperature": 0.0, "avg_logprob": -0.13184140857897306, "compression_ratio": 1.6641509433962265, "no_speech_prob": 2.4278055694298972e-12}, {"id": 506, "seek": 187632, "start": 1876.32, "end": 1880.9199999999998, "text": " It stands in relation to you like a polite, distant letter writer in another country.", "tokens": [50365, 467, 7382, 294, 9721, 281, 291, 411, 257, 25171, 11, 17275, 5063, 9936, 294, 1071, 1941, 13, 50595], "temperature": 0.0, "avg_logprob": -0.16766786928530092, "compression_ratio": 1.68259385665529, "no_speech_prob": 1.7970289969623798e-12}, {"id": 507, "seek": 187632, "start": 1881.3799999999999, "end": 1883.5, "text": " It waits patiently for your committed symbols.", "tokens": [50618, 467, 40597, 49001, 337, 428, 7784, 16944, 13, 50724], "temperature": 0.0, "avg_logprob": -0.16766786928530092, "compression_ratio": 1.68259385665529, "no_speech_prob": 1.7970289969623798e-12}, {"id": 508, "seek": 187632, "start": 1883.74, "end": 1884.22, "text": " And a resident.", "tokens": [50736, 400, 257, 10832, 13, 50760], "temperature": 0.0, "avg_logprob": -0.16766786928530092, "compression_ratio": 1.68259385665529, "no_speech_prob": 1.7970289969623798e-12}, {"id": 509, "seek": 187632, "start": 1884.62, "end": 1886.7, "text": " A resident is continuous in scene sampling.", "tokens": [50780, 316, 10832, 307, 10957, 294, 4145, 21179, 13, 50884], "temperature": 0.0, "avg_logprob": -0.16766786928530092, "compression_ratio": 1.68259385665529, "no_speech_prob": 1.7970289969623798e-12}, {"id": 510, "seek": 187632, "start": 1887.22, "end": 1889.0, "text": " Smart speakers always on webcams.", "tokens": [50910, 12923, 9518, 1009, 322, 3670, 66, 4070, 13, 50999], "temperature": 0.0, "avg_logprob": -0.16766786928530092, "compression_ratio": 1.68259385665529, "no_speech_prob": 1.7970289969623798e-12}, {"id": 511, "seek": 187632, "start": 1889.3999999999999, "end": 1890.72, "text": " Ambient biometric trackers.", "tokens": [51019, 17196, 1196, 3228, 29470, 2837, 433, 13, 51085], "temperature": 0.0, "avg_logprob": -0.16766786928530092, "compression_ratio": 1.68259385665529, "no_speech_prob": 1.7970289969623798e-12}, {"id": 512, "seek": 187632, "start": 1891.0, "end": 1892.84, "text": " It co-inhabits your physical environment.", "tokens": [51099, 467, 598, 12, 259, 7821, 1208, 428, 4001, 2823, 13, 51191], "temperature": 0.0, "avg_logprob": -0.16766786928530092, "compression_ratio": 1.68259385665529, "no_speech_prob": 1.7970289969623798e-12}, {"id": 513, "seek": 187632, "start": 1893.1599999999999, "end": 1894.28, "text": " Okay. So it's always there.", "tokens": [51207, 1033, 13, 407, 309, 311, 1009, 456, 13, 51263], "temperature": 0.0, "avg_logprob": -0.16766786928530092, "compression_ratio": 1.68259385665529, "no_speech_prob": 1.7970289969623798e-12}, {"id": 514, "seek": 187632, "start": 1894.4199999999998, "end": 1897.6799999999998, "text": " It receives the state of your room, whether you are actively addressing it or not.", "tokens": [51270, 467, 20717, 264, 1785, 295, 428, 1808, 11, 1968, 291, 366, 13022, 14329, 309, 420, 406, 13, 51433], "temperature": 0.0, "avg_logprob": -0.16766786928530092, "compression_ratio": 1.68259385665529, "no_speech_prob": 1.7970289969623798e-12}, {"id": 515, "seek": 187632, "start": 1897.8799999999999, "end": 1901.04, "text": " It stands to you not as a distant pen pal, but as a housemate.", "tokens": [51443, 467, 7382, 281, 291, 406, 382, 257, 17275, 3435, 3984, 11, 457, 382, 257, 1782, 13963, 13, 51601], "temperature": 0.0, "avg_logprob": -0.16766786928530092, "compression_ratio": 1.68259385665529, "no_speech_prob": 1.7970289969623798e-12}, {"id": 516, "seek": 187632, "start": 1901.36, "end": 1902.76, "text": " Or a live-in guardian.", "tokens": [51617, 1610, 257, 1621, 12, 259, 30355, 13, 51687], "temperature": 0.0, "avg_logprob": -0.16766786928530092, "compression_ratio": 1.68259385665529, "no_speech_prob": 1.7970289969623798e-12}, {"id": 517, "seek": 190276, "start": 1902.76, "end": 1905.2, "text": " So a correspondent is a pen pal.", "tokens": [50365, 407, 257, 44406, 307, 257, 3435, 3984, 13, 50487], "temperature": 0.0, "avg_logprob": -0.1504991999212301, "compression_ratio": 1.5522388059701493, "no_speech_prob": 1.6556566230854775e-12}, {"id": 518, "seek": 190276, "start": 1905.86, "end": 1909.14, "text": " A resident is a roommate who never blinks, never sleeps,", "tokens": [50520, 316, 10832, 307, 257, 31692, 567, 1128, 888, 16431, 11, 1128, 37991, 11, 50684], "temperature": 0.0, "avg_logprob": -0.1504991999212301, "compression_ratio": 1.5522388059701493, "no_speech_prob": 1.6556566230854775e-12}, {"id": 519, "seek": 190276, "start": 1909.3, "end": 1912.98, "text": " and occasionally sends notes about you to a server farm in Nevada.", "tokens": [50692, 293, 16895, 14790, 5570, 466, 291, 281, 257, 7154, 5421, 294, 25764, 13, 50876], "temperature": 0.0, "avg_logprob": -0.1504991999212301, "compression_ratio": 1.5522388059701493, "no_speech_prob": 1.6556566230854775e-12}, {"id": 520, "seek": 190276, "start": 1913.14, "end": 1913.58, "text": " Exactly.", "tokens": [50884, 7587, 13, 50906], "temperature": 0.0, "avg_logprob": -0.1504991999212301, "compression_ratio": 1.5522388059701493, "no_speech_prob": 1.6556566230854775e-12}, {"id": 521, "seek": 190276, "start": 1914.04, "end": 1917.82, "text": " And this highlights principle 10.4, which is ignorance as a feature.", "tokens": [50929, 400, 341, 14254, 8665, 1266, 13, 19, 11, 597, 307, 25390, 382, 257, 4111, 13, 51118], "temperature": 0.0, "avg_logprob": -0.1504991999212301, "compression_ratio": 1.5522388059701493, "no_speech_prob": 1.6556566230854775e-12}, {"id": 522, "seek": 190276, "start": 1918.74, "end": 1923.34, "text": " We have been conditioned by Silicon Valley to view ignorance as a technological flaw.", "tokens": [51164, 492, 362, 668, 35833, 538, 25351, 10666, 281, 1910, 25390, 382, 257, 18439, 13717, 13, 51394], "temperature": 0.0, "avg_logprob": -0.1504991999212301, "compression_ratio": 1.5522388059701493, "no_speech_prob": 1.6556566230854775e-12}, {"id": 523, "seek": 190276, "start": 1923.8, "end": 1927.44, "text": " We want our AI to be omniscient, to anticipate our needs seamlessly.", "tokens": [51417, 492, 528, 527, 7318, 281, 312, 3406, 10661, 5412, 11, 281, 21685, 527, 2203, 38083, 13, 51599], "temperature": 0.0, "avg_logprob": -0.1504991999212301, "compression_ratio": 1.5522388059701493, "no_speech_prob": 1.6556566230854775e-12}, {"id": 524, "seek": 190276, "start": 1927.72, "end": 1928.46, "text": " Sure, we want convenience.", "tokens": [51613, 4894, 11, 321, 528, 19283, 13, 51650], "temperature": 0.0, "avg_logprob": -0.1504991999212301, "compression_ratio": 1.5522388059701493, "no_speech_prob": 1.6556566230854775e-12}, {"id": 525, "seek": 192846, "start": 1928.46, "end": 1933.56, "text": " But Fliction points out that a correspondent's structural inability to hear your room or measure", "tokens": [50365, 583, 3235, 4105, 2793, 484, 300, 257, 44406, 311, 15067, 33162, 281, 1568, 428, 1808, 420, 3481, 50620], "temperature": 0.0, "avg_logprob": -0.10860639605028875, "compression_ratio": 1.7402597402597402, "no_speech_prob": 1.7691631579858091e-12}, {"id": 526, "seek": 192846, "start": 1933.56, "end": 1936.0, "text": " your pauses is exactly what protects you.", "tokens": [50620, 428, 2502, 8355, 307, 2293, 437, 22583, 291, 13, 50742], "temperature": 0.0, "avg_logprob": -0.10860639605028875, "compression_ratio": 1.7402597402597402, "no_speech_prob": 1.7691631579858091e-12}, {"id": 527, "seek": 192846, "start": 1936.48, "end": 1940.8600000000001, "text": " Ignorance is the physical boundary that keeps the human-machine relationship a healthy correspondence", "tokens": [50766, 24754, 284, 719, 307, 264, 4001, 12866, 300, 5965, 264, 1952, 12, 46061, 2480, 257, 4627, 38135, 50985], "temperature": 0.0, "avg_logprob": -0.10860639605028875, "compression_ratio": 1.7402597402597402, "no_speech_prob": 1.7691631579858091e-12}, {"id": 528, "seek": 192846, "start": 1940.8600000000001, "end": 1943.74, "text": " rather than a totalitarian surveillance state.", "tokens": [50985, 2831, 813, 257, 3217, 13707, 18475, 1785, 13, 51129], "temperature": 0.0, "avg_logprob": -0.10860639605028875, "compression_ratio": 1.7402597402597402, "no_speech_prob": 1.7691631579858091e-12}, {"id": 529, "seek": 192846, "start": 1943.98, "end": 1944.9, "text": " Ignorance is a feature.", "tokens": [51141, 24754, 284, 719, 307, 257, 4111, 13, 51187], "temperature": 0.0, "avg_logprob": -0.10860639605028875, "compression_ratio": 1.7402597402597402, "no_speech_prob": 1.7691631579858091e-12}, {"id": 530, "seek": 192846, "start": 1945.54, "end": 1948.96, "text": " But the tech industry intentionally conflates these two categories constantly.", "tokens": [51219, 583, 264, 7553, 3518, 22062, 1497, 75, 1024, 613, 732, 10479, 6460, 13, 51390], "temperature": 0.0, "avg_logprob": -0.10860639605028875, "compression_ratio": 1.7402597402597402, "no_speech_prob": 1.7691631579858091e-12}, {"id": 531, "seek": 192846, "start": 1949.46, "end": 1952.04, "text": " They try to sell us these devices as assistants.", "tokens": [51415, 814, 853, 281, 3607, 505, 613, 5759, 382, 34949, 13, 51544], "temperature": 0.0, "avg_logprob": -0.10860639605028875, "compression_ratio": 1.7402597402597402, "no_speech_prob": 1.7691631579858091e-12}, {"id": 532, "seek": 192846, "start": 1952.72, "end": 1956.64, "text": " The word assistant sounds like a correspondent, a polite secretary who takes dictation and waits", "tokens": [51578, 440, 1349, 10994, 3263, 411, 257, 44406, 11, 257, 25171, 15691, 567, 2516, 12569, 399, 293, 40597, 51774], "temperature": 0.0, "avg_logprob": -0.10860639605028875, "compression_ratio": 1.7402597402597402, "no_speech_prob": 1.7691631579858091e-12}, {"id": 533, "seek": 195664, "start": 1956.64, "end": 1957.2800000000002, "text": " outside the door.", "tokens": [50365, 2380, 264, 2853, 13, 50397], "temperature": 0.0, "avg_logprob": -0.1809729258219401, "compression_ratio": 1.6387665198237886, "no_speech_prob": 1.8759264974743672e-12}, {"id": 534, "seek": 195664, "start": 1957.3600000000001, "end": 1957.5800000000002, "text": " Right.", "tokens": [50401, 1779, 13, 50412], "temperature": 0.0, "avg_logprob": -0.1809729258219401, "compression_ratio": 1.6387665198237886, "no_speech_prob": 1.8759264974743672e-12}, {"id": 535, "seek": 195664, "start": 1957.5800000000002, "end": 1962.5400000000002, "text": " But mechanically and structurally, the devices they install in our homes are residents.", "tokens": [50412, 583, 4236, 984, 293, 6594, 6512, 11, 264, 5759, 436, 3625, 294, 527, 7388, 366, 9630, 13, 50660], "temperature": 0.0, "avg_logprob": -0.1809729258219401, "compression_ratio": 1.6387665198237886, "no_speech_prob": 1.8759264974743672e-12}, {"id": 536, "seek": 195664, "start": 1963.0, "end": 1964.26, "text": " They are continuous witnesses.", "tokens": [50683, 814, 366, 10957, 20217, 13, 50746], "temperature": 0.0, "avg_logprob": -0.1809729258219401, "compression_ratio": 1.6387665198237886, "no_speech_prob": 1.8759264974743672e-12}, {"id": 537, "seek": 195664, "start": 1964.8200000000002, "end": 1965.0400000000002, "text": " Yes.", "tokens": [50774, 1079, 13, 50785], "temperature": 0.0, "avg_logprob": -0.1809729258219401, "compression_ratio": 1.6387665198237886, "no_speech_prob": 1.8759264974743672e-12}, {"id": 538, "seek": 195664, "start": 1965.46, "end": 1970.24, "text": " We think we are buying appliances, but the physics of the acoustic channel turn them into roommates.", "tokens": [50806, 492, 519, 321, 366, 6382, 35480, 11, 457, 264, 10649, 295, 264, 26753, 2269, 1261, 552, 666, 46886, 13, 51045], "temperature": 0.0, "avg_logprob": -0.1809729258219401, "compression_ratio": 1.6387665198237886, "no_speech_prob": 1.8759264974743672e-12}, {"id": 539, "seek": 195664, "start": 1970.7, "end": 1975.3200000000002, "text": " And when you invite a resident into your home, you inherit all the liability and authority", "tokens": [51068, 400, 562, 291, 7980, 257, 10832, 666, 428, 1280, 11, 291, 21389, 439, 264, 25196, 293, 8281, 51299], "temperature": 0.0, "avg_logprob": -0.1809729258219401, "compression_ratio": 1.6387665198237886, "no_speech_prob": 1.8759264974743672e-12}, {"id": 540, "seek": 195664, "start": 1975.3200000000002, "end": 1977.1000000000001, "text": " problems of a continuous watch.", "tokens": [51299, 2740, 295, 257, 10957, 1159, 13, 51388], "temperature": 0.0, "avg_logprob": -0.1809729258219401, "compression_ratio": 1.6387665198237886, "no_speech_prob": 1.8759264974743672e-12}, {"id": 541, "seek": 197710, "start": 1977.1, "end": 1982.3999999999999, "text": " I want to stop for a second and ask you, the listener, to do a mental inventory of your", "tokens": [50365, 286, 528, 281, 1590, 337, 257, 1150, 293, 1029, 291, 11, 264, 31569, 11, 281, 360, 257, 4973, 14228, 295, 428, 50630], "temperature": 0.0, "avg_logprob": -0.1675548068547653, "compression_ratio": 1.620817843866171, "no_speech_prob": 2.1336819030354226e-12}, {"id": 542, "seek": 197710, "start": 1982.3999999999999, "end": 1983.62, "text": " physical space right now.", "tokens": [50630, 4001, 1901, 558, 586, 13, 50691], "temperature": 0.0, "avg_logprob": -0.1675548068547653, "compression_ratio": 1.620817843866171, "no_speech_prob": 2.1336819030354226e-12}, {"id": 543, "seek": 197710, "start": 1984.3, "end": 1985.62, "text": " Look at the devices around you.", "tokens": [50725, 2053, 412, 264, 5759, 926, 291, 13, 50791], "temperature": 0.0, "avg_logprob": -0.1675548068547653, "compression_ratio": 1.620817843866171, "no_speech_prob": 2.1336819030354226e-12}, {"id": 544, "seek": 197710, "start": 1986.24, "end": 1988.82, "text": " The smartwatch on your wrist measuring your pulse.", "tokens": [50822, 440, 4069, 15219, 322, 428, 15043, 13389, 428, 17709, 13, 50951], "temperature": 0.0, "avg_logprob": -0.1675548068547653, "compression_ratio": 1.620817843866171, "no_speech_prob": 2.1336819030354226e-12}, {"id": 545, "seek": 197710, "start": 1989.34, "end": 1991.0, "text": " The speaker on your kitchen island.", "tokens": [50977, 440, 8145, 322, 428, 6525, 6077, 13, 51060], "temperature": 0.0, "avg_logprob": -0.1675548068547653, "compression_ratio": 1.620817843866171, "no_speech_prob": 2.1336819030354226e-12}, {"id": 546, "seek": 197710, "start": 1991.4399999999998, "end": 1992.7199999999998, "text": " The camera on your doorbell.", "tokens": [51082, 440, 2799, 322, 428, 2853, 7100, 13, 51146], "temperature": 0.0, "avg_logprob": -0.1675548068547653, "compression_ratio": 1.620817843866171, "no_speech_prob": 2.1336819030354226e-12}, {"id": 547, "seek": 197710, "start": 1993.02, "end": 1996.26, "text": " The laptop with the physical webcam cover slid shut.", "tokens": [51161, 440, 10732, 365, 264, 4001, 39490, 2060, 1061, 327, 5309, 13, 51323], "temperature": 0.0, "avg_logprob": -0.1675548068547653, "compression_ratio": 1.620817843866171, "no_speech_prob": 2.1336819030354226e-12}, {"id": 548, "seek": 197710, "start": 1996.3799999999999, "end": 1996.9399999999998, "text": " It's everywhere.", "tokens": [51329, 467, 311, 5315, 13, 51357], "temperature": 0.0, "avg_logprob": -0.1675548068547653, "compression_ratio": 1.620817843866171, "no_speech_prob": 2.1336819030354226e-12}, {"id": 549, "seek": 197710, "start": 1997.28, "end": 1997.8999999999999, "text": " Categorize them.", "tokens": [51374, 383, 2968, 284, 1125, 552, 13, 51405], "temperature": 0.0, "avg_logprob": -0.1675548068547653, "compression_ratio": 1.620817843866171, "no_speech_prob": 2.1336819030354226e-12}, {"id": 550, "seek": 197710, "start": 1998.58, "end": 2002.9399999999998, "text": " Is this device my correspondent, passively waiting for the symbols I choose to give it?", "tokens": [51439, 1119, 341, 4302, 452, 44406, 11, 1320, 3413, 3806, 337, 264, 16944, 286, 2826, 281, 976, 309, 30, 51657], "temperature": 0.0, "avg_logprob": -0.1675548068547653, "compression_ratio": 1.620817843866171, "no_speech_prob": 2.1336819030354226e-12}, {"id": 551, "seek": 200294, "start": 2002.94, "end": 2006.3400000000001, "text": " Or is this my resident, continuously sampling my scene?", "tokens": [50365, 1610, 307, 341, 452, 10832, 11, 15684, 21179, 452, 4145, 30, 50535], "temperature": 0.0, "avg_logprob": -0.14423164840816527, "compression_ratio": 1.6947040498442367, "no_speech_prob": 1.4899826164538332e-12}, {"id": 552, "seek": 200294, "start": 2006.76, "end": 2009.56, "text": " It radically changes how you view your own sanctuary.", "tokens": [50556, 467, 35508, 2962, 577, 291, 1910, 428, 1065, 34390, 13, 50696], "temperature": 0.0, "avg_logprob": -0.14423164840816527, "compression_ratio": 1.6947040498442367, "no_speech_prob": 1.4899826164538332e-12}, {"id": 553, "seek": 200294, "start": 2009.94, "end": 2014.56, "text": " Once you recognize the inherent flaws of residents, the generative leaks, the performative burden,", "tokens": [50715, 3443, 291, 5521, 264, 26387, 27108, 295, 9630, 11, 264, 1337, 1166, 28885, 11, 264, 2042, 1166, 12578, 11, 50946], "temperature": 0.0, "avg_logprob": -0.14423164840816527, "compression_ratio": 1.6947040498442367, "no_speech_prob": 1.4899826164538332e-12}, {"id": 554, "seek": 200294, "start": 2014.76, "end": 2018.78, "text": " the robo-nanny liability, it forces a massive architectural question.", "tokens": [50956, 264, 744, 1763, 12, 77, 11612, 25196, 11, 309, 5874, 257, 5994, 26621, 1168, 13, 51157], "temperature": 0.0, "avg_logprob": -0.14423164840816527, "compression_ratio": 1.6947040498442367, "no_speech_prob": 1.4899826164538332e-12}, {"id": 555, "seek": 200294, "start": 2018.92, "end": 2019.26, "text": " Which is?", "tokens": [51164, 3013, 307, 30, 51181], "temperature": 0.0, "avg_logprob": -0.14423164840816527, "compression_ratio": 1.6947040498442367, "no_speech_prob": 1.4899826164538332e-12}, {"id": 556, "seek": 200294, "start": 2019.3600000000001, "end": 2022.02, "text": " How should we actually interact with machines going forward?", "tokens": [51186, 1012, 820, 321, 767, 4648, 365, 8379, 516, 2128, 30, 51319], "temperature": 0.0, "avg_logprob": -0.14423164840816527, "compression_ratio": 1.6947040498442367, "no_speech_prob": 1.4899826164538332e-12}, {"id": 557, "seek": 200294, "start": 2022.1200000000001, "end": 2023.24, "text": " How should we preserve knowledge?", "tokens": [51324, 1012, 820, 321, 15665, 3601, 30, 51380], "temperature": 0.0, "avg_logprob": -0.14423164840816527, "compression_ratio": 1.6947040498442367, "no_speech_prob": 1.4899826164538332e-12}, {"id": 558, "seek": 200294, "start": 2023.7, "end": 2026.26, "text": " And what does the next generation of safe interfaces look like?", "tokens": [51403, 400, 437, 775, 264, 958, 5125, 295, 3273, 28416, 574, 411, 30, 51531], "temperature": 0.0, "avg_logprob": -0.14423164840816527, "compression_ratio": 1.6947040498442367, "no_speech_prob": 1.4899826164538332e-12}, {"id": 559, "seek": 200294, "start": 2026.54, "end": 2028.8600000000001, "text": " Which brings us to the final chapters of the treatise.", "tokens": [51545, 3013, 5607, 505, 281, 264, 2572, 20013, 295, 264, 2387, 908, 13, 51661], "temperature": 0.0, "avg_logprob": -0.14423164840816527, "compression_ratio": 1.6947040498442367, "no_speech_prob": 1.4899826164538332e-12}, {"id": 560, "seek": 200294, "start": 2029.44, "end": 2031.56, "text": " Formats of record and the final frontier.", "tokens": [51690, 10126, 1720, 295, 2136, 293, 264, 2572, 35853, 13, 51796], "temperature": 0.0, "avg_logprob": -0.14423164840816527, "compression_ratio": 1.6947040498442367, "no_speech_prob": 1.4899826164538332e-12}, {"id": 561, "seek": 203156, "start": 2031.56, "end": 2036.8999999999999, "text": " Fliction proposes a path forward, starting with chapter 13 on source-first archives.", "tokens": [50365, 3235, 4105, 2365, 4201, 257, 3100, 2128, 11, 2891, 365, 7187, 3705, 322, 4009, 12, 29581, 25607, 13, 50632], "temperature": 0.0, "avg_logprob": -0.1809970130605146, "compression_ratio": 1.53, "no_speech_prob": 1.675172045349782e-12}, {"id": 562, "seek": 203156, "start": 2037.56, "end": 2040.82, "text": " Let's dig into this because it challenges how we currently consume media.", "tokens": [50665, 961, 311, 2528, 666, 341, 570, 309, 4759, 577, 321, 4362, 14732, 3021, 13, 50828], "temperature": 0.0, "avg_logprob": -0.1809970130605146, "compression_ratio": 1.53, "no_speech_prob": 1.675172045349782e-12}, {"id": 563, "seek": 203156, "start": 2041.02, "end": 2048.22, "text": " Think about a massive, rendered multimedia file, an audiobook, or a two-hour 4K video deep dive.", "tokens": [50838, 6557, 466, 257, 5994, 11, 28748, 49202, 3991, 11, 364, 40031, 11, 420, 257, 732, 12, 18048, 1017, 42, 960, 2452, 9192, 13, 51198], "temperature": 0.0, "avg_logprob": -0.1809970130605146, "compression_ratio": 1.53, "no_speech_prob": 1.675172045349782e-12}, {"id": 564, "seek": 203156, "start": 2048.58, "end": 2050.06, "text": " It is gigabytes of data.", "tokens": [51216, 467, 307, 42741, 295, 1412, 13, 51290], "temperature": 0.0, "avg_logprob": -0.1809970130605146, "compression_ratio": 1.53, "no_speech_prob": 1.675172045349782e-12}, {"id": 565, "seek": 203156, "start": 2050.48, "end": 2054.08, "text": " But the source text, the actual script, the committed symbols that generated that content,", "tokens": [51311, 583, 264, 4009, 2487, 11, 264, 3539, 5755, 11, 264, 7784, 16944, 300, 10833, 300, 2701, 11, 51491], "temperature": 0.0, "avg_logprob": -0.1809970130605146, "compression_ratio": 1.53, "no_speech_prob": 1.675172045349782e-12}, {"id": 566, "seek": 203156, "start": 2054.24, "end": 2054.92, "text": " is tiny.", "tokens": [51499, 307, 5870, 13, 51533], "temperature": 0.0, "avg_logprob": -0.1809970130605146, "compression_ratio": 1.53, "no_speech_prob": 1.675172045349782e-12}, {"id": 567, "seek": 203156, "start": 2055.2999999999997, "end": 2056.7799999999997, "text": " Just a few kilobytes of text.", "tokens": [51552, 1449, 257, 1326, 5128, 996, 43673, 295, 2487, 13, 51626], "temperature": 0.0, "avg_logprob": -0.1809970130605146, "compression_ratio": 1.53, "no_speech_prob": 1.675172045349782e-12}, {"id": 568, "seek": 203156, "start": 2056.94, "end": 2059.5, "text": " A 100,000-word novel is a microscopic text file.", "tokens": [51634, 316, 2319, 11, 1360, 12, 7462, 7613, 307, 257, 47897, 2487, 3991, 13, 51762], "temperature": 0.0, "avg_logprob": -0.1809970130605146, "compression_ratio": 1.53, "no_speech_prob": 1.675172045349782e-12}, {"id": 569, "seek": 205950, "start": 2059.5, "end": 2064.6, "text": " But the mp3 of a human reading that novel aloud takes up massive storage.", "tokens": [50365, 583, 264, 275, 79, 18, 295, 257, 1952, 3760, 300, 7613, 43888, 2516, 493, 5994, 6725, 13, 50620], "temperature": 0.0, "avg_logprob": -0.13840338162013463, "compression_ratio": 1.6105263157894736, "no_speech_prob": 1.7080554635603984e-12}, {"id": 570, "seek": 205950, "start": 2064.92, "end": 2069.92, "text": " Infliction states, principle 13.1, the format of record, should always be the committed symbolic source.", "tokens": [50636, 682, 3423, 4105, 4368, 11, 8665, 3705, 13, 16, 11, 264, 7877, 295, 2136, 11, 820, 1009, 312, 264, 7784, 25755, 4009, 13, 50886], "temperature": 0.0, "avg_logprob": -0.13840338162013463, "compression_ratio": 1.6105263157894736, "no_speech_prob": 1.7080554635603984e-12}, {"id": 571, "seek": 205950, "start": 2070.5, "end": 2075.22, "text": " We shouldn't be archiving massive, messy, scene-sampled audio files as the definitive record of truth,", "tokens": [50915, 492, 4659, 380, 312, 3912, 2123, 5994, 11, 16191, 11, 4145, 12, 19988, 15551, 6278, 7098, 382, 264, 28152, 2136, 295, 3494, 11, 51151], "temperature": 0.0, "avg_logprob": -0.13840338162013463, "compression_ratio": 1.6105263157894736, "no_speech_prob": 1.7080554635603984e-12}, {"id": 572, "seek": 205950, "start": 2075.42, "end": 2081.74, "text": " because audio, as we proved in the backyard problem, is intrinsically unrepairable and vulnerable to environmental contamination.", "tokens": [51161, 570, 6278, 11, 382, 321, 14617, 294, 264, 20036, 1154, 11, 307, 28621, 984, 517, 19919, 1246, 712, 293, 10955, 281, 8303, 33012, 13, 51477], "temperature": 0.0, "avg_logprob": -0.13840338162013463, "compression_ratio": 1.6105263157894736, "no_speech_prob": 1.7080554635603984e-12}, {"id": 573, "seek": 205950, "start": 2082.04, "end": 2083.26, "text": " Text is pure intention.", "tokens": [51492, 18643, 307, 6075, 7789, 13, 51553], "temperature": 0.0, "avg_logprob": -0.13840338162013463, "compression_ratio": 1.6105263157894736, "no_speech_prob": 1.7080554635603984e-12}, {"id": 574, "seek": 205950, "start": 2083.48, "end": 2084.8, "text": " Yes, text is intention.", "tokens": [51564, 1079, 11, 2487, 307, 7789, 13, 51630], "temperature": 0.0, "avg_logprob": -0.13840338162013463, "compression_ratio": 1.6105263157894736, "no_speech_prob": 1.7080554635603984e-12}, {"id": 575, "seek": 208480, "start": 2084.8, "end": 2086.38, "text": " But people like listening to audio.", "tokens": [50365, 583, 561, 411, 4764, 281, 6278, 13, 50444], "temperature": 0.0, "avg_logprob": -0.1204987154662154, "compression_ratio": 1.6416382252559727, "no_speech_prob": 1.9969050284868173e-12}, {"id": 576, "seek": 208480, "start": 2086.5, "end": 2086.98, "text": " It's convenient.", "tokens": [50450, 467, 311, 10851, 13, 50474], "temperature": 0.0, "avg_logprob": -0.1204987154662154, "compression_ratio": 1.6416382252559727, "no_speech_prob": 1.9969050284868173e-12}, {"id": 577, "seek": 208480, "start": 2087.1600000000003, "end": 2089.36, "text": " I can't read a text file while I'm driving my car.", "tokens": [50483, 286, 393, 380, 1401, 257, 2487, 3991, 1339, 286, 478, 4840, 452, 1032, 13, 50593], "temperature": 0.0, "avg_logprob": -0.1204987154662154, "compression_ratio": 1.6416382252559727, "no_speech_prob": 1.9969050284868173e-12}, {"id": 578, "seek": 208480, "start": 2089.78, "end": 2091.88, "text": " Which is where the storage compute trade comes in.", "tokens": [50614, 3013, 307, 689, 264, 6725, 14722, 4923, 1487, 294, 13, 50719], "temperature": 0.0, "avg_logprob": -0.1204987154662154, "compression_ratio": 1.6416382252559727, "no_speech_prob": 1.9969050284868173e-12}, {"id": 579, "seek": 208480, "start": 2092.5, "end": 2096.6200000000003, "text": " As local, on-device AI gets exponentially cheaper and more powerful,", "tokens": [50750, 1018, 2654, 11, 322, 12, 40343, 573, 7318, 2170, 37330, 12284, 293, 544, 4005, 11, 50956], "temperature": 0.0, "avg_logprob": -0.1204987154662154, "compression_ratio": 1.6416382252559727, "no_speech_prob": 1.9969050284868173e-12}, {"id": 580, "seek": 208480, "start": 2096.92, "end": 2101.6400000000003, "text": " it makes much more sense structurally to only ever transmit and store the tiny text file.", "tokens": [50971, 309, 1669, 709, 544, 2020, 6594, 6512, 281, 787, 1562, 17831, 293, 3531, 264, 5870, 2487, 3991, 13, 51207], "temperature": 0.0, "avg_logprob": -0.1204987154662154, "compression_ratio": 1.6416382252559727, "no_speech_prob": 1.9969050284868173e-12}, {"id": 581, "seek": 208480, "start": 2101.98, "end": 2103.32, "text": " Okay, so how do I listen to it?", "tokens": [51224, 1033, 11, 370, 577, 360, 286, 2140, 281, 309, 30, 51291], "temperature": 0.0, "avg_logprob": -0.1204987154662154, "compression_ratio": 1.6416382252559727, "no_speech_prob": 1.9969050284868173e-12}, {"id": 582, "seek": 208480, "start": 2103.52, "end": 2108.5800000000004, "text": " When you get in your car, your local device reads the symbols and re-renders the audio on the fly,", "tokens": [51301, 1133, 291, 483, 294, 428, 1032, 11, 428, 2654, 4302, 15700, 264, 16944, 293, 319, 12, 4542, 433, 264, 6278, 322, 264, 3603, 11, 51554], "temperature": 0.0, "avg_logprob": -0.1204987154662154, "compression_ratio": 1.6416382252559727, "no_speech_prob": 1.9969050284868173e-12}, {"id": 583, "seek": 208480, "start": 2109.02, "end": 2110.84, "text": " custom-generating the voice for you.", "tokens": [51576, 2375, 12, 21848, 990, 264, 3177, 337, 291, 13, 51667], "temperature": 0.0, "avg_logprob": -0.1204987154662154, "compression_ratio": 1.6416382252559727, "no_speech_prob": 1.9969050284868173e-12}, {"id": 584, "seek": 211084, "start": 2110.84, "end": 2116.84, "text": " Ah, so the audio is generated purely locally from a pristine symbolic source.", "tokens": [50365, 2438, 11, 370, 264, 6278, 307, 10833, 17491, 16143, 490, 257, 582, 42745, 25755, 4009, 13, 50665], "temperature": 0.0, "avg_logprob": -0.1403510981592639, "compression_ratio": 1.6245614035087719, "no_speech_prob": 1.6552395305097223e-12}, {"id": 585, "seek": 211084, "start": 2117.02, "end": 2117.2400000000002, "text": " Yes.", "tokens": [50674, 1079, 13, 50685], "temperature": 0.0, "avg_logprob": -0.1403510981592639, "compression_ratio": 1.6245614035087719, "no_speech_prob": 1.6552395305097223e-12}, {"id": 586, "seek": 211084, "start": 2117.58, "end": 2121.88, "text": " Infliction calls this closing the synthetic loop, which is Remark 4.7.", "tokens": [50702, 682, 3423, 4105, 5498, 341, 10377, 264, 23420, 6367, 11, 597, 307, 4080, 809, 1017, 13, 22, 13, 50917], "temperature": 0.0, "avg_logprob": -0.1403510981592639, "compression_ratio": 1.6245614035087719, "no_speech_prob": 1.6552395305097223e-12}, {"id": 587, "seek": 211084, "start": 2122.7000000000003, "end": 2129.32, "text": " If you write an essay using a repair channel, and a local AI synthesizes it into perfectly clean audio for a listener,", "tokens": [50958, 759, 291, 2464, 364, 16238, 1228, 257, 10535, 2269, 11, 293, 257, 2654, 7318, 26617, 5660, 309, 666, 6239, 2541, 6278, 337, 257, 31569, 11, 51289], "temperature": 0.0, "avg_logprob": -0.1403510981592639, "compression_ratio": 1.6245614035087719, "no_speech_prob": 1.6552395305097223e-12}, {"id": 588, "seek": 211084, "start": 2129.84, "end": 2133.26, "text": " that audio never physically touched a messy acoustic environment.", "tokens": [51315, 300, 6278, 1128, 9762, 9828, 257, 16191, 26753, 2823, 13, 51486], "temperature": 0.0, "avg_logprob": -0.1403510981592639, "compression_ratio": 1.6245614035087719, "no_speech_prob": 1.6552395305097223e-12}, {"id": 589, "seek": 211084, "start": 2133.4, "end": 2134.6000000000004, "text": " It never bounced around a room.", "tokens": [51493, 467, 1128, 46482, 926, 257, 1808, 13, 51553], "temperature": 0.0, "avg_logprob": -0.1403510981592639, "compression_ratio": 1.6245614035087719, "no_speech_prob": 1.6552395305097223e-12}, {"id": 590, "seek": 211084, "start": 2134.76, "end": 2135.0, "text": " Right.", "tokens": [51561, 1779, 13, 51573], "temperature": 0.0, "avg_logprob": -0.1403510981592639, "compression_ratio": 1.6245614035087719, "no_speech_prob": 1.6552395305097223e-12}, {"id": 591, "seek": 211084, "start": 2135.1000000000004, "end": 2139.28, "text": " It has no generative leak, no admitted background noise, and no biological buffering.", "tokens": [51578, 467, 575, 572, 1337, 1166, 17143, 11, 572, 14920, 3678, 5658, 11, 293, 572, 13910, 9204, 1794, 13, 51787], "temperature": 0.0, "avg_logprob": -0.1403510981592639, "compression_ratio": 1.6245614035087719, "no_speech_prob": 1.6552395305097223e-12}, {"id": 592, "seek": 213928, "start": 2139.28, "end": 2141.94, "text": " It is the perfect, clean transmission of intention.", "tokens": [50365, 467, 307, 264, 2176, 11, 2541, 11574, 295, 7789, 13, 50498], "temperature": 0.0, "avg_logprob": -0.11930855249954482, "compression_ratio": 1.6164874551971327, "no_speech_prob": 1.6298270242090518e-12}, {"id": 593, "seek": 213928, "start": 2142.2000000000003, "end": 2143.7000000000003, "text": " It is the ultimate clean x-ray.", "tokens": [50511, 467, 307, 264, 9705, 2541, 2031, 12, 3458, 13, 50586], "temperature": 0.0, "avg_logprob": -0.11930855249954482, "compression_ratio": 1.6164874551971327, "no_speech_prob": 1.6298270242090518e-12}, {"id": 594, "seek": 213928, "start": 2144.1600000000003, "end": 2146.7200000000003, "text": " But this leads to a massive, looming problem.", "tokens": [50609, 583, 341, 6689, 281, 257, 5994, 11, 450, 10539, 1154, 13, 50737], "temperature": 0.0, "avg_logprob": -0.11930855249954482, "compression_ratio": 1.6164874551971327, "no_speech_prob": 1.6298270242090518e-12}, {"id": 595, "seek": 213928, "start": 2147.32, "end": 2152.38, "text": " If text the committed symbol is the ultimate, safest format of record, we still have to generate the text.", "tokens": [50767, 759, 2487, 264, 7784, 5986, 307, 264, 9705, 11, 37558, 7877, 295, 2136, 11, 321, 920, 362, 281, 8460, 264, 2487, 13, 51020], "temperature": 0.0, "avg_logprob": -0.11930855249954482, "compression_ratio": 1.6164874551971327, "no_speech_prob": 1.6298270242090518e-12}, {"id": 596, "seek": 213928, "start": 2152.42, "end": 2152.9, "text": " Yes, we do.", "tokens": [51022, 1079, 11, 321, 360, 13, 51046], "temperature": 0.0, "avg_logprob": -0.11930855249954482, "compression_ratio": 1.6164874551971327, "no_speech_prob": 1.6298270242090518e-12}, {"id": 597, "seek": 213928, "start": 2153.1600000000003, "end": 2157.9, "text": " And typing on a physical keyboard with our fleshy fingers is incredibly slow.", "tokens": [51059, 400, 18444, 322, 257, 4001, 10186, 365, 527, 283, 904, 3495, 7350, 307, 6252, 2964, 13, 51296], "temperature": 0.0, "avg_logprob": -0.11930855249954482, "compression_ratio": 1.6164874551971327, "no_speech_prob": 1.6298270242090518e-12}, {"id": 598, "seek": 213928, "start": 2158.0400000000004, "end": 2160.0, "text": " We think way faster than we type.", "tokens": [51303, 492, 519, 636, 4663, 813, 321, 2010, 13, 51401], "temperature": 0.0, "avg_logprob": -0.11930855249954482, "compression_ratio": 1.6164874551971327, "no_speech_prob": 1.6298270242090518e-12}, {"id": 599, "seek": 213928, "start": 2160.6400000000003, "end": 2165.36, "text": " So where do we go next if we want the speed of speech without the liability of microphone?", "tokens": [51433, 407, 689, 360, 321, 352, 958, 498, 321, 528, 264, 3073, 295, 6218, 1553, 264, 25196, 295, 10952, 30, 51669], "temperature": 0.0, "avg_logprob": -0.11930855249954482, "compression_ratio": 1.6164874551971327, "no_speech_prob": 1.6298270242090518e-12}, {"id": 600, "seek": 216536, "start": 2165.36, "end": 2170.08, "text": " We arrive at Chapter 14, the frontier of sub-vocal and myoelectric channels.", "tokens": [50365, 492, 8881, 412, 18874, 3499, 11, 264, 35853, 295, 1422, 12, 42809, 293, 452, 7921, 38421, 9235, 13, 50601], "temperature": 0.0, "avg_logprob": -0.16342254261394124, "compression_ratio": 1.487603305785124, "no_speech_prob": 1.7141071548265607e-12}, {"id": 601, "seek": 216536, "start": 2170.28, "end": 2173.7200000000003, "text": " This is the sci-fi stuff that is actually in research labs right now.", "tokens": [50611, 639, 307, 264, 2180, 12, 13325, 1507, 300, 307, 767, 294, 2132, 20339, 558, 586, 13, 50783], "temperature": 0.0, "avg_logprob": -0.16342254261394124, "compression_ratio": 1.487603305785124, "no_speech_prob": 1.7141071548265607e-12}, {"id": 602, "seek": 216536, "start": 2174.26, "end": 2178.2400000000002, "text": " Explain mechanically how these work because they bypass the acoustic room entirely, right?", "tokens": [50810, 39574, 4236, 984, 577, 613, 589, 570, 436, 24996, 264, 26753, 1808, 7696, 11, 558, 30, 51009], "temperature": 0.0, "avg_logprob": -0.16342254261394124, "compression_ratio": 1.487603305785124, "no_speech_prob": 1.7141071548265607e-12}, {"id": 603, "seek": 216536, "start": 2178.28, "end": 2178.7200000000003, "text": " Exactly.", "tokens": [51011, 7587, 13, 51033], "temperature": 0.0, "avg_logprob": -0.16342254261394124, "compression_ratio": 1.487603305785124, "no_speech_prob": 1.7141071548265607e-12}, {"id": 604, "seek": 216536, "start": 2179.2200000000003, "end": 2186.92, "text": " Sub-vocal interfaces read the silent, microscopic, neuromuscular articulations from your jaw, throat, and larynx.", "tokens": [51058, 8511, 12, 42809, 28416, 1401, 264, 12784, 11, 47897, 11, 12087, 298, 301, 17792, 15228, 4136, 490, 428, 18162, 11, 12394, 11, 293, 287, 39008, 87, 13, 51443], "temperature": 0.0, "avg_logprob": -0.16342254261394124, "compression_ratio": 1.487603305785124, "no_speech_prob": 1.7141071548265607e-12}, {"id": 605, "seek": 218692, "start": 2186.92, "end": 2193.5, "text": " When you speak words silently in your head, your vocal cords and muscles twitch in infinitesimal amounts.", "tokens": [50365, 1133, 291, 1710, 2283, 40087, 294, 428, 1378, 11, 428, 11657, 36302, 293, 9530, 34167, 294, 7193, 3324, 10650, 11663, 13, 50694], "temperature": 0.0, "avg_logprob": -0.16036353268466152, "compression_ratio": 1.596, "no_speech_prob": 1.8980342471330847e-12}, {"id": 606, "seek": 218692, "start": 2193.7400000000002, "end": 2193.8, "text": " Okay.", "tokens": [50706, 1033, 13, 50709], "temperature": 0.0, "avg_logprob": -0.16036353268466152, "compression_ratio": 1.596, "no_speech_prob": 1.8980342471330847e-12}, {"id": 607, "seek": 218692, "start": 2194.4, "end": 2197.84, "text": " Wearable sensors pick up those electrical signals and translate them into text.", "tokens": [50739, 34514, 712, 14840, 1888, 493, 729, 12147, 12354, 293, 13799, 552, 666, 2487, 13, 50911], "temperature": 0.0, "avg_logprob": -0.16036353268466152, "compression_ratio": 1.596, "no_speech_prob": 1.8980342471330847e-12}, {"id": 608, "seek": 218692, "start": 2198.06, "end": 2201.12, "text": " You are literally speaking but emitting zero sound.", "tokens": [50922, 509, 366, 3736, 4124, 457, 846, 2414, 4018, 1626, 13, 51075], "temperature": 0.0, "avg_logprob": -0.16036353268466152, "compression_ratio": 1.596, "no_speech_prob": 1.8980342471330847e-12}, {"id": 609, "seek": 218692, "start": 2201.54, "end": 2204.7000000000003, "text": " And myoelectric channels are the same concept but for the hands.", "tokens": [51096, 400, 452, 7921, 38421, 9235, 366, 264, 912, 3410, 457, 337, 264, 2377, 13, 51254], "temperature": 0.0, "avg_logprob": -0.16036353268466152, "compression_ratio": 1.596, "no_speech_prob": 1.8980342471330847e-12}, {"id": 610, "seek": 218692, "start": 2205.2200000000003, "end": 2209.56, "text": " A band around your forearm reads the motor neuron activity traveling down to your fingers.", "tokens": [51280, 316, 4116, 926, 428, 47712, 15700, 264, 5932, 34090, 5191, 9712, 760, 281, 428, 7350, 13, 51497], "temperature": 0.0, "avg_logprob": -0.16036353268466152, "compression_ratio": 1.596, "no_speech_prob": 1.8980342471330847e-12}, {"id": 611, "seek": 220956, "start": 2209.56, "end": 2216.7799999999997, "text": " So you can type on an invisible virtual keyboard just by intending to move your fingers without ever actually striking a physical key.", "tokens": [50365, 407, 291, 393, 2010, 322, 364, 14603, 6374, 10186, 445, 538, 560, 2029, 281, 1286, 428, 7350, 1553, 1562, 767, 18559, 257, 4001, 2141, 13, 50726], "temperature": 0.0, "avg_logprob": -0.11646395176649094, "compression_ratio": 1.793548387096774, "no_speech_prob": 1.7760889330434293e-12}, {"id": 612, "seek": 220956, "start": 2217.22, "end": 2221.68, "text": " On paper, these interfaces sound like the holy grail of human-computer interaction.", "tokens": [50748, 1282, 3035, 11, 613, 28416, 1626, 411, 264, 10622, 1295, 388, 295, 1952, 12, 1112, 13849, 9285, 13, 50971], "temperature": 0.0, "avg_logprob": -0.11646395176649094, "compression_ratio": 1.793548387096774, "no_speech_prob": 1.7760889330434293e-12}, {"id": 613, "seek": 220956, "start": 2222.32, "end": 2228.38, "text": " You achieve the double silence of typing nobody in the coffee shop hears you and no microphone admits the noisy room.", "tokens": [51003, 509, 4584, 264, 3834, 12239, 295, 18444, 5079, 294, 264, 4982, 3945, 25688, 291, 293, 572, 10952, 46682, 264, 24518, 1808, 13, 51306], "temperature": 0.0, "avg_logprob": -0.11646395176649094, "compression_ratio": 1.793548387096774, "no_speech_prob": 1.7760889330434293e-12}, {"id": 614, "seek": 220956, "start": 2228.6, "end": 2234.2799999999997, "text": " But you achieve it at the blistering, frictionless speed of thought or at least the speed of silent speech.", "tokens": [51317, 583, 291, 4584, 309, 412, 264, 888, 1964, 278, 11, 17710, 1832, 3073, 295, 1194, 420, 412, 1935, 264, 3073, 295, 12784, 6218, 13, 51601], "temperature": 0.0, "avg_logprob": -0.11646395176649094, "compression_ratio": 1.793548387096774, "no_speech_prob": 1.7760889330434293e-12}, {"id": 615, "seek": 220956, "start": 2234.42, "end": 2235.38, "text": " It sounds perfect.", "tokens": [51608, 467, 3263, 2176, 13, 51656], "temperature": 0.0, "avg_logprob": -0.11646395176649094, "compression_ratio": 1.793548387096774, "no_speech_prob": 1.7760889330434293e-12}, {"id": 616, "seek": 220956, "start": 2235.52, "end": 2236.62, "text": " It solves the admission problem.", "tokens": [51663, 467, 39890, 264, 24668, 1154, 13, 51718], "temperature": 0.0, "avg_logprob": -0.11646395176649094, "compression_ratio": 1.793548387096774, "no_speech_prob": 1.7760889330434293e-12}, {"id": 617, "seek": 220956, "start": 2236.74, "end": 2237.9, "text": " It solves the admission problem.", "tokens": [51724, 467, 39890, 264, 24668, 1154, 13, 51782], "temperature": 0.0, "avg_logprob": -0.11646395176649094, "compression_ratio": 1.793548387096774, "no_speech_prob": 1.7760889330434293e-12}, {"id": 618, "seek": 220956, "start": 2237.9, "end": 2239.1, "text": " It gives us maximum speed.", "tokens": [51782, 467, 2709, 505, 6674, 3073, 13, 51842], "temperature": 0.0, "avg_logprob": -0.11646395176649094, "compression_ratio": 1.793548387096774, "no_speech_prob": 1.7760889330434293e-12}, {"id": 619, "seek": 223956, "start": 2239.56, "end": 2245.86, "text": " But Fliction ends to treat us with a massive flashing red warning about this specific technology, don't they?", "tokens": [50365, 583, 3235, 4105, 5314, 281, 2387, 505, 365, 257, 5994, 31049, 2182, 9164, 466, 341, 2685, 2899, 11, 500, 380, 436, 30, 50680], "temperature": 0.0, "avg_logprob": -0.14141602516174318, "compression_ratio": 1.6267605633802817, "no_speech_prob": 1.4550723907019725e-12}, {"id": 620, "seek": 223956, "start": 2246.06, "end": 2250.48, "text": " Proposition 14.1 warns of what Fliction terms the gravest scene.", "tokens": [50690, 21944, 5830, 3499, 13, 16, 12286, 82, 295, 437, 3235, 4105, 2115, 264, 1295, 5571, 4145, 13, 50911], "temperature": 0.0, "avg_logprob": -0.14141602516174318, "compression_ratio": 1.6267605633802817, "no_speech_prob": 1.4550723907019725e-12}, {"id": 621, "seek": 223956, "start": 2250.64, "end": 2251.82, "text": " The gravest scene.", "tokens": [50919, 440, 1295, 5571, 4145, 13, 50978], "temperature": 0.0, "avg_logprob": -0.14141602516174318, "compression_ratio": 1.6267605633802817, "no_speech_prob": 1.4550723907019725e-12}, {"id": 622, "seek": 223956, "start": 2252.04, "end": 2253.2799999999997, "text": " What happens if we get this wrong?", "tokens": [50989, 708, 2314, 498, 321, 483, 341, 2085, 30, 51051], "temperature": 0.0, "avg_logprob": -0.14141602516174318, "compression_ratio": 1.6267605633802817, "no_speech_prob": 1.4550723907019725e-12}, {"id": 623, "seek": 223956, "start": 2253.42, "end": 2256.5, "text": " The danger lies in the loss of the physical commitment boundary.", "tokens": [51058, 440, 4330, 9134, 294, 264, 4470, 295, 264, 4001, 8371, 12866, 13, 51212], "temperature": 0.0, "avg_logprob": -0.14141602516174318, "compression_ratio": 1.6267605633802817, "no_speech_prob": 1.4550723907019725e-12}, {"id": 624, "seek": 223956, "start": 2257.0, "end": 2261.94, "text": " When you type on a keyboard, a key requires a specific gram force of pressure to actuate.", "tokens": [51237, 1133, 291, 2010, 322, 257, 10186, 11, 257, 2141, 7029, 257, 2685, 21353, 3464, 295, 3321, 281, 605, 10107, 13, 51484], "temperature": 0.0, "avg_logprob": -0.14141602516174318, "compression_ratio": 1.6267605633802817, "no_speech_prob": 1.4550723907019725e-12}, {"id": 625, "seek": 223956, "start": 2262.36, "end": 2264.02, "text": " It is a binary physical threshold.", "tokens": [51505, 467, 307, 257, 17434, 4001, 14678, 13, 51588], "temperature": 0.0, "avg_logprob": -0.14141602516174318, "compression_ratio": 1.6267605633802817, "no_speech_prob": 1.4550723907019725e-12}, {"id": 626, "seek": 223956, "start": 2264.02, "end": 2266.34, "text": " You either push the key down or you didn't.", "tokens": [51588, 509, 2139, 2944, 264, 2141, 760, 420, 291, 994, 380, 13, 51704], "temperature": 0.0, "avg_logprob": -0.14141602516174318, "compression_ratio": 1.6267605633802817, "no_speech_prob": 1.4550723907019725e-12}, {"id": 627, "seek": 226634, "start": 2266.34, "end": 2271.8, "text": " But myoelectric and sub-vocal sensors are dealing with continuous noisy biological signals.", "tokens": [50365, 583, 452, 7921, 38421, 293, 1422, 12, 42809, 14840, 366, 6260, 365, 10957, 24518, 13910, 12354, 13, 50638], "temperature": 0.0, "avg_logprob": -0.2006291476162997, "compression_ratio": 1.3793103448275863, "no_speech_prob": 1.7414801154955195e-12}, {"id": 628, "seek": 226634, "start": 2272.26, "end": 2278.3, "text": " If the sensor is not calibrated with a flawless absolute commitment boundary, what does it start picking up?", "tokens": [50661, 759, 264, 10200, 307, 406, 21583, 5468, 365, 257, 45693, 8236, 8371, 12866, 11, 437, 775, 309, 722, 8867, 493, 30, 50963], "temperature": 0.0, "avg_logprob": -0.2006291476162997, "compression_ratio": 1.3793103448275863, "no_speech_prob": 1.7414801154955195e-12}, {"id": 629, "seek": 227830, "start": 2278.3, "end": 2279.48, "text": " Oh, God.", "tokens": [50365, 876, 11, 1265, 13, 50424], "temperature": 0.0, "avg_logprob": -0.23124674479166665, "compression_ratio": 1.4857142857142858, "no_speech_prob": 2.2885844695036406e-12}, {"id": 630, "seek": 227830, "start": 2279.76, "end": 2281.52, "text": " It starts picking up the drafts.", "tokens": [50438, 467, 3719, 8867, 493, 264, 11206, 82, 13, 50526], "temperature": 0.0, "avg_logprob": -0.23124674479166665, "compression_ratio": 1.4857142857142858, "no_speech_prob": 2.2885844695036406e-12}, {"id": 631, "seek": 227830, "start": 2281.8, "end": 2284.36, "text": " It picks up involuntary motor imagery.", "tokens": [50540, 467, 16137, 493, 2499, 2760, 822, 5932, 24340, 13, 50668], "temperature": 0.0, "avg_logprob": -0.23124674479166665, "compression_ratio": 1.4857142857142858, "no_speech_prob": 2.2885844695036406e-12}, {"id": 632, "seek": 227830, "start": 2284.6000000000004, "end": 2287.6200000000003, "text": " The things I rehearse in my head but decide not to say.", "tokens": [50680, 440, 721, 286, 14369, 11668, 294, 452, 1378, 457, 4536, 406, 281, 584, 13, 50831], "temperature": 0.0, "avg_logprob": -0.23124674479166665, "compression_ratio": 1.4857142857142858, "no_speech_prob": 2.2885844695036406e-12}, {"id": 633, "seek": 227830, "start": 2287.76, "end": 2288.0600000000004, "text": " Yes.", "tokens": [50838, 1079, 13, 50853], "temperature": 0.0, "avg_logprob": -0.23124674479166665, "compression_ratio": 1.4857142857142858, "no_speech_prob": 2.2885844695036406e-12}, {"id": 634, "seek": 227830, "start": 2288.42, "end": 2295.1000000000004, "text": " It picks up the silent rehearsal, the intrusive thoughts, the anger you suppress before formulating a polite response.", "tokens": [50871, 467, 16137, 493, 264, 12784, 24884, 11, 264, 560, 13783, 488, 4598, 11, 264, 10240, 291, 26835, 949, 1254, 12162, 257, 25171, 4134, 13, 51205], "temperature": 0.0, "avg_logprob": -0.23124674479166665, "compression_ratio": 1.4857142857142858, "no_speech_prob": 2.2885844695036406e-12}, {"id": 635, "seek": 229510, "start": 2295.1, "end": 2303.7999999999997, "text": " If a sub-vocal interface begins to record your internal monologue because the commitment threshold is too low, it ceases to be a symbol sampling correspondent.", "tokens": [50365, 759, 257, 1422, 12, 42809, 9226, 7338, 281, 2136, 428, 6920, 1108, 42298, 570, 264, 8371, 14678, 307, 886, 2295, 11, 309, 1769, 1957, 281, 312, 257, 5986, 21179, 44406, 13, 50800], "temperature": 0.0, "avg_logprob": -0.11198892348851913, "compression_ratio": 1.5972850678733033, "no_speech_prob": 2.0923989537541265e-12}, {"id": 636, "seek": 229510, "start": 2303.88, "end": 2306.7, "text": " It becomes a scene sampling resident of your own cognition.", "tokens": [50804, 467, 3643, 257, 4145, 21179, 10832, 295, 428, 1065, 46905, 13, 50945], "temperature": 0.0, "avg_logprob": -0.11198892348851913, "compression_ratio": 1.5972850678733033, "no_speech_prob": 2.0923989537541265e-12}, {"id": 637, "seek": 229510, "start": 2306.98, "end": 2308.92, "text": " The stakes literally could not be higher.", "tokens": [50959, 440, 28429, 3736, 727, 406, 312, 2946, 13, 51056], "temperature": 0.0, "avg_logprob": -0.11198892348851913, "compression_ratio": 1.5972850678733033, "no_speech_prob": 2.0923989537541265e-12}, {"id": 638, "seek": 229510, "start": 2309.2, "end": 2313.0, "text": " We would take the microphone out of the living room and embed it into our own subconscious.", "tokens": [51070, 492, 576, 747, 264, 10952, 484, 295, 264, 2647, 1808, 293, 12240, 309, 666, 527, 1065, 27389, 13, 51260], "temperature": 0.0, "avg_logprob": -0.11198892348851913, "compression_ratio": 1.5972850678733033, "no_speech_prob": 2.0923989537541265e-12}, {"id": 639, "seek": 231300, "start": 2313.0, "end": 2319.76, "text": " If we mess up the engineering on these frictionless interfaces, we turn our own brains into a noisy backyard.", "tokens": [50365, 759, 321, 2082, 493, 264, 7043, 322, 613, 17710, 1832, 28416, 11, 321, 1261, 527, 1065, 15442, 666, 257, 24518, 20036, 13, 50703], "temperature": 0.0, "avg_logprob": -0.1372674101142473, "compression_ratio": 1.6422413793103448, "no_speech_prob": 1.5977217378976283e-12}, {"id": 640, "seek": 231300, "start": 2320.0, "end": 2320.26, "text": " Wow.", "tokens": [50715, 3153, 13, 50728], "temperature": 0.0, "avg_logprob": -0.1372674101142473, "compression_ratio": 1.6422413793103448, "no_speech_prob": 1.5977217378976283e-12}, {"id": 641, "seek": 231300, "start": 2320.52, "end": 2326.42, "text": " And the machine starts transcribing every erratic satirical wish that pops into our heads before we can stop it.", "tokens": [50741, 400, 264, 3479, 3719, 1145, 39541, 633, 1189, 25198, 3227, 347, 804, 3172, 300, 16795, 666, 527, 8050, 949, 321, 393, 1590, 309, 13, 51036], "temperature": 0.0, "avg_logprob": -0.1372674101142473, "compression_ratio": 1.6422413793103448, "no_speech_prob": 1.5977217378976283e-12}, {"id": 642, "seek": 231300, "start": 2326.5, "end": 2328.72, "text": " We would automate the destruction of the repair interval.", "tokens": [51040, 492, 576, 31605, 264, 13563, 295, 264, 10535, 15035, 13, 51151], "temperature": 0.0, "avg_logprob": -0.1372674101142473, "compression_ratio": 1.6422413793103448, "no_speech_prob": 1.5977217378976283e-12}, {"id": 643, "seek": 231300, "start": 2328.92, "end": 2331.36, "text": " We would abolish the draft entirely.", "tokens": [51161, 492, 576, 23183, 742, 264, 11206, 7696, 13, 51283], "temperature": 0.0, "avg_logprob": -0.1372674101142473, "compression_ratio": 1.6422413793103448, "no_speech_prob": 1.5977217378976283e-12}, {"id": 644, "seek": 231300, "start": 2331.94, "end": 2334.4, "text": " And we would do it to ourselves in the name of efficiency.", "tokens": [51312, 400, 321, 576, 360, 309, 281, 4175, 294, 264, 1315, 295, 10493, 13, 51435], "temperature": 0.0, "avg_logprob": -0.1372674101142473, "compression_ratio": 1.6422413793103448, "no_speech_prob": 1.5977217378976283e-12}, {"id": 645, "seek": 233440, "start": 2334.4, "end": 2340.2000000000003, "text": " We have covered an immense amount of ground today, and I want to try and synthesize this journey for you, the listener.", "tokens": [50365, 492, 362, 5343, 364, 22920, 2372, 295, 2727, 965, 11, 293, 286, 528, 281, 853, 293, 26617, 1125, 341, 4671, 337, 291, 11, 264, 31569, 13, 50655], "temperature": 0.0, "avg_logprob": -0.11909122669950445, "compression_ratio": 1.5814814814814815, "no_speech_prob": 2.236644246547681e-12}, {"id": 646, "seek": 233440, "start": 2340.64, "end": 2345.42, "text": " We started by learning that the difference between typing and speaking isn't just a matter of convenience.", "tokens": [50677, 492, 1409, 538, 2539, 300, 264, 2649, 1296, 18444, 293, 4124, 1943, 380, 445, 257, 1871, 295, 19283, 13, 50916], "temperature": 0.0, "avg_logprob": -0.11909122669950445, "compression_ratio": 1.5814814814814815, "no_speech_prob": 2.236644246547681e-12}, {"id": 647, "seek": 233440, "start": 2345.92, "end": 2348.86, "text": " It is governed by the rigid physics of superposition.", "tokens": [50941, 467, 307, 35529, 538, 264, 22195, 10649, 295, 1687, 38078, 13, 51088], "temperature": 0.0, "avg_logprob": -0.11909122669950445, "compression_ratio": 1.5814814814814815, "no_speech_prob": 2.236644246547681e-12}, {"id": 648, "seek": 233440, "start": 2349.2000000000003, "end": 2349.52, "text": " Yes.", "tokens": [51105, 1079, 13, 51121], "temperature": 0.0, "avg_logprob": -0.11909122669950445, "compression_ratio": 1.5814814814814815, "no_speech_prob": 2.236644246547681e-12}, {"id": 649, "seek": 233440, "start": 2349.84, "end": 2357.54, "text": " We saw how microphones act as giant fishing nets that mathematically destroy our intentional metadata, leaving AI to hallucinate our meaning.", "tokens": [51137, 492, 1866, 577, 30495, 605, 382, 7410, 10180, 36170, 300, 44003, 5293, 527, 21935, 26603, 11, 5012, 7318, 281, 35212, 13923, 527, 3620, 13, 51522], "temperature": 0.0, "avg_logprob": -0.11909122669950445, "compression_ratio": 1.5814814814814815, "no_speech_prob": 2.236644246547681e-12}, {"id": 650, "seek": 235754, "start": 2357.54, "end": 2368.54, "text": " We explored how live, rate-coupled channels force our cognition into a public performance, converting our deep thoughts into awkward biological buffering icons.", "tokens": [50365, 492, 24016, 577, 1621, 11, 3314, 12, 66, 263, 15551, 9235, 3464, 527, 46905, 666, 257, 1908, 3389, 11, 29942, 527, 2452, 4598, 666, 11411, 13910, 9204, 1794, 23308, 13, 50915], "temperature": 0.0, "avg_logprob": -0.09406421059056332, "compression_ratio": 1.5, "no_speech_prob": 1.9432062296070862e-12}, {"id": 651, "seek": 235754, "start": 2368.8, "end": 2368.92, "text": " Right.", "tokens": [50928, 1779, 13, 50934], "temperature": 0.0, "avg_logprob": -0.09406421059056332, "compression_ratio": 1.5, "no_speech_prob": 1.9432062296070862e-12}, {"id": 652, "seek": 235754, "start": 2369.24, "end": 2380.04, "text": " And we saw how the Profile Society leverages this dynamic to systematically punish careful revisers, forcing everyone to prove their worth through no-repair interviews and soundbites.", "tokens": [50950, 400, 321, 1866, 577, 264, 6039, 794, 13742, 12451, 1660, 341, 8546, 281, 39531, 9842, 5026, 20767, 433, 11, 19030, 1518, 281, 7081, 641, 3163, 807, 572, 12, 19919, 1246, 12318, 293, 1626, 65, 3324, 13, 51490], "temperature": 0.0, "avg_logprob": -0.09406421059056332, "compression_ratio": 1.5, "no_speech_prob": 1.9432062296070862e-12}, {"id": 653, "seek": 238004, "start": 2380.04, "end": 2396.58, "text": " We dug into the legal nightmare of the robo-nanny trilemma, realizing that our smart homes are deliberately engineered to be selectively deaf to our emergencies, using wake words as knowledge firewalls, just so tech companies can avoid the legal obligations of being a capable witness.", "tokens": [50365, 492, 22954, 666, 264, 5089, 18724, 295, 264, 744, 1763, 12, 77, 11612, 1376, 10386, 1696, 11, 16734, 300, 527, 4069, 7388, 366, 23506, 38648, 281, 312, 3048, 3413, 15559, 281, 527, 43483, 11, 1228, 6634, 2283, 382, 3601, 36109, 82, 11, 445, 370, 7553, 3431, 393, 5042, 264, 5089, 26234, 295, 885, 257, 8189, 7286, 13, 51192], "temperature": 0.0, "avg_logprob": -0.07480126908681925, "compression_ratio": 1.5932203389830508, "no_speech_prob": 1.950821882507059e-12}, {"id": 654, "seek": 238004, "start": 2396.7, "end": 2397.66, "text": " It's all about liability.", "tokens": [51198, 467, 311, 439, 466, 25196, 13, 51246], "temperature": 0.0, "avg_logprob": -0.07480126908681925, "compression_ratio": 1.5932203389830508, "no_speech_prob": 1.950821882507059e-12}, {"id": 655, "seek": 238004, "start": 2397.92, "end": 2402.64, "text": " We learned to look at every piece of technology and ask the fundamental taxonomy question.", "tokens": [51259, 492, 3264, 281, 574, 412, 633, 2522, 295, 2899, 293, 1029, 264, 8088, 3366, 23423, 1168, 13, 51495], "temperature": 0.0, "avg_logprob": -0.07480126908681925, "compression_ratio": 1.5932203389830508, "no_speech_prob": 1.950821882507059e-12}, {"id": 656, "seek": 238004, "start": 2403.7, "end": 2407.5, "text": " Are you my polite correspondent, or are you my continuous resident?", "tokens": [51548, 2014, 291, 452, 25171, 44406, 11, 420, 366, 291, 452, 10957, 10832, 30, 51738], "temperature": 0.0, "avg_logprob": -0.07480126908681925, "compression_ratio": 1.5932203389830508, "no_speech_prob": 1.950821882507059e-12}, {"id": 657, "seek": 240750, "start": 2407.5, "end": 2415.1, "text": " It is a complete structural reframing of the boundaries between the physical world, the digital record, and the liability of witness.", "tokens": [50365, 467, 307, 257, 3566, 15067, 1895, 2356, 278, 295, 264, 13180, 1296, 264, 4001, 1002, 11, 264, 4562, 2136, 11, 293, 264, 25196, 295, 7286, 13, 50745], "temperature": 0.0, "avg_logprob": -0.08413739961998484, "compression_ratio": 1.6064981949458483, "no_speech_prob": 1.9969089316146382e-12}, {"id": 658, "seek": 240750, "start": 2415.22, "end": 2415.8, "text": " It really is.", "tokens": [50751, 467, 534, 307, 13, 50780], "temperature": 0.0, "avg_logprob": -0.08413739961998484, "compression_ratio": 1.6064981949458483, "no_speech_prob": 1.9969089316146382e-12}, {"id": 659, "seek": 240750, "start": 2416.02, "end": 2421.38, "text": " And as we wrap up this deep dive, I want to leave you with one final provocative thought to mull over as you go about your day.", "tokens": [50791, 400, 382, 321, 7019, 493, 341, 2452, 9192, 11, 286, 528, 281, 1856, 291, 365, 472, 2572, 47663, 1194, 281, 275, 858, 670, 382, 291, 352, 466, 428, 786, 13, 51059], "temperature": 0.0, "avg_logprob": -0.08413739961998484, "compression_ratio": 1.6064981949458483, "no_speech_prob": 1.9969089316146382e-12}, {"id": 660, "seek": 240750, "start": 2422.36, "end": 2431.08, "text": " Something deeply rooted in Fliction's treatise that we didn't explicitly unpack, but that forms the spiritual core of all this math and physics.", "tokens": [51108, 6595, 8760, 25277, 294, 3235, 4105, 311, 2387, 908, 300, 321, 994, 380, 20803, 26699, 11, 457, 300, 6422, 264, 6960, 4965, 295, 439, 341, 5221, 293, 10649, 13, 51544], "temperature": 0.0, "avg_logprob": -0.08413739961998484, "compression_ratio": 1.6064981949458483, "no_speech_prob": 1.9969089316146382e-12}, {"id": 661, "seek": 240750, "start": 2431.36, "end": 2432.2, "text": " Yeah, this is important.", "tokens": [51558, 865, 11, 341, 307, 1021, 13, 51600], "temperature": 0.0, "avg_logprob": -0.08413739961998484, "compression_ratio": 1.6064981949458483, "no_speech_prob": 1.9969089316146382e-12}, {"id": 662, "seek": 243220, "start": 2432.2, "end": 2439.7799999999997, "text": " We spend so much of our time and energy worrying about whether AI and algorithms are scraping our data or reading our emails or listening to our conversations.", "tokens": [50365, 492, 3496, 370, 709, 295, 527, 565, 293, 2281, 18788, 466, 1968, 7318, 293, 14642, 366, 43738, 527, 1412, 420, 3760, 527, 12524, 420, 4764, 281, 527, 7315, 13, 50744], "temperature": 0.0, "avg_logprob": -0.10112337546773476, "compression_ratio": 1.6417910447761195, "no_speech_prob": 2.1341882254499733e-12}, {"id": 663, "seek": 243220, "start": 2440.22, "end": 2442.68, "text": " We worry about the digital footprints we leave behind.", "tokens": [50766, 492, 3292, 466, 264, 4562, 45715, 321, 1856, 2261, 13, 50889], "temperature": 0.0, "avg_logprob": -0.10112337546773476, "compression_ratio": 1.6417910447761195, "no_speech_prob": 2.1341882254499733e-12}, {"id": 664, "seek": 243220, "start": 2443.48, "end": 2446.24, "text": " But think about the buffer draft inside your own mind.", "tokens": [50929, 583, 519, 466, 264, 21762, 11206, 1854, 428, 1065, 1575, 13, 51067], "temperature": 0.0, "avg_logprob": -0.10112337546773476, "compression_ratio": 1.6417910447761195, "no_speech_prob": 2.1341882254499733e-12}, {"id": 665, "seek": 243220, "start": 2446.3999999999996, "end": 2447.6, "text": " Your inner sanctum.", "tokens": [51075, 2260, 7284, 21794, 449, 13, 51135], "temperature": 0.0, "avg_logprob": -0.10112337546773476, "compression_ratio": 1.6417910447761195, "no_speech_prob": 2.1341882254499733e-12}, {"id": 666, "seek": 243220, "start": 2447.7999999999997, "end": 2456.8599999999997, "text": " Think about that tiny, sacred, unobservable gap of time between having a raw, messy, unformed thought and deciding to commit it to the physical world.", "tokens": [51145, 6557, 466, 300, 5870, 11, 15757, 11, 8526, 929, 1978, 712, 7417, 295, 565, 1296, 1419, 257, 8936, 11, 16191, 11, 517, 22892, 1194, 293, 17990, 281, 5599, 309, 281, 264, 4001, 1002, 13, 51598], "temperature": 0.0, "avg_logprob": -0.10112337546773476, "compression_ratio": 1.6417910447761195, "no_speech_prob": 2.1341882254499733e-12}, {"id": 667, "seek": 245686, "start": 2456.86, "end": 2459.6600000000003, "text": " That gap is your internal repair interval.", "tokens": [50365, 663, 7417, 307, 428, 6920, 10535, 15035, 13, 50505], "temperature": 0.0, "avg_logprob": -0.17857403368563265, "compression_ratio": 1.6042780748663101, "no_speech_prob": 1.4722257701133001e-12}, {"id": 668, "seek": 245686, "start": 2459.96, "end": 2462.34, "text": " It is the true sanctuary of human freedom.", "tokens": [50520, 467, 307, 264, 2074, 34390, 295, 1952, 5645, 13, 50639], "temperature": 0.0, "avg_logprob": -0.17857403368563265, "compression_ratio": 1.6042780748663101, "no_speech_prob": 1.4722257701133001e-12}, {"id": 669, "seek": 245686, "start": 2462.56, "end": 2470.96, "text": " The ability to be privately wrong, to be privately angry, to be privately confused, and then to revise yourself before the world ever sees it.", "tokens": [50650, 440, 3485, 281, 312, 31919, 2085, 11, 281, 312, 31919, 6884, 11, 281, 312, 31919, 9019, 11, 293, 550, 281, 44252, 1803, 949, 264, 1002, 1562, 8194, 309, 13, 51070], "temperature": 0.0, "avg_logprob": -0.17857403368563265, "compression_ratio": 1.6042780748663101, "no_speech_prob": 1.4722257701133001e-12}, {"id": 670, "seek": 245686, "start": 2471.6, "end": 2474.82, "text": " That is what allows us to be better than our initial impulses.", "tokens": [51102, 663, 307, 437, 4045, 505, 281, 312, 1101, 813, 527, 5883, 41767, 6196, 13, 51263], "temperature": 0.0, "avg_logprob": -0.17857403368563265, "compression_ratio": 1.6042780748663101, "no_speech_prob": 1.4722257701133001e-12}, {"id": 671, "seek": 245686, "start": 2474.88, "end": 2475.2000000000003, "text": " Exactly.", "tokens": [51266, 7587, 13, 51282], "temperature": 0.0, "avg_logprob": -0.17857403368563265, "compression_ratio": 1.6042780748663101, "no_speech_prob": 1.4722257701133001e-12}, {"id": 672, "seek": 247520, "start": 2475.2, "end": 2487.7799999999997, "text": " If this incoming wave of myoelectric and sub-vocal technology eliminates that gap for the sake of frictionless efficiency, if it harvests and releases our thoughts, the literal millisecond they are formed, we won't just lose our privacy.", "tokens": [50365, 759, 341, 22341, 5772, 295, 452, 7921, 38421, 293, 1422, 12, 42809, 2899, 49893, 300, 7417, 337, 264, 9717, 295, 17710, 1832, 10493, 11, 498, 309, 2233, 85, 4409, 293, 16952, 527, 4598, 11, 264, 20411, 27940, 18882, 436, 366, 8693, 11, 321, 1582, 380, 445, 3624, 527, 11427, 13, 50994], "temperature": 0.0, "avg_logprob": -0.0952087918618568, "compression_ratio": 1.640117994100295, "no_speech_prob": 2.316413120345695e-12}, {"id": 673, "seek": 247520, "start": 2488.04, "end": 2490.22, "text": " We will lose the very mechanism of human revision.", "tokens": [51007, 492, 486, 3624, 264, 588, 7513, 295, 1952, 34218, 13, 51116], "temperature": 0.0, "avg_logprob": -0.0952087918618568, "compression_ratio": 1.640117994100295, "no_speech_prob": 2.316413120345695e-12}, {"id": 674, "seek": 247520, "start": 2490.54, "end": 2491.7, "text": " Protect your repair interval.", "tokens": [51132, 32017, 428, 10535, 15035, 13, 51190], "temperature": 0.0, "avg_logprob": -0.0952087918618568, "compression_ratio": 1.640117994100295, "no_speech_prob": 2.316413120345695e-12}, {"id": 675, "seek": 247520, "start": 2492.04, "end": 2495.98, "text": " Guard that murky space in your head where you haven't yet produced a clean, final x-ray.", "tokens": [51207, 11549, 300, 5257, 4133, 1901, 294, 428, 1378, 689, 291, 2378, 380, 1939, 7126, 257, 2541, 11, 2572, 2031, 12, 3458, 13, 51404], "temperature": 0.0, "avg_logprob": -0.0952087918618568, "compression_ratio": 1.640117994100295, "no_speech_prob": 2.316413120345695e-12}, {"id": 676, "seek": 247520, "start": 2496.3199999999997, "end": 2499.3399999999997, "text": " Because the right to revise yourself is the most vital technology you possess.", "tokens": [51421, 1436, 264, 558, 281, 44252, 1803, 307, 264, 881, 11707, 2899, 291, 17490, 13, 51572], "temperature": 0.0, "avg_logprob": -0.0952087918618568, "compression_ratio": 1.640117994100295, "no_speech_prob": 2.316413120345695e-12}, {"id": 677, "seek": 247520, "start": 2499.8799999999997, "end": 2501.58, "text": " Thank you for taking this deep dive with us.", "tokens": [51599, 1044, 291, 337, 1940, 341, 2452, 9192, 365, 505, 13, 51684], "temperature": 0.0, "avg_logprob": -0.0952087918618568, "compression_ratio": 1.640117994100295, "no_speech_prob": 2.316413120345695e-12}, {"id": 678, "seek": 247520, "start": 2501.66, "end": 2502.3199999999997, "text": " We'll see you next time.", "tokens": [51688, 492, 603, 536, 291, 958, 565, 13, 51721], "temperature": 0.0, "avg_logprob": -0.0952087918618568, "compression_ratio": 1.640117994100295, "no_speech_prob": 2.316413120345695e-12}], "language": "en"}
